<script>
import { bindRuntime, runtime } from './lib/runtime.js'
import { recordDiagnostic, flushDiagnosticLog } from './lib/diagnostic-log.js'
import { WATCH_VERSION } from './lib/version.js'
import brightness from '@blueos.hardware.display.brightness'
import schedule from '@blueos.app.appmanager.schedule'
import { createTrainingRuntime } from './lib/training-runtime.js'
import { readStored, writeStoredAtomic } from './lib/persistence.js'
import { loadState, flushHr } from './lib/session.js'
import { startSessionHr } from './lib/sensors.js'
import { startServer, replayPendingEvents } from './lib/rpc.js'

function sessionDiagnosticContext() {
  try {
    const state = loadState('hr') || {}
    return { active: !!state.active, paused: !!state.pausedAt, sid: state.sid || '', sessionAt: state.startedAt || state.sessionAt || 0 }
  } catch { return { active: false } }
}
export default {
  onCreate() {
    bindRuntime(this.$def || this)
    const r = runtime(), timeouts = new Set(), intervals = new Set()
    r.destroyed = false
    runtime().timers = {
      setTimeout: (fn, ms) => {
        if (r.destroyed) return null
        const id = setTimeout(() => { timeouts.delete(id); if (!r.destroyed) fn() }, ms)
        timeouts.add(id); return id
      },
      clearTimeout: id => { if (r.destroyed) return; timeouts.delete(id); clearTimeout(id) },
      setInterval: (fn, ms) => {
        if (r.destroyed) return null
        const id = setInterval(() => { if (!r.destroyed) fn() }, ms)
        intervals.add(id); return id
      },
      clearInterval: id => { if (r.destroyed) return; intervals.delete(id); clearInterval(id) },
      dispose: () => {
        for (const id of timeouts) clearTimeout(id)
        for (const id of intervals) clearInterval(id)
        timeouts.clear(); intervals.clear()
      },
    }
    console.log('opengym 启动')
    try { recordDiagnostic('app_start', { version: WATCH_VERSION, ...sessionDiagnosticContext() }); flushDiagnosticLog() } catch { /* Diagnostics are optional. */ }
    const jobKey = 'training_background_job_v1'
    r.trainingRuntime = createTrainingRuntime({ brightness, schedule,
      // Full read only at lifecycle/checkpoint boundaries, so six-hour expiry
      // and durable close recovery also apply when no Page clock is running.
      isDestroyed: () => !!r.destroyed, readState: () => loadState(),
      readJob: () => readStored(jobKey), writeJob: async value => (await writeStoredAtomic(jobKey, () => value)).ok,
      setTimeout: r.timers.setTimeout, clearTimeout: r.timers.clearTimeout,
      record: recordDiagnostic, checkpoint: () => flushHr(),
      restore: () => { startServer(); startSessionHr(); replayPendingEvents() },
    })
    r.trainingRuntime.start()
  },
  onShow() {
    runtime().trainingRuntime?.show()
    try { recordDiagnostic('app_show', sessionDiagnosticContext()); flushDiagnosticLog() } catch {}
  },
  onHide() {
    runtime().trainingRuntime?.hide()
    try { recordDiagnostic('app_hide', sessionDiagnosticContext()); flushDiagnosticLog() } catch {}
  },
  onTrainingMaintenance(params) { return runtime().trainingRuntime?.run(params) },
  onError(error) {
    try { recordDiagnostic('app_error', { code: error?.code, ...sessionDiagnosticContext() }); flushDiagnosticLog() } catch {}
  },
  onDestroy() {
    try { recordDiagnostic('app_destroy', sessionDiagnosticContext()); flushDiagnosticLog() } catch { /* Best effort only. */ }
    const app = this.$def || this
    const r = app.openGymRuntime
    if (!r) return
    try { r.trainingRuntime?.dispose() } catch {}
    try { r.rpc?.stop?.() } catch { /* The SDK may already be closed. */ }
    try { r.hrCapture?.stop() } catch { /* Continue releasing other owners. */ }
    r.destroyed = true
    try { r.persistence?.dispose?.() } catch { /* Pending callers must not restart work. */ }
    r.timers?.dispose?.()
    // Native callbacks can outlive onDestroy. Keep the lifetime guard, release
    // large caches and Page subscribers; confirmed training remains on disk.
    delete r.diagnosticLog
    delete r.persistence
    delete r.hrCapture
    delete r.trainingRuntime
  },
}
</script>

<template>
  <div></div>
</template>

