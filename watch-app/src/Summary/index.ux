<script>
import { bindRuntime } from '../lib/runtime.js'
// 结束页：本次训练摘要。手机是数据源，这里只展示手表本地结算的结果。
// Official v1.4.5 SummaryScreen / SumStat / HrStat. Business receipt remains sid-specific.
import storage from '@blueos.storage.storage'
import router from '@blueos.app.appmanager.router'
import { startServer, synchronizationStatus, isConnected } from '../lib/rpc.js'
import { startSession, applySync } from '../lib/session.js'
import { journalDelivery } from '../lib/close-journal.js'
import {
  summaryDurationLabel, summaryMinutesOf, summaryNameLabel, summarySetsLabel,
  summaryVolumeOf, summaryHeartOf, summaryCaloriesOf, summarySyncLabel,
} from '../lib/summary-view.js'

export default {
  staticData: { rpcModel: { detach: null } },
  data: {
    blocks: [], summaryName: '', durationLabel: '', setsLabel: '', volumeText: '', volumeUnit: '', heartText: '', caloriesText: '',
    syncLabel: '',
    clockLabel: '',
  },

  onInit() {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    this.shownAt = Date.now()
    this.bindRpc()
    this.load()
  },

  // 只读 summary_last：字段缺失就隐藏或写“未记录”，不补示例值，也不重新核算业务。
  load() {
    try {
      const s = storage.getSync({ key: 'summary_last' })
      this.summary = s && typeof s === 'object' ? s : null
    } catch (e) { this.summary = null }
    // 同步文案必须匹配本总结自己的 sid：旧摘要没有 sid 就只能保守显示待确认。
    this.phoneExecuted = this.summary?.executionProtocol === 4
    this.sid = this.summary ? (this.summary.sid || this.summary.id || '') : ''
    this.blocks = this.buildBlocks()
    this.summaryName = summaryNameLabel(this.summary)
    this.durationLabel = summaryDurationLabel(summaryMinutesOf(this.summary))
    this.setsLabel = summarySetsLabel(this.summary)
    const volume = summaryVolumeOf(this.summary), heart = summaryHeartOf(this.summary)
    this.volumeText = volume && volume.text !== '0' ? volume.text : ''
    this.volumeUnit = volume ? volume.unit : ''
    this.heartText = heart ? heart.text : ''
    this.caloriesText = summaryCaloriesOf(this.summary) || ''
    this.updateSync()
  },

  buildBlocks() {
    const s = this.summary
    const blocks = [{ kind: 'saved', key: 'saved' },
      { kind: 'name', key: 'name', label: summaryNameLabel(s) },
      { kind: 'metric', key: 'dur', label: '时长', value: summaryDurationLabel(summaryMinutesOf(s)) },
      { kind: 'metric', key: 'sets', label: '完成组数', value: summarySetsLabel(s) }]
    // 缺失的统计整块隐藏，合法的 0 照常显示。
    const volume = summaryVolumeOf(s)
    if (volume) blocks.push({ kind: 'metric', key: 'vol', label: '训练容量', value: volume.text, unit: volume.unit })
    const heart = summaryHeartOf(s)
    if (heart) blocks.push({ kind: 'metric', key: 'hr', label: '心率', value: heart.text, cls: 'hr-value' })
    const kcal = summaryCaloriesOf(s)
    if (kcal) blocks.push({ kind: 'metric', key: 'kcal', label: '估算热量', value: kcal, unit: 'kcal' })
    // 本地没有真实 PR 数据来源：不渲染奖杯，也不自己算 PR。
    blocks.push({ kind: 'sync', key: 'sync' }, { kind: 'done', key: 'done' })
    return blocks
  },

  onShow() {
    this.bindRpc()
    this.load()
    if (!this.timer) this.timer = setInterval(() => this.tick(), 1000)
  },
  onHide() { if (this.timer) clearInterval(this.timer); this.timer = null },
  onDestroy() { this.onHide(); const owner = this.rpcModel || this; if (typeof owner.rpcDetach === 'function') owner.rpcDetach(); owner.rpcDetach = null },
  tick() {
    const d = new Date()
    const clock = String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0')
    if (this.clockLabel !== clock) this.clockLabel = clock
    this.updateSync()
  },
  updateSync() {
    // 只读关闭日志的送达状态：不调用 markDelivered，也不把 session_close_ack 当汇总确认，
    // 更不会为了“显示已上传”去清空 outbox 或关闭日志。
    if (this.phoneExecuted) { if (this.syncLabel !== '训练已在手表结束') this.syncLabel = '训练已在手表结束'; return }
    let delivered = false
    try {
      delivered = this.sid ? journalDelivery(this.sid) === 'delivered' : false
    } catch (e) { delivered = false }
    this.syncLabel = summarySyncLabel({ delivered, pending: synchronizationStatus().pending, connected: isConnected() })
  },
  bindRpc() {
    const next = msg => {
      const s = startSession({ name: msg.workout, sid: msg.sid, exercises: msg.exercises }, msg.profile)
      if (msg.t === 'sync') applySync(s, msg)
      router.replace({ uri: '/Workout' })
      return { status: 'applied', page: 'Summary', exercises: msg.exercises.length }
    }
    const rpcOwner = this.rpcModel || this
    rpcOwner.rpcDetach = startServer({ onPhoneStart: () => router.replace({ uri: '/Workout' }), onPlan: next, onSync: next, onConflict: () => router.replace({ uri: '/Index' }) })
  },

  // “完成”只返回首页：不结算、不发事件、不重复关闭。
  onBack() {
    if (Date.now() - (this.shownAt || 0) < 1000) return
    router.replace({ uri: '/Index' })
  },
}
</script>
<template><div class="page"><list class="scroll" id="summary" touch-focusable="true"><list-item type="summary" class="summary-content"><div class="saved"><div class="check"><image class="saved-icon" src="/common/icons/wear-check-ink.svg" /></div><text class="saved-text">训练已保存</text></div><text class="workoutname">{{ summaryName }}</text><text class="label">时间</text><text class="duration">{{ durationLabel }}</text><div class="stats"><div class="stat pair-stat"><text class="label">组数</text><text class="stat-value">{{ setsLabel }}</text></div><div class="stat pair-stat" if="{{ volumeText }}"><text class="label">总量</text><text class="stat-value {{ volumeText.length + volumeUnit.length > 8 ? 'stat-compact' : '' }}">{{ volumeText }} {{ volumeUnit }}</text></div></div><div class="heart" if="{{ heartText }}"><text class="label">心率</text><text class="heart-value">{{ heartText }}</text></div><div class="stat" if="{{ caloriesText }}"><text class="label">估算热量</text><text class="stat-value">{{ caloriesText }} kcal</text></div><text class="sync">{{ syncLabel }}</text><input class="done" type="button" value="完成" onclick="onBack" /></list-item></list></div></template>
<style>
/* Screens.kt SummaryScreen. Source dp/sp ×1.6; local estimated kcal is labelled honestly. */
.page { width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; }
.scroll { width: 326px; height: 370px; margin-top: 40px; margin-bottom: 40px; padding-top: 10px; padding-bottom: 16px; }
.summary-content { width: 326px; flex-direction: column; align-items: center; }
.saved { width: 326px; min-height: 38px; flex-direction: row; align-items: center; justify-content: center; }
.check { width: 29px; height: 29px; border-radius: 15px; background-color: #A3E635; justify-content: center; align-items: center; }
.saved-icon { width: 18px; height: 18px; }
.saved-text { margin-left: 10px; font-size: 24px; font-weight: bold; color: #FFFFFF; lines: 2; }
.workoutname { width: 326px; font-size: 19px; color: #8D8D93; text-align: center; lines: 2; margin-top: 6px; margin-bottom: 6px; line-height: 24px; }
.label { min-height: 25px; font-size: 19px; color: #8D8D93; text-align: center; }
.duration { width: 326px; height: 62px; font-size: 48px; font-weight: bold; color: #FFD60A; text-align: center; lines: 1; }
.stats { width: 326px; min-height: 64px; flex-direction: row; justify-content: center; margin-bottom: 6px; }
.stat { min-width: 104px; max-width: 235px; min-height: 60px; margin-left: 11px; margin-right: 11px; flex-direction: column; align-items: center; }
.stat-value { font-size: 26px; color: #FFFFFF; font-weight: bold; text-align: center; lines: 1; line-height: 38px; }
.heart { width: 326px; flex-direction: column; align-items: center; margin-top: 4px; margin-bottom: 4px; }
.heart-value { width: 326px; font-size: 21px; color: #FF453A; text-align: center; lines: 2; line-height: 26px; }
.sync { width: 326px; min-height: 38px; font-size: 19px; color: #8D8D93; text-align: center; lines: 3; margin-top: 6px; margin-bottom: 6px; line-height: 24px; }
.done { width: 314px; height: 64px; border-radius: 32px; background-color: #A3E635; color: #0C0E12; font-size: 22px; font-weight: bold; margin-top: 6px; }
.pair-stat { width: 146px; min-width: 146px; max-width: 146px; margin-left: 7px; margin-right: 7px; }
.stat-compact { font-size: 19px; }
</style>
