<script>
// 结束页：显示本次训练摘要。
import storage from '@blueos.storage.storage'
import router from '@blueos.app.appmanager.router'

export default {
  data: { minutes: '', sets: '', kcal: '', hr: '' },

  onInit() {
    try {
      const s = storage.getSync({ key: 'summary_last' })
      if (s && typeof s === 'object') {
        this.minutes = this.fmtDur(s.minutes)
        this.sets = String(s.sets || 0)
        this.kcal = String(s.calories || 0)
        this.hr = s.avgHr ? String(s.avgHr) : '--'
      }
    } catch (e) {}
  },

  fmtDur(min) {
    const m = Math.max(0, Math.round(min))
    return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0')
  },

  onBack() {
    try { storage.delete({ key: 'summary_last' }) } catch (e) {}
    router.push({ uri: '/Index' })
  },
}
</script>

<template>
  <div class="page">
    <text class="title">训练完成</text>

    <div class="grid">
      <div class="cell">
        <text class="num">{{ minutes }}</text>
        <text class="lbl">训练时长</text>
      </div>
      <div class="cell">
        <text class="num">{{ sets }}</text>
        <text class="lbl">完成组数</text>
      </div>
      <div class="cell">
        <text class="num">{{ kcal }}</text>
        <text class="lbl">千卡</text>
      </div>
      <div class="cell">
        <text class="num">{{ hr }}</text>
        <text class="lbl">平均心率</text>
      </div>
    </div>

    <input class="btn" type="button" value="完成" onclick="onBack" />
  </div>
</template>

<style>
.page { flex-direction: column; align-items: center; justify-content: center; width: 450px; height: 390px; background-color: #000000; }
.title { font-size: 30px; color: #30d158; margin-bottom: 12px; }
.grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 400px; }
.cell { flex-direction: column; align-items: center; width: 195px; margin: 7px 0; }
.num { font-size: 38px; color: #ffffff; }
.lbl { font-size: 17px; color: #8e8e93; margin-top: 1px; }
.btn { width: 240px; height: 52px; font-size: 23px; border-radius: 14px; background-color: #30d158; color: #ffffff; margin-top: 12px; }
</style>
