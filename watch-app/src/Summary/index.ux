<script>
// 结束页：训练结束后停留，显示本次的时长 / 完成组数 / 卡路里 / 心率。
// 数据由 Workout 页 onEnd 传过来（存在 session_state 前短暂窗口 → 直接用 storage 快照）。
import storage from '@blueos.storage.storage'
import router from '@blueos.app.appmanager.router'

export default {
  data: {
    minutes: '',
    sets: '',
    kcal: '',
    hr: '',
  },

  onInit() {
    // Workout.onEnd 把总结存到 summary_last，读出来展示；离开本页即清
    try {
      const s = storage.getSync({ key: 'summary_last' })
      if (s && typeof s === 'object') {
        this.minutes = this.fmtDur(s.minutes)
        this.sets = String(s.sets || 0)
        this.kcal = String(s.calories || 0)
        this.hr = s.avgHr ? String(s.avgHr) : '--'
      }
    } catch (e) { /* 没有总结可显示 */ }
  },

  fmtDur(min) {
    const m = Math.max(0, Math.round(min))
    return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0')
  },

  onBack() {
    try { storage.delete({ key: 'summary_last' }) } catch (e) { /* 无所谓 */ }
    router.push({ uri: '/Index' })
  },
}</script>

<template>
  <div class="page">
    <text class="title">训练完成</text>

    <div class="grid">
      <div class="cell">
        <text class="num">{{ minutes }}</text>
        <text class="lbl">训练时长</text>
      </div>
      <div class="cell">
        <text class="num">{{ sets }}</text>
        <text class="lbl">完成组数</text>
      </div>
      <div class="cell">
        <text class="num">{{ kcal }}</text>
        <text class="lbl">千卡</text>
      </div>
      <div class="cell">
        <text class="num">{{ hr }}</text>
        <text class="lbl">平均心率</text>
      </div>
    </div>

    <input class="btn" type="button" value="完成" onclick="onBack" />
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 466px;
  height: 466px;
  background-color: #000000;
}
.title { font-size: 34px; color: #30d158; margin-bottom: 20px; }
.grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 430px; }
.cell { flex-direction: column; align-items: center; width: 210px; margin: 10px 0; }
.num { font-size: 44px; color: #ffffff; }
.lbl { font-size: 20px; color: #8e8e93; margin-top: 2px; }
.btn { width: 300px; height: 76px; font-size: 30px; border-radius: 20px; background-color: #30d158; color: #ffffff; margin-top: 18px; }
</style>
