<script>
import { bindRuntime } from '../lib/runtime.js'
// 结束页：本次训练摘要。手机是数据源，这里只展示手表本地结算的紧凑结果。
import storage from '@blueos.storage.storage'
import router from '@blueos.app.appmanager.router'
import { startServer, pendingCount, isConnected } from '../lib/rpc.js'
import { startSession, applySync } from '../lib/session.js'

export default {
  data: { minutes: '', sets: '', kcal: '', hr: '', volume: '', syncLabel: '', weightUnit: 'kg' },

  onInit() {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    this.bindRpc()
    try {
      const s = storage.getSync({ key: 'summary_last' })
      if (s && typeof s === 'object') {
        this.minutes = this.fmtDur(s.totalMinutes != null ? s.totalMinutes : s.minutes)
        this.sets = String(s.sets || 0)
        this.kcal = String(Math.round(s.totalCalories != null ? s.totalCalories : s.calories || 0))
        this.hr = s.avgHr ? String(s.avgHr) : '--'
        this.weightUnit = s.weightUnit || 'kg'
        this.volume = s.volume ? String(Math.round(s.volume)) : ''
      }
    } catch (e) {}
  },

  onShow() {
    this.bindRpc()
    this.updateSync()
    if (!this.timer) this.timer = setInterval(() => this.updateSync(), 1000)
  },
  updateSync() { const n = pendingCount(); this.syncLabel = n ? '待上传 ' + n + ' 条' : isConnected() ? '已上传' : '离线保存' },
  onHide() { if (this.timer) clearInterval(this.timer); this.timer = null },
  onDestroy() { this.onHide() },
  bindRpc() {
    const next = msg => {
      const s = startSession({ name: msg.workout, sid: msg.sid, exercises: msg.exercises }, msg.profile)
      if (msg.t === 'sync') applySync(s, msg)
      router.replace({ uri: '/Workout' })
      return { status: 'applied', page: 'Summary', exercises: msg.exercises.length }
    }
    startServer({ onPlan: next, onSync: next })
  },

  fmtDur(min) {
    const m = Math.max(0, Math.round(min))
    return Math.floor(m / 60) + ':' + String(m % 60).padStart(2, '0')
  },

  onBack() {
    router.replace({ uri: '/Index' })
  },
}
</script>

<template>
  <div class="page">
    <text class="title">训练完成</text>

    <text class="kcal">{{ kcal }}</text>
    <text class="kcal-lbl">估算千卡</text>

    <div class="row">
      <div class="cell">
        <text class="num">{{ minutes }}</text>
        <text class="lbl">时长</text>
      </div>
      <div class="cell">
        <text class="num">{{ sets }}</text>
        <text class="lbl">组数</text>
      </div>
      <div class="cell">
        <text class="num">{{ hr }}</text>
        <text class="lbl">平均心率</text>
      </div>
    </div>
    <text class="volume" if="{{ volume }}">训练量 {{ volume }} {{ weightUnit }}</text>
    <text class="volume">{{ syncLabel }}</text>

    <input class="btn" type="button" value="完成" onclick="onBack" />
  </div>
</template>

<style>
.page { flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; background-color: #000000; }
.title { font-size: 26px; color: #63dfb1; margin-bottom: 6px; }
.kcal { font-size: 64px; color: #ffffff; margin-top: 4px; }
.kcal-lbl { font-size: 18px; color: #8b9497; margin-bottom: 8px; }
.row { flex-direction: row; justify-content: center; width: 350px; margin-top: 2px; }
.cell { flex-direction: column; align-items: center; width: 116px; }
.num { font-size: 26px; color: #ffffff; }
.lbl { font-size: 15px; color: #8b9497; margin-top: 1px; }
.volume { font-size: 16px; color: #8b9497; margin-top: 8px; }
.btn { width: 350px; height: 52px; font-size: 23px; border-radius: 12px; background-color: #63dfb1; color: #001b12; margin-top: 12px; }
@media screen and (min-width: 450px) {
  .title { font-size: 22px; margin-bottom: 4px; }
  .kcal { font-size: 52px; }
  .kcal-lbl { font-size: 15px; margin-bottom: 6px; }
  .row { width: 280px; }
  .cell { width: 93px; }
  .num { font-size: 22px; }
  .lbl { font-size: 13px; }
  .volume { font-size: 14px; margin-top: 5px; }
  .btn { width: 280px; height: 44px; font-size: 20px; margin-top: 9px; }
}
</style>
