<script>
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { loadState, startSession, applySync, replacePlan, closeSession, save } from '../lib/session.js'
import { startServer, sendEvent, pendingCount, isConnected } from '../lib/rpc.js'
import { WATCH_VERSION } from '../lib/version.js'

export default {
  data: { version: WATCH_VERSION, status: '正在连接手机', plans: [], selected: null, workoutName: '',
    exerciseCount: 0, canResume: false, conflict: null, hasSummary: false },
  onInit(params) {
    this.visible = true
    if (params && params.conflict) { try { this.conflict = JSON.parse(params.conflict) } catch (e) {} }
    this.readLocal()
    this.bindRpc()
  },
  onReady() { this.ready = true; this.enterWorkout() },
  onShow() { this.visible = true; this.readLocal(); this.bindRpc(); this.enterWorkout() },
  onHide() { this.visible = false; this.navigating = false },
  onDestroy() { this.visible = false },
  enterWorkout() {
    if (!this.ready || !this.visible || this.navigating || this.conflict) return
    const s = loadState()
    if (!s.active || !s.workout || !s.workout.exercises.length) return
    this.navigating = true
    router.replace({ uri: '/Workout' })
  },
  readLocal() {
    const s = loadState()
    this.canResume = !!s.active
    this.hasSummary = !!storage.getSync({ key: 'summary_last' })
    const catalog = storage.getSync({ key: 'plan_catalog' })
    if (catalog) this.onCatalog(catalog)
    if (s.active) {
      this.workoutName = s.workout.name; this.exerciseCount = s.workout.exercises.length
      this.status = s.pendingStart ? '离线训练 · 待同步' : '训练进行中'
    } else this.status = storage.getSync({ key: 'last_notice' }) || (this.plans.length ? '缓存计划 · 待同步' : '今日暂无计划')
  },
  bindRpc() {
    startServer({
      onCatalog: msg => { this.onCatalog(msg); if (!this.canResume) this.status = this.plans.length ? '选择训练计划' : '今日暂无计划' },
      onPlan: msg => this.onPlan(msg), onSync: msg => this.onSync(msg),
      onStartAck: msg => { if (msg.status === 'conflict') this.conflict = msg.snapshot },
      onEnded: () => { this.canResume = false; this.readLocal() },
      onState: connected => { if (!this.canResume) this.status = connected ? this.plans.length ? '选择训练计划' : '今日暂无计划' : '缓存计划 · 待同步' },
    })
  },
  onCatalog(msg) {
    this.plans = (msg.plans || []).filter(p => p.available !== false)
    if (!this.selected || !this.plans.some(p => p.id === this.selected.id)) this.selected = this.plans[0] || null
    if (!this.canResume && this.selected) { this.workoutName = this.selected.name; this.exerciseCount = this.selected.exercises.length }
  },
  onPlan(msg) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) return { status: 'rejected', reason: 'empty_exercises', page: 'Index' }
    const s = loadState()
    if (s.active && s.sid !== msg.sid) return { status: 'conflict', activeSid: s.sid, page: 'Index' }
    const retained = !!s.active
    if (retained) replacePlan(s, { name: msg.workout, exercises: msg.exercises })
    else startSession({ name: msg.workout, sid: msg.sid, exercises: msg.exercises }, msg.profile)
    this.readLocal()
    this.enterWorkout()
    return { status: retained ? 'retained' : 'applied', page: 'Index', exercises: msg.exercises.length }
  },
  onSync(msg) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) return { status: 'rejected', reason: 'empty_exercises', page: 'Index' }
    let s = loadState()
    if (s.active && s.sid !== msg.sid) return { status: 'conflict', activeSid: s.sid, page: 'Index' }
    if (!s.active) s = startSession({ name: msg.workout, sid: msg.sid, exercises: msg.exercises }, msg.profile)
    applySync(s, msg); this.canResume = true; this.readLocal()
    this.enterWorkout()
    return { status: 'applied', page: 'Index' }
  },
  choose(p) { this.selected = p; this.workoutName = p.name; this.exerciseCount = p.exercises.length },
  onStart() {
    if (loadState().active) { this.onResume(); return }
    const p = this.selected
    if (!p || !p.exercises.length) return
    const s = startSession({ name: p.name, exercises: p.exercises, rows: p.rows }, p.profile)
    s.pendingStart = true; s.planId = p.id; save(s)
    sendEvent({ t: 'watch_start', sid: s.sid, startedAt: s.startedAt, planId: p.id, plan: p })
    this.onResume()
  },
  onResume() {
    this.enterWorkout()
  },
  acceptConflict() {
    const s = loadState()
    if (s.active) {
      sendEvent({ t: 'session_close', sid: s.sid, disposition: 'abandoned', closedAt: Date.now() })
      closeSession(s.sid)
    }
    const msg = this.conflict
    this.conflict = null
    if (msg) this.onSync(msg)
    this.onResume()
  },
  keepConflict() { this.conflict = null },
  showSummary() { router.push({ uri: '/Summary' }) },
}
</script>
<template>
  <div class="page">
    <div class="content">
    <image class="logo" src="/assets/images/logo.png" />
    <text class="title">opengym</text>
    <text class="status">{{ status }}</text>
    <text class="name" if="{{ canResume }}">{{ workoutName }}</text>
    <list class="plans" if="{{ !canResume && plans.length }}">
      <list-item class="plan" type="plan" for="{{ p in plans }}" tid="id" onclick="choose(p)">
        <text class="plan-name {{ selected && selected.id === p.id ? 'selected' : '' }}">{{ p.today ? '今日 · ' : '' }}{{ p.name }}</text>
        <text class="count">{{ p.exercises.length }} 个动作</text>
      </list-item>
    </list>
    <text class="empty" if="{{ !canResume && !plans.length }}">暂无可用训练计划</text>
    <input class="btn" type="button" value="继续当前训练" onclick="onResume" if="{{ canResume }}" />
    <input class="btn" type="button" value="开始训练" onclick="onStart" if="{{ !canResume && selected }}" />
    <div class="links"><input class="link" type="button" value="最近结果" onclick="showSummary" if="{{ hasSummary }}" /></div>
    </div>
    <div class="overlay" if="{{ conflict }}">
      <text class="name">手机已有活动训练</text>
      <text class="status">继续手机训练将丢弃本地未保存训练</text>
      <input class="btn" type="button" value="继续手机训练" onclick="acceptConflict" />
      <input class="link" type="button" value="返回" onclick="keepConflict" />
    </div>
  </div>
</template>
<style>
.page { width: 100%; height: 100%; flex-direction: column; align-items: center; background-color: #000000; }
.content { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; justify-content: flex-start; }
.logo { width: 54px; height: 54px; margin-bottom: 3px; }
.title { width: 350px; height: 38px; font-size: 30px; color: #ffffff; text-align: center; }
.status { width: 350px; height: 34px; font-size: 17px; color: #aeb9bd; text-align: center; lines: 2; }
.name { width: 350px; height: 46px; font-size: 24px; color: #ffffff; text-align: center; lines: 2; }
.plans { width: 350px; height: 170px; }
.plan { width: 350px; height: 76px; flex-direction: column; padding: 7px 8px; }
.plan-name { width: 334px; height: 34px; font-size: 23px; color: #ffffff; lines: 1; }
.selected { color: #63dfb1; }
.count { font-size: 16px; color: #aeb9bd; }
.empty { width: 350px; height: 52px; font-size: 19px; color: #8e8e93; text-align: center; }
.btn { width: 350px; height: 54px; font-size: 23px; border-radius: 8px; margin-top: 10px; background-color: #63dfb1; color: #001b12; }
.links { width: 350px; height: 40px; justify-content: center; margin-top: 7px; }
.link { width: 170px; height: 40px; font-size: 19px; background-color: transparent; color: #aeb9bd; }
.overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; background-color: #000000; }
</style>
