<script>
// 开始页：手表是手机训练的辅助端，不独立开始训练。
// 手机开始训练后推送 plan；手表打开时如果已有活跃会话，直接接着显示。
import router from '@blueos.app.appmanager.router'
import { loadState, startSession, applySync } from '../lib/session.js'
import { startServer } from '../lib/rpc.js'
import { WATCH_VERSION } from '../lib/version.js'
import storage from '@blueos.storage.storage'

export default {
  data: {
    version: WATCH_VERSION,
    status: '正在连接手机…',
    workoutName: '',
    exerciseCount: 0,
    canStart: false,
    canResume: false,
    linkLabel: '',
    plan: null,
    resumeSid: '',
  },

  onInit() {
    const s = loadState()
    if (s.active && s.workout) {
      this.canResume = true
      this.resumeSid = s.sid || ''
      this.workoutName = s.workout.name || '上次的训练'
      this.exerciseCount = s.workout.exercises.length
      this.status = '手机训练进行中'
    } else {
      this.status = '请在手机上开始训练'
    }

    this.bindRpc()
  },

  onShow() {
    const s = loadState()
    const closed = storage.getSync({ key: 'closed_sessions' }) || []
    if (!s.active && (closed.indexOf(this.resumeSid) >= 0 || this.plan && closed.indexOf(this.plan.sid) >= 0)) {
      this.canResume = false; this.canStart = false; this.resumeSid = ''; this.plan = null
      this.workoutName = ''; this.exerciseCount = 0; this.status = '请在手机上开始训练'
    }
    this.bindRpc()
  },

  bindRpc() {
    startServer({
      onPlan: (msg) => this.onPlanMsg(msg),
      onSync: (msg) => this.onSyncMsg(msg),
      onEnded: () => {
        this.plan = null; this.canStart = false; this.canResume = false
        this.resumeSid = ''; this.exerciseCount = 0; this.workoutName = ''
        router.replace({ uri: '/Summary' })
      },
      onState: (connected) => {
        this.linkLabel = connected ? '已连接手机' : ''
        if (!this.canResume && !this.plan && !connected) this.status = '请在手机上开始训练'
      },
      onError: () => {
        this.linkLabel = ''
        this.status = '连接失败，请检查运动健康'
      },
    })
  },

  onPlanMsg(msg) {
    if (this.canResume && (!msg.sid || msg.sid === this.resumeSid)) {
      return { status: 'retained', page: 'Index', exercises: this.exerciseCount }
    }
    return this.applyPlan(msg.workout, msg.exercises || [], msg.sid || '', msg.profile || null)
  },

  onSyncMsg(msg) {
    this.snapshot = msg
    // 手机重连后推来的权威快照：如果本地没有活跃会话，按快照进入训练。
    if (this.canResume && (!msg.sid || msg.sid === this.resumeSid)) {
      applySync(loadState(), msg)
      return { status: 'retained', page: 'Index', exercises: this.exerciseCount }
    }
    return this.applyPlan(msg.workout || msg.name, msg.exercises || [], msg.sid || '', msg.profile || null)
  },

  applyPlan(name, exercises, sid, profile) {
    if (!Array.isArray(exercises) || !exercises.length) {
      return { status: 'rejected', page: 'Index', reason: 'empty_exercises', exercises: 0 }
    }
    this.canResume = false
    this.plan = { sid, name, exercises, profile }
    this.workoutName = name
    this.exerciseCount = exercises.length
    this.status = '手机训练中\n今天：' + name
    this.canStart = true
    return { status: 'applied', page: 'Index', exercises: exercises.length }
  },

  onStart() {
    const p = this.plan
    if (!p) return
    const s = startSession({ name: p.name, sid: p.sid, exercises: p.exercises }, p.profile)
    if (this.snapshot && this.snapshot.sid === p.sid) applySync(s, this.snapshot)
    router.push({ uri: '/Workout' })
  },

  onResume() { router.push({ uri: '/Workout' }) },
}
</script>

<template>
  <div class="page">
    <image class="logo" src="/assets/images/logo.png" />
    <text class="title">训练助手</text>
    <text class="version">v{{ version }}</text>
    <text class="status">{{ status }}</text>
    <text class="sub" if="{{ exerciseCount }}">{{ exerciseCount }} 个动作</text>
    <text class="link" if="{{ linkLabel }}">{{ linkLabel }}</text>

    <input class="btn primary" type="button" value="继续训练" onclick="onResume" if="{{ canResume }}" />
    <input class="btn primary" type="button" value="进入辅助" onclick="onStart" if="{{ canStart }}" />
  </div>
</template>

<style>
.page { flex-direction: column; justify-content: center; align-items: center; width: 390px; height: 450px; background-color: #000000; padding: 16px; }
.logo { width: 54px; height: 54px; margin-bottom: 10px; }
.title { font-size: 28px; color: #ffffff; margin-bottom: 6px; }
.version { font-size: 15px; color: #aeb9bd; margin-bottom: 22px; }
.status { font-size: 22px; color: #f5f5f7; text-align: center; max-width: 350px; lines: 2; margin-bottom: 5px; }
.sub { font-size: 18px; color: #9aa0a6; margin-bottom: 10px; }
.link { font-size: 17px; color: #4ade80; margin-bottom: 5px; }
.btn { width: 310px; height: 56px; font-size: 22px; border-radius: 8px; margin-top: 16px; }
.primary { background-color: #63dfb1; color: #001b12; }
</style>
