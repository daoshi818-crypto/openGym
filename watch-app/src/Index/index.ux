<script>
import { bindRuntime } from '../lib/runtime.js'
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { commitLocalClose, commitSessionStart, loadState, startSession, applySync, replacePlan, closeSession, save } from '../lib/session.js'
import { startServer, sendEvent, pendingCount, isConnected } from '../lib/rpc.js'
import { WATCH_VERSION } from '../lib/version.js'

export default {
  data: { version: WATCH_VERSION, status: '正在连接手机', plans: [], selected: null, workoutName: '',
    exerciseCount: 0, canResume: false, conflict: null, hasSummary: false,
    // 文案由数据决定：有今日计划就是“开始训练”，只有缓存计划就是“快速开始”；
    // 本地没有缓存、手机也没下发过时提示去同步，而不是假装“今日没有计划”。
    todayLabel: '今日训练', startLabel: '快速开始', needSync: false },
  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    this.visible = true
    if (params && params.conflict) { try { this.conflict = JSON.parse(params.conflict) } catch (e) {} }
    this.readLocal()
    this.bindRpc()
  },
  onReady() { this.ready = true; this.enterWorkout() },
  onShow() { this.visible = true; this.readLocal(); this.bindRpc(); this.enterWorkout() },
  onHide() { this.visible = false; this.navigating = false },
  onDestroy() { this.visible = false },
  enterWorkout() {
    if (!this.ready || !this.visible || this.navigating || this.conflict) return
    const s = loadState()
    if (!s.active || !s.workout || !s.workout.exercises.length) return
    this.navigating = true
    router.replace({ uri: '/Workout' })
  },
  readLocal() {
    const s = loadState()
    this.canResume = !!s.active
    this.hasSummary = !!storage.getSync({ key: 'summary_last' })
    const catalog = storage.getSync({ key: 'plan_catalog' })
    if (catalog) this.onCatalog(catalog)
    if (s.active) {
      this.workoutName = s.workout.name; this.exerciseCount = s.workout.exercises.length
      this.status = s.pendingStart ? '离线训练 · 待同步' : '训练进行中'
    } else {
      const notice = storage.getSync({ key: 'last_notice' })
      this.status = notice === '存在同步冲突，离线操作及其依赖已保留，请核对手机训练记录'
        ? '两端状态以手机为准' : notice || (this.plans.length ? '缓存计划 · 待同步' : '今日暂无计划')
    }
    // 本地没有计划缓存、手机也没下发过计划：说明还没同步过，不是“今天没有计划”。
    this.needSync = !catalog && !this.plans.length && !s.active
  },
  bindRpc() {
    startServer({
      onCatalog: msg => { this.onCatalog(msg); if (!this.canResume) this.status = this.plans.length ? '选择训练计划' : '今日暂无计划' },
      onPlan: msg => this.onPlan(msg), onSync: (msg, options) => this.onSync(msg, options),
      onStartAck: msg => { if (msg.status === 'conflict') this.conflict = msg.snapshot },
      onEnded: () => { this.canResume = false; this.readLocal() },
      onState: connected => { if (!this.canResume) this.status = connected ? this.plans.length ? '选择训练计划' : '今日暂无计划' : '缓存计划 · 待同步' },
    })
  },
  onCatalog(msg) {
    this.plans = (msg.plans || []).filter(p => p.available !== false).map(p => ({
      ...p,
      // 计划行第二行：最多三个动作名，超出用“等 N 个动作”收尾（方形/圆形都不裁切）。
      preview: (p.exercises || []).slice(0, 3).map(e => (e && e.name) || '').filter(Boolean).join('、')
        + ((p.exercises || []).length > 3 ? ' 等 ' + p.exercises.length + ' 个动作' : ''),
    }))
    if (!this.selected || !this.plans.some(p => p.id === this.selected.id)) this.selected = this.plans[0] || null
    this.startLabel = this.plans.some(p => p.today) ? '开始训练' : '快速开始'
    // 手机刚下发计划：立即不再提示“请先同步”，否则要等到下一次 onShow 才更新。
    this.needSync = !this.plans.length && !this.canResume
    if (!this.canResume && this.selected) { this.workoutName = this.selected.name; this.exerciseCount = this.selected.exercises.length }
  },
  onPlan(msg) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) return { status: 'rejected', reason: 'empty_exercises', page: 'Index' }
    const s = loadState()
    if (s.active && s.sid !== msg.sid) return { status: 'conflict', activeSid: s.sid, page: 'Index' }
    const retained = !!s.active
    if (retained) replacePlan(s, { name: msg.workout, exercises: msg.exercises })
    else startSession({ ...msg, name: msg.workout, exercises: msg.exercises }, msg.profile)
    this.readLocal()
    this.enterWorkout()
    return { status: retained ? 'retained' : 'applied', page: 'Index', exercises: msg.exercises.length }
  },
  onSync(msg, options) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) return { status: 'rejected', reason: 'empty_exercises', page: 'Index' }
    let s = loadState()
    if (s.active && s.sid !== msg.sid) return { status: 'conflict', activeSid: s.sid, page: 'Index' }
    if (options && options.persisted && !s.active) return { status: 'retained', page: 'Index' }
    if (!s.active) s = startSession({ name: msg.workout, sid: msg.sid, exercises: msg.exercises }, msg.profile)
    if (!(options && options.persisted)) applySync(s, msg)
    this.canResume = true; this.readLocal()
    this.enterWorkout()
    return { status: 'applied', page: 'Index' }
  },
  choose(p) { this.selected = p; this.workoutName = p.name; this.exerciseCount = p.exercises.length },
  async onStart() {
    if (this.startSaving) return
    if (loadState().active) { this.onResume(); return }
    const p = this.selected
    if (!p || !p.exercises.length) return
    this.startSaving = true
    try {
      const result = await commitSessionStart(p, p.profile)
      if (!result.ok) { this.startLabel = '存储失败，请重试'; return }
      for (const event of result.value.pendingEdits || []) sendEvent(event)
      this.onResume()
    } catch (_) { this.startLabel = '存储失败，请重试' }
    finally { this.startSaving = false }
  },
  onResume() {
    this.enterWorkout()
  },
  async acceptConflict() {
    const s = loadState()
    if (s.active) {
      const result = await commitLocalClose(s.sid, 'abandoned')
      if (!result.ok) { this.status = '存储失败，未结束，请重试'; return }
      for (const event of [...(result.entry.pendingEvents || []), result.entry.closeEvent]) sendEvent(event)
    }
    const msg = this.conflict
    this.conflict = null
    if (msg) this.onSync(msg)
    this.onResume()
  },
  keepConflict() { this.conflict = null },
  showSummary() { router.push({ uri: '/Summary' }) },
}
</script>
<template>
<div class="page">
  <div class="content" if="{{ !conflict }}">
    <div class="topbar"><text class="brand">opengym</text><text class="version">v{{ version }}</text></div>
    <list class="home-scroll"><list-item type="intro" class="home-section">
    <text class="status">{{ status }}</text>
    <div class="hero" if="{{ canResume }}"><text class="card-name">{{ workoutName }}</text><text class="card-meta">{{ exerciseCount }} 个动作 · 训练进行中</text><div class="start-circle" onclick="onResume"><image class="start-icon" src="/common/icons/play.svg" /></div><text class="start-label" onclick="onResume">继续当前训练</text></div>
    <div class="hero" if="{{ !canResume && selected }}"><text class="card-name">{{ selected.name }}</text><text class="card-meta">{{ exerciseCount }} 个动作</text><div class="start-circle" onclick="onStart"><image class="start-icon" src="/common/icons/play.svg" /></div><text class="start-label" onclick="onStart">{{ startLabel }}</text></div>
    </list-item><list-item class="plan {{ selected && selected.id === p.id ? 'selected' : '' }}" type="plan" for="{{ p in (canResume ? [] : plans) }}" tid="id" onclick="choose(p)"><text class="plan-name">{{ p.name }} ›</text><text class="plan-preview">{{ p.preview }}</text></list-item><list-item type="home-links" class="home-section">
    <div class="empty-state" if="{{ !canResume && !plans.length }}"><text class="empty-icon">＋</text><text class="empty-title">{{ needSync ? '尚未同步' : '暂无可用计划' }}</text><text class="empty">{{ needSync ? '请先打开手机应用同步计划' : '在手机上创建训练计划后同步至手表' }}</text></div>
    <div class="links" if="{{ hasSummary }}"><input class="link" type="button" value="最近训练结果 ›" onclick="showSummary" if="{{ hasSummary }}" /></div>
    </list-item></list>
  </div>
  <div class="overlay" if="{{ conflict }}"><list class="modal-scroll"><list-item type="conflict" class="modal-content"><text class="overlay-title">手机已有活动训练</text><text class="overlay-text">继续手机训练将丢弃本地未保存训练</text><input class="btn" type="button" value="继续手机训练" onclick="acceptConflict" /><input class="link" type="button" value="返回" onclick="keepConflict" /></list-item></list></div>
</div>
</template>

<style>
/* Full viewport; Apple-style routine hero, circular start, scrollable alternate plans. */
.page { width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; }
.content { width: 100%; height: 100%; flex-direction: column; align-items: center; }
.topbar { width: 314px; height: 44px; margin-top: 18px; flex-direction: row; justify-content: space-between; align-items: center; }
.brand { font-size: 26px; color: #FFFFFF; }
.version { font-size: 18px; color: #929297; }
.status { width: 338px; height: 40px; font-size: 20px; color: #FF9F0A; lines: 2; }
.hero { width: 338px; height: 244px; flex-direction: column; align-items: center; }
.card-name { width: 338px; height: 64px; line-height: 32px; font-size: 28px; font-weight: bold; color: #FFFFFF; text-align: center; lines: 2; }
.card-meta { width: 338px; height: 32px; font-size: 21px; color: #929297; text-align: center; lines: 1; }
.start-circle { width: 96px; height: 96px; border-radius: 48px; background-color: #30D158; align-items: center; justify-content: center; }
.start-icon { width: 42px; height: 42px; }
.start-label { width: 338px; height: 52px; line-height: 52px; font-size: 25px; font-weight: bold; color: #30D158; text-align: center; }
.plan { width: 338px; min-height: 128px; padding: 12px; margin-bottom: 12px; border-radius: 22px; background-color: #1C1C1E; flex-direction: column; }
.selected { background-color: #242725; }
.plan-name { width: 314px; height: 64px; line-height: 32px; font-size: 26px; color: #FFFFFF; lines: 2; }
.plan-preview { width: 314px; height: 56px; line-height: 28px; font-size: 20px; color: #929297; lines: 2; }
.empty-state { width: 338px; flex-direction: column; justify-content: center; align-items: center; min-height: 244px; }
.empty-icon { width: 100px; height: 94px; font-size: 80px; color: #30D158; text-align: center; }
.empty-title { width: 338px; height: 48px; font-size: 27px; color: #FFFFFF; text-align: center; }
.empty { width: 310px; min-height: 72px; font-size: 24px; color: #929297; text-align: center; lines: 3; }
.links { width: 338px; height: 64px; margin-bottom: 0px; justify-content: center; }
.link { width: 338px; height: 60px; background-color: #000000; color: #30D158; font-size: 24px; }
.overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; justify-content: flex-start; }
.overlay-title { width: 338px; height: 60px; font-size: 27px; color: #FFFFFF; text-align: center; lines: 2; }
.overlay-text { width: 338px; height: 86px; font-size: 21px; color: #929297; text-align: center; lines: 3; }
.btn { width: 338px; height: 64px; border-radius: 30px; background-color: #0A3418; color: #30D158; font-size: 25px; }

.home-scroll { width: 338px; flex: 1; min-height: 0px; margin-bottom: 24px; }
.home-section { width: 338px; flex-direction: column; align-items: center; }
.modal-scroll { width: 338px; flex: 1; min-height: 0px; margin-top: 48px; margin-bottom: 32px; }
.modal-content { width: 338px; flex-direction: column; align-items: center; }

@media screen and (min-width: 450px) {

 .topbar { width: 220px; margin-top: 30px; }
 .home-scroll { width: 300px; margin-bottom: 58px; }
 .home-section, .status, .hero, .card-name, .card-meta, .start-label, .plan, .links, .link, .empty-state, .empty-title, .overlay-title, .overlay-text, .btn { width: 300px; }
 .plan-name, .plan-preview { width: 276px; }
 .empty { width: 280px; }
 .modal-scroll { width: 300px; margin-top: 58px; margin-bottom: 58px; }
 .modal-content { width: 300px; }

}
</style>
