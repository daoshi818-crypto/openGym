<script>
// 开始页：先等待手机通过 BLE 配对并推送今天的训练计划。
import router from '@blueos.app.appmanager.router'
import { loadState, startSession } from '../lib/session.js'
import { flushPending } from '../lib/cloud.js'
import { startServer } from '../lib/ble.js'

export default {
  data: {
    status: '正在启动…',
    workoutName: '',
    exerciseCount: 0,
    canStart: false,
    canResume: false,
    bleLabel: '',
    plan: null,
  },

  onInit() {
    const s = loadState()
    if (s.active && s.workout) {
      this.canResume = true
      this.workoutName = s.workout.name || '上次的训练'
      this.exerciseCount = s.workout.exercises.length
      this.status = '上次训练还没结束'
    } else this.status = '请打开手机应用进行匹配'

    startServer({
      onPlan: (msg) => this.onPlanMsg(msg),
      onRest: () => {},
      onState: (connected) => {
        this.bleLabel = connected ? '已匹配' : ''
        if (!this.canResume && !this.plan) {
          this.status = connected ? '已匹配，等待手机发送训练计划' : '请打开手机应用进行匹配'
        }
      },
    })

    flushPending().catch(() => {})
  },

  onPlanMsg(msg) {
    if (this.canResume) return
    this.applyPlan(msg.workout, msg.exercises || [], msg.sid || '', msg.profile || null)
  },

  applyPlan(name, exercises, sid, profile) {
    if (!exercises.length) return
    this.plan = { sid, name, exercises, profile }
    this.workoutName = name
    this.exerciseCount = exercises.length
    this.status = '已匹配\n今天：' + name
    this.canStart = true
  },

  onStart() {
    const p = this.plan
    if (!p) return
    startSession({ name: p.name, sid: p.sid, exercises: p.exercises }, p.profile)
    router.push({ uri: '/Workout' })
  },

  onResume() { router.push({ uri: '/Workout' }) },
}
</script>

<template>
  <div class="page">
    <text class="title">训练助手</text>
    <text class="status">{{ status }}</text>
    <text class="sub" if="{{ exerciseCount }}">{{ exerciseCount }} 个动作</text>
    <text class="ble" if="{{ bleLabel }}">{{ bleLabel }}</text>

    <input class="btn primary" type="button" value="继续训练" onclick="onResume" if="{{ canResume }}" />
    <input class="btn primary" type="button" value="开始训练" onclick="onStart" if="{{ canStart }}" />
  </div>
</template>

<style>
.page { flex-direction: column; justify-content: center; align-items: center; width: 390px; height: 450px; background-color: #0c0e12; padding: 16px; }
.title { font-size: 30px; color: #a3e635; margin-bottom: 8px; }
.status { font-size: 22px; color: #f5f5f7; text-align: center; max-width: 350px; lines: 2; margin-bottom: 5px; }
.sub { font-size: 18px; color: #9aa0a6; margin-bottom: 10px; }
.ble { font-size: 17px; color: #4ade80; margin-bottom: 5px; }
.btn { width: 220px; height: 54px; font-size: 22px; border-radius: 14px; margin-top: 8px; }
.primary { background-color: #a3e635; color: #0c0e12; }
</style>
