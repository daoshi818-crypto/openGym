<script>
import { bindRuntime } from '../lib/runtime.js'
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { loadState, startSession, applySync, replacePlan, closeSession, save } from '../lib/session.js'
import { startServer, sendEvent, pendingCount, isConnected } from '../lib/rpc.js'
import { WATCH_VERSION } from '../lib/version.js'

export default {
  data: { version: WATCH_VERSION, status: '正在连接手机', plans: [], selected: null, workoutName: '',
    exerciseCount: 0, canResume: false, conflict: null, hasSummary: false,
    // 文案由数据决定：有今日计划就是“开始训练”，只有缓存计划就是“快速开始”；
    // 本地没有缓存、手机也没下发过时提示去同步，而不是假装“今日没有计划”。
    todayLabel: '今日训练', startLabel: '快速开始', needSync: false },
  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    this.visible = true
    if (params && params.conflict) { try { this.conflict = JSON.parse(params.conflict) } catch (e) {} }
    this.readLocal()
    this.bindRpc()
  },
  onReady() { this.ready = true; this.enterWorkout() },
  onShow() { this.visible = true; this.readLocal(); this.bindRpc(); this.enterWorkout() },
  onHide() { this.visible = false; this.navigating = false },
  onDestroy() { this.visible = false },
  enterWorkout() {
    if (!this.ready || !this.visible || this.navigating || this.conflict) return
    const s = loadState()
    if (!s.active || !s.workout || !s.workout.exercises.length) return
    this.navigating = true
    router.replace({ uri: '/Workout' })
  },
  readLocal() {
    const s = loadState()
    this.canResume = !!s.active
    this.hasSummary = !!storage.getSync({ key: 'summary_last' })
    const catalog = storage.getSync({ key: 'plan_catalog' })
    if (catalog) this.onCatalog(catalog)
    if (s.active) {
      this.workoutName = s.workout.name; this.exerciseCount = s.workout.exercises.length
      this.status = s.pendingStart ? '离线训练 · 待同步' : '训练进行中'
    } else this.status = storage.getSync({ key: 'last_notice' }) || (this.plans.length ? '缓存计划 · 待同步' : '今日暂无计划')
    // 本地没有计划缓存、手机也没下发过计划：说明还没同步过，不是“今天没有计划”。
    this.needSync = !catalog && !this.plans.length && !s.active
  },
  bindRpc() {
    startServer({
      onCatalog: msg => { this.onCatalog(msg); if (!this.canResume) this.status = this.plans.length ? '选择训练计划' : '今日暂无计划' },
      onPlan: msg => this.onPlan(msg), onSync: msg => this.onSync(msg),
      onStartAck: msg => { if (msg.status === 'conflict') this.conflict = msg.snapshot },
      onEnded: () => { this.canResume = false; this.readLocal() },
      onState: connected => { if (!this.canResume) this.status = connected ? this.plans.length ? '选择训练计划' : '今日暂无计划' : '缓存计划 · 待同步' },
    })
  },
  onCatalog(msg) {
    this.plans = (msg.plans || []).filter(p => p.available !== false).map(p => ({
      ...p,
      // 计划行第二行：最多三个动作名，超出用“等 N 个动作”收尾（方形/圆形都不裁切）。
      preview: (p.exercises || []).slice(0, 3).map(e => (e && e.name) || '').filter(Boolean).join('、')
        + ((p.exercises || []).length > 3 ? ' 等 ' + p.exercises.length + ' 个动作' : ''),
    }))
    if (!this.selected || !this.plans.some(p => p.id === this.selected.id)) this.selected = this.plans[0] || null
    this.startLabel = this.plans.some(p => p.today) ? '开始训练' : '快速开始'
    // 手机刚下发计划：立即不再提示“请先同步”，否则要等到下一次 onShow 才更新。
    this.needSync = !this.plans.length && !this.canResume
    if (!this.canResume && this.selected) { this.workoutName = this.selected.name; this.exerciseCount = this.selected.exercises.length }
  },
  onPlan(msg) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) return { status: 'rejected', reason: 'empty_exercises', page: 'Index' }
    const s = loadState()
    if (s.active && s.sid !== msg.sid) return { status: 'conflict', activeSid: s.sid, page: 'Index' }
    const retained = !!s.active
    if (retained) replacePlan(s, { name: msg.workout, exercises: msg.exercises })
    else startSession({ ...msg, name: msg.workout, exercises: msg.exercises }, msg.profile)
    this.readLocal()
    this.enterWorkout()
    return { status: retained ? 'retained' : 'applied', page: 'Index', exercises: msg.exercises.length }
  },
  onSync(msg) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) return { status: 'rejected', reason: 'empty_exercises', page: 'Index' }
    let s = loadState()
    if (s.active && s.sid !== msg.sid) return { status: 'conflict', activeSid: s.sid, page: 'Index' }
    if (!s.active) s = startSession({ name: msg.workout, sid: msg.sid, exercises: msg.exercises }, msg.profile)
    applySync(s, msg); this.canResume = true; this.readLocal()
    this.enterWorkout()
    return { status: 'applied', page: 'Index' }
  },
  choose(p) { this.selected = p; this.workoutName = p.name; this.exerciseCount = p.exercises.length },
  onStart() {
    if (loadState().active) { this.onResume(); return }
    const p = this.selected
    if (!p || !p.exercises.length) return
    const s = startSession({ ...p, name: p.name, exercises: p.exercises, rows: p.rows }, p.profile)
    s.pendingStart = true; s.planId = p.id; save(s)
    sendEvent({ t: 'watch_start', sid: s.sid, startedAt: s.startedAt, planId: p.id, plan: p })
    this.onResume()
  },
  onResume() {
    this.enterWorkout()
  },
  acceptConflict() {
    const s = loadState()
    if (s.active) {
      sendEvent({ t: 'session_close', sid: s.sid, disposition: 'abandoned', closedAt: Date.now() })
      closeSession(s.sid)
    }
    const msg = this.conflict
    this.conflict = null
    if (msg) this.onSync(msg)
    this.onResume()
  },
  keepConflict() { this.conflict = null },
  showSummary() { router.push({ uri: '/Summary' }) },
}
</script>
<template>
<div class="page">
  <div class="content">
    <div class="brand">
      <image class="logo" src="/assets/images/logo.png" />
      <text class="title">opengym</text>
    </div>
    <text class="status">{{ status }}</text>

    <div class="card resume" if="{{ canResume }}">
      <text class="card-lbl">进行中的训练</text>
      <text class="card-name">{{ workoutName }}</text>
      <text class="card-meta">{{ exerciseCount }} 个动作</text>
      <input class="btn" type="button" value="继续当前训练" onclick="onResume" />
    </div>

    <div class="card today" if="{{ !canResume && selected }}">
      <text class="card-lbl">{{ todayLabel }}</text>
      <text class="card-name">{{ selected.name }}</text>
      <text class="card-meta">{{ exerciseCount }} 个动作</text>
      <input class="btn" type="button" value="{{ startLabel }}" onclick="onStart" />
    </div>

    <list class="plans" if="{{ !canResume && plans.length }}">
      <list-item class="plan {{ selected && selected.id === p.id ? 'selected' : '' }}" type="plan" for="{{ p in plans }}" tid="id" onclick="choose(p)">
        <text class="plan-name">{{ p.name }}</text>
        <text class="plan-preview">{{ p.preview }}</text>
      </list-item>
    </list>

    <text class="empty" if="{{ !canResume && !plans.length }}">{{ needSync ? '请先打开手机应用同步计划' : '暂无可用训练计划' }}</text>

    <div class="links"><input class="link" type="button" value="最近结果" onclick="showSummary" if="{{ hasSummary }}" /></div>
  </div>
  <div class="overlay" if="{{ conflict }}">
    <text class="overlay-title">手机已有活动训练</text>
    <text class="overlay-text">继续手机训练将丢弃本地未保存训练</text>
    <input class="btn" type="button" value="继续手机训练" onclick="acceptConflict" />
    <input class="link" type="button" value="返回" onclick="keepConflict" />
  </div>
</div>
</template>
<style>
/* v1.4.4 Wear OS 视觉令牌（BlueOS 不支持全局 CSS 变量，逐页同值声明）
   background #000000 · primary #30D158 · primaryText #000000 · tile #1C1C1E · tileHigh #2C2C2E
   text #FFFFFF · muted #A1A1A6 · warm #FF9F0A · danger #FF453A · effort #E0C775
   触控目标 ≥48：主按钮 48，行内次要按钮 48。 */
.page { width: 100%; height: 100%; flex-direction: column; align-items: center; background-color: #000000; }
.content { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; }
.brand { width: 350px; height: 34px; flex-direction: row; align-items: center; justify-content: center; }
.logo { width: 26px; height: 26px; margin-right: 8px; }
.title { font-size: 22px; color: #A1A1A6; }
.status { width: 350px; height: 28px; font-size: 15px; color: #A1A1A6; text-align: center; lines: 2; }
.card { width: 350px; flex-direction: column; align-items: center; border-radius: 16px; background-color: #1C1C1E; padding: 10px 12px 12px; margin-top: 8px; }
.resume { height: 150px; border: 1px solid #30D158; }
.today { height: 150px; }
.card-lbl { width: 326px; height: 20px; font-size: 14px; color: #30D158; text-align: center; lines: 1; }
.card-name { width: 326px; height: 44px; font-size: 24px; color: #FFFFFF; text-align: center; lines: 2; }
.card-meta { width: 326px; height: 18px; font-size: 14px; color: #A1A1A6; text-align: center; lines: 1; }
.plans { width: 350px; height: 150px; margin-top: 6px; }
.plan { width: 350px; height: 70px; flex-direction: column; justify-content: center; padding: 6px 12px; margin-bottom: 6px; border-radius: 14px; background-color: #1C1C1E; }
.plan.selected { background-color: #2C2C2E; border: 1px solid #30D158; }
.plan-name { width: 326px; height: 26px; font-size: 20px; color: #FFFFFF; lines: 1; }
.plan-preview { width: 326px; height: 20px; font-size: 13px; color: #A1A1A6; lines: 1; }
.empty { width: 350px; height: 60px; font-size: 16px; color: #A1A1A6; text-align: center; lines: 2; margin-top: 10px; }
.btn { width: 326px; height: 48px; font-size: 20px; border-radius: 12px; margin-top: 8px; background-color: #30D158; color: #000000; }
.links { width: 350px; height: 48px; flex-direction: row; align-items: center; justify-content: center; margin-top: 4px; }
.link { width: 170px; height: 48px; font-size: 16px; background-color: transparent; color: #A1A1A6; }
.overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; background-color: #000000; }
.overlay-title { width: 350px; height: 40px; font-size: 24px; color: #FFFFFF; text-align: center; lines: 2; }
.overlay-text { width: 350px; height: 52px; font-size: 15px; color: #A1A1A6; text-align: center; lines: 3; margin-bottom: 10px; }
@media screen and (min-width: 450px) {
  .content { width: 280px; height: 300px; margin-top: 70px; }
  .brand { width: 280px; height: 30px; }
  .logo { width: 22px; height: 22px; margin-right: 6px; }
  .title { font-size: 19px; }
  .status { width: 280px; height: 24px; font-size: 13px; }
  .card { width: 280px; padding: 8px 8px 10px; border-radius: 14px; margin-top: 6px; }
  .resume, .today { height: 124px; }
  .card-lbl { width: 264px; height: 18px; font-size: 13px; }
  .card-name { width: 264px; height: 38px; font-size: 20px; }
  .card-meta { width: 264px; height: 16px; font-size: 12px; }
  .btn { width: 264px; height: 44px; font-size: 17px; margin-top: 6px; }
  .plans { width: 280px; height: 104px; margin-top: 4px; }
  .plan { width: 280px; height: 56px; padding: 4px 8px; margin-bottom: 4px; }
  .plan-name { width: 264px; height: 22px; font-size: 17px; }
  .plan-preview { width: 264px; height: 16px; font-size: 12px; }
  .empty { width: 280px; height: 48px; font-size: 14px; margin-top: 6px; }
  .links { width: 280px; height: 40px; margin-top: 2px; }
  .link { width: 150px; height: 40px; font-size: 14px; }
  .overlay-title { width: 280px; height: 34px; font-size: 19px; }
  .overlay-text { width: 280px; height: 44px; font-size: 13px; }
}
</style>
