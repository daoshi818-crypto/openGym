{
  "package": "com.zcode.gymtimer",
  "name": "训练助手",
  "icon": "/assets/images/logo.png",
  "versionName": "0.5.2",
  "versionCode": 14,
  "appCategory": ["health"],
  "deviceTypeList": ["watch"],
  "config": {
    "designWidth": 390
  },
  "display": {
    "backgroundColor": "#000000"
  },
  "features": [
    { "name": "blueos.storage.storage" },
    { "name": "blueos.network.fetch" },
    { "name": "blueos.hardware.vibrator.vibrator" },
    { "name": "blueos.hardware.display.brightness" },
    { "name": "blueos.health.health" },
    { "name": "blueos.bluexlink.connectionManager" }
  ],
  "permissions": [
    { "name": "watch.permission.READ_HEALTH_DATA" }
  ],
  "router": {
    "entry": "Index",
    "pages": {
      "Index": { "component": "index" },
      "Workout": { "component": "index", "followHand": "disable" },
      "Keypad": { "component": "index" },
      "ExerciseList": { "component": "index" },
      "Summary": { "component": "index" }
    }
  }
}
