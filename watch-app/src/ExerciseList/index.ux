<script>
import { bindRuntime, runtime } from '../lib/runtime.js'
// 动作列表页：查看动作和组，点组返回训练页并切换游标。
import router from '@blueos.app.appmanager.router'
import { loadState, save, commitSessionAction, stageSessionEvent, endSession, closeSession, commitLocalClose } from '../lib/session.js'
import { sendEvent } from '../lib/rpc.js'

export default {
  data: { list: [], expanded: -1, endOn: false, hint: '', trainName: '', abandonArmed: false },

  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    const s = loadState()
    if (!s.active || !s.workout) { router.back(); return }
    this.state = s
    const detailEx = params && params.detailEx != null ? Number(params.detailEx) : -1
    this.expanded = Number.isInteger(detailEx) && detailEx >= 0 && detailEx < s.workout.exercises.length ? detailEx : -1
    this.gesture = null
    this.trailingTapBlockedUntil = 0
    this.navPending = false
    this.rebuild()
  },

  onShow() {
    // 回到本页：上一次导航要么已完成（正常 back），要么没有生效；后者定向进入训练页，
    // 不把用户留在列表里反复点击。手势状态一律从干净状态开始。
    this.gesture = null
    this.trailingTapBlockedUntil = 0
    if (this.navPending) { this.navPending = false; router.replace({ uri: '/Workout' }); return }
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Index' }); return }
    this.state = s
    this.rebuild()
  },

  onHide() { this.navPending = false; this.gesture = null; this.abandonArmed = false },

  rebuild() {
    const s = this.state
    this.trainName = s.workout.name || '训练动作'
    this.list = s.workout.exercises.map((ex, i) => {
      const rows = s.workout.rows[i] || []
      return {
        name: ex.name,
        // Native text can keep an uninterrupted Latin identifier on one line.
        // Add invisible line-break opportunities without changing the exercise name.
        readableName: String(ex.name || '').replace(/([A-Za-z0-9]{12})(?=[A-Za-z0-9])/g, '$1\u200b'),
        idx: i, sid: s.sid, entryInstanceId: ex.entryInstanceId,
        // 官方 Overview 的右侧“已完成/总数”与当前动作高亮：只影响展示，不改完成语义。
        doneCount: rows.filter(r => r.done).length,
        totalCount: rows.length,
        current: i === s.exIdx,
        rows: rows.map((row, j) => ({
          no: String(j + 1), txt: this.rowTxt(row, ex), done: row.done, sid: s.sid, entryInstanceId: ex.entryInstanceId, exIdx: i, setIdx: j, setId: row.setId,
        })),
      }
    })
  },
  onReady() {
    this.focusPanel()
    if (this.expanded >= 0) {
      try { this.$element('exercises').scrollTo({ index: this.expanded, behavior: 'instant' }) } catch (e) {}
    }
  },
  focusPanel() { try { this.$element('page').requestFocus(true) } catch (e) {} },

  // ---- 手势归属：一次触摸 = 一个手势 ----------------------------------------
  // 父子两个组件都会收到 touch 事件，所以状态挂在页面上、只认一个手势：
  //  - 新的一次真实 touchstart 永远开始新手势，并清掉上一次滑动留下的尾随保护；
  //  - 滑动抬手后的那个 click 被消费一次（保护到 400ms 截止，也为没有 touch 的事件兜底）；
  //  - 下一次独立轻触不再被旧时间窗吞掉 —— 这是“点组要连点几下”的直接原因。
  touchStart(e) {
    const t = e.touches && e.touches[0]
    const point = t ? { x: t.clientX, y: t.clientY } : null
    this.gesture = { start: point, last: point, consumed: false }
    this.trailingTapBlockedUntil = 0
    this.touch = point
    this.touchLast = point
    this.swipeConsumed = false
  },
  touchMove(e) {
    const t = e.touches && e.touches[0]
    if (!t) return
    if (!this.gesture) this.gesture = { start: { x: t.clientX, y: t.clientY }, last: null, consumed: false }
    this.gesture.last = { x: t.clientX, y: t.clientY }
    this.touchLast = this.gesture.last
    this.handleSwipe(this.gesture.last)
  },
  touchEnd(e) {
    const t = e.changedTouches && e.changedTouches[0] || e.touches && e.touches[0]
    const end = t ? { x: t.clientX, y: t.clientY } : this.gesture && this.gesture.last
    if (this.gesture && end) this.handleSwipe(end)
    this.touchCancel()
  },
  touchCancel() {
    // 固件可在新面板挂载时 cancel：只要这个手势滑动过，就保护它的尾随 click。
    if (this.gesture && this.gesture.consumed) this.trailingTapBlockedUntil = Date.now() + 400
    this.gesture = null
    this.swipeConsumed = false
    this.touch = null
    this.touchLast = null
  },
  handleSwipe(end) {
    const g = this.gesture
    if (!g || !g.start || !end || g.consumed) return false
    const dx = end.x - g.start.x, dy = end.y - g.start.y
    if (Math.abs(dx) < 45 || Math.abs(dx) <= Math.abs(dy) + 8) return false
    g.consumed = true
    this.swipeConsumed = true
    this.trailingTapBlockedUntil = Date.now() + 400
    if (dx > 0 && !this.endOn) { this.endOn = true; this.focusPanel() }
    else if (dx < 0 && this.endOn) { this.endOn = false; this.focusPanel() }
    return true
  },
  // 只拦“这个手势的尾随 click”；新的 touchstart 已经把截止时间清零。
  interactionBlocked() { return !!(this.gesture && this.gesture.consumed) || Date.now() < (this.trailingTapBlockedUntil || 0) },
  backToExercises() {
    if (this.interactionBlocked()) return
    this.endOn = false; this.abandonArmed = false; this.hint = ''; this.focusPanel()
  },
  onBackPress() {
    if (this.interactionBlocked() || this.navPending) return true
    if (this.endOn) this.backToExercises()
    else this.onExit()
    return true
  },

  rowTxt(row, ex) {
    const w = row.w === '' || row.w == null ? '' : row.w + (this.state.weightUnit || 'kg') + '*'
    const timed = ex && String(ex.reps || '').indexOf('秒') >= 0
    const r = row.r === '' || row.r == null ? '—' : row.r + (timed ? '秒' : '')
    return (w + r) || '—'
  },

  toggleEx(index) {
    if (this.endOn || this.interactionBlocked()) return
    const idx = Number(index)
    this.expanded = this.expanded === idx ? -1 : idx
  },

  pickExercise(item) {
    if (this.endOn || this.interactionBlocked() || this.navPending) return
    const s = loadState()
    if (!item || item.sid !== s.sid || !s.workout) { this.hint = '训练已变化'; return }
    const ex = item.entryInstanceId ? s.workout.exercises.findIndex(e => e.entryInstanceId === item.entryInstanceId) : item.idx
    if (!(ex >= 0) || !s.workout.exercises[ex]) { this.hint = '该动作已被删除'; return }
    const rows = s.workout.rows[ex] || [], first = rows.findIndex(r => !r.done), set = first < 0 ? 0 : first
    if (!rows[set]) { this.hint = '该动作已没有可选的组'; return }
    return this.pickRow({ sid: s.sid, entryInstanceId: item.entryInstanceId, exIdx: ex, setId: rows[set].setId, setIdx: set })
  },

  // 一次有效轻触 = 一次导航：先同步运行态与持久化（网络与回执不参与），再返回训练页。
  async pickRow(d) {
    if (this.endOn || this.interactionBlocked() || this.navPending || this.focusSaving) return
    const sid = loadState().sid
    this.focusSaving = true
    try {
      const result = await commitSessionAction(sid, s => {
        if (!d || (d.sid && d.sid !== s.sid)) throw new Error('训练已变化')
        const ex = d.entryInstanceId ? s.workout.exercises.findIndex(e => e.entryInstanceId === d.entryInstanceId) : Number(d.exIdx)
        if (!(ex >= 0 && ex < s.workout.exercises.length)) throw new Error('该动作已被删除')
        const rows = s.workout.rows[ex] || []
        const set = d.setId ? rows.findIndex(r => r.setId === d.setId) : Number(d.setIdx)
        if (!Number.isInteger(set) || !rows[set]) throw new Error('该组已被删除')
        s.exIdx = ex; s.setIdx = set; s.focusAt = Date.now()
        stageSessionEvent(s, { t: 'focus', sid: s.sid, entryInstanceId: s.workout.exercises[ex].entryInstanceId,
          setId: rows[set].setId, ex, set: set + 1, at: s.focusAt, source: 'watch' })
      })
      if (!result.ok) { this.hint = '未保存，请重试'; return }
      for (const event of result.value.pendingEdits || []) sendEvent(event)
      this.hint = ''; this.navPending = true; this.focusPanel(); router.back()
    } catch (error) { this.hint = String(error.message || '未保存，请重试') }
    finally { this.focusSaving = false }
  },

  onExit() {
    if (this.interactionBlocked() || this.navPending) return
    this.navPending = true
    router.back()
  },

  async closeWorkout(disposition) {
    if (this.closeSaving) return
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Index' }); return }
    this.closeSaving = true
    try {
      const result = await commitLocalClose(s.sid, disposition)
      if (!result.ok) { this.hint = '存储失败，未结束，请重试'; return }
      for (const event of [...(result.entry.pendingEvents || []), result.entry.closeEvent]) sendEvent(event)
      if (result.entry.delivery === 'pending') sendEvent(result.entry.summaryEvent)
      router.replace({ uri: disposition === 'saved' ? '/Summary' : '/Index' })
    } catch (_) { this.hint = '存储失败，未结束，请重试' }
    finally { this.closeSaving = false }
  },
  // 放弃不可逆：第一次点击只进入武装态并给出警告，第二次才真的放弃（官方 Finish 的二次确认）。
  abandonWorkout() {
    if (this.interactionBlocked()) return
    if (!this.abandonArmed) {
      this.abandonArmed = true
      this.hint = '再次点击“确认放弃”才会丢弃本次训练'
      return
    }
    this.abandonArmed = false
    this.hint = ''
    return this.closeWorkout('abandoned')
  },
  saveWorkout() {
    if (this.interactionBlocked() || this.navPending) return
    this.navPending = true
    runtime().finishRequest = { sid: this.state.sid }
    router.back()
  },

}
</script>

<template>
<div class="page" id="page" touch-focusable="true" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
  <div class="content" if="{{ !endOn }}">
    <text class="title" if="{{ !hint }}">{{ trainName }}</text>
    <text class="hint-line" if="{{ hint }}">{{ hint }}</text>
    <div class="body">
      <list class="scroll" id="exercises" touch-focusable="true" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
        <list-item class="exrow {{ item.current ? 'current' : '' }}" type="exercise" for="{{ item in list }}" tid="idx">
          <div class="exhead">
            <text class="exname {{ item.current ? 'current-name' : '' }}" onclick="pickExercise(item)">{{ item.name }}</text>
            <text class="cnt {{ item.doneCount === item.totalCount && item.totalCount > 0 ? 'cnt-done' : '' }}">{{ item.doneCount }}/{{ item.totalCount }}</text>
            <input class="expand-hit" type="button" value="{{ expanded === item.idx ? '⌃' : '⌄' }}" onclick="toggleEx(item.idx)" />
          </div>
          <div class="rows" if="{{ expanded === item.idx }}">
            <text class="full-name">{{ item.readableName }}</text>
            <div class="rrow" for="{{ r in item.rows }}" onclick="pickRow(r)">
              <text class="rno {{ r.done ? 'done-no' : '' }}">{{ r.done ? '完' : r.no }}</text>
              <text class="rtxt {{ r.done ? 'done' : '' }}">{{ r.txt }}</text>
              <text class="chev">›</text>
            </div>
          </div>
        </list-item>
      </list>
    </div>

    <div class="foot">
      <input class="endbtn save" type="button" value="保存结束" onclick="saveWorkout" />
      <div class="exit-row">
        <div class="endbtn back compact-action" onclick="onExit"><image class="back-icon" src="/common/icons/back.svg" /><text class="back-label">返回训练</text></div>
        <input class="endbtn abandon compact-action {{ abandonArmed ? 'armed' : '' }}" type="button" value="放弃训练" onclick="abandonWorkout" />
      </div>
    </div>
  </div>
  <div class="end-panel" id="end-panel" touch-focusable="true" if="{{ endOn }}">
    <text class="title end-title">结束本次训练</text>
    <text class="hint">保存训练记录，或放弃本次训练</text>
    <input class="endbtn end-spaced save" type="button" value="保存结束" onclick="saveWorkout" />
    <input class="endbtn end-spaced abandon {{ abandonArmed ? 'armed' : '' }}" type="button" value="放弃训练" onclick="abandonWorkout" />
    <div class="endbtn end-spaced back" onclick="backToExercises"><image class="back-icon" src="/common/icons/back.svg" /><text class="back-label">返回动作</text></div>
  </div>
</div>
</template>


<style>
/* Wear OS: tap the exercise name to focus it; separate disclosure expands sets. */
.page { width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; }
.content { width: 100%; height: 100%; flex-direction: column; align-items: center; }
.title { width: 314px; height: 52px; margin-top: 18px; font-size: 28px; font-weight: bold; color: #FFFFFF; lines: 1; }
.hint-line { width: 314px; height: 52px; margin-top: 18px; font-size: 22px; color: #FF9F0A; lines: 2; }
.body { width: 338px; flex: 1; min-height: 0px; }
.scroll { width: 338px; height: 100%; }
.exrow { width: 338px; padding: 12px; margin-bottom: 12px; border-radius: 22px; background-color: #1C1C1E; flex-direction: column; }
.current { background-color: #242725; }
.exhead { width: 314px; min-height: 76px; flex-direction: row; align-items: center;  justify-content: space-between;}
.exname { width: 204px; min-height: 64px; font-size: 26px; color: #FFFFFF; lines: 2;  line-height: 32px;}
.current-name { color: #30D158; }
.cnt { width: 46px; font-size: 20px; color: #929297; text-align: right; }
.cnt-done { color: #30D158; }
.expand-hit { width: 56px; height: 56px; border-radius: 22px; font-size: 30px; background-color: #242725; color: #929297; }
.rows { width: 314px; flex-direction: column; }
.full-name { width: 314px; min-height: 64px; font-size: 24px; line-height: 32px; color: #FFFFFF; lines: 0; }
.rrow { width: 314px; min-height: 64px; flex-direction: row; align-items: center; }
.rno { width: 42px; font-size: 22px; color: #929297; text-align: center; }
.rtxt { width: 242px; font-size: 25px; color: #FFFFFF; lines: 2;  line-height: 30px;}
.done { color: #929297; }
.done-no { color: #30D158; }
.chev { width: 22px; font-size: 24px; color: #929297; }
.foot { width: 314px; height: 128px; margin-bottom: 24px; flex-direction: column; justify-content: space-between; }
.endbtn { width: 314px; height: 60px; font-size: 24px; border-radius: 30px; background-color: #242725; color: #FFFFFF; }
.save { background-color: #0A3418; color: #30D158; }
.exit-row { width: 314px; height: 60px; flex-direction: row; justify-content: space-between; }
.compact-action { width: 152px; }
.abandon { color: #FF453A; }
.armed { background-color: #FF453A; color: #000000; }
.end-panel { width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; }
.end-spaced { margin-top: 14px; }
.hint { width: 338px; height: 64px; font-size: 22px; color: #929297; text-align: center; lines: 2; }


.back { flex-direction: row; justify-content: center; align-items: center; }
.back-icon { width: 26px; height: 26px; margin-right: 6px; }
.back-label { font-size: 22px; color: #30D158; }


@media screen and (device: watch-round) {

 .title, .hint-line { width: 220px; margin-top: 30px; }
 .body, .scroll, .exrow, .foot, .exit-row, .hint, .endbtn { width: 300px; }
 .exhead, .rows, .rrow, .full-name { width: 276px; }
 .exname { width: 166px; }
 .rtxt { width: 204px; }
 .foot { margin-bottom: 58px; }
 .compact-action { width: 144px; }
 .back-label { font-size: 21px; }
 .end-title { width: 300px; margin-top: 0px; }

}
</style>
