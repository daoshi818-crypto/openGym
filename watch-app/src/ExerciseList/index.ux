<script>
// 动作列表页：查看动作和组，点组返回训练页并切换游标。
import router from '@blueos.app.appmanager.router'
import { loadState, save, endSession, closeSession } from '../lib/session.js'
import { sendEvent } from '../lib/rpc.js'

export default {
  data: { list: [], expanded: -1, endOn: false },

  onInit() {
    const s = loadState()
    if (!s.active || !s.workout) { router.back(); return }
    this.state = s
    this.rebuild()
  },

  rebuild() {
    const s = this.state
    this.list = s.workout.exercises.map((ex, i) => ({
      name: ex.name,
      idx: i,
      rows: (s.workout.rows[i] || []).map((row, j) => ({
        no: String(j + 1), txt: this.rowTxt(row, ex), done: row.done, exIdx: i, setIdx: j,
      })),
    }))
  },
  onReady() { this.focusPanel() },
  focusPanel() { try { this.$element('page').requestFocus(true) } catch (e) {} },
  touchStart(e) {
    const t = e.touches && e.touches[0]
    this.touch = t ? { x: t.clientX, y: t.clientY } : null
    this.touchLast = this.touch
  },
  touchMove(e) {
    const t = e.touches && e.touches[0]
    if (this.touch && t) {
      this.touchLast = { x: t.clientX, y: t.clientY }
      this.handleSwipe(this.touchLast)
    }
  },
  touchCancel() { this.touch = null; this.touchLast = null },
  touchEnd(e) {
    const t = e.changedTouches && e.changedTouches[0] || e.touches && e.touches[0]
    const end = t ? { x: t.clientX, y: t.clientY } : this.touchLast
    if (end) this.handleSwipe(end)
    this.touchCancel()
  },
  handleSwipe(end) {
    if (!this.touch) return
    const dx = end.x - this.touch.x, dy = end.y - this.touch.y
    if (Math.abs(dx) < 45 || Math.abs(dx) <= Math.abs(dy) + 8) return
    this.touchCancel()
    this.ignoreTapUntil = Date.now() + 350
    if (dx > 0 && !this.endOn) { this.endOn = true; this.focusPanel() }
    else if (dx < 0 && this.endOn) this.backToExercises()
  },
  backToExercises() { this.endOn = false; this.focusPanel() },
  onBackPress() {
    if (this.endOn) this.backToExercises()
    else router.back()
    return true
  },

  rowTxt(row, ex) {
    const w = row.w === '' || row.w == null ? '' : row.w + 'kg*'
    const timed = ex && String(ex.reps || '').indexOf('秒') >= 0
    const r = row.r === '' || row.r == null ? '—' : row.r + (timed ? '秒' : '')
    return (w + r) || '—'
  },

  toggleEx(index) {
    if (this.endOn || Date.now() < (this.ignoreTapUntil || 0)) return
    const idx = Number(index)
    this.expanded = this.expanded === idx ? -1 : idx
  },

  pickRow(d) {
    if (this.endOn || Date.now() < (this.ignoreTapUntil || 0)) return
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Summary' }); return }
    const ex = Number(d.exIdx)
    const set = Number(d.setIdx)
    s.exIdx = ex
    s.setIdx = set
    s.focusAt = Date.now()
    save(s)
    sendEvent({ t: 'focus', sid: s.sid, ex, set: set + 1, at: s.focusAt, source: 'watch' })
    router.back()
  },

  onExit() { if (Date.now() >= (this.ignoreTapUntil || 0)) router.back() },

  closeWorkout(disposition) {
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Index' }); return }
    const closedAt = Date.now()
    const session = disposition === 'saved' ? endSession(s, s.profile, closedAt) : null
    if (!session) closeSession(s.sid)
    sendEvent({ t: 'session_close', sid: s.sid, disposition, closedAt, at: closedAt,
      ...(session ? { workout: s.workout, startedAt: s.startedAt, summary: { minutes: session.minutes, avgHr: session.avgHr, maxHr: session.maxHr, calories: session.calories, volume: session.volume }, completedSets: session.sets } : {}) })
    router.replace({ uri: disposition === 'saved' ? '/Summary' : '/Index' })
  },
  abandonWorkout() { if (Date.now() >= (this.ignoreTapUntil || 0)) this.closeWorkout('abandoned') },
  saveWorkout() { if (Date.now() >= (this.ignoreTapUntil || 0)) this.closeWorkout('saved') },

}
</script>

<template>
  <div class="page" id="page" touch-focusable="true" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
    <div class="content" if="{{ !endOn }}">
    <text class="title">训练动作</text>
    <div class="body">
      <list class="scroll" id="exercises" touch-focusable="true" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
        <list-item class="exrow" type="exercise" for="{{ item in list }}" tid="idx">
          <div class="exhead" onclick="toggleEx(item.idx)">
            <text class="exname">{{ item.name }}</text>
            <text class="cnt">{{ item.rows.length }}组</text>
          </div>
          <div class="rows" if="{{ expanded === item.idx }}">
            <div class="rrow" for="{{ r in item.rows }}" onclick="pickRow(r)">
              <text class="rno {{ r.done ? 'done-no' : '' }}">{{ r.done ? '✓' : r.no }}</text>
              <text class="rtxt {{ r.done ? 'done' : '' }}">{{ r.txt }}{{ r.done ? ' · 已完成' : '' }}</text>
              <text class="chev">›</text>
            </div>
          </div>
        </list-item>
      </list>
    </div>

    <div class="foot">
      <div class="exit-row">
        <input class="endbtn save" type="button" value="保存结束" onclick="saveWorkout" />
        <input class="endbtn abandon" type="button" value="放弃训练" onclick="abandonWorkout" />
      </div>
      <input class="back" type="button" value="返回训练" onclick="onExit" />
    </div>
    </div>
    <div class="end-panel" id="end-panel" touch-focusable="true" if="{{ endOn }}">
      <text class="title">结束本次训练</text>
      <text class="hint">保存训练记录，或放弃本次训练</text>
      <input class="endbtn save" type="button" value="保存结束" onclick="saveWorkout" />
      <input class="endbtn abandon" type="button" value="放弃训练" onclick="abandonWorkout" />
      <input class="endbtn" type="button" value="返回动作" onclick="backToExercises" />
    </div>
  </div>
</template>

<style>
.page { flex-direction: column; align-items: center; width: 100%; height: 100%; background-color: #000000; }
.content { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; }
.title { height: 36px; width: 350px; font-size: 26px; color: #ffffff; text-align: center; }
.body { width: 350px; height: 274px; }
.scroll { width: 350px; height: 274px; }
.exrow { flex-direction: column; width: 350px; padding: 8px 4px; }
.exhead { flex-direction: column; min-height: 48px; }
.exname { width: 342px; font-size: 23px; color: #ffffff; lines: 2; }
.cnt { font-size: 17px; color: #8e8e93; margin-top: 1px; }
.rows { flex-direction: column; margin-top: 4px; }
.rrow { flex-direction: row; align-items: center; min-height: 48px; padding: 6px 0; }
.rno { font-size: 20px; color: #30d158; width: 38px; }
.rtxt { font-size: 20px; color: #ffffff; flex: 1; }
.rtxt.done { color: #63dfb1; }
.done-no { color: #63dfb1; }
.chev { font-size: 22px; color: #48484a; }
.foot { width: 350px; height: 104px; flex-direction: column; align-items: center; justify-content: space-between; padding-top: 4px; }
.exit-row { width: 326px; height: 48px; flex-direction: row; justify-content: space-between; }
.back { width: 180px; height: 42px; font-size: 18px; color: #8e8e93; background-color: transparent; }
.end-panel { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; justify-content: center; }
.hint { width: 350px; height: 48px; font-size: 18px; color: #aeb9bd; text-align: center; lines: 2; }
.endbtn { width: 310px; height: 52px; margin-top: 14px; font-size: 23px; border-radius: 8px; background-color: #191d1f; color: #ffffff; }
.exit-row .endbtn { width: 156px; height: 46px; margin-top: 0; font-size: 18px; }
.abandon { background-color: #3a3a3c; }
.save { background-color: #30d158; }
</style>
