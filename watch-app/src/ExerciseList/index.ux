<script>
import { bindRuntime } from '../lib/runtime.js'
// 动作列表页：查看动作和组，点组返回训练页并切换游标。
import router from '@blueos.app.appmanager.router'
import { loadState, save, endSession, closeSession } from '../lib/session.js'
import { sendEvent } from '../lib/rpc.js'

export default {
  data: { list: [], expanded: -1, endOn: false, hint: '', trainName: '', abandonArmed: false },

  onInit() {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    const s = loadState()
    if (!s.active || !s.workout) { router.back(); return }
    this.state = s
    this.gesture = null
    this.trailingTapBlockedUntil = 0
    this.navPending = false
    this.rebuild()
  },

  onShow() {
    // 回到本页：上一次导航要么已完成（正常 back），要么没有生效；后者定向进入训练页，
    // 不把用户留在列表里反复点击。手势状态一律从干净状态开始。
    this.gesture = null
    this.trailingTapBlockedUntil = 0
    if (this.navPending) { this.navPending = false; router.replace({ uri: '/Workout' }); return }
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Index' }); return }
    this.state = s
    this.rebuild()
  },

  onHide() { this.navPending = false; this.gesture = null; this.abandonArmed = false },

  rebuild() {
    const s = this.state
    this.trainName = s.workout.name || '训练动作'
    this.list = s.workout.exercises.map((ex, i) => {
      const rows = s.workout.rows[i] || []
      return {
        name: ex.name,
        idx: i, sid: s.sid, entryInstanceId: ex.entryInstanceId,
        // 官方 Overview 的右侧“已完成/总数”与当前动作高亮：只影响展示，不改完成语义。
        doneCount: rows.filter(r => r.done).length,
        totalCount: rows.length,
        current: i === s.exIdx,
        rows: rows.map((row, j) => ({
          no: String(j + 1), txt: this.rowTxt(row, ex), done: row.done, sid: s.sid, entryInstanceId: ex.entryInstanceId, exIdx: i, setIdx: j, setId: row.setId,
        })),
      }
    })
  },
  onReady() { this.focusPanel() },
  focusPanel() { try { this.$element('page').requestFocus(true) } catch (e) {} },

  // ---- 手势归属：一次触摸 = 一个手势 ----------------------------------------
  // 父子两个组件都会收到 touch 事件，所以状态挂在页面上、只认一个手势：
  //  - 新的一次真实 touchstart 永远开始新手势，并清掉上一次滑动留下的尾随保护；
  //  - 滑动抬手后的那个 click 被消费一次（保护到 400ms 截止，也为没有 touch 的事件兜底）；
  //  - 下一次独立轻触不再被旧时间窗吞掉 —— 这是“点组要连点几下”的直接原因。
  touchStart(e) {
    const t = e.touches && e.touches[0]
    const point = t ? { x: t.clientX, y: t.clientY } : null
    this.gesture = { start: point, last: point, consumed: false }
    this.trailingTapBlockedUntil = 0
    this.touch = point
    this.touchLast = point
    this.swipeConsumed = false
  },
  touchMove(e) {
    const t = e.touches && e.touches[0]
    if (!t) return
    if (!this.gesture) this.gesture = { start: { x: t.clientX, y: t.clientY }, last: null, consumed: false }
    this.gesture.last = { x: t.clientX, y: t.clientY }
    this.touchLast = this.gesture.last
    this.handleSwipe(this.gesture.last)
  },
  touchEnd(e) {
    const t = e.changedTouches && e.changedTouches[0] || e.touches && e.touches[0]
    const end = t ? { x: t.clientX, y: t.clientY } : this.gesture && this.gesture.last
    if (this.gesture && end) this.handleSwipe(end)
    this.touchCancel()
  },
  touchCancel() {
    // 固件可在新面板挂载时 cancel：只要这个手势滑动过，就保护它的尾随 click。
    if (this.gesture && this.gesture.consumed) this.trailingTapBlockedUntil = Date.now() + 400
    this.gesture = null
    this.swipeConsumed = false
    this.touch = null
    this.touchLast = null
  },
  handleSwipe(end) {
    const g = this.gesture
    if (!g || !g.start || !end || g.consumed) return false
    const dx = end.x - g.start.x, dy = end.y - g.start.y
    if (Math.abs(dx) < 45 || Math.abs(dx) <= Math.abs(dy) + 8) return false
    g.consumed = true
    this.swipeConsumed = true
    this.trailingTapBlockedUntil = Date.now() + 400
    if (dx > 0 && !this.endOn) { this.endOn = true; this.focusPanel() }
    else if (dx < 0 && this.endOn) { this.endOn = false; this.focusPanel() }
    return true
  },
  // 只拦“这个手势的尾随 click”；新的 touchstart 已经把截止时间清零。
  interactionBlocked() { return !!(this.gesture && this.gesture.consumed) || Date.now() < (this.trailingTapBlockedUntil || 0) },
  backToExercises() {
    if (this.interactionBlocked()) return
    this.endOn = false; this.abandonArmed = false; this.hint = ''; this.focusPanel()
  },
  onBackPress() {
    if (this.interactionBlocked()) return true
    if (this.endOn) this.backToExercises()
    else router.back()
    return true
  },

  rowTxt(row, ex) {
    const w = row.w === '' || row.w == null ? '' : row.w + (this.state.weightUnit || 'kg') + '*'
    const timed = ex && String(ex.reps || '').indexOf('秒') >= 0
    const r = row.r === '' || row.r == null ? '—' : row.r + (timed ? '秒' : '')
    return (w + r) || '—'
  },

  toggleEx(index) {
    if (this.endOn || this.interactionBlocked()) return
    const idx = Number(index)
    this.expanded = this.expanded === idx ? -1 : idx
  },

  pickExercise(item) {
    if (this.endOn || this.interactionBlocked() || this.navPending) return
    const s = loadState()
    if (!item || item.sid !== s.sid || !s.workout) { this.hint = '训练已变化'; return }
    const ex = item.entryInstanceId ? s.workout.exercises.findIndex(e => e.entryInstanceId === item.entryInstanceId) : item.idx
    if (!(ex >= 0) || !s.workout.exercises[ex]) { this.hint = '该动作已被删除'; return }
    const rows = s.workout.rows[ex] || [], first = rows.findIndex(r => !r.done), set = first < 0 ? 0 : first
    if (!rows[set]) { this.hint = '该动作已没有可选的组'; return }
    this.pickRow({ sid: s.sid, entryInstanceId: item.entryInstanceId, exIdx: ex, setId: rows[set].setId, setIdx: set })
  },

  // 一次有效轻触 = 一次导航：先同步运行态与持久化（网络与回执不参与），再返回训练页。
  pickRow(d) {
    if (this.endOn || this.interactionBlocked() || this.navPending) return
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Summary' }); return }
    if (!d || (d.sid && d.sid !== s.sid)) { this.hint = '训练已变化'; return }
    const ex = d.entryInstanceId ? s.workout.exercises.findIndex(e => e.entryInstanceId === d.entryInstanceId) : Number(d.exIdx)
    if (!(ex >= 0 && ex < s.workout.exercises.length)) { this.hint = '该动作已被删除'; return }
    const rows = s.workout.rows[ex] || []
    if (!rows.length) { this.hint = '该动作已没有可选的组'; return }
    let set = Number(d.setIdx)
    if (d.setId) {
      const stable = rows.findIndex(r => r.setId === d.setId)
      if (stable < 0) { this.hint = '该组已被删除'; return }
      set = stable
    }
    if (!Number.isInteger(set) || !(set >= 0 && set < rows.length)) { this.hint = '该组已被删除'; return }
    this.hint = ''
    s.exIdx = ex
    s.setIdx = set
    s.focusAt = Date.now()
    save(s)
    sendEvent({ t: 'focus', sid: s.sid, entryInstanceId: s.workout.exercises[ex].entryInstanceId, setId: rows[set].setId, ex, set: set + 1, at: s.focusAt, source: 'watch' })
    this.navPending = true
    this.focusPanel()
    router.back()
  },

  onExit() { if (!this.interactionBlocked()) router.back() },

  closeWorkout(disposition) {
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Index' }); return }
    const closedAt = Date.now()
    const session = disposition === 'saved' ? endSession(s, s.profile, closedAt) : null
    if (!session) closeSession(s.sid)
    sendEvent({ t: 'session_close', sid: s.sid, disposition, closedAt, at: closedAt,
      ...(session ? { workout: s.workout, startedAt: s.startedAt, weightUnit: s.weightUnit || 'kg', summary: { minutes: session.minutes, avgHr: session.avgHr, maxHr: session.maxHr, calories: session.calories, volume: session.volume }, completedSets: session.sets } : {}) })
    router.replace({ uri: disposition === 'saved' ? '/Summary' : '/Index' })
  },
  // 放弃不可逆：第一次点击只进入武装态并给出警告，第二次才真的放弃（官方 Finish 的二次确认）。
  abandonWorkout() {
    if (this.interactionBlocked()) return
    if (!this.abandonArmed) {
      this.abandonArmed = true
      this.hint = '再次点击“确认放弃”才会丢弃本次训练'
      return
    }
    this.abandonArmed = false
    this.hint = ''
    this.closeWorkout('abandoned')
  },
  saveWorkout() {
    if (this.interactionBlocked() || this.navPending) return
    this.navPending = true
    router.replace({ uri: '/Workout', params: { requestFinish: true } })
  },

}
</script>

<template>
<div class="page" id="page" touch-focusable="true" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
  <div class="content" if="{{ !endOn }}">
    <text class="title" if="{{ !hint }}">{{ trainName }}</text>
    <text class="hint-line" if="{{ hint }}">{{ hint }}</text>
    <div class="body">
      <list class="scroll" id="exercises" touch-focusable="true" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
        <list-item class="exrow {{ item.current ? 'current' : '' }}" type="exercise" for="{{ item in list }}" tid="idx">
          <div class="exhead">
            <text class="exname {{ item.current ? 'current-name' : '' }}" onclick="pickExercise(item)">{{ item.name }}</text>
            <text class="cnt {{ item.doneCount === item.totalCount && item.totalCount > 0 ? 'cnt-done' : '' }}">{{ item.doneCount }}/{{ item.totalCount }}</text>
            <input class="expand-hit" type="button" value="{{ expanded === item.idx ? '⌃' : '⌄' }}" onclick="toggleEx(item.idx)" />
          </div>
          <div class="rows" if="{{ expanded === item.idx }}">
            <div class="rrow" for="{{ r in item.rows }}" onclick="pickRow(r)">
              <text class="rno {{ r.done ? 'done-no' : '' }}">{{ r.done ? '✓' : r.no }}</text>
              <text class="rtxt {{ r.done ? 'done' : '' }}">{{ r.txt }}</text>
              <text class="chev">›</text>
            </div>
          </div>
        </list-item>
      </list>
    </div>

    <div class="foot">
      <input class="endbtn save" type="button" value="保存结束" onclick="saveWorkout" />
      <div class="exit-row">
        <input class="endbtn back" type="button" value="返回训练" onclick="onExit" />
        <input class="endbtn abandon {{ abandonArmed ? 'armed' : '' }}" type="button" value="放弃训练" onclick="abandonWorkout" />
      </div>
    </div>
  </div>
  <div class="end-panel" id="end-panel" touch-focusable="true" if="{{ endOn }}">
    <text class="title">结束本次训练</text>
    <text class="hint">保存训练记录，或放弃本次训练</text>
    <input class="endbtn save" type="button" value="保存结束" onclick="saveWorkout" />
    <input class="endbtn abandon {{ abandonArmed ? 'armed' : '' }}" type="button" value="放弃训练" onclick="abandonWorkout" />
    <input class="endbtn back" type="button" value="返回动作" onclick="backToExercises" />
  </div>
</div>
</template>

<style>
/* v1.4.4 Wear OS 视觉令牌（逐页同值声明）：#000000 底 / #30D158 主操作 / #1C1C1E 卡片
   #2C2C2E 选中卡片 / #FFFFFF 主文字 / #A1A1A6 辅助 / #FF9F0A 提示 / #FF453A 危险 */
.page { flex-direction: column; align-items: center; width: 100%; height: 100%; background-color: #000000; }
.content { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; }
.title { height: 34px; width: 350px; font-size: 23px; color: #FFFFFF; text-align: center; lines: 1; }
.hint-line { height: 34px; width: 350px; font-size: 16px; color: #FF9F0A; text-align: center; lines: 2; }
.body { width: 350px; height: 274px; }
.scroll { width: 350px; height: 274px; }
.exrow { flex-direction: column; width: 350px; padding: 8px 12px; margin-bottom: 6px; border-radius: 14px; background-color: #1C1C1E; }
.exrow.current { background-color: #2C2C2E; border: 1px solid #30D158; }
.exhead { flex-direction: row; align-items: center; justify-content: space-between; min-height: 48px; }
.exname { width: 250px; font-size: 21px; color: #FFFFFF; lines: 2; }
.current-name { color: #30D158; }
.cnt { width: 62px; font-size: 16px; color: #A1A1A6; text-align: right; }
.cnt-done { color: #30D158; }
.rows { flex-direction: column; margin-top: 4px; }
.rrow { flex-direction: row; align-items: center; min-height: 48px; padding: 6px 6px; border-radius: 12px; }
.rno { font-size: 19px; color: #A1A1A6; width: 38px; text-align: center; }
.rtxt { font-size: 19px; color: #FFFFFF; flex: 1; }
.rtxt.done { color: #A1A1A6; }
.done-no { color: #30D158; }
.chev { font-size: 20px; color: #A1A1A6; }
.foot { width: 350px; height: 106px; flex-direction: column; align-items: center; justify-content: space-between; padding-top: 2px; }
.exit-row { width: 326px; height: 48px; flex-direction: row; justify-content: space-between; }
.end-panel { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; justify-content: center; }
.hint { width: 350px; height: 48px; font-size: 16px; color: #A1A1A6; text-align: center; lines: 2; }
.endbtn { width: 326px; height: 48px; margin-top: 10px; font-size: 20px; border-radius: 14px; color: #FFFFFF; }
.save { background-color: #30D158; color: #000000; }
.back { background-color: #1C1C1E; color: #FFFFFF; }
.abandon { background-color: #1C1C1E; color: #FF453A; }
.abandon.armed { background-color: #FF453A; color: #000000; }
.exit-row .endbtn { width: 156px; height: 48px; margin-top: 0; font-size: 17px; }
@media screen and (min-width: 450px) {
  .content { width: 280px; height: 300px; margin-top: 70px; }
  .title { width: 280px; height: 30px; font-size: 19px; }
  .hint-line { width: 280px; height: 30px; font-size: 14px; }
  .body, .scroll { width: 280px; height: 168px; }
  .exrow { width: 280px; padding: 5px 8px; margin-bottom: 4px; }
  .exhead { min-height: 40px; }
  .exname { width: 196px; font-size: 17px; }
  .cnt { width: 52px; font-size: 13px; }
  .rrow { min-height: 38px; padding: 4px 4px; }
  .rno { width: 30px; font-size: 16px; }
  .rtxt { font-size: 16px; }
  .chev { font-size: 17px; }
  .foot { width: 280px; height: 96px; }
  .exit-row { width: 264px; height: 40px; }
  .end-panel { width: 280px; height: 300px; margin-top: 70px; }
  .hint { width: 280px; height: 40px; font-size: 14px; }
  .endbtn { width: 264px; height: 40px; margin-top: 8px; font-size: 17px; }
  .exit-row .endbtn { width: 126px; height: 40px; font-size: 15px; }
}
.expand-hit { width: 44px; height: 44px; font-size: 24px; color: #929297; background-color: #000000; }
.exname { width: 240px; min-height: 44px; }
</style>
