<script>
// 动作列表页：查看动作和组，点组返回训练页并切换游标。
import router from '@blueos.app.appmanager.router'
import { loadState, save, endSession, closeSession } from '../lib/session.js'
import { sendControl, sendEvent } from '../lib/rpc.js'

export default {
  data: { list: [], expanded: -1 },

  onInit() {
    const s = loadState()
    if (!s.active || !s.workout) { router.back(); return }
    this.state = s
    this.rebuild()
  },

  rebuild() {
    const s = this.state
    this.list = s.workout.exercises.map((ex, i) => ({
      name: ex.name,
      idx: i,
      rows: (s.workout.rows[i] || []).map((row, j) => ({
        no: String(j + 1), txt: this.rowTxt(row, ex), done: row.done, exIdx: i, setIdx: j,
      })),
    }))
  },
  onReady() { try { this.$element('exercises').requestFocus(true) } catch (e) {} },

  rowTxt(row, ex) {
    const w = row.w === '' || row.w == null ? '' : row.w + 'kg*'
    const timed = ex && String(ex.reps || '').indexOf('秒') >= 0
    const r = row.r === '' || row.r == null ? '—' : row.r + (timed ? '秒' : '')
    return (w + r) || '—'
  },

  toggleEx(index) {
    const idx = Number(index)
    this.expanded = this.expanded === idx ? -1 : idx
  },

  pickRow(d) {
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Summary' }); return }
    const ex = Number(d.exIdx)
    const set = Number(d.setIdx)
    s.exIdx = ex
    s.setIdx = set
    s.focusAt = Date.now()
    save(s)
    sendControl({ t: 'focus', sid: s.sid, ex, set: set + 1, at: s.focusAt, source: 'watch' })
    router.back()
  },

  onExit() { router.back() },

  closeWorkout(disposition) {
    const s = loadState()
    if (!s.active || !s.workout) { router.replace({ uri: '/Index' }); return }
    const closedAt = Date.now()
    const session = disposition === 'saved' ? endSession(s, s.profile, closedAt) : null
    if (!session) closeSession(s.sid)
    sendEvent({ t: 'session_close', sid: s.sid, disposition, closedAt, at: closedAt,
      ...(session ? { workout: s.workout, startedAt: s.startedAt, summary: { minutes: session.minutes, avgHr: session.avgHr, maxHr: session.maxHr, calories: session.calories, volume: session.volume }, completedSets: session.sets } : {}) })
    router.replace({ uri: disposition === 'saved' ? '/Summary' : '/Index' })
  },
  abandonWorkout() { this.closeWorkout('abandoned') },
  saveWorkout() { this.closeWorkout('saved') },

}
</script>

<template>
  <div class="page">
    <div class="content">
    <text class="title">训练动作</text>
    <div class="body">
      <list class="scroll" id="exercises" touch-focusable="true">
        <list-item class="exrow" type="exercise" for="{{ item in list }}" tid="idx">
          <div class="exhead" onclick="toggleEx(item.idx)">
            <text class="exname">{{ item.name }}</text>
            <text class="cnt">{{ item.rows.length }}组</text>
          </div>
          <div class="rows" if="{{ expanded === item.idx }}">
            <div class="rrow" for="{{ r in item.rows }}" onclick="pickRow(r)">
              <text class="rno">{{ r.no }}</text>
              <text class="rtxt {{ r.done ? 'done' : '' }}">{{ r.txt }} {{ r.done ? '✓' : '' }}</text>
              <text class="chev">›</text>
            </div>
          </div>
        </list-item>
      </list>
    </div>

    <div class="foot">
      <input class="back" type="button" value="返回训练" onclick="onExit" />
      <div class="endrow">
        <input class="fbtn abandon" type="button" value="退出" onclick="abandonWorkout" />
        <input class="fbtn save" type="button" value="保存" onclick="saveWorkout" />
      </div>
    </div>
    </div>
  </div>
</template>

<style>
.page { flex-direction: column; align-items: center; width: 100%; height: 100%; background-color: #000000; }
.content { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; }
.title { height: 36px; width: 350px; font-size: 26px; color: #ffffff; text-align: center; }
.body { width: 350px; height: 290px; }
.scroll { width: 350px; height: 290px; }
.exrow { flex-direction: column; width: 350px; padding: 8px 4px; }
.exhead { flex-direction: column; min-height: 48px; }
.exname { width: 342px; font-size: 23px; color: #ffffff; lines: 2; }
.cnt { font-size: 17px; color: #8e8e93; margin-top: 1px; }
.rows { flex-direction: column; margin-top: 4px; }
.rrow { flex-direction: row; align-items: center; min-height: 48px; padding: 6px 0; }
.rno { font-size: 20px; color: #30d158; width: 38px; }
.rtxt { font-size: 20px; color: #ffffff; flex: 1; }
.rtxt.done { color: #636366; }
.chev { font-size: 22px; color: #48484a; }
.foot { height: 88px; flex-direction: column; align-items: center; justify-content: flex-end; }
.back { width: 140px; height: 38px; font-size: 16px; color: #8e8e93; background-color: transparent; }
.endrow { width: 350px; height: 54px; flex-direction: row; justify-content: space-between; }
.fbtn { width: 170px; height: 48px; font-size: 22px; border-radius: 8px; background-color: #191d1f; color: #ffffff; }
.abandon { background-color: #3a3a3c; }
.save { background-color: #30d158; }
</style>
