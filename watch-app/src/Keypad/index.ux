<script>
import { bindRuntime } from '../lib/runtime.js'
// 计算器输入页：改重量/次数。路由参数直接使用 exIdx、setIdx、field。
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { loadState, setRowValue, commitSessionAction } from '../lib/session.js'
import { rotationStep, valueStep } from '../lib/value-step.js'
import { rowTarget } from '../lib/workout-interaction.js'

export default {
  data: {
    saving: false,
    show: '0',
    label: '重量',
    unit: 'kg',
    exIdx: 0,
    setIdx: 0,
    field: 'w', inputMode: 'keypad', notice: '', targetName: '', stepLabel: '0.5',
  },

  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    const p = params && typeof params === 'object' ? params : {}
    const s = loadState()
    if (!s.active || !s.workout) { router.back(); return }
    this.editSid = s.sid; this.editUnit = s.weightUnit || 'kg'
    const target = rowTarget(s, { ...p, exIdx: Number(p.exIdx != null ? p.exIdx : this.exIdx || 0), setIdx: Number(p.setIdx != null ? p.setIdx : this.setIdx || 0) })
    if (!target || target.row.done || s.pausedAt || s.restUntil) { router.back(); return }
    this.exIdx = target.exIdx; this.setIdx = target.setIdx
    this.field = (p.field != null ? p.field : this.field) === 'r' ? 'r' : 'w'
    this.inputMode = p.inputMode === 'quick' ? 'quick' : 'keypad'
    this.targetName = s.workout.exercises[target.exIdx].name
    const row = target.row

    this.entryInstanceId = s.workout.exercises[this.exIdx].entryInstanceId
    this.setId = row.setId
    this.buffer = ''
    this.changed = false
    const cur = this.field === 'w' ? row.w : row.r
    this.initVal = cur === '' || cur == null ? '' : String(cur)
    this.buffer = this.initVal; this.replaceOnDigit = true
    this.show = this.initVal || '—'
    if (this.field === 'w') { this.label = '重量'; this.unit = s.weightUnit || 'kg' }
    else {
      const ex = s.workout.exercises[this.exIdx]
      const timed = ex && String(ex.reps || '').indexOf('秒') >= 0
      this.label = timed ? '时长' : '次数'
      this.unit = timed ? '秒' : '次'
    }
    const step = Number(storage.getSync({ key: 'weight_step' }))
    this.stepLabel = this.field === 'w' ? String(Number.isFinite(step) && step >= 0.001 ? Math.round(step * 1000) / 1000 : 0.5) : '1'
  },

  onKey(k) {
    if (k === 'C') { this.changed = true; this.buffer = ''; this.show = '—'; this.replaceOnDigit = false; return }
    if (k === 'ok') { this.commit(); return }
    if (this.replaceOnDigit) { this.buffer = ''; this.replaceOnDigit = false }
    if (k === '.') {
      if (this.field !== 'w' || this.buffer.indexOf('.') >= 0) return
      if (!this.buffer) this.buffer = '0'
      this.buffer += '.'
    } else {
      if (this.buffer.replace('.', '').length >= 5) return
      this.buffer += k
    }
    this.changed = true
    this.show = this.buffer.endsWith('.') ? this.buffer : String(parseFloat(this.buffer))
  },

  backspace() { this.buffer = this.buffer.slice(0, -1); this.changed = true; this.replaceOnDigit = false; this.show = this.buffer || '—' },
  decimalOrClear() {
    if (this.field === 'w') { this.onKey('.'); return }
    this.buffer = this.buffer.slice(0, -1); this.changed = true; this.replaceOnDigit = false
    this.show = this.buffer || '—'
  },
  onKey1() { this.onKey('1') },
  onKey2() { this.onKey('2') },
  onKey3() { this.onKey('3') },
  onKey4() { this.onKey('4') },
  onKey5() { this.onKey('5') },
  onKey6() { this.onKey('6') },
  onKey7() { this.onKey('7') },
  onKey8() { this.onKey('8') },
  onKey9() { this.onKey('9') },
  onKey0() { this.onKey('0') },
  onKeyDot() { this.onKey('.') },
  onKeyC() { this.onKey('C') },
  onKeyOk() { this.onKey('ok') },
  onCancel() { router.back() },
  onReady() { this.focusCrown() },
  onShow() { this.focusCrown() },
  focusCrown() { try { this.$element('keypad').requestFocus(true) } catch (e) {} },
  onRotation(ev) { const direction = rotationStep(ev); if (direction) this.adjustDraft(direction) },
  adjustDraft(direction) {
    this.buffer = valueStep(this.buffer, this.field, direction, storage.getSync({ key: 'weight_step' }))
    this.show = this.buffer; this.changed = true; this.replaceOnDigit = false
  },
  minus() { this.adjustDraft(-1) },
  plus() { this.adjustDraft(1) },
  useKeyboard() { this.inputMode = 'keypad' },
  useQuick() { this.inputMode = 'quick' },

  async commit() {
    if (!this.changed) { router.back(); return }
    const v = this.buffer === '' ? '' : String(parseFloat(this.buffer) || 0)
    // 编辑期间手机仍可能更新其他行，提交时只改最新会话里的目标字段。
    const s = loadState()
    if (!s.active || s.sid !== this.editSid) { router.back(); return }
    const ex = this.entryInstanceId ? s.workout.exercises.findIndex(e => e.entryInstanceId === this.entryInstanceId) : this.exIdx
    const set = this.setId ? s.workout.rows[ex]?.findIndex(r => r.setId === this.setId) : this.setIdx
    const row = s.workout.rows[ex] && s.workout.rows[ex][set]
    if (!(ex >= 0) || !(set >= 0) || !row || row.done || s.pausedAt || s.restUntil) { this.notice = '目标已变化，未保存'; return }
    if (this.saving) return
    this.saving = true
    try {
    const result = await commitSessionAction(s.sid, latest => {
      const ix = this.entryInstanceId ? latest.workout.exercises.findIndex(e => e.entryInstanceId === this.entryInstanceId) : ex
      const iy = this.setId ? latest.workout.rows[ix]?.findIndex(r => r.setId === this.setId) : set
      const target = latest.workout.rows[ix]?.[iy]
      if (!target || target.done || latest.pausedAt || latest.restUntil) throw new Error('target_changed')
      const value = this.field === 'w' && this.editUnit !== (latest.weightUnit || 'kg') && v !== '' ? Math.round(Number(v) * (this.editUnit === 'lb' ? 0.45359237 : 1 / 0.45359237) * 1000) / 1000 : v
      setRowValue(latest, ix, iy, this.field, value, true)
    })
    if (!result.ok) { this.notice = '存储失败，未保存，请重试'; return }
    router.back()
    } catch { this.notice = '存储失败，未保存，请重试' } finally { this.saving = false }
  },
}
</script>
<template><div class="page" id="keypad" touch-focusable="true" onrotation="onRotation"><div class="number-row"><div class="cancel" onclick="onCancel"><image class="cancel-icon" src="/common/icons/wear-left.svg" /></div><text class="keyboard-value {{ show.length > 6 ? 'long-value' : '' }}">{{ show }}</text><text class="unit">{{ unit === '次' ? '' : unit }}</text></div><text class="notice" if="{{ notice }}">{{ notice }}</text><div class="grid" if="{{ inputMode === 'keypad' }}"><div class="key-row"><input class="key" type="button" value="1" onclick="onKey1" /><input class="key" type="button" value="2" onclick="onKey2" /><input class="key" type="button" value="3" onclick="onKey3" /></div><div class="key-row"><input class="key" type="button" value="4" onclick="onKey4" /><input class="key" type="button" value="5" onclick="onKey5" /><input class="key" type="button" value="6" onclick="onKey6" /></div><div class="key-row"><input class="key" type="button" value="7" onclick="onKey7" /><input class="key" type="button" value="8" onclick="onKey8" /><input class="key" type="button" value="9" onclick="onKey9" /></div><div class="key-row"><input class="key decimal" type="button" value="." disabled="{{ field !== 'w' }}" onclick="onKeyDot" /><input class="key" type="button" value="0" onclick="onKey0" /><div class="key symbol" onclick="backspace"><image class="key-icon" src="/common/icons/wear-back.svg" /></div></div></div><div class="quick" if="{{ inputMode === 'quick' }}"><text class="quiet">{{ targetName }}</text><div class="step-row"><input class="step" type="button" value="−" onclick="minus" /><text class="show">{{ show }}</text><input class="step" type="button" value="+" onclick="plus" /></div><input class="switch" type="button" value="键盘精确输入" onclick="useKeyboard" /></div><div class="ok {{ saving ? 'saving' : '' }}" onclick="onKeyOk"><image class="ok-icon" src="/common/icons/wear-check-ink.svg" /></div></div></template>
<style>
/* Screens.kt KeypadView, square branch. Source dp/sp ×1.6. */
.page { width: 100%; height: 100%; padding: 7px 10px; background-color: #000000; flex-direction: column; align-items: center; }
.number-row { width: 370px; height: 48px; flex-direction: row; align-items: center; margin-bottom: 4px; }
.cancel { width: 48px; height: 48px; border-radius: 24px; background-color: #2C2C2E; justify-content: center; align-items: center; margin-right: 10px; }
.cancel-icon { width: 18px; height: 18px; }
.keyboard-value { max-width: 260px; height: 48px; line-height: 48px; font-size: 42px; font-weight: bold; color: #FFFFFF; lines: 1; }
.long-value { font-size: 30px; }
.unit { font-size: 19px; color: #8D8D93; margin-left: 5px; }
.notice { width: 350px; font-size: 19px; color: #FF9F0A; lines: 2; }
.grid { width: 370px; flex: 1; min-height: 0px; flex-direction: column; justify-content: space-between; }
.key-row { width: 370px; flex: 1; min-height: 0px; flex-direction: row; justify-content: space-between; margin-bottom: 3px; }
.key { width: 120px; height: 100%; border-radius: 14px; background-color: #2C2C2E; color: #FFFFFF; font-size: 29px; font-weight: bold; }
.symbol { justify-content: center; align-items: center; }
.key-icon { width: 29px; height: 29px; }
.ok { width: 370px; height: 54px; border-radius: 27px; background-color: #A3E635; justify-content: center; align-items: center; margin-top: 3px; }
.ok-icon { width: 27px; height: 27px; }
.saving { opacity: 0.35; }
.quick { width: 350px; flex: 1; min-height: 0px; flex-direction: column; justify-content: center; align-items: center; }
.quiet { width: 350px; color: #8D8D93; font-size: 19px; text-align: center; lines: 2; }
.step-row { width: 350px; height: 120px; align-items: center; justify-content: space-between; }
.step { width: 64px; height: 64px; border-radius: 32px; background-color: #2C2C2E; color: #FFFFFF; font-size: 29px; }
.show { width: 210px; font-size: 52px; color: #A3E635; text-align: center; }
.switch { width: 350px; height: 77px; border-radius: 22px; background-color: #1C1C1E; color: #FFFFFF; font-size: 24px; }
</style>
