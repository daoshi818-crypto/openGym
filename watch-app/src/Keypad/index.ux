<script>
import { bindRuntime } from '../lib/runtime.js'
// 计算器输入页：改重量/次数。路由参数直接使用 exIdx、setIdx、field。
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { loadState, setRowValue } from '../lib/session.js'
import { rotationStep, valueStep } from '../lib/value-step.js'
import { rowTarget } from '../lib/workout-interaction.js'

export default {
  data: {
    show: '0',
    label: '重量',
    unit: 'kg',
    exIdx: 0,
    setIdx: 0,
    field: 'w', inputMode: 'quick', notice: '',
  },

  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    const p = params && typeof params === 'object' ? params : {}
    const s = loadState()
    if (!s.active || !s.workout) { router.back(); return }
    this.state = s
    this.editSid = s.sid; this.editUnit = s.weightUnit || 'kg'
    const target = rowTarget(s, { ...p, exIdx: Number(p.exIdx != null ? p.exIdx : this.exIdx || 0), setIdx: Number(p.setIdx != null ? p.setIdx : this.setIdx || 0) })
    if (!target || target.row.done || s.pausedAt || s.restUntil) { router.back(); return }
    this.exIdx = target.exIdx; this.setIdx = target.setIdx
    this.field = (p.field != null ? p.field : this.field) === 'r' ? 'r' : 'w'
    this.inputMode = p.inputMode === 'keypad' ? 'keypad' : 'quick'
    const row = target.row

    this.entryInstanceId = s.workout.exercises[this.exIdx].entryInstanceId
    this.setId = row.setId
    this.buffer = ''
    this.changed = false
    const cur = this.field === 'w' ? row.w : row.r
    this.initVal = cur === '' || cur == null ? '' : String(cur)
    this.buffer = this.initVal; this.replaceOnDigit = true
    this.show = this.initVal || '—'
    if (this.field === 'w') { this.label = '重量'; this.unit = s.weightUnit || 'kg' }
    else {
      const ex = s.workout.exercises[this.exIdx]
      const timed = ex && String(ex.reps || '').indexOf('秒') >= 0
      this.label = timed ? '时长' : '次数'
      this.unit = timed ? '秒' : '次'
    }
  },

  onKey(k) {
    if (k === 'C') { this.changed = true; this.buffer = ''; this.show = '—'; this.replaceOnDigit = false; return }
    if (k === 'ok') { this.commit(); return }
    if (this.replaceOnDigit) { this.buffer = ''; this.replaceOnDigit = false }
    if (k === '.') {
      if (this.field !== 'w' || this.buffer.indexOf('.') >= 0) return
      if (!this.buffer) this.buffer = '0'
      this.buffer += '.'
    } else {
      if (this.buffer.replace('.', '').length >= 5) return
      this.buffer += k
    }
    this.changed = true
    this.show = this.buffer.endsWith('.') ? this.buffer : String(parseFloat(this.buffer))
  },

  onKey1() { this.onKey('1') },
  onKey2() { this.onKey('2') },
  onKey3() { this.onKey('3') },
  onKey4() { this.onKey('4') },
  onKey5() { this.onKey('5') },
  onKey6() { this.onKey('6') },
  onKey7() { this.onKey('7') },
  onKey8() { this.onKey('8') },
  onKey9() { this.onKey('9') },
  onKey0() { this.onKey('0') },
  onKeyDot() { this.onKey('.') },
  onKeyC() { this.onKey('C') },
  onKeyOk() { this.onKey('ok') },
  onCancel() { router.back() },
  onReady() { this.focusCrown() },
  onShow() { this.focusCrown() },
  focusCrown() { try { this.$element('keypad').requestFocus(true) } catch (e) {} },
  onRotation(ev) { const direction = rotationStep(ev); if (direction) this.adjustDraft(direction) },
  adjustDraft(direction) {
    this.buffer = valueStep(this.buffer, this.field, direction, storage.getSync({ key: 'weight_step' }))
    this.show = this.buffer; this.changed = true; this.replaceOnDigit = false
  },
  minus() { this.adjustDraft(-1) },
  plus() { this.adjustDraft(1) },
  useKeyboard() { this.inputMode = 'keypad' },
  useQuick() { this.inputMode = 'quick' },

  commit() {
    if (!this.changed) { router.back(); return }
    const v = this.buffer === '' ? '' : String(parseFloat(this.buffer) || 0)
    // 编辑期间手机仍可能更新其他行，提交时只改最新会话里的目标字段。
    const s = loadState()
    if (!s.active || s.sid !== this.editSid) { router.back(); return }
    const ex = this.entryInstanceId ? s.workout.exercises.findIndex(e => e.entryInstanceId === this.entryInstanceId) : this.exIdx
    const set = this.setId ? s.workout.rows[ex]?.findIndex(r => r.setId === this.setId) : this.setIdx
    const row = s.workout.rows[ex] && s.workout.rows[ex][set]
    if (!(ex >= 0) || !(set >= 0) || !row || row.done || s.pausedAt || s.restUntil) { this.notice = '目标已变化，未保存'; return }
    const value = this.field === 'w' && this.editUnit !== (s.weightUnit || 'kg') && v !== '' ? Math.round(Number(v) * (this.editUnit === 'lb' ? 0.45359237 : 1 / 0.45359237) * 1000) / 1000 : v
    setRowValue(s, ex, set, this.field, value, true)
    router.back()
  },
}
</script>

<template>
<div class="page" id="keypad" touch-focusable="true" onrotation="onRotation">
  <list class="editor-scroll"><list-item class="editor-content" type="editor">
  <text class="label">{{ label }} · {{ unit }}</text>
  <text class="show">{{ show }}</text>

  <div class="quick" if="{{ inputMode === 'quick' }}">
    <div class="step-row"><input class="step" type="button" value="−" onclick="minus" /><input class="step" type="button" value="+" onclick="plus" /></div>
    <text class="step-hint">每次 {{ field === 'w' ? '按重量步长' : '1' }} · 仅保存后生效</text>
    <input class="switch" type="button" value="数字键盘" onclick="useKeyboard" />
  </div>
  <div class="grid" if="{{ inputMode === 'keypad' }}">
    <input class="k" type="button" value="1" onclick="onKey1" />
    <input class="k" type="button" value="2" onclick="onKey2" />
    <input class="k" type="button" value="3" onclick="onKey3" />
    <input class="k" type="button" value="4" onclick="onKey4" />
    <input class="k" type="button" value="5" onclick="onKey5" />
    <input class="k" type="button" value="6" onclick="onKey6" />
    <input class="k" type="button" value="7" onclick="onKey7" />
    <input class="k" type="button" value="8" onclick="onKey8" />
    <input class="k" type="button" value="9" onclick="onKey9" />
    <input class="k" type="button" value="." onclick="onKeyDot" if="{{ field === 'w' }}" />
    <input class="k" type="button" value="0" onclick="onKey0" />
    <input class="k c" type="button" value="C" onclick="onKeyC" />
  </div>

  <input class="switch" type="button" if="{{ inputMode === 'keypad' }}" value="返回减加" onclick="useQuick" />
  <text class="step-hint" if="{{ notice }}">{{ notice }}</text>
  <div class="actions">
    <input class="cancel" type="button" value="取消" onclick="onCancel" />
    <input class="ok" type="button" value="保存" onclick="onKeyOk" />
  </div>
  </list-item></list>
</div>
</template>

<style>
/* v1.4.4 Wear OS 视觉令牌（逐页同值声明）：#000000 底 / #30D158 主操作 / #1C1C1E 按键
   #FFFFFF 数字 / #A1A1A6 标签 / #FF453A 清除。数值用固定宽高容器，避免位数变化时跳动。 */
.page { flex-direction: column; align-items: center; justify-content: flex-start; width: 100%; height: 100%; background-color: #000000; }
.label { height: 26px; font-size: 18px; color: #A1A1A6; margin-top: 16px; lines: 1; }
.show { height: 58px; width: 350px; font-size: 48px; color: #FFFFFF; text-align: center; line-height: 58px; margin: 2px 0 8px; lines: 1; }
.grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 350px; }
.k { width: 112px; height: 58px; font-size: 26px; border-radius: 14px; background-color: #1C1C1E; color: #FFFFFF; margin: 2px; }
.c { color: #FF453A; }
.actions { width: 350px; height: 52px; flex-direction: row; justify-content: space-between; margin-top: 8px; }
.ok { width: 232px; height: 52px; font-size: 21px; border-radius: 14px; background-color: #30D158; color: #000000; }
.cancel { width: 110px; height: 52px; font-size: 19px; border-radius: 14px; background-color: #1C1C1E; color: #FFFFFF; }
@media screen and (min-width: 450px) {
  .label { margin-top: 12px; font-size: 15px; height: 22px; }
  .show { height: 46px; width: 280px; font-size: 38px; line-height: 46px; margin: 2px 0 6px; }
  .grid { width: 280px; }
  .k { width: 88px; height: 44px; font-size: 22px; margin: 2px; }
  .actions { width: 280px; height: 44px; margin-top: 6px; }
  .ok { width: 184px; height: 44px; font-size: 18px; }
  .cancel { width: 88px; height: 44px; font-size: 17px; }
}
.quick { width: 350px; flex-direction: column; align-items: center; }
.step-row { width: 350px; height: 82px; flex-direction: row; justify-content: space-between; }
.step { width: 164px; height: 76px; font-size: 38px; border-radius: 20px; background-color: #242725; color: #F4F7F5; }
.step-hint { width: 350px; height: 44px; font-size: 18px; text-align: center; color: #929297; lines: 2; }
.switch { width: 350px; height: 44px; font-size: 18px; border-radius: 14px; background-color: #242725; color: #F4F7F5; }
.show { font-size: 76px; height: 92px; line-height: 92px; }
@media screen and (max-height: 420px) { .show { font-size: 72px; height: 88px; line-height: 88px; } .k { height: 44px; } }
@media screen and (min-width: 450px) {
  .quick, .step-row, .switch, .step-hint { width: 280px; }
  .step { width: 132px; height: 52px; }
  .step-row { height: 56px; }
  .show { font-size: 52px; height: 66px; line-height: 66px; }
}
.editor-scroll { width: 100%; height: 100%; }
.editor-content { width: 100%; flex-direction: column; align-items: center; padding-bottom: 16px; }
</style>
