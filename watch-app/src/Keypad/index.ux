<script>
import { bindRuntime } from '../lib/runtime.js'
// 计算器输入页：改重量/次数。路由参数直接使用 exIdx、setIdx、field。
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { loadState, setRowValue, commitSessionAction } from '../lib/session.js'
import { rotationStep, valueStep } from '../lib/value-step.js'
import { rowTarget } from '../lib/workout-interaction.js'

export default {
  data: {
    saving: false,
    show: '0',
    label: '重量',
    unit: 'kg',
    exIdx: 0,
    setIdx: 0,
    field: 'w', inputMode: 'quick', notice: '', targetName: '', stepLabel: '0.5',
  },

  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    const p = params && typeof params === 'object' ? params : {}
    const s = loadState()
    if (!s.active || !s.workout) { router.back(); return }
    this.state = s
    this.editSid = s.sid; this.editUnit = s.weightUnit || 'kg'
    const target = rowTarget(s, { ...p, exIdx: Number(p.exIdx != null ? p.exIdx : this.exIdx || 0), setIdx: Number(p.setIdx != null ? p.setIdx : this.setIdx || 0) })
    if (!target || target.row.done || s.pausedAt || s.restUntil) { router.back(); return }
    this.exIdx = target.exIdx; this.setIdx = target.setIdx
    this.field = (p.field != null ? p.field : this.field) === 'r' ? 'r' : 'w'
    this.inputMode = p.inputMode === 'keypad' ? 'keypad' : 'quick'
    this.targetName = s.workout.exercises[target.exIdx].name
    const row = target.row

    this.entryInstanceId = s.workout.exercises[this.exIdx].entryInstanceId
    this.setId = row.setId
    this.buffer = ''
    this.changed = false
    const cur = this.field === 'w' ? row.w : row.r
    this.initVal = cur === '' || cur == null ? '' : String(cur)
    this.buffer = this.initVal; this.replaceOnDigit = true
    this.show = this.initVal || '—'
    if (this.field === 'w') { this.label = '重量'; this.unit = s.weightUnit || 'kg' }
    else {
      const ex = s.workout.exercises[this.exIdx]
      const timed = ex && String(ex.reps || '').indexOf('秒') >= 0
      this.label = timed ? '时长' : '次数'
      this.unit = timed ? '秒' : '次'
    }
    const step = Number(storage.getSync({ key: 'weight_step' }))
    this.stepLabel = this.field === 'w' ? String(Number.isFinite(step) && step >= 0.001 ? Math.round(step * 1000) / 1000 : 0.5) : '1'
  },

  onKey(k) {
    if (k === 'C') { this.changed = true; this.buffer = ''; this.show = '—'; this.replaceOnDigit = false; return }
    if (k === 'ok') { this.commit(); return }
    if (this.replaceOnDigit) { this.buffer = ''; this.replaceOnDigit = false }
    if (k === '.') {
      if (this.field !== 'w' || this.buffer.indexOf('.') >= 0) return
      if (!this.buffer) this.buffer = '0'
      this.buffer += '.'
    } else {
      if (this.buffer.replace('.', '').length >= 5) return
      this.buffer += k
    }
    this.changed = true
    this.show = this.buffer.endsWith('.') ? this.buffer : String(parseFloat(this.buffer))
  },

  decimalOrClear() {
    if (this.field === 'w') { this.onKey('.'); return }
    this.buffer = this.buffer.slice(0, -1); this.changed = true; this.replaceOnDigit = false
    this.show = this.buffer || '—'
  },
  onKey1() { this.onKey('1') },
  onKey2() { this.onKey('2') },
  onKey3() { this.onKey('3') },
  onKey4() { this.onKey('4') },
  onKey5() { this.onKey('5') },
  onKey6() { this.onKey('6') },
  onKey7() { this.onKey('7') },
  onKey8() { this.onKey('8') },
  onKey9() { this.onKey('9') },
  onKey0() { this.onKey('0') },
  onKeyDot() { this.onKey('.') },
  onKeyC() { this.onKey('C') },
  onKeyOk() { this.onKey('ok') },
  onCancel() { router.back() },
  onReady() { this.focusCrown() },
  onShow() { this.focusCrown() },
  focusCrown() { try { this.$element('keypad').requestFocus(true) } catch (e) {} },
  onRotation(ev) { const direction = rotationStep(ev); if (direction) this.adjustDraft(direction) },
  adjustDraft(direction) {
    this.buffer = valueStep(this.buffer, this.field, direction, storage.getSync({ key: 'weight_step' }))
    this.show = this.buffer; this.changed = true; this.replaceOnDigit = false
  },
  minus() { this.adjustDraft(-1) },
  plus() { this.adjustDraft(1) },
  useKeyboard() { this.inputMode = 'keypad' },
  useQuick() { this.inputMode = 'quick' },

  async commit() {
    if (!this.changed) { router.back(); return }
    const v = this.buffer === '' ? '' : String(parseFloat(this.buffer) || 0)
    // 编辑期间手机仍可能更新其他行，提交时只改最新会话里的目标字段。
    const s = loadState()
    if (!s.active || s.sid !== this.editSid) { router.back(); return }
    const ex = this.entryInstanceId ? s.workout.exercises.findIndex(e => e.entryInstanceId === this.entryInstanceId) : this.exIdx
    const set = this.setId ? s.workout.rows[ex]?.findIndex(r => r.setId === this.setId) : this.setIdx
    const row = s.workout.rows[ex] && s.workout.rows[ex][set]
    if (!(ex >= 0) || !(set >= 0) || !row || row.done || s.pausedAt || s.restUntil) { this.notice = '目标已变化，未保存'; return }
    if (this.saving) return
    this.saving = true
    try {
    const result = await commitSessionAction(s.sid, latest => {
      const ix = this.entryInstanceId ? latest.workout.exercises.findIndex(e => e.entryInstanceId === this.entryInstanceId) : ex
      const iy = this.setId ? latest.workout.rows[ix]?.findIndex(r => r.setId === this.setId) : set
      const target = latest.workout.rows[ix]?.[iy]
      if (!target || target.done || latest.pausedAt || latest.restUntil) throw new Error('target_changed')
      const value = this.field === 'w' && this.editUnit !== (latest.weightUnit || 'kg') && v !== '' ? Math.round(Number(v) * (this.editUnit === 'lb' ? 0.45359237 : 1 / 0.45359237) * 1000) / 1000 : v
      setRowValue(latest, ix, iy, this.field, value, true)
    })
    if (!result.ok) { this.notice = '存储失败，未保存，请重试'; return }
    router.back()
    } catch { this.notice = '存储失败，未保存，请重试' } finally { this.saving = false }
  },
}
</script>

<template>
<div class="page" id="keypad" touch-focusable="true" onrotation="onRotation">
  <list class="editor-scroll"><list-item class="editor-content {{ inputMode === 'keypad' ? 'keyboard-content' : '' }}" type="editor">
    <text class="label" if="{{ inputMode !== 'keypad' }}">编辑{{ label }} · {{ unit }}</text>
    <text class="label keyboard-label {{ notice ? 'notice-label' : '' }}" if="{{ inputMode === 'keypad' }}">{{ notice || ('编辑' + label + ' · ' + unit + ' · 第 ' + (setIdx + 1) + ' 组') }}</text>
    <text class="edit-target {{ inputMode === 'keypad' ? 'keyboard-target' : '' }}">{{ targetName }}</text><text class="edit-group" if="{{ inputMode !== 'keypad' }}">第 {{ setIdx + 1 }} 组</text>
    <div class="quick" if="{{ inputMode === 'quick' }}"><div class="step-row"><input class="step" type="button" value="−" onclick="minus" /><text class="show {{ show.length > 8 ? 'extra-long-value' : show.length > 5 ? 'long-value' : '' }}">{{ show }}</text><input class="step" type="button" value="+" onclick="plus" /></div><text class="step-hint">{{ unit }} · 每次 ±{{ stepLabel }}</text><input class="switch" type="button" value="键盘精确输入" onclick="useKeyboard" /></div>
    <text class="keyboard-value {{ show.length > 8 ? 'keyboard-long-value' : '' }}" if="{{ inputMode === 'keypad' }}">{{ show }} {{ unit }}</text>
    <div class="grid" if="{{ inputMode === 'keypad' }}">
      <input class="k" type="button" value="1" onclick="onKey1" /><input class="k" type="button" value="2" onclick="onKey2" /><input class="k" type="button" value="3" onclick="onKey3" /><input class="k" type="button" value="4" onclick="onKey4" /><input class="k" type="button" value="5" onclick="onKey5" /><input class="k" type="button" value="6" onclick="onKey6" /><input class="k" type="button" value="7" onclick="onKey7" /><input class="k" type="button" value="8" onclick="onKey8" /><input class="k" type="button" value="9" onclick="onKey9" /><div class="k key-symbol" onclick="decimalOrClear"><text class="decimal" if="{{ field === 'w' }}">.</text><image class="key-icon" if="{{ field !== 'w' }}" src="/common/icons/backspace.svg" /></div><input class="k" type="button" value="0" onclick="onKey0" /><input class="k c" type="button" value="清空" onclick="onKeyC" />
    </div>
    <input class="switch keyboard-switch" type="button" if="{{ inputMode === 'keypad' }}" value="返回减加" onclick="useQuick" /><text class="notice" if="{{ notice && inputMode !== 'keypad' }}">{{ notice }}</text>
  </list-item></list>
  <div class="actions"><input class="cancel" type="button" value="取消" onclick="onCancel" /><input class="ok" type="button" value="{{ saving ? '保存中' : '保存' }}" disabled="{{ saving }}" onclick="onKeyOk" /></div>
</div>
</template>

<style>
/* Explicit-save drafts. Large keys scroll; Save/Cancel always stay outside the scroll viewport. */
.page { width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; }
.editor-scroll { width: 338px; flex: 1; min-height: 0px; margin-top: 32px; }
.editor-content { width: 100%; min-height: 0px; flex-direction: column; align-items: center; padding-bottom: 16px; }
.label { width: 314px; height: 36px; margin-top: 18px; font-size: 22px; color: #929297; }
.edit-target { width: 338px; height: 64px; line-height: 32px; font-size: 28px; font-weight: bold; color: #FFFFFF; lines: 2; }
.edit-group { width: 338px; height: 32px; font-size: 21px; color: #929297; }
.quick { width: 338px; flex-direction: column; align-items: center; }
.step-row { width: 338px; height: 112px; flex-direction: row; justify-content: space-between; align-items: center; }
.step { width: 64px; height: 64px; border-radius: 32px; font-size: 36px; background-color: #242725; color: #FFFFFF; }
.show { width: 194px; height: 100px; line-height: 100px; font-size: 64px; color: #30D158; text-align: center; lines: 1; }
.long-value { font-size: 40px; }
.extra-long-value { font-size: 28px; }
.step-hint { width: 338px; height: 36px; font-size: 20px; color: #929297; text-align: center; }
.switch { width: 338px; height: 60px; border-radius: 30px; font-size: 23px; background-color: #161D18; color: #FFFFFF; }
.actions { width: 338px; height: 64px; margin-top: 8px; flex-direction: row; justify-content: space-between; margin-bottom: 24px; flex-shrink: 0; }
.cancel { width: 146px; height: 64px; border-radius: 32px; font-size: 25px; background-color: #242725; color: #FFFFFF; }
.ok { width: 182px; height: 64px; border-radius: 32px; font-size: 25px; background-color: #0A3418; color: #30D158; }
.keyboard-content { padding-bottom: 20px; }
.keyboard-label { height: 36px; margin-top: 18px; font-size: 21px; lines: 2; }
.keyboard-target { height: 64px; line-height: 32px; font-size: 28px; }
.keyboard-value { width: 338px; height: 64px; font-size: 48px; color: #30D158; text-align: center; lines: 1; }
.keyboard-long-value { font-size: 30px; }
.keyboard-switch { height: 56px; font-size: 23px; }
.notice-label { color: #FF9F0A; }
.grid { width: 338px; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.k { width: 106px; height: 60px; margin-bottom: 8px; font-size: 32px; border-radius: 28px; background-color: #1C1C1E; color: #FFFFFF; }
.key-symbol { justify-content: center; align-items: center; }
.key-icon { width: 30px; height: 30px; }
.decimal { color: #FFFFFF; font-size: 25px; }
.c { color: #FF453A; }
.notice { width: 338px; min-height: 44px; color: #FF9F0A; font-size: 22px; lines: 2; }

@media screen and (min-width: 450px) {

 .editor-scroll { width: 300px; margin-top: 58px; }
 .editor-content { width: 300px; }
 .label { width: 300px; margin-top: 0px; }
 .edit-target, .edit-group, .quick, .step-row, .step-hint, .switch, .actions, .keyboard-value, .grid, .notice { width: 300px; }
 .show { width: 156px; font-size: 52px; }
 .long-value { font-size: 34px; }
 .extra-long-value { font-size: 24px; }
 .actions { margin-bottom: 58px; }
 .cancel { width: 128px; }
 .ok { width: 160px; }
 .k { width: 94px; }

}
</style>
