<script>
// 主训练页（单屏 + 手势）：重量/次数保持可见，休息态只保留必要操作。
import router from '@blueos.app.appmanager.router'
import brightness from '@blueos.hardware.display.brightness'
import {
  loadState, save, replacePlan, applySync, toggleSet, nextUndone,
  addHr, flushHr, endSession, closeSession, addSet, removeSet, addRestTime, setRowValue, calories,
} from '../lib/session.js'
import { startHr, stopHr, tick, restOver } from '../lib/sensors.js'
import { startServer, sendEvent, sendControl, pendingCount, isConnected } from '../lib/rpc.js'
import { applyFocus, applyRest, restOf } from '../lib/protocol.js'

export default {
  data: {
    exName: '',
    groupLabel: '',
    setProgressLabel: '',
    elapsedLabel: '',
    clockLabel: '',
    weightVal: '—',
    repsVal: '—',
    restLabel: '0:00',
    restTotalLabel: '0:00',
    restProgLabel: '',
    restExerciseName: '',
    nextLabel: '',
    nextDetails: '',
    hrLabel: '♥ --',
    syncLabel: '',
    isRest: false,
    menuOn: false,
    leaveChoice: false,
    allFinished: false,
    rowDone: false,
    kcalLabel: '0',
    volumeLabel: '0',
    pageIndex: 0,
    closeMode: '',
    paused: false,
    pauseLabel: '暂停训练',
  },

  onInit() {
    const s = loadState()
    if (!s.active || !s.workout) { router.push({ uri: '/Index' }); return }
    this.state = s
    this.profile = s.profile || null
    this.restSeq = 0
    this.remoteRestSeq = 0
    this.restStartAt = 0
    this.hrLast = 0
    this.hrDirty = false
    this.hrActive = false
    this.clockPeriod = 0
    this.touch = null
    this.restCrownTimer = null
    this.restCrownDirty = false
    this.visible = true

    this.bindRpc()

    // 保存的游标就是当前组；nextUndone 仅用于完成后找下一组。
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))

    if (s.restUntil && s.restUntil <= Date.now()) {
      s.restUntil = 0
      save(s)
      restOver()
    }
    this.setRestScreenLock(!!s.restUntil)

    this.hrFlush = setInterval(() => {
      if (this.hrDirty) {
        flushHr(this.state)
        this.hrDirty = false
      }
    }, 15000)

    this.startHrCapture()
    this.refresh()
  },

  onShow() {
    this.visible = true
    // Keypad/动作列表独立读取并保存会话，返回训练页时重新读取，确保重量立即回显。
    const latest = loadState()
    if (!latest.active || !latest.workout) { this.stopHrCapture(); router.replace({ uri: '/Index' }); return }
    if (latest.active && latest.workout) {
      this.state = latest
      this.profile = latest.profile || null
    }
    if (this.state) this.bindRpc()
    // 熄屏时系统可能暂停 JS 定时器，回到页面先按绝对截止时间校准。
    this.reconcileRestClock()
    // 与输入页通过持久化状态交接，使用当前连接的可靠事件队列发送。
    const edits = this.state && this.state.pendingEdits || []
    for (const edit of edits) this.emitEvent(edit)
    this.startHrCapture()
    this.refresh()
    this.focusCrown()
  },

  onReady() {
    this.displayReady = true
    this.setRestScreenLock(this.visible !== false && !!(this.state && this.state.restUntil))
    this.focusCrown()
  },
  focusCrown() {
    try { this.$element('training').requestFocus(true) } catch (e) {}
  },
  onRotation(ev) {
    if (!ev || this.visible === false || ev.state === 3 || this.menuOn || this.closeMode || this.pageIndex || this.paused) return
    const delta = Number(ev.delta) || (ev.direction === true ? 1 : ev.direction === false ? -1 : 0)
    if (!delta) return
    if (this.isRest || this.restCrownDirty) this.queueRestNudge(delta > 0 ? 5 : -5)
    else this.stepSet(delta > 0 ? 1 : -1)
  },
  onBackPress() {
    if (this.closeMode) this.cancelClose()
    else if (this.menuOn) this.menuOn = false
    else if (this.pageIndex) this.pageIndex = 0
    else this.openExercises()
    return true
  },
  openMenu() { this.menuOn = true; this.leaveChoice = false },
  openActions() { if (!this.isRest) this.pageIndex = 1; this.menuOn = false },
  openExercises() { router.push({ uri: '/ExerciseList' }) },

  bindRpc() {
    const handle = (method, ...args) => {
      // 隐藏的训练页仍会收到 RPC；保留输入页刚保存的编辑和其他页面的更新。
      const latest = loadState()
      if (latest.active && latest.sid === this.state.sid) {
        if (this.restCrownDirty) {
          latest.restUntil = this.state.restUntil; latest.restTargetSec = this.state.restTargetSec
          latest.restVersion = this.state.restVersion; latest.restId = this.state.restId
          latest.restStartedAt = this.state.restStartedAt
        }
        this.state = latest
      }
      return this[method](...args)
    }
    startServer({
      onPlan: (msg) => handle('onPlanUpdate', msg),
      onSync: (msg) => handle('onSyncUpdate', msg),
      onRest: (msg) => handle('onRemoteRest', msg),
      onPause: (msg) => handle('onRemotePause', msg),
      onStartAck: msg => {
        if (msg.status === 'conflict') { this.syncLabel = '手机已有训练'; router.replace({ uri: '/Index', params: { conflict: JSON.stringify(msg.snapshot) } }) }
      },
      onSet: (msg) => handle('onRemoteSet', msg),
      onUnset: (msg) => handle('onRemoteUnset', msg),
      onWeight: (msg) => handle('onRemoteValue', msg, 'w'),
      onReps: (msg) => handle('onRemoteValue', msg, 'r'),
      onAddSet: (msg) => handle('onRemoteAddSet', msg),
      onRemoveSet: (msg) => handle('onRemoteRemoveSet', msg),
      onFocus: (msg) => handle('onRemoteFocus', msg),
      onEnded: () => this.onRemoteEnded(),
      onError: () => { this.syncLabel = '连接异常' },
    })
  },

  onHide() {
    this.visible = false
    this.flushRestNudge()
    this.setRestScreenLock(false)
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    this.stopHrCapture()
  },

  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    this.flushRestNudge()
    if (this.hrFlush) clearInterval(this.hrFlush)
    this.stopHrCapture()
    this.setRestScreenLock(false)
  },

  setRestScreenLock(keepOn) {
    if (!this.displayReady) return
    keepOn = !!keepOn
    if (this.screenLocked === keepOn) return
    this.screenLocked = keepOn
    try {
      brightness.setKeepScreenOn({ keepScreenOn: keepOn, success() {}, fail: (data, code) => {
        this.screenLocked = null
        console.log('rest screen lock failed', code)
      } })
    } catch (e) { this.screenLocked = null }
  },

  startHrCapture() {
    if (this.hrActive || !this.state || !this.state.active || this.state.pausedAt) return
    this.hrActive = true
    startHr((bpm) => {
      addHr(this.state, bpm)
      this.hrLast = bpm
      this.hrDirty = true
    })
  },

  stopHrCapture() {
    if (!this.hrActive) return
    stopHr()
    this.hrActive = false
    if (this.hrDirty && this.state) {
      flushHr(this.state)
      this.hrDirty = false
    }
  },

  touchStart(e) {
    const t = e.touches && e.touches[0]
    this.touch = t ? { x: t.clientX, y: t.clientY } : null
    this.touchLast = this.touch
  },

  touchMove(e) {
    if (!this.touch) return
    const t = e.touches && e.touches[0]
    if (t) this.touchLast = { x: t.clientX, y: t.clientY }
  },

  touchEnd(e) {
    if (!this.touch) return
    // 固件触摸回调未必带 changedTouches，用最后一次 move 的坐标兜底。
    const t = e.changedTouches && e.changedTouches[0] || e.touches && e.touches[0]
    const end = t ? { x: t.clientX, y: t.clientY } : this.touchLast
    const start = this.touch
    this.touchCancel()
    if (!end) return
    const dx = end.x - start.x
    const dy = end.y - start.y
    if (Math.abs(dx) < 60 && Math.abs(dy) < 60) return
    if (this.closeMode) return
    if (this.isRest) {
      if (dx > 60 && Math.abs(dx) > Math.abs(dy)) this.openExercises()
      return
    }
    if (this.menuOn) {
      if (dy > 60) this.menuOn = false
      return
    }
    if (Math.abs(dx) > Math.abs(dy)) {
      // 右滑打开动作列表，左滑切换训练与操作页。
      if (dx > 60) this.openExercises()
      else if (dx < -60) this.pageIndex = this.pageIndex ? 0 : 1
    } else {
      // 上下滑动切换两页。
      if (dy < -60) this.pageIndex = 1
      else if (dy > 60) this.pageIndex = 0
    }
  },

  touchCancel() { this.touch = null; this.touchLast = null },

  closeMenu() { this.menuOn = false },

  continueTraining() { this.leaveChoice = false },

  leaveTraining() {
    this.leaveChoice = false
    this.stopHrCapture()
    save(this.state)
    router.push({ uri: '/Index' })
  },

  onMenuAddSet() {
    const s = this.state
    const ex = s.exIdx
    addSet(s, ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    s.setIdx = rows.length - 1
    this.menuOn = false
    this.emitEvent({ t: 'add_set', sid: s.sid, ex, set: s.setIdx + 1, sets: rows.length, weight: rows[s.setIdx].w, reps: rows[s.setIdx].r, at: Date.now() })
    this.refresh()
  },

  onMenuRemoveSet() {
    const s = this.state
    const ex = s.exIdx
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1 || rows[rows.length - 1].done) { this.menuOn = false; return }
    const removed = rows.length
    removeSet(s, ex)
    this.menuOn = false
    this.emitEvent({ t: 'remove_set', sid: s.sid, ex, set: removed, sets: rows.length, at: Date.now() })
    this.refresh()
  },

  onMenuPrev() { this.menuOn = false; this.stepSet(-1) },
  onMenuNext() { this.menuOn = false; this.stepSet(1) },

  stepSet(dir) {
    const s = this.state
    if (!s.workout || !s.workout.rows.length) return
    let nx = s.exIdx
    let ni = s.setIdx + dir
    while (nx >= 0 && nx < s.workout.rows.length) {
      const rows = s.workout.rows[nx] || []
      if (ni >= 0 && ni < rows.length) break
      nx += dir
      if (nx < 0 || nx >= s.workout.rows.length) return
      ni = dir > 0 ? 0 : (s.workout.rows[nx] || []).length - 1
    }
    if (nx < 0 || nx >= s.workout.rows.length || ni < 0) return
    s.exIdx = nx; s.setIdx = ni
    save(s)
    s.focusAt = Date.now(); save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, ex: nx, set: ni + 1, at: s.focusAt, source: 'watch' })
    this.refresh()
  },

  stepExercise(dir) {
    const s = this.state
    if (!s.workout || !s.workout.exercises.length) return
    const nx = Math.max(0, Math.min(s.exIdx + dir, s.workout.exercises.length - 1))
    if (nx === s.exIdx) return
    const rows = s.workout.rows[nx] || []
    const first = rows.findIndex(r => !r.done)
    s.exIdx = nx
    s.setIdx = first >= 0 ? first : 0
    save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, ex: nx, set: s.setIdx + 1, at: Date.now(), source: 'watch' })
    this.refresh()
  },

  onPrevSet() { this.stepSet(-1) },
  onNextSet() { this.stepSet(1) },

  editWeight() {
    if (this.isRest || this.paused || this.isDoneRowCur()) return
    router.push({ uri: '/Keypad', params: { exIdx: this.state.exIdx, setIdx: this.state.setIdx, field: 'w' } })
  },

  editReps() {
    if (this.isRest || this.paused || this.isDoneRowCur()) return
    router.push({ uri: '/Keypad', params: { exIdx: this.state.exIdx, setIdx: this.state.setIdx, field: 'r' } })
  },

  onComplete() {
    if (this.isRest || this.paused || this.closeMode) return
    const s = this.state
    const exIdx = s.exIdx, setIdx = s.setIdx
    const current = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!current || current.done) return
    const row = toggleSet(s, true)
    if (!row) return
    this.restStartAt = Date.now()
    this.setRestScreenLock(!!s.restUntil)
    this.emitEvent({ t: 'set', sid: s.sid, ex: exIdx, set: setIdx + 1, reps: row.r != null ? String(row.r) : '', weight: row.w != null ? String(row.w) : '', at: row.at, rest: restOf(s) })
    tick()
    const next = nextUndone(s)
    if (next) {
      s.exIdx = next.exIdx; s.setIdx = next.setIdx; save(s)
      this.emitEvent({ t: 'focus', sid: s.sid, ex: next.exIdx, set: next.setIdx + 1, at: Date.now(), source: 'watch' })
    }
    else this.allFinished = true
    this.refresh()
  },

  onUndo() {
    const s = this.state
    const exIdx = s.exIdx, setIdx = s.setIdx
    const row = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!row || !row.done) return
    toggleSet(s, false)
    this.cancelRestNudge()
    this.restStartAt = 0
    this.allFinished = false
    this.emitEvent({ t: 'unset', sid: s.sid, ex: exIdx, set: setIdx + 1, at: Date.now() })
    this.refresh()
  },

  onCurrentSetAction() {
    if (this.closeMode) return
    if (this.rowDone) this.onUndo()
    else this.onComplete()
  },

  onRemoteSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || row.done) return
    row.done = true
    row.at = Date.now()
    this.allFinished = s.workout.rows.every(rows => rows.every(r => r.done))
    save(s)
    this.refresh()
  },

  onRemoteUnset(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || !row.done) return
    row.done = false
    row.at = 0
    this.allFinished = false
    save(s)
    this.refresh()
  },

  onRemoteValue(msg, field) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const value = field === 'w' ? msg.weight : msg.reps
    const type = field === 'w' ? 'weight' : 'reps'
    // 回传关联编辑时间戳，旧快照/旧确认不能覆盖更新的本地输入。
    s.pendingEdits = (s.pendingEdits || []).filter(edit => !(edit.t === type &&
      edit.ex === msg.ex && edit.set === msg.set && msg.editAt != null && edit.at <= msg.editAt))
    const pending = s.pendingEdits.filter(edit => edit.t === type && edit.ex === msg.ex && edit.set === msg.set)
    const latest = pending[pending.length - 1]
    setRowValue(s, msg.ex, msg.set - 1, field, latest ? latest[type] : value)
    this.refresh()
  },

  onRemoteAddSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length + 1
    if (target <= rows.length || target > 100) return
    while (rows.length < target) addSet(s, ex)
    const i = rows.length - 1
    if (msg.weight != null && msg.weight !== '') rows[i].w = msg.weight
    if (msg.reps != null && msg.reps !== '') rows[i].r = msg.reps
    save(s)
    this.refresh()
  },

  onRemoteRemoveSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length - 1
    if (target < 1 || target >= rows.length) return
    if (rows.slice(target).some(r => r.done)) return
    rows.splice(target)
    s.workout.exercises[ex].sets = rows.length
    if (s.exIdx === ex && s.setIdx >= rows.length) s.setIdx = rows.length - 1
    save(s)
    this.refresh()
  },

  onRemoteFocus(msg) {
    const s = this.state
    if (!applyFocus(s, msg)) return
    save(s)
    this.refresh()
  },

  onSyncUpdate(msg) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    const localRest = this.restCrownDirty && (!msg.sid || msg.sid === this.state.sid)
    const localRound = localRest ? { restUntil: this.state.restUntil, restTargetSec: this.state.restTargetSec,
      restVersion: this.state.restVersion, restId: this.state.restId, restStartedAt: this.state.restStartedAt } : null
    if (!localRest) this.cancelRestNudge()
    applySync(this.state, msg)
    if (localRound) Object.assign(this.state, localRound)
    this.profile = this.state.profile || this.profile
    if (this.state.pausedAt) this.stopHrCapture()
    else this.startHrCapture()
    this.allFinished = (this.state.workout.rows || []).every(rows => rows.every(r => r.done))
    this.refresh()
    return { status: 'applied', page: 'Workout', exercises: this.state.workout.exercises.length }
  },

  onRemoteEnded() {
    this.cancelRestNudge()
    this.setRestScreenLock(false)
    this.hrDirty = false
    this.state = loadState()
    this.stopHrCapture()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    router.replace({ uri: '/Index' })
  },

  onSkipRest() {
    this.cancelRestNudge()
    const s = this.state
    if (s.restUntil && this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
    s.restUntil = 0
    this.restStartAt = 0
    this.setRestScreenLock(false)
    this.restSeq += 1
    s.restVersion = Math.max(Date.now(), (s.restVersion || 0) + 1); s.restTargetSec = 0; s.restLeftSec = 0
    this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) })
    save(s)
    this.refresh()
  },

  nudgeRest(deltaSec) {
    this.applyRestNudge(deltaSec)
    this.flushRestNudge()
  },

  queueRestNudge(deltaSec) {
    if (!this.state || !this.state.restUntil || !deltaSec) return
    this.applyRestNudge(deltaSec)
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    // 旋转回调只改截止时间和数字，停转后才写存储/发 RPC，避免堵塞手表线程。
    this.restCrownTimer = setTimeout(() => {
      this.flushRestNudge()
    }, 300)
  },

  cancelRestNudge() {
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    this.restCrownTimer = null
    this.restCrownDirty = false
  },

  flushRestNudge() {
    const dirty = this.restCrownDirty
    this.cancelRestNudge()
    const s = this.state
    if (!dirty || !s || !s.active) return
    const left = Math.max(0, Math.ceil((s.restUntil - Date.now()) / 1000))
    s.restVersion = Math.max(Date.now(), (s.restVersion || 0) + 1)
    save(s)
    this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) })
  },

  applyRestNudge(deltaSec) {
    const s = this.state
    if (!s || !s.active || !s.restUntil || !Number.isFinite(deltaSec)) return
    const now = Date.now()
    const target = Math.min(now + 900000, s.restUntil + deltaSec * 1000)
    s.restTargetSec = Math.max(0, Math.min(900, (s.restTargetSec || 0) + (target - s.restUntil) / 1000))
    s.restVersion = Math.max(now, (s.restVersion || 0) + 1)
    this.restCrownDirty = true
    if (target <= now) {
      if (this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
      s.restUntil = 0
      this.restStartAt = 0
      this.setRestScreenLock(false)
      this.isRest = false
      this.syncClockTimer()
    } else {
      s.restUntil = target
    }
    this.restLabel = this.mmss(Math.max(0, Math.ceil((s.restUntil - now) / 1000)))
    this.restTotalLabel = this.mmss(s.restTargetSec)
  },

  onRestMinus() { this.nudgeRest(-15) },
  onRestPlus() { this.nudgeRest(15) },

  reconcileRestClock() {
    const s = this.state
    if (!s || !s.restUntil || s.restUntil > Date.now()) return
    if (this.restStartAt) addRestTime(s, (s.restUntil - this.restStartAt) / 1000)
    this.cancelRestNudge()
    s.restUntil = 0
    this.restStartAt = 0
    this.setRestScreenLock(false)
    save(s)
    restOver()
  },

  onPlanUpdate(msg) {
    const s = this.state
    if (msg && msg.sid && s.sid && msg.sid !== s.sid) {
      return { status: 'rejected', page: 'Workout', reason: 'session_mismatch', activeSid: s.sid }
    }
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    if (msg && msg.profile) s.profile = msg.profile
    replacePlan(s, { name: msg.workout, exercises: msg.exercises })
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))
    save(s)
    this.refresh()
    return { status: 'applied', page: 'Workout', exercises: s.workout.exercises.length }
  },

  onRemoteRest(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    if (this.restCrownDirty) return
    if (!applyRest(s, msg)) return
    save(s)
    this.refresh()
  },

  isDoneRowCur() {
    const s = this.state
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    this.rowDone = !!(row && row.done)
    return !!(row && row.done)
  },

  refresh() {
    const s = this.state
    if (!s || !s.workout) return
    this.reconcileRestClock()
    this.setRestScreenLock(this.visible !== false && !!s.restUntil)
    this.rowDone = this.isDoneRowCur()
    const ex = s.workout.exercises[s.exIdx]
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    this.exName = ex ? ex.name : ''
    this.groupLabel = ex ? '第 ' + (s.setIdx + 1) + ' / ' + (ex.sets || 1) + ' 组' : ''
    this.weightVal = row && row.w !== '' && row.w != null ? row.w + ' kg' : '—'
    this.repsVal = row && row.r !== '' && row.r != null ? row.r + (this.isTimed(ex) ? ' 秒' : ' 次') : '—'
    this.isRest = !!s.restUntil
    if (this.isRest) this.pageIndex = 0
    this.paused = !!s.pausedAt
    this.pauseLabel = this.paused ? '继续训练' : '暂停训练'

    // 完成后游标已前进；休息提示优先展示当前待做组，避免跳过一组。
    const next = row && !row.done ? { exIdx: s.exIdx, setIdx: s.setIdx } : nextUndone(s)
    const totalSets = s.workout.rows.reduce((n, r) => n + r.length, 0)
    const doneSets = s.workout.rows.reduce((n, r) => n + r.filter(x => x.done).length, 0)
    this.checkCompletion(totalSets, doneSets)
    this.setProgressLabel = '完成 ' + doneSets + ' / 剩余 ' + Math.max(0, totalSets - doneSets) + ' 组'
    let completedVolume = 0
    s.workout.rows.forEach((rows, exIdx) => {
      if (this.isTimed(s.workout.exercises[exIdx])) return
      rows.forEach(r => {
        const weight = parseFloat(r.w), reps = parseFloat(r.r)
        if (r.done && Number.isFinite(weight) && Number.isFinite(reps)) completedVolume += weight * reps
      })
    })
    this.volumeLabel = this.formatVolume(completedVolume)
    this.restProgLabel = '✓ ' + doneSets + '/' + totalSets + ' 组'
    let completed = null
    s.workout.rows.forEach((rows, exIdx) => rows.forEach((r, setIdx) => {
      if (r.done && (!completed || r.at > completed.at)) completed = { exIdx, setIdx, at: r.at || 0 }
    }))
    this.restExerciseName = completed
      ? s.workout.exercises[completed.exIdx].name
      : this.exName
    if (next) {
      const ne = s.workout.exercises[next.exIdx]
      const nr = s.workout.rows[next.exIdx][next.setIdx]
      const w = nr && nr.w !== '' && nr.w != null ? nr.w + 'kg' : ''
      const timed = ne && String(ne.reps || '').indexOf('秒') >= 0
      const r = nr && nr.r !== '' && nr.r != null ? nr.r + (timed ? '秒' : '次') : ''
      this.nextLabel = next.exIdx !== (completed ? completed.exIdx : s.exIdx) ? '下一动作 · ' + ne.name : '下一组'
      this.nextDetails = '第 ' + (next.setIdx + 1) + ' / ' + (s.workout.rows[next.exIdx] || []).length + ' 组 · ' + (w && r ? w + ' × ' + r : (w || r || '待填写'))
    } else { this.nextLabel = '本次训练已完成'; this.nextDetails = this.restProgLabel }

    this.syncClockTimer()
    this.tickClock()
  },

  isTimed(ex) { return ex && String(ex.reps || '').indexOf('秒') >= 0 },

  checkCompletion(total, done) {
    this.allFinished = total > 0 && done === total
    if (!this.allFinished) {
      if (this.state.completionAcknowledged) {
        this.state.completionAcknowledged = false
        save(this.state)
      }
      if (this.closeMode === 'complete') this.closeMode = ''
      return
    }
    if (this.visible === false || !this.state.active || this.state.completionAcknowledged || this.closeMode) return
    this.menuOn = false
    this.closeMode = 'complete'
    this.completionIgnoreUntil = Date.now() + 400
    this.touchCancel()
    this.focusCrown()
  },

  formatVolume(value) {
    return String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
  },

  syncClockTimer() {
    if (this.visible === false) return
    const period = this.state && this.state.restUntil ? 250 : 1000
    if (this.timer && this.clockPeriod === period) return
    if (this.timer) clearInterval(this.timer)
    this.clockPeriod = period
    this.timer = setInterval(() => this.tickClock(), period)
  },

  tickClock() {
    const s = this.state
    if (!s || !s.workout) return
    const currentTime = new Date()
    this.clockLabel = String(currentTime.getHours()).padStart(2, '0') + ':' + String(currentTime.getMinutes()).padStart(2, '0')
    if (Date.now() - (s.segmentStartedAt || s.startedAt) >= 21600000) { loadState(); this.onRemoteEnded(); return }
    const elapsed = Math.max(0, (s.pausedAt || Date.now()) - s.startedAt - (s.pausedMs || 0))
    const mins = Math.floor(elapsed / 60000)
    const secs = Math.floor((elapsed % 60000) / 1000)
    this.elapsedLabel = mins + ':' + String(secs).padStart(2, '0')

    const left = s.restUntil ? Math.ceil((s.restUntil - Date.now()) / 1000) : 0
    if (s.restUntil && left <= 0) {
      this.reconcileRestClock()
      this.refresh()
      return
    }
    this.restLabel = this.mmss(left)
    if (this.metricSecond === Math.floor(Date.now() / 1000)) return
    this.metricSecond = Math.floor(Date.now() / 1000)
    this.restTotalLabel = this.mmss(Math.round(s.restTargetSec || 0))
    this.hrLabel = this.hrLast ? '♥ ' + this.hrLast : '♥ --'
    this.kcalLabel = String((s.baseCalories || 0) + calories(s, s.profile, Math.max(0, ((s.pausedAt || Date.now()) - (s.segmentStartedAt || s.startedAt) - (s.pausedMs || 0)) / 60000)))
    const n = pendingCount()
    this.syncLabel = n > 0 ? '待上传 ' + n + ' 条' : isConnected() ? '已连接' : '离线记录'
  },

  mmss(sec) {
    sec = Math.max(0, Math.round(sec))
    return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0')
  },

  emitEvent(ev) {
    sendEvent(ev)
    const latest = loadState()
    if (latest.sid === this.state.sid) this.state.pendingEdits = latest.pendingEdits || []
  },
  onPause() { this.setPaused(!this.state.pausedAt, Date.now(), true) },
  onRemotePause(msg) {
    if (msg.sid !== this.state.sid || msg.seq <= (this.state.pauseVersion || 0)) return
    this.setPaused(!!msg.paused, msg.at || Date.now(), false)
  },
  setPaused(paused, at, notify) {
    const s = this.state
    this.flushRestNudge()
    if (paused && !s.pausedAt) {
      s.restLeftSec = restOf(s).leftSec; s.restUntil = 0; s.pausedAt = at
      this.stopHrCapture()
    } else if (!paused && s.pausedAt) {
      s.pausedMs = (s.pausedMs || 0) + Math.max(0, at - s.pausedAt); s.pausedAt = 0
      s.restUntil = s.restLeftSec ? Date.now() + s.restLeftSec * 1000 : 0
      this.startHrCapture()
    }
    s.pauseVersion = at; s.restVersion = at; save(s)
    if (notify) { this.emitEvent({ t: 'pause', sid: s.sid, paused, seq: at, at }); this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) }) }
    this.refresh()
  },
  askEnd() { this.closeMode = 'end' },
  askAbandon() { this.closeMode = 'abandon' },
  cancelClose() {
    if (this.closeMode === 'complete') {
      if (Date.now() < this.completionIgnoreUntil) return
      // 继续训练后不因时钟、同步或页面恢复反复弹窗；出现未完成组才重新提示。
      this.state.completionAcknowledged = true
      save(this.state)
    }
    this.closeMode = ''
    this.focusCrown()
  },
  saveEnd() {
    if (this.closeMode === 'complete' && Date.now() < this.completionIgnoreUntil) return
    this.onEnd('saved')
  },
  discardEnd() { this.onEnd('discarded') },
  abandonEnd() { this.onEnd('abandoned') },
  onEnd(reason, notifyPhone = true) {
    if (typeof reason !== 'string') reason = 'manual'
    const s = this.state
    if (!s || !s.active) return
    this.cancelRestNudge()
    this.setRestScreenLock(false)
    this.stopHrCapture()
    const closedAt = Date.now()
    const session = reason === 'saved' ? endSession(s, s.profile) : null
    if (!session) closeSession(s.sid)
    if (notifyPhone) sendEvent({ t: 'session_close', sid: s.sid, disposition: reason, closedAt, at: closedAt,
      ...(session ? { workout: s.workout, startedAt: s.startedAt, summary: { minutes: session.minutes, avgHr: session.avgHr, maxHr: session.maxHr, calories: session.calories, volume: session.volume }, completedSets: session.sets } : {}) })
    this.state = loadState()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    router.replace({ uri: reason === 'saved' ? '/Summary' : '/Index' })
  },
}

</script>

<template>
  <div class="page" id="training" touch-focusable="true" onrotation="onRotation" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
    <div class="screen" if="{{ pageIndex === 0 && !closeMode }}">
    <div class="topline"><text class="status">{{ syncLabel }}</text><text class="clock now">{{ clockLabel }}</text><text class="clock">已用 {{ elapsedLabel }}</text></div>
    <text class="ex">{{ isRest ? restExerciseName : exName }}</text>

    <div class="training-panel compact" if="{{ !isRest }}">
      <text class="group">{{ groupLabel }}{{ rowDone ? ' · 已完成' : '' }}</text>
      <div class="inputs">
        <div class="field" onclick="editWeight">
          <text class="fval">{{ weightVal }}</text>
        </div>
        <div class="field" onclick="editReps">
          <text class="fval">{{ repsVal }}</text>
        </div>
      </div>
      <div class="navrow">
        <input class="nav" type="button" value="上" onclick="onPrevSet" />
        <input class="nav" type="button" value="下" onclick="onNextSet" />
        <input class="complete {{ rowDone || paused ? 'secondary' : '' }}" type="button" value="{{ paused ? '已暂停' : rowDone ? '已完成' : '完成' }}" disabled="{{ paused }}" onclick="onCurrentSetAction" />
      </div>
    </div>

    <div class="training-panel rest-panel" if="{{ isRest }}">
      <text class="rest-kicker">剩余休息</text>
      <text class="rest">{{ restLabel }}</text>
      <div class="rrow">
        <input class="rbtn" type="button" value="−15s" onclick="onRestMinus" />
        <text class="rest-total">本次 {{ restTotalLabel }}</text>
        <input class="rbtn" type="button" value="+15s" onclick="onRestPlus" />
      </div>
      <text class="next">{{ nextLabel }}</text>
      <text class="next-details">{{ nextDetails }}</text>
      <input class="skip" type="button" value="跳过休息" onclick="onSkipRest" />
    </div>
    <div class="primary-footer"><text class="progress">{{ setProgressLabel }}</text><div class="footer-metrics"><text class="energy">{{ kcalLabel }} 千卡</text><text class="hr">{{ hrLabel }}</text></div></div>
    </div>
    <div class="screen operation-screen" if="{{ pageIndex === 1 && !closeMode }}">
    <div class="topline"><text class="status">{{ syncLabel }}</text><text class="clock now">{{ clockLabel }}</text><text class="clock">已用 {{ elapsedLabel }}</text></div>
    <text class="group">{{ setProgressLabel }}</text>
    <text class="volume-line">已完成容量 {{ volumeLabel }} kg·次</text>
    <div class="metrics"><text class="energy">{{ kcalLabel }} 千卡</text><text class="hr">{{ hrLabel }}</text></div>
    <div class="mrow">
      <input class="m" type="button" value="加组" onclick="onMenuAddSet" />
      <input class="m" type="button" value="减组" onclick="onMenuRemoveSet" />
    </div>
    <input class="operation" type="button" value="{{ pauseLabel }}" onclick="onPause" />
    </div>
    <div class="dots" if="{{ !isRest && !closeMode }}"><div class="dot {{ pageIndex === 0 ? 'selected' : '' }}"></div><div class="dot {{ pageIndex === 1 ? 'selected' : '' }}"></div></div>
    <div class="completion-panel" if="{{ closeMode === 'complete' }}">
      <text class="completion-title">全部组已完成</text>
      <text class="completion-progress">{{ setProgressLabel }}</text>
      <input class="completion-btn finish" type="button" value="保存结束" onclick="saveEnd" />
      <input class="completion-btn continue" type="button" value="继续训练" onclick="cancelClose" />
    </div>

  </div>
</template>

<style>
.page { flex-direction: column; align-items: center; width: 100%; height: 100%; background-color: #000000; }
.screen { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; justify-content: space-between; }
.training-panel { width: 350px; height: 290px; flex-direction: column; align-items: center; justify-content: space-between; }
.rest-panel { height: 270px; }
.compact { height: 230px; justify-content: center; }
.primary-footer { width: 326px; height: 48px; flex-direction: column; align-items: center; justify-content: space-between; }
.progress { font-size: 16px; color: #bfc6c9; }
.footer-metrics { width: 326px; height: 22px; flex-direction: row; align-items: center; justify-content: space-between; }
.dots { position: absolute; right: 6px; top: 64px; width: 8px; height: 30px; flex-direction: column; justify-content: space-between; }
.dot { width: 7px; height: 7px; border-radius: 4px; background-color: #48484a; }
.selected { background-color: #63dfb1; }
.action-link { width: 160px; height: 40px; font-size: 18px; color: #aeb9bd; background-color: transparent; margin-top: 4px; }
.footer-action { margin-top: 0; }
.danger { color: #ff7d93; }
.operation { width: 326px; height: 56px; margin-top: 4px; border-radius: 8px; font-size: 23px; background-color: #191d1f; color: #ffffff; }
.topline { width: 326px; height: 22px; flex-direction: row; justify-content: space-between; }
.status { font-size: 16px; color: #63dfb1; }
.clock { font-size: 17px; color: #bfc6c9; }
.now { color: #ffffff; }
.ex { width: 350px; height: 56px; font-size: 25px; color: #ffffff; lines: 2; text-align: center; }
.group { width: 350px; height: 26px; font-size: 19px; color: #bfc6c9; text-align: center; lines: 1; }
.inputs { flex-direction: row; justify-content: space-between; width: 350px; height: 72px; margin-top: 12px; margin-bottom: 16px; }
.field { flex-direction: column; align-items: center; justify-content: center; width: 170px; height: 72px; border-radius: 8px; background-color: #191d1f; }
.fval { font-size: 34px; color: #ffffff; width: 164px; text-align: center; lines: 1; }
.navrow { flex-direction: row; justify-content: space-between; width: 350px; height: 52px; }
.nav { width: 72px; height: 52px; font-size: 22px; border-radius: 8px; background-color: #191d1f; color: #ffffff; }
.complete { width: 190px; height: 52px; font-size: 25px; border-radius: 8px; background-color: #63dfb1; color: #001b12; }
.secondary { background-color: #283236; color: #ffffff; }
.rest-kicker { width: 350px; height: 22px; font-size: 18px; color: #aeb9bd; text-align: center; }
.rest { width: 350px; height: 82px; line-height: 76px; font-size: 62px; color: #63dfb1; text-align: center; lines: 1; }
.rrow { flex-direction: row; align-items: center; justify-content: space-between; width: 350px; height: 48px; margin-top: 8px; }
.rbtn { width: 105px; height: 44px; font-size: 20px; border-radius: 8px; background-color: #191d1f; color: #ffffff; }
.rest-total { width: 120px; font-size: 18px; color: #ffffff; text-align: center; lines: 1; }
.next { width: 350px; height: 36px; line-height: 18px; font-size: 16px; color: #63dfb1; text-align: center; lines: 2; }
.next-details { width: 350px; height: 24px; font-size: 18px; color: #ffffff; text-align: center; lines: 1; }
.prog { width: 350px; height: 26px; font-size: 18px; color: #bfc6c9; text-align: center; }
.skip { width: 220px; height: 44px; font-size: 21px; border-radius: 8px; background-color: #63dfb1; color: #001b12; margin-top: 0; }
.metrics { width: 326px; height: 38px; flex-direction: row; align-items: center; justify-content: space-between; }
.hr { font-size: 17px; color: #ff7d93; }
.energy { font-size: 17px; color: #e0c775; }
.volume-line { width: 326px; height: 30px; font-size: 19px; color: #ffffff; text-align: center; }
.sync { width: 326px; height: 24px; font-size: 16px; color: #63dfb1; text-align: center; }
.mrow { width: 326px; height: 64px; flex-direction: row; justify-content: space-between; }
.m { width: 156px; height: 60px; font-size: 23px; border-radius: 8px; background-color: #191d1f; color: #ffffff; }
.footer { width: 350px; height: 48px; justify-content: space-between; }
.tool { width: 110px; height: 44px; border-radius: 8px; background-color: #191d1f; color: #ffffff; font-size: 18px; }
.menu { position: absolute; top: 0; left: 0; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; background-color: #000000; }
.mrow { width: 326px; height: 64px; flex-direction: row; justify-content: space-between; }
.m { width: 156px; height: 60px; font-size: 23px; border-radius: 8px; background-color: #191d1f; color: #ffffff; margin: 0; }
.operation-screen { justify-content: space-between; }
.operation-screen .operation { margin-top: 0; }
.panel-title { height: 32px; font-size: 26px; color: #ffffff; margin-bottom: 4px; }
.mclose { width: 180px; height: 44px; font-size: 18px; border-radius: 12px; background-color: transparent; color: #636366; margin-top: 5px; }
.undo { width: 250px; color: #e0c775; }
.finish { background-color: #63dfb1; color: #001b12; }
.leave-panel { position: absolute; top: 0; left: 0; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; background-color: #000000; }
.leave-title { font-size: 28px; color: #ffffff; margin-bottom: 4px; }
.leave-hint { font-size: 16px; color: #8e8e93; margin-bottom: 14px; }
.leave-btn { width: 350px; height: 54px; font-size: 23px; border-radius: 8px; margin-top: 12px; }
.continue { background-color: #1c1c1e; color: #ffffff; }
.exit { background-color: #3a3a3c; color: #ffffff; }
.end { background-color: #ff453a; color: #ffffff; }
.completion-panel { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; justify-content: center; }
.completion-title { width: 350px; height: 44px; font-size: 26px; color: #ffffff; text-align: center; }
.completion-progress { width: 350px; height: 32px; font-size: 18px; color: #bfc6c9; text-align: center; }
.completion-btn { width: 310px; height: 56px; margin-top: 18px; font-size: 23px; border-radius: 8px; }
</style>
