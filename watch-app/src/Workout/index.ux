<script>
import { bindRuntime } from '../lib/runtime.js'
// 主训练页（单屏 + 手势）：重量/次数保持可见，休息态只保留必要操作。
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { rotationStep, valueStep } from '../lib/value-step.js'
import { captureRow, rowTarget, setDotWindow } from '../lib/workout-interaction.js'
import brightness from '@blueos.hardware.display.brightness'
import {
  loadState, save, replacePlan, applySync, toggleSet, nextUndone, nextUndoneFrom,
  endSession, closeSession, addSet, removeSet, addRestTime, setRowValue, setEffort, calories,
} from '../lib/session.js'
import {
  effortScaleOf, effortValueOf, effortKindOf, stepEffortValue, effortMeaning,
  formatEffort,
} from '../lib/effort-scale.js'
import { startSessionHr, stopSessionHr, tick, restOver } from '../lib/sensors.js'
import { startServer, sendEvent, sendControl, pendingCount, isConnected, persistenceStatus, synchronizationStatus, transportDiagnostics } from '../lib/rpc.js'
import { storageStatus } from '../lib/persistence.js'
import { applyEdit, applyFocus, applyRest, restOf } from '../lib/protocol.js'
import { lastTimeView } from '../lib/watch-last-time.js'

export default {
  data: {
    exName: '', syncWarning: false,
    selectedField: null, setDots: [], dotSegmented: false, dotHasPrev: false, dotHasNext: false, inputNotice: '',
    groupLabel: '',
    setProgressLabel: '',
    elapsedLabel: '',
    clockLabel: '',
    weightVal: '—',
    repsVal: '—',
    restLabel: '0:00',
    restPctLabel: '',
    restTotalLabel: '0:00',
    restProgLabel: '',
    restExerciseName: '',
    nextLabel: '',
    nextDetails: '',
    hrLabel: '♥ --', weightUnit: 'kg',
    syncLabel: '',
    diagnosticOn: false, diagnosticPage: 0, diagnosticTitle: '', diagnosticText: '',
    isRest: false,
    menuOn: false,
    leaveChoice: false,
    allFinished: false,
    rowDone: false,
    kcalLabel: '0',
    volumeLabel: '0',
    pageIndex: 0,
    closeMode: '',
    paused: false,
    pauseLabel: '暂停训练',
    // 视觉：数值与单位分开，单位弱一级
    weightNum: '—', weightSuffix: 'kg', repsNum: '—', repsSuffix: '次',
    statusLead: '已连接',
    // 本组强度登记（同页覆盖层）
    effortOn: false,
    effortScale: 'none',            // 手机设置：'rpe' | 'rir' | 'none'
    effortScaleLabel: '',
    effortDraft: null,
    effortDraftLabel: '—',
    effortHint: '左右滑动选择',
    effortMeaning: '',
    effortEntryText: '未登记',
    effortEntryLabel: '本组强度',
    effortEntryOn: false,
    effortHasSaved: false,
    effortNotice: '',
    effortTargetLabel: '',
    effortRestLabel: '',
    effortStale: false,
    // 上次（只读参考）：摘要行 + 同页详情。不写本次处方、不发任何事件。
    lastLine: '',
    lastOn: false,
    lastOpen: false,
    lastTitle: '',
    lastMeta: '',
    lastRows: [],
    // 结束入口与确认（旗帜只发起确认，不直接结束）
    finishOn: false,
    finishName: '',
    finishCount: '',
    confirmRemain: '',
    lastEffortOn: false,
    lastEffortText: '',
  },

  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    const s = loadState()
    if (!s.active || !s.workout) { router.push({ uri: '/Index' }); return }
    this.state = s
    this.profile = s.profile || null
    this.restSeq = 0
    this.remoteRestSeq = 0
    this.restStartAt = 0
    this.hrLast = 0
    this.hrDirty = false
    this.hrActive = false
    this.clockPeriod = 0
    this.touch = null
    this.restCrownTimer = null
    this.restCrownDirty = false
    this.visible = true
    this.effortTarget = null
    this.effortBaseVersion = 0
    this.effortScaleAtOpen = 'none'

    this.bindRpc()

    // 保存的游标就是当前组；nextUndone 仅用于完成后找下一组。
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))

    if (s.restUntil && s.restUntil <= Date.now()) {
      s.restUntil = 0
      save(s)
      restOver()
    }
    this.setRestScreenLock(!!s.restUntil)


    this.startHrCapture()
    this.refresh()
    if (params && params.requestFinish) this.openFinish()
  },

  onShow() {
    this.visible = true
    // Keypad/动作列表独立读取并保存会话，返回训练页时重新读取，确保重量立即回显。
    const latest = loadState()
    if (!latest.active || !latest.workout) { this.stopHrCapture(); router.replace({ uri: '/Index' }); return }
    if (latest.active && latest.workout) {
      this.state = latest
      this.autoFocusEx = latest.exIdx; this.autoFocusSet = latest.setIdx; this.autoFocusIgnoreUntil = 0
      this.profile = latest.profile || null
    }
    if (this.state) this.bindRpc()
    // 熄屏时系统可能暂停 JS 定时器，回到页面先按绝对截止时间校准。
    this.reconcileRestClock()
    // 与输入页通过持久化状态交接，使用当前连接的可靠事件队列发送。
    this.flushPendingRowEdits()
    this.startHrCapture()
    this.refresh()
    this.focusCrown()
  },

  onReady() {
    this.displayReady = true
    this.setRestScreenLock(this.visible !== false && !!(this.state && this.state.restUntil))
    this.focusCrown()
  },
  focusCrown() {
    try { this.$element('training').requestFocus(true) } catch (e) {}
  },
  onRotation(ev) {
    if (this.diagnosticOn) return
    if (ev && this.effortOn && ev.state !== 3) {
      const d = Number(ev.delta) || (ev.direction === true ? 1 : ev.direction === false ? -1 : 0)
      if (d) this.effortMove(d > 0 ? 1 : -1)
      return
    }
    if (!ev || this.visible === false || ev.state === 3 || this.menuOn || this.closeMode || this.pageIndex || this.paused || this.lastOpen || this.finishOn) return
    const delta = Number(ev.delta) || (ev.direction === true ? 1 : ev.direction === false ? -1 : 0)
    if (!delta) return
    if (this.isRest || this.restCrownDirty) this.queueRestNudge(delta > 0 ? 5 : -5)
    else this.adjustSelectedField(rotationStep(ev))
  },
  onBackPress() {
    if (this.diagnosticOn) { this.closeDiagnostics(); return true }
    if (this.effortOn) { this.closeEffort(); return true }
    // 详情/结束入口只关闭自己，不切组、不停表、不退出会话。
    if (this.lastOpen) { this.closeLast(); return true }
    if (this.finishOn) { this.closeFinish(); return true }
    if (this.closeMode) this.cancelClose()
    else if (this.menuOn) this.menuOn = false
    else if (this.pageIndex) this.pageIndex = 0
    else this.openExercises()
    return true
  },
  openMenu() { this.menuOn = true; this.leaveChoice = false },
  openActions() { if (!this.isRest) this.pageIndex = 1; this.menuOn = false },
  interactionBlocked() { return !!this.touchAxis || Date.now() < (this.trailingTapBlockedUntil || 0) || Date.now() < (this.autoFocusIgnoreUntil || 0) },
  openExercises(fromGesture) {
    if (fromGesture !== true && this.interactionBlocked()) return
    this.clearFieldSelection(); router.push({ uri: '/ExerciseList' })
  },

  bindRpc() {
    const handle = (method, ...args) => {
      // 隐藏的训练页仍会收到 RPC；保留输入页刚保存的编辑和其他页面的更新。
      const latest = loadState()
      if (latest.active && latest.sid === this.state.sid) {
        if (this.restCrownDirty) {
          latest.restUntil = this.state.restUntil; latest.restTargetSec = this.state.restTargetSec
          latest.restVersion = this.state.restVersion; latest.restId = this.state.restId
          latest.restStartedAt = this.state.restStartedAt
        }
        this.state = latest
      }
      const msg = args[0], s = this.state
      if (msg?.entryInstanceId && ['set','unset','weight','reps','add_set','remove_set','focus','effort'].includes(msg.t)) {
        const ex = s.workout.exercises.findIndex(e => e.entryInstanceId === msg.entryInstanceId)
        if (ex < 0) return
        const set = msg.setId ? s.workout.rows[ex].findIndex(r => r.setId === msg.setId) + 1 : msg.set
        if (msg.setId && !set) return
        args[0] = { ...msg, ex, set }
        if (msg.weight != null && msg.weight !== '' && msg.weightUnit && msg.weightUnit !== s.weightUnit) args[0].weight = Math.round(Number(msg.weight) * (msg.weightUnit === 'lb' ? 0.45359237 : 1 / 0.45359237) * 1000) / 1000
        if (['add_set','remove_set'].includes(msg.t)) { applyEdit(s, msg); save(s); this.refresh(); return }
      }
      return this[method](...args)
    }
    startServer({
      onPlan: (msg) => handle('onPlanUpdate', msg),
      onSync: (msg) => handle('onSyncUpdate', msg),
      onRest: (msg) => handle('onRemoteRest', msg),
      onPause: (msg) => handle('onRemotePause', msg),
      onStartAck: msg => {
        if (msg.status === 'conflict') { this.syncLabel = '手机已有训练'; router.replace({ uri: '/Index', params: { conflict: JSON.stringify(msg.snapshot) } }) }
      },
      onSet: (msg) => handle('onRemoteSet', msg),
      onUnset: (msg) => handle('onRemoteUnset', msg),
      onEffort: (msg) => handle('onRemoteEffort', msg),
      onWeight: (msg) => handle('onRemoteValue', msg, 'w'),
      onReps: (msg) => handle('onRemoteValue', msg, 'r'),
      onAddSet: (msg) => handle('onRemoteAddSet', msg),
      onRemoveSet: (msg) => handle('onRemoteRemoveSet', msg),
      onFocus: (msg) => handle('onRemoteFocus', msg),
      onEnded: () => this.onRemoteEnded(),
      onError: () => { this.syncLabel = '连接异常' },
    })
  },

  onHide() {
    this.visible = false
    this.flushRestNudge()
    this.setRestScreenLock(false)
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },

  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    this.flushRestNudge()
    this.setRestScreenLock(false)
  },

  setRestScreenLock(keepOn) {
    if (!this.displayReady) return
    keepOn = !!keepOn
    if (this.screenLocked === keepOn) return
    this.screenLocked = keepOn
    try {
      brightness.setKeepScreenOn({ keepScreenOn: keepOn, success() {}, fail: (data, code) => {
        this.screenLocked = null
        console.log('rest screen lock failed', code)
      } })
    } catch (e) { this.screenLocked = null }
  },

  startHrCapture() { startSessionHr() },

  stopHrCapture() { stopSessionHr() },

  touchStart(e) {
    const t = e.touches && e.touches[0]
    if (t) { this.autoFocusIgnoreUntil = 0; this.trailingTapBlockedUntil = 0 }
    this.touch = t ? { x: t.clientX, y: t.clientY } : null
    this.touchLast = this.touch
    this.touchAxis = null
    this.effortSwipe = 0
  },

  touchMove(e) {
    if (!this.touch) return
    const t = e.touches && e.touches[0]
    if (t) {
      this.touchLast = { x: t.clientX, y: t.clientY }
      if (!this.touchAxis) {
        const dx = Math.abs(t.clientX - this.touch.x), dy = Math.abs(t.clientY - this.touch.y)
        if (Math.max(dx, dy) >= 24) this.touchAxis = dx > dy ? 'x' : 'y'
      }
    }
  },

  touchEnd(e) {
    if (this.diagnosticOn) { this.touchCancel(); return }
    if (!this.touch) return
    // 固件触摸回调未必带 changedTouches，用最后一次 move 的坐标兜底。
    const t = e.changedTouches && e.changedTouches[0] || e.touches && e.touches[0]
    const end = t ? { x: t.clientX, y: t.clientY } : this.touchLast
    const start = this.touch
    const axisAtRelease = this.touchAxis
    this.touchCancel()
    if (axisAtRelease || (end && Math.max(Math.abs(end.x - start.x), Math.abs(end.y - start.y)) >= 24)) this.trailingTapBlockedUntil = Date.now() + 400
    if (!end) return
    // 评分层独占横滑：只移动一个步长，不切页、不切组、不碰休息。
    if (this.effortOn) {
      if (Math.abs(end.x - start.x) >= 24 && Math.abs(end.x - start.x) > Math.abs(end.y - start.y)) {
        this.effortMove(end.x < start.x ? 1 : -1)
      }
      return
    }
    const dx = end.x - start.x
    const dy = end.y - start.y
    if (Math.abs(dx) < 60 && Math.abs(dy) < 60) return
    this.autoFocusIgnoreUntil = 0
    if (this.closeMode) return
    // 详情打开时右滑只关闭详情；结束入口打开时不切页、不切组、不碰休息。
    if (this.lastOpen) { if (dx > 60 && Math.abs(dx) > Math.abs(dy)) this.closeLast(); return }
    if (this.finishOn) { if (dy > 60) this.closeFinish(); return }
    if (this.isRest) {
      if (dx > 60 && Math.abs(dx) > Math.abs(dy)) this.openExercises(true)
      return
    }
    if (this.menuOn) {
      if (dy > 60) this.menuOn = false
      return
    }
    const axis = axisAtRelease || (Math.abs(dx) > Math.abs(dy) ? 'x' : 'y')
    if (axis === 'x') {
      // 右滑打开动作列表，左滑切换训练与操作页。
      if (dx > 60) this.openExercises(true)
      else if (dx < -60) this.pageIndex = this.pageIndex ? 0 : 1
    }
    // Vertical gestures belong to the visible native list; horizontal swipes navigate pages.
  },

  touchCancel() { this.touch = null; this.touchLast = null; this.touchAxis = null },

  closeMenu() { this.menuOn = false },

  continueTraining() { this.leaveChoice = false },

  leaveTraining() {
    this.leaveChoice = false
    this.stopHrCapture()
    save(this.state)
    router.push({ uri: '/Index' })
  },

  onMenuAddSet() {
    const s = this.state
    this.weightUnit = s.weightUnit || 'kg'
    const ex = s.exIdx
    addSet(s, ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    s.setIdx = rows.length - 1
    this.menuOn = false
    this.emitEvent({ t: 'add_set', sid: s.sid, ex, set: s.setIdx + 1, sets: rows.length, weight: rows[s.setIdx].w, reps: rows[s.setIdx].r, at: Date.now() })
    this.refresh()
  },

  onMenuRemoveSet() {
    const s = this.state
    const ex = s.exIdx
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1 || rows[rows.length - 1].done) { this.menuOn = false; return }
    const removed = rows.length
    const removedSetIds = [rows[rows.length - 1].setId].filter(Boolean)
    removeSet(s, ex)
    this.menuOn = false
    this.emitEvent({ t: 'remove_set', sid: s.sid, ex, removedSetIds, set: removed, sets: rows.length, at: Date.now() })
    this.refresh()
  },

  onMenuPrev() { this.menuOn = false; this.stepSet(-1) },
  onMenuNext() { this.menuOn = false; this.stepSet(1) },

  stepSet(dir) {
    const s = this.state
    if (!s.workout || !s.workout.rows.length) return
    let nx = s.exIdx
    let ni = s.setIdx + dir
    while (nx >= 0 && nx < s.workout.rows.length) {
      const rows = s.workout.rows[nx] || []
      if (ni >= 0 && ni < rows.length) break
      nx += dir
      if (nx < 0 || nx >= s.workout.rows.length) return
      ni = dir > 0 ? 0 : (s.workout.rows[nx] || []).length - 1
    }
    if (nx < 0 || nx >= s.workout.rows.length || ni < 0) return
    this.autoFocusEx = nx; this.autoFocusIgnoreUntil = 0
    this.clearFieldSelection(); this.autoFocusSet = ni
    s.exIdx = nx; s.setIdx = ni
    s.focusAt = Date.now(); save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, ex: nx, set: ni + 1, at: s.focusAt, source: 'watch' })
    this.refresh()
  },

  stepExercise(dir) {
    const s = this.state
    if (!s.workout || !s.workout.exercises.length) return
    const nx = Math.max(0, Math.min(s.exIdx + dir, s.workout.exercises.length - 1))
    if (nx === s.exIdx) return
    const rows = s.workout.rows[nx] || []
    const first = rows.findIndex(r => !r.done)
    this.autoFocusEx = nx; this.autoFocusIgnoreUntil = 0
    s.exIdx = nx
    s.setIdx = first >= 0 ? first : 0
    this.clearFieldSelection(); this.autoFocusSet = s.setIdx
    save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, ex: nx, set: s.setIdx + 1, at: Date.now(), source: 'watch' })
    this.refresh()
  },

  onPrevSet() { this.stepSet(-1) },
  onNextSet() { this.stepSet(1) },

  clearFieldSelection() { this.selectedField = null; this.fieldTarget = null },
  flushPendingRowEdits() {
    // Reuse the original durable identities. RPC owns deduplication and ACK removal.
    const edits = (this.state && this.state.pendingEdits || []).slice()
    for (const edit of edits) this.emitEvent(edit)
  },
  selectField(field) {
    if (this.interactionBlocked() || this.isRest || this.paused || this.closeMode || this.effortOn || this.lastOpen || this.finishOn) return
    const s = loadState(), target = captureRow(this.state), found = rowTarget(s, target)
    if (!found || found.row.done || s.pausedAt || s.restUntil) { this.clearFieldSelection(); return }
    if (target.weightUnit !== (s.weightUnit || 'kg')) { this.clearFieldSelection(); return }
    this.state = s
    if (this.selectedField === field && this.fieldTarget && this.fieldTarget.setId === target.setId) {
      router.push({ uri: '/Keypad', params: { ...target, field, inputMode: 'quick' } }); return
    }
    this.selectedField = field; this.fieldTarget = target; this.inputNotice = ''
    this.focusCrown()
  },
  editWeight() { this.selectField('w') },
  editReps() { this.selectField('r') },
  adjustSelectedField(direction) {
    if (!direction || !this.selectedField || !this.fieldTarget || this.interactionBlocked()) return
    const s = loadState(), found = rowTarget(s, this.fieldTarget)
    if (!found || found.row.done || s.pausedAt || s.restUntil || this.fieldTarget.weightUnit !== (s.weightUnit || 'kg') || found.exIdx !== s.exIdx || found.setIdx !== s.setIdx) {
      this.clearFieldSelection(); this.inputNotice = '目标已变化，请重新选择'; return
    }
    // Conservative input-only backpressure; never trim accepted edits or completion events.
    if (persistenceStatus().failed || storageStatus().failed || pendingCount() >= 256 || (s.pendingEdits || []).length >= 256) {
      this.inputNotice = '请先同步或恢复存储后再编辑'; return
    }
    const value = valueStep(found.row[this.selectedField], this.selectedField, direction, storage.getSync({ key: 'weight_step' }))
    this.state = s
    setRowValue(s, found.exIdx, found.setIdx, this.selectedField, value, true)
    this.flushPendingRowEdits(); this.refresh()
  },
  refreshSetDots(page) {
    const view = setDotWindow(this.state, page)
    this.dotPage = view.page; this.setDots = view.dots; this.dotSegmented = view.segmented
    this.dotHasPrev = view.hasPrev; this.dotHasNext = view.hasNext
  },
  prevDotSegment() { if (!this.interactionBlocked() && this.dotHasPrev) this.refreshSetDots(this.dotPage - 1) },
  nextDotSegment() { if (!this.interactionBlocked() && this.dotHasNext) this.refreshSetDots(this.dotPage + 1) },
  pickSetDot(target) {
    if (this.interactionBlocked() || this.isRest || this.paused || this.closeMode || this.effortOn || this.lastOpen || this.finishOn) return
    const s = loadState(), found = rowTarget(s, target)
    if (!found || found.row.done || s.sid !== this.state.sid || s.pausedAt || s.restUntil) return
    this.clearFieldSelection(); this.state = s
    this.autoFocusEx = found.exIdx; this.autoFocusSet = found.setIdx; this.autoFocusIgnoreUntil = 0
    s.exIdx = found.exIdx; s.setIdx = found.setIdx; s.focusAt = Date.now(); save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, entryInstanceId: s.workout.exercises[s.exIdx].entryInstanceId,
      setId: found.row.setId, ex: s.exIdx, set: s.setIdx + 1, at: s.focusAt, source: 'watch' })
    this.refresh()
  },

  onComplete() {
    if (this.isRest || this.paused || this.closeMode || this.interactionBlocked() || Date.now() < (this.completionIgnoreUntil || 0)) return
    const s = this.state
    const exIdx = s.exIdx, setIdx = s.setIdx
    const current = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!current || current.done) return
    this.completionIgnoreUntil = Date.now() + 700
    this.clearFieldSelection()
    const row = toggleSet(s, true)
    if (!row) return
    // 评分归属必须在焦点前进之前捕获：完成后游标会去下一组，这里记住的是刚完成的这一组。
    this.effortEntryText = '未登记'
    this.effortTarget = { sid: s.sid, entryInstanceId: s.workout.exercises[exIdx]?.entryInstanceId,
      setId: row.setId, completedAt: row.at, exIdx, setIdx,
      name: s.workout.exercises[exIdx]?.name || '', setNo: setIdx + 1 }
    this.restStartAt = Date.now()
    this.setRestScreenLock(!!s.restUntil)
    this.emitEvent({ t: 'set', sid: s.sid, ex: exIdx, set: setIdx + 1, reps: row.r != null ? String(row.r) : '', weight: row.w != null ? String(row.w) : '', at: row.at, rest: restOf(s) })
    tick()
    const next = nextUndone(s)
    if (next) {
      s.exIdx = next.exIdx; s.setIdx = next.setIdx; save(s)
      this.emitEvent({ t: 'focus', sid: s.sid, ex: next.exIdx, set: next.setIdx + 1, at: Date.now(), source: 'watch' })
    }
    else this.allFinished = true
    this.refresh()
  },

  onUndo() {
    const s = this.state
    const exIdx = s.exIdx, setIdx = s.setIdx
    const row = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!row || !row.done) return
    toggleSet(s, false)
    this.cancelRestNudge()
    this.restStartAt = 0
    this.allFinished = false
    this.emitEvent({ t: 'unset', sid: s.sid, ex: exIdx, set: setIdx + 1, at: Date.now() })
    this.refresh()
  },

  onCurrentSetAction() {
    if (this.closeMode || this.paused || this.interactionBlocked() || Date.now() < (this.completionIgnoreUntil || 0)) return
    if (this.rowDone) this.onUndo()
    else this.onComplete()
  },

  onRemoteSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || row.done) return
    row.done = true
    row.at = Number(msg.at) || Date.now()
    const next = nextUndoneFrom(s, Number(msg.ex), Number(msg.set) - 1)
    if (next) {
      s.exIdx = next.exIdx
      s.setIdx = next.setIdx
    } else {
      s.exIdx = Number(msg.ex)
      s.setIdx = Number(msg.set) - 1
    }
    this.allFinished = s.workout.rows.every(rows => rows.every(r => r.done))
    save(s)
    this.refresh()
  },

  onRemoteUnset(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || !row.done) return
    row.done = false
    row.at = 0
    s.exIdx = Number(msg.ex)
    s.setIdx = Number(msg.set) - 1
    this.allFinished = false
    save(s)
    this.refresh()
  },

  onRemoteValue(msg, field) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const value = field === 'w' ? msg.weight : msg.reps
    const type = field === 'w' ? 'weight' : 'reps'
    // 回传关联编辑时间戳，旧快照/旧确认不能覆盖更新的本地输入。
    s.pendingEdits = (s.pendingEdits || []).filter(edit => !(edit.t === type &&
      edit.ex === msg.ex && edit.set === msg.set && msg.editAt != null && edit.at <= msg.editAt))
    const pending = s.pendingEdits.filter(edit => edit.t === type && edit.ex === msg.ex && edit.set === msg.set)
    const latest = pending[pending.length - 1]
    setRowValue(s, msg.ex, msg.set - 1, field, latest ? latest[type] : value)
    this.refresh()
  },

  onRemoteAddSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length + 1
    if (target <= rows.length || target > 100) return
    while (rows.length < target) addSet(s, ex)
    const i = rows.length - 1
    if (msg.weight != null && msg.weight !== '') rows[i].w = msg.weight
    if (msg.reps != null && msg.reps !== '') rows[i].r = msg.reps
    save(s)
    this.refresh()
  },

  onRemoteRemoveSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length - 1
    if (target < 1 || target >= rows.length) return
    if (rows.slice(target).some(r => r.done)) return
    rows.splice(target)
    s.workout.exercises[ex].sets = rows.length
    if (s.exIdx === ex && s.setIdx >= rows.length) s.setIdx = rows.length - 1
    save(s)
    this.refresh()
  },

  onRemoteFocus(msg) {
    const s = this.state
    if (!applyFocus(s, msg)) return
    save(s)
    this.refresh()
  },

  onSyncUpdate(msg) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    const localRest = this.restCrownDirty && (!msg.sid || msg.sid === this.state.sid)
    const localRound = localRest ? { restUntil: this.state.restUntil, restTargetSec: this.state.restTargetSec,
      restVersion: this.state.restVersion, restId: this.state.restId, restStartedAt: this.state.restStartedAt } : null
    if (!localRest) this.cancelRestNudge()
    applySync(this.state, msg)
    if (localRound) Object.assign(this.state, localRound)
    this.profile = this.state.profile || this.profile
    if (this.state.pausedAt) this.stopHrCapture()
    else this.startHrCapture()
    this.allFinished = (this.state.workout.rows || []).every(rows => rows.every(r => r.done))
    this.refresh()
    return { status: 'applied', page: 'Workout', exercises: this.state.workout.exercises.length }
  },

  onRemoteEnded() {
    this.cancelRestNudge()
    this.setRestScreenLock(false)
    this.hrDirty = false
    this.state = loadState()
    this.stopHrCapture()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    router.replace({ uri: '/Index' })
  },

  onSkipRest() {
    if (Date.now() < (this.autoFocusIgnoreUntil || 0)) return
    this.cancelRestNudge()
    const s = this.state
    if (s.restUntil && this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
    s.restUntil = 0
    this.restStartAt = 0
    this.setRestScreenLock(false)
    this.restSeq += 1
    s.restVersion = Math.max(Date.now(), (s.restVersion || 0) + 1); s.restTargetSec = 0; s.restLeftSec = 0
    this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) })
    save(s)
    this.refresh()
  },

  nudgeRest(deltaSec) {
    this.applyRestNudge(deltaSec)
    this.flushRestNudge()
  },

  queueRestNudge(deltaSec) {
    if (!this.state || !this.state.restUntil || !deltaSec) return
    this.applyRestNudge(deltaSec)
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    // 旋转回调只改截止时间和数字，停转后才写存储/发 RPC，避免堵塞手表线程。
    this.restCrownTimer = setTimeout(() => {
      this.flushRestNudge()
    }, 300)
  },

  cancelRestNudge() {
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    this.restCrownTimer = null
    this.restCrownDirty = false
  },

  flushRestNudge() {
    const dirty = this.restCrownDirty
    this.cancelRestNudge()
    const s = this.state
    if (!dirty || !s || !s.active) return
    const left = Math.max(0, Math.ceil((s.restUntil - Date.now()) / 1000))
    s.restVersion = Math.max(Date.now(), (s.restVersion || 0) + 1)
    save(s)
    this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) })
  },

  applyRestNudge(deltaSec) {
    const s = this.state
    if (!s || !s.active || !s.restUntil || !Number.isFinite(deltaSec)) return
    const now = Date.now()
    const target = Math.min(now + 900000, s.restUntil + deltaSec * 1000)
    s.restTargetSec = Math.max(0, Math.min(900, (s.restTargetSec || 0) + (target - s.restUntil) / 1000))
    s.restVersion = Math.max(now, (s.restVersion || 0) + 1)
    this.restCrownDirty = true
    if (target <= now) {
      if (this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
      s.restUntil = 0
      this.restStartAt = 0
      this.setRestScreenLock(false)
      this.isRest = false
      this.syncClockTimer()
    } else {
      s.restUntil = target
    }
    this.restLabel = this.mmss(Math.max(0, Math.ceil((s.restUntil - now) / 1000)))
    this.restTotalLabel = this.mmss(s.restTargetSec)
  },

  onRestMinus() { this.nudgeRest(-15) },
  onRestPlus() { this.nudgeRest(15) },

  reconcileRestClock() {
    const s = this.state
    if (!s || !s.restUntil || s.restUntil > Date.now()) return
    if (this.restStartAt) addRestTime(s, (s.restUntil - this.restStartAt) / 1000)
    this.cancelRestNudge()
    s.restUntil = 0
    this.restStartAt = 0
    this.setRestScreenLock(false)
    save(s)
    restOver()
  },

  onPlanUpdate(msg) {
    const s = this.state
    if (msg && msg.sid && s.sid && msg.sid !== s.sid) {
      return { status: 'rejected', page: 'Workout', reason: 'session_mismatch', activeSid: s.sid }
    }
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    if (msg && msg.profile) s.profile = msg.profile
    replacePlan(s, { ...msg, name: msg.workout })
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))
    save(s)
    this.refresh()
    return { status: 'applied', page: 'Workout', exercises: s.workout.exercises.length }
  },

  onRemoteRest(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    if (this.restCrownDirty) return
    if (!applyRest(s, msg)) return
    save(s)
    this.refresh()
  },

  isDoneRowCur() {
    const s = this.state
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    this.rowDone = !!(row && row.done)
    return !!(row && row.done)
  },

  // ---- 上次（只读历史）--------------------------------------------------------
  // 归一化模块只负责显示：拿不到（旧包、加载失败）就当作“没有上次”，训练页绝不因此崩。
  lastViewOf(ex, unit) {
    try { return typeof lastTimeView === 'function' ? lastTimeView(ex, unit) : null } catch (e) { return null }
  },
  // 打开时冻结视图和目标动作的稳定身份：训练在下面继续跑，浏览历史不改游标、不发事件。
  openLast() {
    if (!this.lastOn) return
    const s = this.state
    const ex = s.workout && s.workout.exercises[s.exIdx]
    const view = this.lastViewOf(ex, s.weightUnit)
    if (!view) return
    this.lastView = view
    this.lastTarget = { entryInstanceId: ex.entryInstanceId || null, exIdx: s.exIdx }
    this.lastTitle = '上次 · ' + (view.name || '')
    this.lastMeta = view.metaLabel
    this.lastRows = view.rows.map(r => ({ no: r.no, label: r.label, key: r.no }))
    this.lastOpen = true
    // 详情接管表冠：只滚动。关闭后恢复原来的训练页导航。
    setTimeout(() => { try { this.$element('history').requestFocus(true) } catch (e) {} }, 0)
  },
  closeLast() {
    this.lastOpen = false
    this.lastView = null
    this.lastTarget = null
    this.lastRows = []
    this.focusCrown()
    this.refresh()
  },
  // 结构更新（手机改计划/换动作）把目标动作移除了：关掉详情回当前有效训练页，不能按下标乱指。
  lastTargetStillThere(s) {
    if (!s || !s.workout || !s.workout.exercises) return false
    const t = this.lastTarget
    if (!t) return false
    if (t.entryInstanceId) return s.workout.exercises.some(e => e.entryInstanceId === t.entryInstanceId)
    return t.exIdx != null && !!s.workout.exercises[t.exIdx]
  },

  // ---- 结束入口 ---------------------------------------------------------------
  // 旗帜和“结束训练”只发起确认：不直接调 endSession/onEnd，也不补完成任何组。
  openFinish() {
    if (this.closeMode) return
    const s = this.state
    if (!s || !s.active) return
    this.lastOpen = false
    this.finishOn = true
    this.finishName = (s.workout && s.workout.name) || '自由训练'
    this.refresh()
  },
  closeFinish() {
    this.finishOn = false
    this.focusCrown()
    this.refresh()
  },
  // 末组补录：目标是最近一次真正完成的那一组（稳定 setId），不是游标的前一个索引。
  openLastEffort() {
    const s = this.state
    if (!s || !s.active) return
    const target = this.lastCompletedFromState(s)
    if (!target) return
    this.effortTarget = target
    this.openEffort(false)
  },

  // ---- 本组强度（RPE/RIR）----------------------------------------------------
  // 同页覆盖层：不新增页面，原计时器/RPC/心率 owner 全部继续运行，休息不会因为登记暂停或重置。
  effortTargetRow() {
    const t = this.effortTarget
    if (!t) return null
    const s = loadState()
    if (!s.active || s.sid !== t.sid || !s.workout) return null
    const exIdx = t.entryInstanceId
      ? s.workout.exercises.findIndex(ex => ex.entryInstanceId === t.entryInstanceId) : t.exIdx
    if (!(exIdx >= 0)) return null
    const rows = s.workout.rows[exIdx] || []
    const set = t.setId ? rows.findIndex(r => r.setId === t.setId) : t.setIdx
    if (!(set >= 0)) return null
    return rows[set] ? { s, exIdx, set, row: rows[set] } : null
  },
  // 重启后内存里的 lastCompleted 没了：用“最近完成的一组”重建补录目标。
  lastCompletedFromState(s) {
    let best = null
    ;(s.workout?.rows || []).forEach((rows, exIdx) => rows.forEach((r, setIdx) => {
      if (r.done && (!best || (r.at || 0) > best.completedAt)) best = { sid: s.sid,
        entryInstanceId: s.workout.exercises[exIdx]?.entryInstanceId, setId: r.setId,
        completedAt: r.at || 0, exIdx, setIdx, name: s.workout.exercises[exIdx]?.name || '', setNo: setIdx + 1 }
    }))
    return best
  },
  effortTargetValid() {
    const found = this.effortTargetRow()
    return !!(found && (!this.effortOn || !this.effortTargetWasDone || found.row.done))
  },
  openEffort(fromOp) {
    if (this.effortOn) return
    // 训练页登记当前组，休息页登记刚完成组；打开后固定目标，计时结束不换组。
    if (!this.effortTargetValid()) { this.effortNotice = ''; return }
    const found = this.effortTargetRow()
    const scale = this.state.effortScale === 'rpe' || this.state.effortScale === 'rir' ? this.state.effortScale : 'none'
    if (scale === 'none') return
    this.effortScale = scale
    this.effortScaleLabel = effortScaleOf(scale).label
    this.effortScaleAtOpen = scale
    this.effortTargetWasDone = !!found.row.done
    this.effortBaseVersion = Number.isFinite(found.row.effortVersion) ? found.row.effortVersion : 0
    const kind = effortKindOf(found.row)
    const saved = kind ? effortValueOf(found.row, kind) : null
    this.effortHasSaved = saved != null
    this.effortDraft = null
    this.effortStale = false
    this.effortNotice = ''
    this.effortTargetLabel = (this.effortTarget.name || '') + ' · 第' + this.effortTarget.setNo + '组'
      + (found.row.done ? ' · 已完成' : ' · 训练中')
    if (kind && kind === scale && saved != null) {
      // 已登记：显示已存值（旧值即使不是 0.5 步长也如实显示，不静默改写）。
      this.effortDraft = saved
      this.effortHint = '左右滑动调整'
    } else if (kind && saved != null) {
      // 旧值是另一个量表：如实告知，本次按当前量表重新登记。
      this.effortHint = '旧值 ' + effortScaleOf(kind).label + ' ' + formatEffort(saved) + ' · 左右滑动选择'
    } else {
      this.effortHint = '左右滑动选择'
    }
    this.effortOn = true
    this.effortFromOp = !!fromOp
    this.updateEffortText()
    this.refreshEffortRest()
    this.focusCrown()
  },
  closeEffort() {
    this.effortOn = false
    this.effortDraft = null
    this.effortNotice = ''
    this.effortStale = false
    this.effortFromOp = false
    this.focusCrown()
    this.refresh()
  },
  effortMinus() { this.effortMove(-1) },
  effortPlus() { this.effortMove(1) },
  effortMove(dir) {
    if (!this.effortOn) return
    const next = stepEffortValue(this.effortScale, this.effortDraft, dir)
    if (next === this.effortDraft) return
    this.effortDraft = next
    this.effortHint = '左右滑动调整'
    this.updateEffortText()
  },
  updateEffortText() {
    const v = this.effortDraft
    this.effortDraftLabel = v == null ? '—' : formatEffort(v)
    const m = v == null ? null : effortMeaning(this.effortScale, v)
    this.effortMeaning = m ? m.text : ''
  },
  refreshEffortRest() {
    const s = this.state
    const left = s && s.restUntil ? Math.max(0, Math.ceil((s.restUntil - Date.now()) / 1000)) : 0
    this.effortRestLabel = left > 0 ? '休息 ' + this.mmss(left)
      : this.effortTargetWasDone ? '休息已结束' : '训练中'
  },
  confirmEffort() {
    if (!this.effortOn) return
    if (this.state.effortScale !== this.effortScaleAtOpen) {
      // 手表中途换了量表：旧草稿按新量表保存会是错的，要求重新打开。
      this.effortNotice = '手机已切换量表，请重新打开'
      return
    }
    if (this.effortDraft == null) { this.closeEffort(); return }
    this.commitEffort(this.effortDraft)
  },
  clearEffort() {
    if (!this.effortOn || !this.effortHasSaved) return
    this.commitEffort(null)
  },
  commitEffort(value) {
    const found = this.effortTargetRow()
    if (!this.effortTargetValid()) {
      this.effortNotice = '目标组已变化，无法登记'
      return
    }
    // 只把评分字段合并进最新状态：绝不保存打开覆盖层时的整份旧 state。
    const latest = found.s
    const at = Math.max(Date.now(), Number(latest.effortSeq || 0) + 1)
    latest.effortSeq = at
    setEffort(latest, found.exIdx, found.set, this.effortScale, value, at)
    save(latest)
    this.state = loadState()
    this.emitEvent({ t: 'effort', sid: latest.sid, ex: found.exIdx, set: found.set + 1,
      scale: this.effortScale, value: value == null ? null : value, clear: value == null,
      effortVersion: at, baseEffortVersion: this.effortBaseVersion, at })
    this.effortOn = false
    this.effortDraft = null
    this.effortNotice = ''
    this.focusCrown()
    this.refresh()
  },
  onRemoteEffort(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const set = Number(msg.set) - 1
    if (!(ex >= 0) || !(set >= 0)) return
    const row = s.workout.rows[ex] && s.workout.rows[ex][set]
    if (!row) return
    const version = Number(msg.effortVersion) || Date.now()
    if (Number.isFinite(row.effortVersion) && version < row.effortVersion) return
    setEffort(s, ex, set, msg.scale, msg.clear ? null : msg.value, version)
    save(s)
    if (this.effortOn && this.effortTarget && this.effortTarget.setId === row.setId) {
      if (this.effortScale !== s.effortScale) this.effortNotice = '手机已切换量表，请重新打开'
      else this.effortNotice = '手机已更新本组强度'
    }
    this.refresh()
  },

  // 自动切到另一动作后，挡住落在新“完成/跳过”按钮上的慢双击；手动切换立即放行。
  updateAutoFocusLock(s) {
    if (this.autoFocusSid === s.sid && this.autoFocusEx != null && (this.autoFocusEx !== s.exIdx || (this.autoFocusSet != null && this.autoFocusSet !== s.setIdx) || (this.autoFocusWasRest && !s.restUntil))) {
      this.autoFocusIgnoreUntil = Date.now() + 1000
    }
    this.autoFocusSid = s.sid
    this.autoFocusEx = s.exIdx; this.autoFocusSet = s.setIdx; this.autoFocusWasRest = !!s.restUntil
  },

  refresh() {
    this.weightUnit = this.state?.weightUnit || 'kg'
    const s = this.state
    if (!s || !s.workout) return
    this.reconcileRestClock()
    this.updateAutoFocusLock(s)
    this.setRestScreenLock(this.visible !== false && !!s.restUntil)
    this.rowDone = this.isDoneRowCur()
    const ex = s.workout.exercises[s.exIdx]
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    if (this.fieldTarget) {
      const target = rowTarget(s, this.fieldTarget)
      if (!target || target.row.done || target.exIdx !== s.exIdx || target.setIdx !== s.setIdx || s.pausedAt || s.restUntil || this.fieldTarget.weightUnit !== (s.weightUnit || 'kg')) this.clearFieldSelection()
    }
    const cursorKey = s.sid + ':' + (ex && ex.entryInstanceId || s.exIdx) + ':' + (row && row.setId || s.setIdx)
    this.refreshSetDots(cursorKey === this.dotCursorKey ? this.dotPage : undefined); this.dotCursorKey = cursorKey
    this.exName = ex ? ex.name : ''
    this.groupLabel = ex ? '第 ' + (s.setIdx + 1) + ' / ' + (ex.sets || 1) + ' 组' : ''
    this.weightVal = row && row.w !== '' && row.w != null ? row.w + ' ' + (s.weightUnit || 'kg') : '—'
    this.repsVal = row && row.r !== '' && row.r != null ? row.r + (this.isTimed(ex) ? ' 秒' : ' 次') : '—'
    // 数值与单位分开渲染：数字大、单位弱一级。
    this.weightNum = row && row.w !== '' && row.w != null ? String(row.w) : '—'
    this.weightSuffix = s.weightUnit || 'kg'
    this.repsNum = row && row.r !== '' && row.r != null ? String(row.r) : '—'
    this.repsSuffix = this.isTimed(ex) ? '秒' : '次'
    this.isRest = !!s.restUntil
    if (this.isRest) this.pageIndex = 0
    this.paused = !!s.pausedAt
    this.pauseLabel = this.paused ? '继续训练' : '暂停训练'

    // 完成后游标已前进；休息提示优先展示当前待做组，避免跳过一组。
    const next = row && !row.done ? { exIdx: s.exIdx, setIdx: s.setIdx } : nextUndone(s)
    const totalSets = s.workout.rows.reduce((n, r) => n + r.length, 0)
    const doneSets = s.workout.rows.reduce((n, r) => n + r.filter(x => x.done).length, 0)
    this.checkCompletion(totalSets, doneSets)
    this.setProgressLabel = '完成 ' + doneSets + ' / 剩余 ' + Math.max(0, totalSets - doneSets) + ' 组'
    let completedVolume = 0
    s.workout.rows.forEach((rows, exIdx) => {
      if (this.isTimed(s.workout.exercises[exIdx])) return
      rows.forEach(r => {
        const weight = parseFloat(r.w), reps = parseFloat(r.r)
        if (r.done && Number.isFinite(weight) && Number.isFinite(reps)) completedVolume += weight * reps
      })
    })
    this.volumeLabel = this.formatVolume(completedVolume)
    this.restProgLabel = '✓ ' + doneSets + '/' + totalSets + ' 组'
    let completed = null
    s.workout.rows.forEach((rows, exIdx) => rows.forEach((r, setIdx) => {
      if (r.done && (!completed || r.at > completed.at)) completed = { exIdx, setIdx, at: r.at || 0 }
    }))
    this.restExerciseName = completed
      ? s.workout.exercises[completed.exIdx].name
      : this.exName
    if (next) {
      const ne = s.workout.exercises[next.exIdx]
      const nr = s.workout.rows[next.exIdx][next.setIdx]
      const w = nr && nr.w !== '' && nr.w != null ? nr.w + (s.weightUnit || 'kg') : ''
      const timed = ne && String(ne.reps || '').indexOf('秒') >= 0
      const r = nr && nr.r !== '' && nr.r != null ? nr.r + (timed ? '秒' : '次') : ''
      this.nextLabel = next.exIdx !== (completed ? completed.exIdx : s.exIdx) ? '下一动作 · ' + ne.name : '下一组'
      this.nextDetails = '第 ' + (next.setIdx + 1) + ' / ' + (s.workout.rows[next.exIdx] || []).length + ' 组 · ' + (w && r ? w + ' × ' + r : (w || r || '待填写'))
    } else { this.nextLabel = '本次训练已完成'; this.nextDetails = this.restProgLabel }

    // 展示目标跟随当前页面，编辑目标只在打开时固定，绝不把上一组评分带入下一组。
    this.effortScale = s.effortScale === 'rpe' || s.effortScale === 'rir' ? s.effortScale : 'none'
    if (!this.effortOn) {
      if (this.isRest || this.closeMode === 'complete') {
        this.effortTarget = this.lastCompletedFromState(s)
      } else {
        this.effortTarget = row && ex ? { sid: s.sid, entryInstanceId: ex.entryInstanceId,
          setId: row.setId, exIdx: s.exIdx, setIdx: s.setIdx,
          name: ex.name || '', setNo: s.setIdx + 1 } : null
      }
    }
    this.effortEntryLabel = this.effortTarget ? '第' + this.effortTarget.setNo + '组强度' : '本组强度'
    const target = this.effortTargetRow()
    const targetKind = target ? effortKindOf(target.row) : null
    const targetValue = target && targetKind ? effortValueOf(target.row, targetKind) : null
    // 普通页只显示评分，含义解释只在选择层出现；同步状态统一由顶部状态栏展示。
    this.effortEntryText = targetKind && targetValue != null
      ? effortScaleOf(targetKind).label + ' ' + formatEffort(targetValue)
      : '未登记'
    this.effortEntryOn = this.effortScale !== 'none' && !!target
    if (this.effortOn) {
      if (!this.effortTargetValid()) { this.effortNotice = '目标组已变化，已停止编辑' ; this.effortOn = false }
      else if (this.state.effortScale !== this.effortScaleAtOpen) this.effortStale = true
      this.refreshEffortRest()
    }

    // 上次（只读参考）：当前动作的载荷 → 主数值下方一行摘要；没历史就整行隐藏。
    const lastView = this.lastViewOf(ex, s.weightUnit)
    this.lastLine = lastView ? '上次 ' + lastView.text + ' ›' : ''
    this.lastOn = !!lastView
    if (this.lastOpen && !this.lastTargetStillThere(s)) {
      // 结构更新把目标动作移除了：关掉详情回当前有效训练页，不按下标误指新动作。
      this.lastOpen = false; this.lastView = null; this.lastTarget = null; this.lastRows = []
    }
    // 结束入口：组数从当前 rows 的 done 状态算出来，不是示例数字。
    this.finishName = (s.workout && s.workout.name) || '自由训练'
    this.finishCount = '已完成 ' + doneSets + ' / ' + totalSets + ' 组'
    const remaining = Math.max(0, totalSets - doneSets)
    this.confirmRemain = remaining > 0
      ? '还有 ' + remaining + ' 组未完成，保存已完成的 ' + doneSets + ' 组'
      : '全部 ' + totalSets + ' 组已完成'
    // 末组评分入口：目标是最近一次实际完成的组；没有完成组或量表关闭则隐藏。
    // 量表关闭时 effortScaleOf('none') 返回 null，所以标签只在有量表时才取。
    const lastDone = this.lastCompletedFromState(s)
    const lastDoneRow = lastDone ? (s.workout.rows[lastDone.exIdx] || [])[lastDone.setIdx] : null
    const lastDoneKind = lastDoneRow ? effortKindOf(lastDoneRow) : null
    const lastDoneValue = lastDoneRow && lastDoneKind ? effortValueOf(lastDoneRow, lastDoneKind) : null
    const scaleLabel = this.effortScale === 'none' ? '' : (effortScaleOf(this.effortScale)?.label || '')
    this.lastEffortOn = this.effortScale !== 'none' && !!lastDone
    this.lastEffortText = '末组 ' + scaleLabel + '  '
      + (lastDoneKind && lastDoneValue != null ? formatEffort(lastDoneValue) : '未填写')

    this.syncClockTimer()
    this.tickClock()
  },
  isTimed(ex) { return ex && String(ex.reps || '').indexOf('秒') >= 0 },

  checkCompletion(total, done) {
    this.allFinished = total > 0 && done === total
    // 登记强度时不要被“全部完成”面板盖住；关闭后 refresh() 会重新判定一次。
    if (this.effortOn) return
    if (!this.allFinished) {
      if (this.state.completionAcknowledged) {
        this.state.completionAcknowledged = false
        save(this.state)
      }
      if (this.closeMode === 'complete') this.closeMode = ''
      return
    }
    if (this.visible === false || !this.state.active || this.state.completionAcknowledged || this.closeMode) return
    this.menuOn = false
    this.closeMode = 'complete'
    this.completionIgnoreUntil = Date.now() + 400
    this.touchCancel()
    this.focusCrown()
  },

  formatVolume(value) {
    return String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
  },

  syncClockTimer() {
    if (this.visible === false) return
    // The UI displays whole seconds; 500ms keeps expiry responsive without rendering the
    // complete watch page four times a second during every rest interval.
    const period = this.state && this.state.restUntil ? 500 : 1000
    if (this.timer && this.clockPeriod === period) return
    if (this.timer) clearInterval(this.timer)
    this.clockPeriod = period
    this.timer = setInterval(() => this.tickClock(), period)
  },

  tickClock() {
    // 评分层先判目标是否还有效：会话被结束/组被撤销时 this.state 可能已经变成 blank。
    if (this.effortOn) {
      if (!this.effortTargetValid()) { this.effortOn = false; this.effortNotice = '目标组已变化，已停止编辑' }
      else this.refreshEffortRest()
    }
    const s = this.state
    if (!s || !s.workout) return
    const currentTime = new Date()
    const clockLabel = String(currentTime.getHours()).padStart(2, '0') + ':' + String(currentTime.getMinutes()).padStart(2, '0')
    if (this.clockLabel !== clockLabel) this.clockLabel = clockLabel
    if (Date.now() - (s.segmentStartedAt || s.startedAt) >= 21600000) { loadState(); this.onRemoteEnded(); return }
    const elapsed = Math.max(0, (s.pausedAt || Date.now()) - s.startedAt - (s.pausedMs || 0))
    const mins = Math.floor(elapsed / 60000)
    const secs = Math.floor((elapsed % 60000) / 1000)
    const elapsedLabel = mins + ':' + String(secs).padStart(2, '0')
    if (this.elapsedLabel !== elapsedLabel) this.elapsedLabel = elapsedLabel

    const left = s.restUntil ? Math.ceil((s.restUntil - Date.now()) / 1000) : 0
    if (s.restUntil && left <= 0) {
      this.reconcileRestClock()
      this.refresh()
      return
    }
    const restLabel = this.mmss(left)
    if (this.restLabel !== restLabel) this.restLabel = restLabel
    if (this.metricSecond === Math.floor(Date.now() / 1000)) return
    this.metricSecond = Math.floor(Date.now() / 1000)
    this.restTotalLabel = this.mmss(Math.round(s.restTargetSec || 0))
    // 休息进度用百分比表达（圆形表盘放不下动态圆弧，用这个等价表达 + 深色圆角容器）：
    // 剩余 / 目标时长；目标为 0 时只显示累计值。
    const totalSec = Math.round(s.restTargetSec || 0)
    this.restPctLabel = totalSec > 0
      ? '剩余 ' + Math.max(0, Math.min(100, Math.round(left / totalSec * 100))) + '% · ' + this.restTotalLabel
      : this.restTotalLabel
    const latest = loadState()
    if (latest.sid === s.sid) s.hr = latest.hr
    this.hrLabel = s.hr?.last && Date.now() - (s.hr.sampleAt || 0) < 15000 && !s.pausedAt ? '♥ ' + s.hr.last : '♥ --'
    this.kcalLabel = String((s.baseCalories || 0) + calories(s, s.profile, Math.max(0, ((s.pausedAt || Date.now()) - (s.segmentStartedAt || s.startedAt) - (s.pausedMs || 0)) / 60000)))
    const n = pendingCount()
    const sync = synchronizationStatus()
    this.syncWarning = persistenceStatus().failed || storageStatus().failed || sync.conflicts > 0 || sync.phonePending > 0 || n > 0 || !isConnected()
    this.syncLabel = persistenceStatus().failed || storageStatus().failed ? '存储失败，请保留应用' : sync.conflicts > 0 ? '存在冲突，请核对手机' : sync.phonePending > 0 ? '手机待处理 ' + sync.phonePending + ' 条' : n > 0 ? '待上传 ' + n + ' 条' : isConnected() ? (sync.lastCommitAt ? '已同步' : '已连接') : '离线记录'
  },

  showDiagnostics() {
    this.diagnosticSnapshot = transportDiagnostics()
    this.diagnosticPage = 0
    this.diagnosticOn = true
    this.renderDiagnostics()
  },
  renderDiagnostics() {
    const d = this.diagnosticSnapshot, head = d.head
    const events = d.events.slice().reverse(), pages = Math.max(1, Math.ceil(events.length / 2))
    this.diagnosticTitle = '同步诊断 ' + (this.diagnosticPage + 1) + '/' + pages
    this.diagnosticText = '队列 ' + d.pending + ' / 手机待处理 ' + d.phonePending + '\n连接 ' + d.connected + ' / ready ' + d.readyState + ' / v' + d.peerProtocol +
      '\n队头 ' + (head ? head.type + ' / 尝试 ' + head.attempts : '无') + '\n' +
      events.slice(this.diagnosticPage * 2, this.diagnosticPage * 2 + 2).map(e => new Date(e.at).toISOString().slice(11, 19) + 'Z ' + e.stage + ' ' + e.type +
        (e.code ? '\ncode=' + e.code : '') + (e.detail ? '\n' + e.detail : '')).join('\n')
  },
  nextDiagnostic() {
    const pages = Math.max(1, Math.ceil(this.diagnosticSnapshot.events.length / 2))
    this.diagnosticPage = (this.diagnosticPage + 1) % pages
    this.renderDiagnostics()
  },
  closeDiagnostics() { this.diagnosticOn = false; this.touchCancel(); this.focusCrown() },

  mmss(sec) {
    sec = Math.max(0, Math.round(sec))
    return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0')
  },

  emitEvent(ev) {
    sendEvent(ev)
    const latest = loadState()
    if (latest.sid === this.state.sid) this.state.pendingEdits = latest.pendingEdits || []
  },
  onPause() { this.setPaused(!this.state.pausedAt, Date.now(), true) },
  onRemotePause(msg) {
    if (msg.sid !== this.state.sid || msg.seq <= (this.state.pauseVersion || 0)) return
    this.setPaused(!!msg.paused, msg.at || Date.now(), false)
  },
  setPaused(paused, at, notify) {
    const s = this.state
    this.flushRestNudge()
    if (paused && !s.pausedAt) {
      s.restLeftSec = restOf(s).leftSec; s.restUntil = 0; s.pausedAt = at
      this.stopHrCapture()
    } else if (!paused && s.pausedAt) {
      s.pausedMs = (s.pausedMs || 0) + Math.max(0, at - s.pausedAt); s.pausedAt = 0
      s.restUntil = s.restLeftSec ? Date.now() + s.restLeftSec * 1000 : 0
      this.startHrCapture()
    }
    s.pauseVersion = at; s.restVersion = at; save(s)
    if (!paused) this.startHrCapture()
    if (notify) { this.emitEvent({ t: 'pause', sid: s.sid, paused, seq: at, at }); this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) }) }
    this.refresh()
  },
  askEnd() { this.finishOn = false; this.closeMode = 'end' },
  askAbandon() { this.closeMode = 'abandon' },
  cancelClose() {
    if (this.closeMode === 'complete') {
      if (Date.now() < this.completionIgnoreUntil) return
      // 继续训练后不因时钟、同步或页面恢复反复弹窗；出现未完成组才重新提示。
      this.state.completionAcknowledged = true
      save(this.state)
    }
    this.closeMode = ''
    this.focusCrown()
  },
  saveEnd() {
    if (this.closeMode === 'complete' && Date.now() < this.completionIgnoreUntil) return
    this.onEnd('saved')
  },
  discardEnd() { this.onEnd('discarded') },
  abandonEnd() { this.onEnd('abandoned') },
  onEnd(reason, notifyPhone = true) {
    if (typeof reason !== 'string') reason = 'manual'
    const s = this.state
    if (!s || !s.active) return
    this.cancelRestNudge()
    this.setRestScreenLock(false)
    this.stopHrCapture()
    const closedAt = Date.now()
    const session = reason === 'saved' ? endSession(s, s.profile) : null
    if (!session) closeSession(s.sid)
    if (notifyPhone) sendEvent({ t: 'session_close', sid: s.sid, disposition: reason, closedAt, at: closedAt,
      ...(session ? { workout: s.workout, startedAt: s.startedAt, weightUnit: s.weightUnit || 'kg', summary: { minutes: session.minutes, avgHr: session.avgHr, maxHr: session.maxHr, calories: session.calories, volume: session.volume }, completedSets: session.sets } : {}) })
    this.state = loadState()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    router.replace({ uri: reason === 'saved' ? '/Summary' : '/Index' })
  },
}

</script>

<template>
<div class="page" id="training" touch-focusable="true" onrotation="onRotation" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
  <div class="screen" if="{{ pageIndex === 0 && !closeMode }}">
    <div class="topbar">
      <div class="st" if="{{ syncWarning }}" onclick="showDiagnostics"><div class="dot"></div><text class="status">{{ syncLabel }}</text></div>
      <text class="clock now">{{ clockLabel }}</text>
    </div>

    <div class="training-panel compact" if="{{ !isRest }}">
      <list class="training-scroll"><list-item type="current-group" class="training-content">
      <text class="ex" onclick="openExercises">{{ exName }} ›</text>
      <text class="group {{ rowDone ? 'group-done' : '' }}">{{ groupLabel }}{{ rowDone ? ' · 已完成' : '' }}</text>
      <div class="inputs">
        <div class="field {{ rowDone ? 'field-done' : selectedField === 'w' ? 'field-selected' : '' }}" onclick="editWeight">
          <text class="fval">{{ weightNum }}</text>
          <text class="funit">{{ weightSuffix }}</text>
        </div>
        <div class="field {{ rowDone ? 'field-done' : selectedField === 'r' ? 'field-selected' : '' }}" onclick="editReps">
          <text class="fval">{{ repsNum }}</text>
          <text class="funit">{{ repsSuffix }}</text>
        </div>
      </div>
      <text class="input-notice" if="{{ inputNotice }}">{{ inputNotice }}</text>
      <div class="last-row" if="{{ lastOn }}" onclick="openLast"><text class="last-text">{{ lastLine }}</text></div>
      <div class="navrow">
        <input class="complete {{ rowDone || paused ? 'secondary' : '' }}" type="button" value="{{ paused ? '暂停' : rowDone ? '撤销完成' : '完成' }}" disabled="{{ paused }}" onclick="onCurrentSetAction" />
        <input class="effort-circle" type="button" if="{{ effortEntryOn }}" value="{{ effortScaleLabel + ' ' + effortEntryText }}" onclick="openEffort" />
      </div>
      <div class="set-dots">
        <input class="set-hit segment" if="{{ dotSegmented }}" type="button" value="‹" disabled="{{ !dotHasPrev }}" onclick="prevDotSegment" />
        <div class="set-hit" for="{{ item in setDots }}" onclick="pickSetDot(item)">
          <text class="set-dot {{ item.current ? 'set-current' : item.done ? 'set-done' : '' }}">{{ item.done ? '✓' : item.number }}</text>
        </div>
        <input class="set-hit segment" if="{{ dotSegmented }}" type="button" value="›" disabled="{{ !dotHasNext }}" onclick="nextDotSegment" />
      </div>
      </list-item></list>
    </div>

    <div class="training-panel rest-panel" if="{{ isRest }}">
      <list class="rest-scroll"><list-item type="rest-content" class="scroll-content">
      <text class="rest-ex">{{ restExerciseName }}</text>
      <text class="rest">{{ restLabel }}</text>
      <div class="rrow">
        <input class="rbtn" type="button" value="−15s" onclick="onRestMinus" />
        <text class="rest-total">{{ restPctLabel }}</text>
        <input class="rbtn" type="button" value="+15s" onclick="onRestPlus" />
      </div>
      <text class="next">{{ nextLabel }}</text>
      <text class="next-details">{{ nextDetails }}</text>
      <input class="effort-row" type="button" if="{{ effortEntryOn }}" value="{{ effortEntryLabel + '  ' + effortEntryText + '  ›' }}" onclick="openEffort" />
      <input class="skip" type="button" value="跳过休息" onclick="onSkipRest" />
      </list-item></list>
    </div>

    <div class="primary-footer">
      <text class="progress">{{ setProgressLabel }}</text>
      <text class="end-link" onclick="openFinish">结束 ›</text>
    </div>
  </div>

  <div class="screen operation-screen" if="{{ pageIndex === 1 && !closeMode }}">
    <div class="topbar">
      <div class="st" onclick="showDiagnostics"><div class="dot"></div><text class="status">{{ syncLabel }}</text></div>
      <text class="clock now">{{ clockLabel }}</text>
    </div>
    <list class="operation-scroll"><list-item type="operation-content" class="scroll-content">
    <text class="elapsed-label">已用时</text>
    <text class="elapsed-value">{{ elapsedLabel }}</text>
    <div class="metrics"><text class="energy">{{ kcalLabel }} 千卡</text><text class="hr">{{ hrLabel }}</text></div>
    <div class="op-card">
      <text class="op-title">{{ exName }}</text>
      <text class="op-group">{{ groupLabel }}</text>
      <div class="op-row"><text class="op-k">重量</text><text class="op-v">{{ weightNum }}</text><text class="op-u">{{ weightSuffix }}</text></div>
      <div class="op-row"><text class="op-k">次数</text><text class="op-v">{{ repsNum }}</text><text class="op-u">{{ repsSuffix }}</text></div>
    </div>
    <text class="volume-line">已完成容量 {{ volumeLabel }} {{ weightUnit }}·次</text>
    <input class="effort-row" type="button" if="{{ effortEntryOn }}" value="{{ effortEntryLabel + '  ' + effortEntryText + '  ›' }}" onclick="openEffort" />
    <div class="mrow">
      <input class="m" type="button" value="加组" onclick="onMenuAddSet" />
      <input class="m" type="button" value="减组" onclick="onMenuRemoveSet" />
    </div>
    <div class="mrow op-row2">
      <input class="m" type="button" value="{{ pauseLabel }}" onclick="onPause" />
      <input class="m m-end" type="button" value="结束训练" onclick="openFinish" />
    </div>
    </list-item></list>
  </div>

  <div class="pageIndicators" if="{{ !isRest && !closeMode }}"><div class="dot {{ pageIndex === 0 ? 'selected' : '' }}"></div><div class="dot {{ pageIndex === 1 ? 'selected' : '' }}"></div></div>

  <div class="completion-panel" if="{{ closeMode === 'complete' }}">
    <text class="completion-title">全部组已完成</text>
    <text class="completion-progress">{{ setProgressLabel }}</text>
    <input class="completion-btn effort" type="button" if="{{ effortEntryOn }}" value="{{ '登记本组强度 · ' + effortEntryText }}" onclick="openEffort" />
    <input class="completion-btn finish" type="button" value="保存结束" onclick="saveEnd" />
    <input class="completion-btn continue" type="button" value="继续训练" onclick="cancelClose" />
  </div>

  <div class="completion-panel confirm-panel" if="{{ closeMode === 'end' }}">
    <text class="confirm-title">结束本次训练？</text>
    <text class="confirm-remain">{{ confirmRemain }}</text>
    <text class="confirm-note">保留已记录的 RPE / RIR</text>
    <input class="pill confirm-save" type="button" value="保存并结束" onclick="saveEnd" />
    <input class="pill confirm-back" type="button" value="继续训练" onclick="cancelClose" />
  </div>

  <div class="effort-layer finish-layer" if="{{ finishOn && !closeMode }}">
    <text class="finish-name">{{ finishName }}</text>
    <div class="flag" onclick="askEnd">
      <div class="flag-inner"><div class="pole"></div><div class="pennant"></div></div>
    </div>
    <text class="finish-title" onclick="askEnd">结束训练</text>
    <text class="finish-count">{{ finishCount }}</text>
    <input class="last-effort" type="button" if="{{ lastEffortOn }}" value="{{ lastEffortText + '  ›' }}" onclick="openLastEffort" />
    <text class="finish-back" onclick="closeFinish">继续训练</text>
  </div>

  <div class="effort-layer last-layer" if="{{ lastOpen && !closeMode && !finishOn }}">
    <div class="last-head"><text class="last-back" onclick="closeLast">‹ 返回训练</text></div>
    <text class="last-title">{{ lastTitle }}</text>
    <text class="last-meta">{{ lastMeta }}</text>
    <list class="last-list" id="history" touch-focusable="true">
      <list-item class="last-item" type="historyRow" for="{{ r in lastRows }}" tid="key">
        <text class="last-no">{{ r.no }}</text>
        <text class="last-value">{{ r.label }}</text>
      </list-item>
    </list>
    <text class="last-hint">仅显示实际完成的工作组 · 不影响本次记录</text>
  </div>

  <div class="effort-layer diagnostic-layer" if="{{ diagnosticOn }}">
    <text class="effort-target">{{ diagnosticTitle }}</text>
    <text class="diagnostic-text">{{ diagnosticText }}</text>
    <div class="diagnostic-buttons">
      <input class="rbtn" type="button" value="返回" onclick="closeDiagnostics" />
      <input class="rbtn" type="button" value="下一页" onclick="nextDiagnostic" />
    </div>
  </div>
  <div class="effort-layer" if="{{ effortOn && !diagnosticOn }}">
    <list class="effort-scroll"><list-item type="effort-content" class="scroll-content">
    <div class="effort-head">
      <text class="effort-back" onclick="closeEffort">‹ 返回</text>
      <text class="effort-timer">{{ effortRestLabel }}</text>
    </div>
    <text class="effort-target">{{ effortTargetLabel }}</text>
    <text class="effort-scale">{{ effortScaleLabel }}</text>
    <div class="effort-pick">
      <text class="effort-arrow" onclick="effortMinus">−</text>
      <text class="effort-value">{{ effortDraftLabel }}</text>
      <text class="effort-arrow" onclick="effortPlus">+</text>
    </div>
    <text class="effort-hint">{{ effortNotice || effortHint }}</text>
    <text class="effort-meaning" if="{{ effortDraft != null }}">{{ effortMeaning }}</text>
    <input class="effort-ok" type="button" value="确认登记" onclick="confirmEffort" />
    <text class="effort-clear" if="{{ effortHasSaved }}" onclick="clearEffort">清除登记</text>
    </list-item></list>
  </div>
</div>
</template>

<style>
/* v1.4.4 Wear OS 视觉令牌（逐页同值声明，BlueOS 无全局变量）
   background #000000 · primary #30D158 · primaryText #000000 · tile #1C1C1E · tileHigh #2C2C2E
   text #FFFFFF · muted #A1A1A6 · warm #FF9F0A · danger #FF453A · effort #E0C775
   方屏触控目标 48；圆屏沿用已验证的紧凑尺寸（280x300 安全区放不下 48 高的 7 行）。 */
.diagnostic-layer { padding-top: 24px; }
.diagnostic-text { width: 326px; height: 264px; font-size: 16px; line-height: 18px; color: #FFFFFF; lines: 14; }
.diagnostic-buttons { width: 326px; flex-direction: row; justify-content: space-between; }
.page { flex-direction: column; align-items: center; width: 100%; height: 100%; background-color: #000000; }
.screen { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; justify-content: space-between; }

.topbar { width: 326px; height: 24px; flex-direction: row; align-items: center; justify-content: space-between; }
.st { flex-direction: row; align-items: center; }
.dot { width: 7px; height: 7px; border-radius: 4px; background-color: #30D158; margin-right: 7px; }
.status { font-size: 14px; color: #30D158; lines: 1; }
.clock { font-size: 15px; color: #A1A1A6; lines: 1; }
.now { color: #FFFFFF; font-size: 17px; }
.metabar { width: 326px; height: 20px; flex-direction: row; align-items: center; justify-content: space-between; }
.metabar-r { flex-direction: row; align-items: center; }
.metabar-r .energy { margin-right: 10px; }

.training-panel { width: 350px; flex-direction: column; align-items: center; justify-content: center; }
/* 330 = 动作名 40 + 组数 26 + 主数值 112 + 上/完成/下 56 + 上次 40 + 评分入口 52。
   主数值 60、动作名 28 是 V4 的字号硬指标，不能为了塞下“上次”把主数字缩小。 */
.compact { height: 330px; }
.ex { width: 350px; height: 40px; font-size: 28px; color: #FFFFFF; lines: 1; text-align: center; }
.group { width: 350px; height: 26px; font-size: 20px; color: #30D158; text-align: center; lines: 1; }
.group-done { color: #A1A1A6; }
.inputs { flex-direction: row; justify-content: space-between; width: 350px; height: 88px; margin-top: 10px; margin-bottom: 10px; }
.field { flex-direction: column; align-items: center; justify-content: center; width: 170px; height: 88px; border-radius: 16px; background-color: #1C1C1E; }
.field-done { border: 2px solid #30D158; background-color: #2C2C2E; }
.fval { font-size: 60px; color: #FFFFFF; width: 166px; text-align: center; lines: 1; }
.funit { font-size: 14px; color: #A1A1A6; margin-top: 2px; lines: 1; }
.navrow { flex-direction: row; align-items: center; justify-content: space-between; width: 350px; height: 56px; }
.nav { width: 70px; height: 56px; font-size: 22px; border-radius: 14px; background-color: #1C1C1E; color: #FFFFFF; }
.complete { width: 186px; height: 56px; font-size: 25px; border-radius: 14px; background-color: #30D158; color: #000000; }
.secondary { background-color: #2C2C2E; color: #A1A1A6; }

.rest-panel { height: 336px; justify-content: flex-start; background-color: #1C1C1E; border-radius: 20px; padding-top: 8px; }
.rest-ex { width: 350px; height: 48px; line-height: 24px; font-size: 20px; color: #FFFFFF; text-align: center; lines: 2; }
.rest { width: 350px; height: 76px; line-height: 72px; font-size: 58px; color: #FFFFFF; text-align: center; lines: 1; }
.rrow { flex-direction: row; align-items: center; justify-content: space-between; width: 350px; height: 48px; margin-top: 8px; }
.rbtn { width: 92px; height: 48px; font-size: 19px; border-radius: 12px; background-color: #2C2C2E; color: #FFFFFF; }
.rest-total { width: 150px; font-size: 16px; color: #A1A1A6; text-align: center; lines: 1; }
.next { width: 350px; height: 22px; line-height: 22px; margin-top: 4px; font-size: 16px; color: #30D158; text-align: center; lines: 1; }
.next-details { width: 350px; height: 22px; line-height: 22px; font-size: 17px; color: #FFFFFF; text-align: center; lines: 1; }
.skip { width: 350px; height: 48px; font-size: 19px; border-radius: 12px; background-color: #2C2C2E; color: #FFFFFF; margin-top: 6px; }
.rest-panel .effort-row { height: 44px; margin-top: 6px; font-size: 16px; }

.effort-row { width: 350px; height: 48px; font-size: 18px; color: #E0C775; background-color: #1C1C1E; border: 1px solid #2C2C2E; border-radius: 12px; text-align: left; padding-left: 14px; }
.compact .effort-row { height: 48px; margin-top: 4px; }
/* 上次：只读摘要行，整行可点，超长省略；打开的是同页详情，不是新路由。 */
.last-row { width: 350px; height: 36px; flex-direction: row; align-items: center; margin-top: 4px; }
.last-text { width: 350px; font-size: 20px; color: #929297; lines: 1; }
.primary-footer { width: 326px; height: 24px; flex-direction: row; align-items: center; justify-content: space-between; }
.progress { font-size: 15px; color: #A1A1A6; }
.end-link { font-size: 18px; color: #30D158; }
.footer-metrics { width: 326px; height: 20px; flex-direction: row; align-items: center; justify-content: space-between; }
.hr { font-size: 15px; color: #FF9F0A; }
.energy { font-size: 15px; color: #FF9F0A; }

.pageIndicators { position: absolute; right: 10px; top: 96px; width: 8px; height: 30px; flex-direction: column; justify-content: space-between; }
.pageIndicators .dot { width: 7px; height: 7px; border-radius: 4px; background-color: #3A3A3C; margin-right: 0; }
.pageIndicators .selected { background-color: #30D158; }

.operation-screen { justify-content: flex-start; }
.op-card { width: 350px; height: 186px; flex-direction: column; background-color: #1C1C1E; border-radius: 16px; padding: 12px 14px; margin-top: 6px; }
.op-title { width: 318px; height: 50px; font-size: 22px; color: #FFFFFF; lines: 2; }
.op-group { width: 318px; height: 22px; font-size: 16px; color: #30D158; }
.op-row { width: 318px; height: 40px; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 4px; }
.op-k { font-size: 16px; color: #A1A1A6; }
.op-v { font-size: 26px; color: #FFFFFF; }
.op-u { font-size: 13px; color: #A1A1A6; }
.volume-line { width: 350px; height: 26px; font-size: 16px; color: #A1A1A6; text-align: center; margin-top: 6px; }
.operation-screen .effort-row { margin-top: 4px; }
.operation-screen .metrics { margin-top: 4px; }
.metrics { width: 326px; height: 24px; flex-direction: row; align-items: center; justify-content: space-between; }
.mrow { width: 350px; height: 52px; flex-direction: row; justify-content: space-between; }
.op-row2 { margin-top: 6px; }
.m { width: 170px; height: 52px; font-size: 20px; border-radius: 14px; background-color: #1C1C1E; color: #FFFFFF; }
.m-end { color: #30D158; }
.operation { width: 350px; height: 52px; margin-top: 6px; border-radius: 14px; font-size: 20px; background-color: #1C1C1E; color: #FFFFFF; }

.completion-panel { width: 350px; height: 414px; margin-top: 18px; flex-direction: column; align-items: center; justify-content: center; }
.completion-title { width: 350px; height: 40px; font-size: 26px; color: #FFFFFF; text-align: center; }
.completion-progress { width: 350px; height: 28px; font-size: 16px; color: #A1A1A6; text-align: center; }
.completion-btn { width: 310px; height: 52px; margin-top: 12px; font-size: 21px; border-radius: 14px; }
.completion-btn.effort { background-color: #1C1C1E; color: #E0C775; border: 1px solid #2C2C2E; }
.finish { background-color: #30D158; color: #000000; }
.continue { background-color: #1C1C1E; color: #FFFFFF; }

/* 结束确认：先说明还有几组没做，只有“保存并结束”才走既有结算。 */
.confirm-title { width: 350px; height: 44px; font-size: 29px; color: #FFFFFF; text-align: center; lines: 1; margin-top: 8px; }
.confirm-remain { width: 336px; height: 56px; font-size: 20px; color: #B5B5BD; text-align: center; lines: 2; margin-top: 10px; }
.confirm-note { width: 336px; height: 26px; font-size: 18px; color: #929297; text-align: center; lines: 1; margin-top: 2px; }
.pill { width: 336px; height: 60px; margin-top: 12px; font-size: 23px; border-radius: 30px; background-color: #0A3418; color: #30D158; }
.pill.confirm-back { background-color: #202023; color: #DDDDDD; }

/* 结束入口：计划名 / 大绿圆旗帜 / 结束训练 / 已完成组数 / 末组评分 / 继续训练。
   旗帜只发起确认：模板里它调用 askEnd()，从不直接 endSession。 */
.finish-layer { justify-content: flex-start; }
.finish-name { width: 350px; height: 34px; font-size: 24px; color: #AAAAAA; text-align: center; lines: 1; margin-top: 26px; }
.flag { width: 132px; height: 132px; border-radius: 66px; background-color: #30D158; margin-top: 12px; flex-direction: row; align-items: center; justify-content: center; }
.flag-inner { width: 54px; height: 68px; flex-direction: row; align-items: flex-start; }
.pole { width: 8px; height: 64px; background-color: #000000; }
.pennant { width: 44px; height: 38px; background-color: #000000; border-radius: 0 10px 10px 0; margin-top: 2px; }
.finish-title { width: 350px; height: 44px; font-size: 29px; color: #30D158; text-align: center; lines: 1; margin-top: 8px; }
.finish-count { width: 350px; height: 28px; font-size: 20px; color: #939399; text-align: center; lines: 1; margin-top: 4px; }
.last-effort { width: 336px; height: 52px; margin-top: 12px; font-size: 19px; border-radius: 26px; background-color: #171719; color: #CCCCCC; }
.finish-back { width: 336px; height: 44px; margin-top: 8px; font-size: 19px; color: #30D158; text-align: center; line-height: 44px; }

/* 上次详情：同页只读覆盖层，纵向滚到底，所有已完成工作组按原序列出。 */
.last-layer { justify-content: flex-start; }
.last-head { width: 350px; height: 40px; flex-direction: row; align-items: center; margin-top: 14px; }
.last-back { font-size: 20px; color: #30D158; }
.last-title { width: 350px; height: 38px; font-size: 28px; color: #FFFFFF; lines: 1; margin-top: 2px; }
.last-meta { width: 350px; height: 26px; font-size: 19px; color: #929297; lines: 1; margin-top: 2px; }
.last-list { width: 350px; height: 224px; margin-top: 6px; }
.last-item { width: 350px; height: 56px; flex-direction: row; align-items: center; border-bottom: 1px solid #212124; }
.last-no { width: 108px; font-size: 17px; color: #929297; }
.last-value { width: 242px; font-size: 28px; color: #FFFFFF; lines: 1; }
.last-hint { width: 330px; height: 44px; font-size: 18px; color: #929297; text-align: center; lines: 2; margin-top: 6px; }

.effort-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; }
.effort-head { width: 350px; height: 34px; margin-top: 18px; flex-direction: row; align-items: center; justify-content: space-between; }
.effort-back { font-size: 17px; color: #A1A1A6; }
.effort-timer { font-size: 17px; color: #30D158; }
.effort-target { width: 350px; height: 48px; font-size: 17px; color: #A1A1A6; text-align: center; lines: 2; }
.effort-scale { width: 350px; height: 20px; font-size: 14px; color: #A1A1A6; text-align: center; }
.effort-pick { width: 350px; height: 108px; flex-direction: row; align-items: center; justify-content: space-between; }
.effort-arrow { width: 64px; height: 108px; font-size: 40px; color: #30D158; text-align: center; line-height: 108px; }
.effort-value { width: 170px; font-size: 66px; color: #FFFFFF; text-align: center; lines: 1; }
.effort-hint { width: 350px; height: 22px; font-size: 15px; color: #A1A1A6; text-align: center; lines: 1; }
.effort-meaning { width: 330px; height: 44px; font-size: 18px; color: #E0C775; text-align: center; lines: 2; margin-top: 4px; }
.effort-ok { width: 300px; height: 52px; margin-top: 10px; font-size: 21px; border-radius: 14px; background-color: #30D158; color: #000000; }
.effort-clear { width: 300px; height: 40px; font-size: 16px; color: #FF453A; text-align: center; line-height: 40px; }

@media screen and (min-width: 450px) {
  .diagnostic-layer { padding-top: 70px; }
  .diagnostic-text { width: 280px; height: 232px; font-size: 13px; line-height: 16px; }
  .diagnostic-buttons { width: 280px; }
  .screen { width: 280px; height: 300px; margin-top: 70px; }
  .topbar, .metabar, .primary-footer, .footer-metrics, .metrics { width: 260px; }
  .topbar { height: 20px; }
  .metabar { height: 18px; }
  .training-panel { width: 280px; }
  .compact { height: 240px; }
  .compact .effort-row { height: 38px; }
  .rest-panel { height: 230px; padding-top: 4px; border-radius: 16px; }
  .ex { width: 280px; height: 32px; font-size: 18px; }
  .group { width: 280px; height: 20px; font-size: 16px; }
  .inputs { width: 280px; height: 54px; margin-top: 4px; margin-bottom: 6px; }
  .field { width: 136px; height: 54px; border-radius: 12px; }
  .fval { width: 132px; font-size: 26px; }
  .funit { font-size: 12px; }
  .navrow { width: 280px; height: 44px; }
  .nav { width: 56px; height: 44px; font-size: 19px; }
  .complete { width: 150px; height: 44px; font-size: 20px; }
  .rest-ex { width: 280px; height: 36px; line-height: 18px; font-size: 15px; }
  .rest { width: 280px; height: 52px; line-height: 52px; font-size: 42px; }
  .rrow { width: 280px; height: 32px; margin-top: 8px; }
  .rbtn { width: 84px; height: 32px; font-size: 15px; }
  .rest-total { width: 100px; font-size: 13px; }
  .next { width: 280px; height: 18px; line-height: 18px; margin-top: 2px; font-size: 14px; }
  .next-details { width: 280px; height: 18px; line-height: 18px; font-size: 14px; }
  .skip { width: 280px; height: 30px; margin-top: 2px; font-size: 16px; }
  .rest-panel .effort-row { height: 28px; margin-top: 2px; font-size: 13px; }
  .effort-row { width: 280px; height: 34px; font-size: 15px; padding-left: 10px; }
  .primary-footer { height: 20px; }
  .progress { font-size: 13px; }
  .footer-metrics { height: 16px; }
  .hr, .energy { font-size: 13px; }
  .pageIndicators { right: 22px; top: 104px; }
  .op-card { width: 280px; height: 150px; padding: 8px 10px; border-radius: 14px; }
  .op-title { width: 256px; height: 40px; font-size: 18px; }
  .op-group { width: 256px; height: 18px; font-size: 14px; }
  .op-row { width: 256px; height: 30px; }
  .op-v { font-size: 20px; }
  .volume-line { width: 280px; height: 20px; font-size: 14px; }
  .m { width: 136px; height: 42px; font-size: 18px; }
  .operation { width: 280px; height: 42px; font-size: 19px; }
  .mrow { width: 280px; height: 42px; }
  .metrics { height: 20px; }
  .completion-panel { width: 280px; height: 300px; margin-top: 70px; }
  .completion-title { width: 280px; height: 34px; font-size: 22px; }
  .completion-progress { width: 280px; height: 22px; font-size: 15px; }
  .completion-btn { width: 250px; height: 42px; margin-top: 8px; font-size: 19px; }
  .confirm-title { width: 280px; height: 34px; font-size: 22px; }
  .confirm-remain { width: 264px; height: 40px; font-size: 15px; }
  .confirm-note { width: 264px; height: 20px; font-size: 13px; }
  .pill { width: 264px; height: 40px; margin-top: 8px; font-size: 18px; }
  .finish-name { width: 280px; height: 26px; font-size: 19px; margin-top: 14px; }
  .flag { width: 114px; height: 114px; border-radius: 57px; margin-top: 8px; }
  .flag-inner { width: 46px; height: 58px; }
  .pole { width: 7px; height: 54px; }
  .pennant { width: 38px; height: 32px; }
  .finish-title { width: 280px; height: 34px; font-size: 22px; margin-top: 6px; }
  .finish-count { width: 280px; height: 22px; font-size: 15px; }
  .last-effort { width: 264px; height: 38px; font-size: 14px; margin-top: 8px; }
  .finish-back { width: 264px; height: 34px; font-size: 15px; line-height: 34px; margin-top: 4px; }
  .last-head { width: 280px; height: 30px; margin-top: 10px; }
  .last-back { font-size: 15px; }
  .last-title { width: 280px; height: 28px; font-size: 20px; }
  .last-meta { width: 280px; height: 20px; font-size: 14px; }
  .last-list { width: 280px; height: 150px; margin-top: 4px; }
  .last-item { width: 280px; height: 42px; }
  .last-no { width: 86px; font-size: 13px; }
  .last-value { width: 194px; font-size: 20px; }
  .last-hint { width: 264px; height: 32px; font-size: 13px; margin-top: 4px; }
  .last-text { width: 280px; font-size: 15px; }
  .last-row { width: 280px; height: 28px; margin-top: 2px; }
  .end-link { font-size: 15px; }
  .effort-head { width: 280px; height: 28px; margin-top: 14px; }
  .effort-back, .effort-timer { font-size: 14px; }
  .effort-target { width: 280px; height: 38px; font-size: 14px; }
  .effort-scale { width: 280px; height: 18px; font-size: 12px; }
  .effort-pick { width: 280px; height: 78px; }
  .effort-arrow { width: 52px; height: 78px; font-size: 30px; line-height: 78px; }
  .effort-value { width: 140px; font-size: 48px; }
  .effort-hint { width: 280px; height: 18px; font-size: 13px; }
  .effort-meaning { width: 270px; height: 34px; font-size: 15px; }
  .effort-ok { width: 240px; height: 40px; font-size: 18px; }
  .effort-clear { width: 240px; height: 32px; font-size: 14px; line-height: 32px; }
}

/* 390 × 390（紧凑高度）：同一套结构只收紧高度和数值，不按表形猜测新增分流。
   只覆盖本轮引入的元素（当前组、上次摘要与详情、结束入口与确认）；休息/评分/编辑的
   紧凑排版属于 V3 任务书，本轮不改，也不假装已在真机验证。若设备不支持 max-height，
   这一段不生效，排版退回上面的 390×450。 */
@media screen and (max-height: 420px) {
  .screen { height: 354px; margin-top: 12px; }
  .topbar { height: 22px; }
  .now { font-size: 24px; }
  .ex { height: 36px; font-size: 26px; }
  .group { height: 24px; font-size: 18px; }
  .inputs { height: 80px; margin-top: 8px; margin-bottom: 8px; }
  .field { height: 80px; }
  .fval { font-size: 56px; }
  .navrow { height: 52px; }
  .nav { height: 52px; }
  .complete { height: 52px; }
  .compact { height: 286px; }
  .last-row { height: 32px; }
  .last-text { font-size: 18px; }
  .effort-row { height: 44px; }
  .flag { width: 114px; height: 114px; border-radius: 57px; }
  .flag-inner { width: 46px; height: 58px; }
  .pole { width: 7px; height: 54px; }
  .pennant { width: 38px; height: 32px; }
  .completion-panel { height: 390px; margin-top: 0; }
  .last-list { height: 200px; }
}
/* V5: scrollable current group; retain readable numbers instead of squeezing every row. */
.training-scroll { width: 350px; height: 330px; }
.training-content { width: 350px; flex-direction: column; align-items: center; }
.ex { height: 68px; line-height: 34px; lines: 2; color: #F4F7F5; }
.field { background-color: #242725; border-radius: 20px; }
.field-selected { border: 2px solid #30D158; }
.input-notice { width: 350px; height: 44px; font-size: 18px; color: #E9BD70; lines: 2; }
.navrow { height: 100px; justify-content: center; margin-top: 4px; }
.complete { width: 96px; height: 96px; border-radius: 48px; font-size: 23px; }
.effort-circle { width: 72px; height: 72px; border-radius: 36px; margin-left: 20px; font-size: 15px; background-color: #242725; color: #E0C775; }
.set-dots { width: 350px; height: 88px; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 6px; }
.set-hit { width: 44px; height: 44px; justify-content: center; align-items: center; }
.set-dot { width: 28px; height: 28px; line-height: 28px; border-radius: 14px; font-size: 15px; text-align: center; background-color: #242725; color: #F4F7F5; }
.set-current { border: 2px solid #30D158; color: #30D158; }
.set-done { color: #929297; }
.segment { background-color: #000000; color: #929297; font-size: 24px; }
.now { font-size: 26px; }
@media screen and (max-height: 420px) {
  .training-scroll { height: 286px; }
  .complete { width: 90px; height: 90px; border-radius: 45px; }
  .ex { height: 64px; line-height: 32px; }
  .now { font-size: 24px; }
}
@media screen and (min-width: 450px) {
  .training-scroll { width: 280px; height: 240px; }
  .training-content { width: 280px; }
  .ex { width: 280px; }
  .set-dots { width: 280px; }
}
/* V5 readable values. Lists intentionally scroll; content must not be squeezed into the viewport. */
.scroll-content { width: 350px; flex-direction: column; align-items: center; }
.rest-scroll { width: 350px; height: 328px; }
.operation-scroll { width: 350px; height: 382px; }
.effort-scroll { width: 350px; height: 414px; margin-top: 18px; }
.effort-head { margin-top: 0; height: 44px; }
.rest { height: 130px; line-height: 130px; font-size: 104px; }
.next-details { height: 48px; line-height: 48px; font-size: 36px; }
.effort-pick { height: 112px; }
.effort-value { font-size: 88px; height: 112px; line-height: 112px; }
.effort-clear { height: 44px; line-height: 44px; }
.elapsed-label { width: 350px; height: 28px; font-size: 20px; color: #929297; }
.elapsed-value { width: 350px; height: 106px; line-height: 106px; font-size: 84px; color: #F4F7F5; lines: 1; }
@media screen and (max-height: 420px) {
  .rest-panel { height: 300px; }
  .rest-scroll { height: 292px; }
  .operation-scroll { height: 330px; }
  .effort-scroll { height: 354px; margin-top: 12px; }
