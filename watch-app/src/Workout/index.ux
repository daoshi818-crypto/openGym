<script>
// 主训练页（单屏 + 手势）：重量/次数保持可见，休息态只保留必要操作。
import router from '@blueos.app.appmanager.router'
import {
  loadState, save, replacePlan, toggleSet, nextUndone,
  addHr, flushHr, endSession, addSet, removeSet, addRestTime,
} from '../lib/session.js'
import { startHr, stopHr, tick, restOver } from '../lib/sensors.js'
import { startServer, sendEvent, sendControl, pendingCount, isConnected } from '../lib/ble.js'

export default {
  data: {
    exName: '',
    groupLabel: '',
    elapsedLabel: '',
    weightVal: '—',
    repsVal: '—',
    restLabel: '0:00',
    restTotalLabel: '0:00',
    restProgLabel: '',
    nextLabel: '',
    hrLabel: '♥ --',
    syncLabel: '',
    isRest: false,
    menuOn: false,
    allFinished: false,
  },

  onInit() {
    const s = loadState()
    if (!s.active || !s.workout) { router.push({ uri: '/Index' }); return }
    this.state = s
    this.profile = s.profile || null
    this.restSeq = 0
    this.remoteRestSeq = 0
    this.restStartAt = 0
    this.hrLast = 0
    this.hrDirty = false
    this.hrActive = false
    this.clockPeriod = 0
    this.touch = null

    startServer({
      onPlan: (msg) => this.onPlanUpdate(msg),
      onRest: (msg) => this.onRemoteRest(msg),
      onUnset: (msg) => this.onRemoteUnset(msg),
    })

    const next = nextUndone(s)
    if (next) { s.exIdx = next.exIdx; s.setIdx = next.setIdx }
    else this.allFinished = true

    if (s.restUntil && s.restUntil <= Date.now()) {
      s.restUntil = 0
      save(s)
      restOver()
    }

    this.hrFlush = setInterval(() => {
      if (this.hrDirty) {
        flushHr(this.state)
        this.hrDirty = false
      }
    }, 15000)

    this.startHrCapture()
    this.refresh()
  },

  onShow() {
    // Keypad/动作列表独立读取并保存会话，返回训练页时重新读取，确保重量立即回显。
    const latest = loadState()
    if (latest.active && latest.workout) {
      this.state = latest
      this.profile = latest.profile || null
    }
    this.startHrCapture()
    this.refresh()
  },

  onHide() {
    this.stopHrCapture()
  },

  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    this.stopHrCapture()
  },

  startHrCapture() {
    if (this.hrActive || !this.state || !this.state.active) return
    this.hrActive = true
    startHr((bpm) => {
      addHr(this.state, bpm)
      this.hrLast = bpm
      this.hrDirty = true
    })
  },

  stopHrCapture() {
    if (!this.hrActive) return
    stopHr()
    this.hrActive = false
    if (this.hrDirty && this.state) {
      flushHr(this.state)
      this.hrDirty = false
    }
  },

  touchStart(e) {
    const t = e.touches && e.touches[0]
    this.touch = t ? { x: t.clientX, y: t.clientY } : null
  },

  touchEnd(e) {
    if (!this.touch) return
    const t = e.changedTouches && e.changedTouches[0]
    if (!t) return
    const dx = t.clientX - this.touch.x
    const dy = t.clientY - this.touch.y
    this.touch = null
    if (Math.abs(dx) < 60 && Math.abs(dy) < 60) return
    if (dy < -60 && Math.abs(dx) < 60) this.menuOn = true
    else if (dx < -60 && Math.abs(dy) < 60) router.push({ uri: '/ExerciseList' })
    else if (dy > 60 && this.menuOn) this.menuOn = false
  },

  closeMenu() { this.menuOn = false },

  onMenuAddSet() {
    addSet(this.state, this.state.exIdx)
    this.state.setIdx = this.state.workout.rows[this.state.exIdx].length - 1
    this.menuOn = false
    this.refresh()
  },

  onMenuRemoveSet() {
    removeSet(this.state, this.state.exIdx)
    this.menuOn = false
    this.refresh()
  },

  onMenuPrev() { this.menuOn = false; this.stepSet(-1) },
  onMenuNext() { this.menuOn = false; this.stepSet(1) },

  stepSet(dir) {
    const s = this.state
    const rows = s.workout.rows[s.exIdx]
    if (!rows) return
    let ni = s.setIdx + dir
    let nx = s.exIdx
    if (ni < 0) {
      if (nx <= 0) return
      nx -= 1; ni = s.workout.rows[nx].length - 1
    } else if (ni >= rows.length) {
      if (nx >= s.workout.rows.length - 1) return
      nx += 1; ni = 0
    }
    s.exIdx = nx; s.setIdx = ni
    save(s)
    this.refresh()
  },

  onPrevSet() { this.stepSet(-1) },
  onNextSet() { this.stepSet(1) },

  editWeight() {
    if (this.isRest || this.isDoneRowCur()) return
    router.push({ uri: '/Keypad', params: { exIdx: this.state.exIdx, setIdx: this.state.setIdx, field: 'w' } })
  },

  editReps() {
    if (this.isRest || this.isDoneRowCur()) return
    router.push({ uri: '/Keypad', params: { exIdx: this.state.exIdx, setIdx: this.state.setIdx, field: 'r' } })
  },

  onComplete() {
    const s = this.state
    const exIdx = s.exIdx, setIdx = s.setIdx
    const row = toggleSet(s, true)
    if (!row) return
    sendEvent({ t: 'set', sid: s.sid, ex: exIdx, set: setIdx + 1, reps: row.r != null ? String(row.r) : '', weight: row.w != null ? String(row.w) : '', at: row.at })
    tick()
    const next = nextUndone(s)
    if (next) { s.exIdx = next.exIdx; s.setIdx = next.setIdx; save(s) }
    else this.allFinished = true
    this.refresh()
  },

  onUndo() {
    const s = this.state
    const exIdx = s.exIdx, setIdx = s.setIdx
    const row = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!row || !row.done) return
    toggleSet(s, false)
    sendControl({ t: 'unset', sid: s.sid, ex: exIdx, set: setIdx + 1 })
    this.refresh()
  },

  onRemoteUnset(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || !row.done) return
    row.done = false
    row.at = 0
    save(s)
    this.refresh()
  },

  onSkipRest() {
    const s = this.state
    if (s.restUntil && this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
    s.restUntil = 0
    this.restStartAt = 0
    this.restSeq += 1
    sendControl({ t: 'rest', sid: s.sid, leftSec: 0, totalSec: 0, seq: this.restSeq })
    save(s)
    this.refresh()
  },

  nudgeRest(deltaSec) {
    const s = this.state
    if (!s.restUntil) return
    const left = Math.max(0, Math.round((s.restUntil - Date.now()) / 1000) + deltaSec)
    if (left <= 0) {
      if (this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
      s.restUntil = 0
      this.restStartAt = 0
    } else {
      s.restUntil = Date.now() + left * 1000
      this.restSeq += 1
      sendControl({ t: 'rest', sid: s.sid, leftSec: left, totalSec: left, seq: this.restSeq })
    }
    save(s)
    this.refresh()
  },

  onRestMinus() { this.nudgeRest(-15) },
  onRestPlus() { this.nudgeRest(15) },

  onPlanUpdate(msg) {
    const s = this.state
    if (msg && msg.sid && s.sid && msg.sid !== s.sid) return
    replacePlan(s, { name: msg.workout, exercises: msg.exercises })
    const next = nextUndone(s)
    if (next) { s.exIdx = next.exIdx; s.setIdx = next.setIdx; this.allFinished = false }
    else this.allFinished = true
    save(s)
    this.refresh()
  },

  onRemoteRest(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    if (typeof msg.seq === 'number' && msg.seq <= this.remoteRestSeq) return
    if (typeof msg.seq === 'number') this.remoteRestSeq = msg.seq
    if (msg.leftSec > 0 && !s.restUntil) this.restStartAt = Date.now()
    s.restUntil = msg.leftSec > 0 ? Date.now() + msg.leftSec * 1000 : 0
    if (!s.restUntil) this.restStartAt = 0
    save(s)
    this.refresh()
  },

  isDoneRowCur() {
    const s = this.state
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    return !!(row && row.done)
  },

  refresh() {
    const s = this.state
    if (!s || !s.workout) return
    const ex = s.workout.exercises[s.exIdx]
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    this.exName = ex ? ex.name : ''
    this.groupLabel = ex ? '第 ' + (s.setIdx + 1) + ' / ' + (ex.sets || 1) + ' 组' : ''
    this.weightVal = row && row.w !== '' && row.w != null ? row.w + ' kg' : '—'
    this.repsVal = row && row.r !== '' && row.r != null ? row.r + (this.isTimed(ex) ? ' 秒' : ' 次') : '—'
    this.isRest = !!(row && !row.done && s.restUntil)
    this.menuOn = false

    const next = nextUndone(s)
    const totalSets = s.workout.rows.reduce((n, r) => n + r.length, 0)
    const doneSets = s.workout.rows.reduce((n, r) => n + r.filter(x => x.done).length, 0)
    this.restProgLabel = '✓ ' + doneSets + '/' + totalSets + ' 组'
    if (next) {
      const ne = s.workout.exercises[next.exIdx]
      const nr = s.workout.rows[next.exIdx][next.setIdx]
      const w = nr && nr.w !== '' && nr.w != null ? nr.w + 'kg' : ''
      const timed = ne && String(ne.reps || '').indexOf('秒') >= 0
      const r = nr && nr.r !== '' && nr.r != null ? nr.r + (timed ? '秒' : '次') : ''
      this.nextLabel = '下一组 ' + ne.name + ' ' + (w && r ? w + '×' + r : (w || r || ''))
    } else this.nextLabel = '本次训练已完成'

    this.syncClockTimer()
    this.tickClock()
  },

  isTimed(ex) { return ex && String(ex.reps || '').indexOf('秒') >= 0 },

  syncClockTimer() {
    const period = this.state && this.state.restUntil ? 1000 : 5000
    if (this.timer && this.clockPeriod === period) return
    if (this.timer) clearInterval(this.timer)
    this.clockPeriod = period
    this.timer = setInterval(() => this.tickClock(), period)
  },

  tickClock() {
    const s = this.state
    if (!s || !s.workout) return
    const mins = Math.floor((Date.now() - s.startedAt) / 60000)
    const secs = Math.floor(((Date.now() - s.startedAt) % 60000) / 1000)
    this.elapsedLabel = mins + ':' + String(secs).padStart(2, '0')

    const left = s.restUntil ? Math.ceil((s.restUntil - Date.now()) / 1000) : 0
    if (s.restUntil && left <= 0) {
      if (this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
      this.restStartAt = 0
      s.restUntil = 0
      save(s)
      restOver()
      this.refresh()
      return
    }
    this.restLabel = this.mmss(left)
    this.restTotalLabel = this.mmss(Math.round(s.restTotalSec || 0))
    this.hrLabel = this.hrLast ? '♥ ' + this.hrLast : '♥ --'
    const n = pendingCount()
    this.syncLabel = isConnected() ? '已同步' : (n > 0 ? '未同步 ' + n + ' 条' : '')
  },

  mmss(sec) {
    sec = Math.max(0, Math.round(sec))
    return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0')
  },

  onEnd() {
    const s = this.state
    this.stopHrCapture()
    const session = endSession(s, s.profile)
    sendEvent({
      t: 'end', sid: session.sid, minutes: session.minutes, avgHr: session.avgHr,
      maxHr: session.maxHr, calories: session.calories, sets: session.sets.length,
    })
    storageSetSummary(session)
    router.push({ uri: '/Summary' })
  },
}

import storage from '@blueos.storage.storage'
import { pushSession } from '../lib/cloud.js'
function storageSetSummary(session) {
  storage.set({
    key: 'summary_last',
    value: { minutes: session.minutes, sets: session.sets.length, calories: session.calories, avgHr: session.avgHr },
    fail: () => {},
  })
  pushSession(session).catch(() => {})
}
</script>

<template>
  <div class="page" ontouchstart="touchStart" ontouchend="touchEnd">
    <text class="ex">{{ exName }}</text>

    <block if="{{ !isRest }}">
      <text class="group">{{ groupLabel }} · {{ elapsedLabel }}</text>
      <div class="inputs">
        <div class="field" onclick="editWeight">
          <text class="fval">{{ weightVal }}</text>
          <text class="flbl">重量</text>
        </div>
        <div class="field" onclick="editReps">
          <text class="fval">{{ repsVal }}</text>
          <text class="flbl">次数</text>
        </div>
      </div>
      <div class="navrow">
        <input class="nav" type="button" value="‹ 上组" onclick="onPrevSet" />
        <input class="nav" type="button" value="下组 ›" onclick="onNextSet" />
      </div>
    </block>

    <block if="{{ isRest }}">
      <text class="rest">{{ restLabel }}</text>
      <div class="rrow">
        <input class="rbtn" type="button" value="−15s" onclick="onRestMinus" />
        <text class="rtotal">{{ restTotalLabel }}</text>
        <input class="rbtn" type="button" value="+15s" onclick="onRestPlus" />
      </div>
      <text class="prog">{{ restProgLabel }} · 动作</text>
      <text class="next">{{ nextLabel }}</text>
      <input class="skip" type="button" value="跳过" onclick="onSkipRest" />
    </block>

    <text class="hr">{{ hrLabel }} {{ syncLabel ? '· ' + syncLabel : '' }}</text>

    <div class="menu" if="{{ menuOn }}">
      <div class="mrow">
        <input class="m" type="button" value="加组" onclick="onMenuAddSet" />
        <input class="m" type="button" value="减组" onclick="onMenuRemoveSet" />
      </div>
      <div class="mrow">
        <input class="m" type="button" value="上组" onclick="onMenuPrev" />
        <input class="m" type="button" value="下组" onclick="onMenuNext" />
      </div>
      <input class="mclose" type="button" value="收起" onclick="closeMenu" />
    </div>

    <input class="finish" type="button" value="结束训练" onclick="onEnd" if="{{ allFinished && !isRest }}" />
  </div>
</template>

<style>
.page { flex-direction: column; align-items: center; justify-content: flex-start; width: 450px; height: 390px; background-color: #000000; padding-top: 12px; }
.ex { font-size: 28px; color: #ffffff; lines: 1; max-width: 410px; text-align: center; }
.group { font-size: 19px; color: #8e8e93; margin-top: 4px; }
.inputs { flex-direction: row; justify-content: center; margin-top: 8px; }
.field { flex-direction: column; align-items: center; justify-content: center; width: 190px; height: 92px; border-radius: 14px; background-color: #1c1c1e; margin: 0 4px; }
.fval { font-size: 30px; color: #ffffff; }
.flbl { font-size: 17px; color: #8e8e93; margin-top: 2px; }
.navrow { flex-direction: row; justify-content: center; margin-top: 8px; }
.nav { width: 172px; height: 48px; font-size: 21px; border-radius: 13px; background-color: #1c1c1e; color: #ffffff; margin: 0 4px; }
.rest { font-size: 60px; color: #30d158; margin-top: 8px; }
.rrow { flex-direction: row; align-items: center; justify-content: center; margin-top: 6px; }
.rbtn { width: 88px; height: 44px; font-size: 19px; border-radius: 12px; background-color: #1c1c1e; color: #ffffff; margin: 0 6px; }
.rtotal { font-size: 20px; color: #8e8e93; margin: 0 4px; }
.prog { font-size: 18px; color: #ffffff; margin-top: 8px; }
.next { font-size: 17px; color: #8e8e93; margin-top: 4px; max-width: 400px; lines: 1; }
.skip { width: 220px; height: 48px; font-size: 21px; border-radius: 13px; background-color: #30d158; color: #ffffff; margin-top: 8px; }
.hr { font-size: 17px; color: #ff5a5f; margin-top: 8px; max-width: 420px; lines: 1; }
.menu { position: absolute; top: 0; left: 0; width: 450px; height: 390px; flex-direction: column; align-items: center; justify-content: center; background-color: #000000e0; }
.mrow { flex-direction: row; justify-content: center; }
.m { width: 165px; height: 58px; font-size: 22px; border-radius: 14px; background-color: #1c1c1e; color: #ffffff; margin: 6px 8px; }
.mclose { width: 180px; height: 42px; font-size: 18px; border-radius: 12px; background-color: transparent; color: #636366; margin-top: 4px; }
.finish { width: 220px; height: 46px; font-size: 20px; border-radius: 13px; background-color: #30d158; color: #ffffff; margin-top: 8px; }
</style>
