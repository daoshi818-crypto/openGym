<script>
import { commitPageAction } from '../lib/local-action.js'
import { bindRuntime, runtime } from '../lib/runtime.js'
import { recordDiagnostic, flushDiagnosticLog } from '../lib/diagnostic-log.js'
// 主训练页（单屏 + 手势）：重量/次数保持可见，休息态只保留必要操作。
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { rotationStep, valueStep } from '../lib/value-step.js'
import { captureRow, rowTarget, setDotWindow, createSetDotPicker } from '../lib/workout-interaction.js'
import brightness from '@blueos.hardware.display.brightness'
import {
  loadState, readSessionHr, save, commitSessionAction, stageSessionEvent, replacePlan, applySync, toggleSet, nextUndone, nextUndoneFrom,
  endSession, closeSession, commitLocalClose, addSet, removeSet, addRestTime, setRowValue, setEffort, calories,
} from '../lib/session.js'
import {
  effortScaleOf, effortValueOf, effortKindOf, stepEffortValue, effortMeaning,
  formatEffort,
} from '../lib/effort-scale.js'
import { startSessionHr, stopSessionHr, tick, restOver } from '../lib/sensors.js'
import { startServer, sendEvent, replayPendingEvents, sendControl, pendingCount, isConnected, persistenceStatus, synchronizationStatus, transportDiagnostics } from '../lib/rpc.js'
import { storageStatus } from '../lib/persistence.js'
import { applyEdit, applyFocus, applyRest, restOf } from '../lib/protocol.js'
import { lastTimeView } from '../lib/watch-last-time.js'

const pageDefinition = {
  data: {
    exName: '', remainingLabel: '', syncWarning: false,
    selectedField: null, setDots: [], dotSegmented: false, dotHasPrev: false, dotHasNext: false, inputNotice: '',
    groupLabel: '',
    setProgressLabel: '',
    elapsedLabel: '',
    clockLabel: '',
    weightVal: '—',
    repsVal: '—',
    restLabel: '0:00',
    restProgLabel: '',
    restExerciseName: '',
    nextLabel: '',
    nextDetails: '', nextTargetLabel: '', nextSetLabel: '', nextValuesLabel: '', effortNumber: '—',
    hrLabel: '心率 --', weightUnit: 'kg',
    syncLabel: '',
    diagnosticOn: false, diagnosticPage: 0, diagnosticTitle: '', diagnosticText: '',
    isRest: false,
    menuOn: false,
    leaveChoice: false,
    allFinished: false,
    rowDone: false,
    kcalLabel: '0',
    volumeLabel: '0',
    pageIndex: 0,
    closeMode: '',
    paused: false,
    pauseLabel: '暂停训练',
    // 视觉：数值与单位分开，单位弱一级
    weightNum: '—', weightSuffix: 'kg', repsNum: '—', repsSuffix: '次',
    statusLead: '已连接',
    // 本组强度登记（同页覆盖层）
    effortOn: false,
    effortScale: 'none',            // 手机设置：'rpe' | 'rir' | 'none'
    effortScaleLabel: '',
    effortDraft: null,
    effortDraftLabel: '—',
    effortHint: '左右滑动选择',
    effortMeaning: '',
    effortEntryText: '未登记',
    effortEntryLabel: '本组强度',
    effortEntryOn: false,
    effortHasSaved: false,
    effortNotice: '',
    effortTargetLabel: '',
    effortRestLabel: '',
    effortStale: false,
    // 上次（只读参考）：摘要行 + 同页详情。不写本次处方、不发任何事件。
    lastLine: '',
    lastOn: false,
    lastOpen: false,
    lastTitle: '',
    lastMeta: '',
    lastRows: [],
    // 结束入口与确认（旗帜只发起确认，不直接结束）
    finishOn: false,
    finishName: '',
    finishCount: '',
    confirmRemain: '',
    lastEffortOn: false,
    lastEffortText: '',
  },

  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    const s = loadState()
    if (!s.active || !s.workout) { router.push({ uri: '/Index' }); return }
    this.state = s
    this.profile = s.profile || null
    this.restSeq = 0
    this.remoteRestSeq = 0
    this.restStartAt = 0
    this.hrLast = 0
    this.hrDirty = false
    this.hrActive = false
    this.clockPeriod = 0
    this.hrUpdatedAt = null
    this.caloriesUpdatedAt = null
    this.syncSecond = null
    this.nextExIdx = -1
    this.resetInteraction()
    this.restCrownTimer = null
    this.restCrownDirty = false
    this.visible = true
    this.effortTarget = null
    this.effortBaseVersion = 0
    this.effortScaleAtOpen = 'none'

    this.bindRpc()

    // 保存的游标就是当前组；nextUndone 仅用于完成后找下一组。
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))

    if (s.restUntil && s.restUntil <= Date.now()) {
      s.restUntil = 0
      save(s)
      restOver()
    }
    this.setRestScreenLock(!!s.restUntil)

    this.startHrCapture()
    this.refresh()
    if (params && params.requestFinish) this.openFinish()
  },

  onShow() {
    this.logInteraction('page_show')
    this.resetInteraction()
    this.visible = true
    // Keypad/动作列表独立读取并保存会话，返回训练页时重新读取，确保重量立即回显。
    const latest = loadState()
    if (!latest.active || !latest.workout) { this.stopHrCapture(); router.replace({ uri: '/Index' }); return }
    if (latest.active && latest.workout) {
      this.adoptSession(latest)
      this.autoFocusEx = latest.exIdx; this.autoFocusSet = latest.setIdx; this.autoFocusIgnoreUntil = 0
      this.profile = latest.profile || null
    }
    if (this.state) this.bindRpc()
    // 熄屏时系统可能暂停 JS 定时器，回到页面先按绝对截止时间校准。
    this.reconcileRestClock()
    // 与输入页通过持久化状态交接，使用当前连接的可靠事件队列发送。
    this.flushPendingRowEdits()
    this.startHrCapture()
    this.refresh()
    this.focusCrown()
    const finish = runtime().finishRequest
    if (finish) {
      delete runtime().finishRequest
      if (finish.sid === this.state.sid) this.openFinish()
    }
  },

  onReady() {
    this.displayReady = true
    this.setRestScreenLock(this.visible !== false && !!(this.state && this.state.restUntil))
    this.focusCrown()
  },
  focusCrown() {
    try { this.$element('training').requestFocus(true) } catch (e) {}
  },
  onRotation(ev) {
    if (this.diagnosticOn) return
    if (ev && this.effortOn && ev.state !== 3) {
      const d = Number(ev.delta) || (ev.direction === true ? 1 : ev.direction === false ? -1 : 0)
      if (d) this.effortMove(d > 0 ? 1 : -1)
      return
    }
    if (!ev || this.visible === false || ev.state === 3 || this.menuOn || this.closeMode || this.pageIndex || this.paused || this.lastOpen || this.finishOn) return
    const delta = Number(ev.delta) || (ev.direction === true ? 1 : ev.direction === false ? -1 : 0)
    if (!delta) return
    if (this.isRest || this.restCrownDirty) this.queueRestNudge(delta > 0 ? 5 : -5)
    else return this.adjustSelectedField(rotationStep(ev))
  },
  onBackPress() {
    if (this.diagnosticOn) { this.closeDiagnostics(); return true }
    if (this.effortOn) { this.closeEffort(); return true }
    // 详情/结束入口只关闭自己，不切组、不停表、不退出会话。
    if (this.lastOpen) { this.closeLast(); return true }
    if (this.finishOn) { this.closeFinish(); return true }
    if (this.closeMode) this.cancelClose()
    else if (this.menuOn) this.menuOn = false
    else if (this.pageIndex) this.pageIndex = 0
    else this.openExercises()
    return true
  },
  showCurrent() { this.pageIndex = 0; this.focusCrown() },
  openMenu() { this.menuOn = true; this.leaveChoice = false },
  openActions() { if (!this.isRest) this.pageIndex = 1; this.menuOn = false },
  resetInteraction() {
    this.logInteraction('interaction_reset')
    this.cancelSetDotPick()
    this.touchCancel()
    this.trailingTapBlockedUntil = 0
    this.autoFocusIgnoreUntil = 0
    this.navPending = false
  },
  interactionBlocked(allowSetPick) { return !!this.touchAxis || Date.now() < (this.trailingTapBlockedUntil || 0) || Date.now() < (this.autoFocusIgnoreUntil || 0) || allowSetPick !== true && !!this.setDotPicker?.pending() },
  openExercises(fromGesture) {
    if (this.navPending) return
    if (fromGesture !== true && this.interactionBlocked()) return
    this.navPending = true
    this.clearFieldSelection(); router.push({ uri: '/ExerciseList', params: { detailEx: String(this.state.exIdx) } })
  },
  openRestExercise() {
    if (this.navPending || this.interactionBlocked()) return
    const completed = this.lastCompletedFromState(this.state)
    this.navPending = true
    router.push({ uri: '/ExerciseList', params: { detailEx: String(completed ? completed.exIdx : this.state.exIdx) } })
  },
  openNextExercise() {
    if (this.navPending || this.interactionBlocked() || this.nextExIdx < 0) return
    this.navPending = true
    router.push({ uri: '/ExerciseList', params: { detailEx: String(this.nextExIdx) } })
  },

  adoptSession(latest) {
    if (this.state && this.state.sid !== latest.sid) {
      this.cancelRestNudge()
      this.resetInteraction()
      this.closeMode = ''; this.effortOn = false; this.menuOn = false
      this.finishOn = false; this.lastOpen = false; this.leaveChoice = false
      this.diagnosticOn = false; this.pageIndex = 0; this.selectedField = null; this.inputNotice = ''
      this.effortTarget = null; this.effortDraft = null; this.effortBaseVersion = 0
      this.effortStale = false; this.effortNotice = ''; this.effortScaleAtOpen = 'none'
      this.completionIgnoreUntil = 0; this.restStartAt = 0
      this.restSeq = 0; this.remoteRestSeq = 0; this.restCrownBase = null
      this.autoFocusEx = latest.exIdx; this.autoFocusSet = latest.setIdx
    }
    this.state = latest
    this.profile = latest.profile || null
  },

  bindRpc() {
    const handle = (method, ...args) => {
      // 隐藏的训练页仍会收到 RPC；保留输入页刚保存的编辑和其他页面的更新。
      const latest = loadState()
      if (latest.active && latest.sid === this.state.sid) {
        this.state = this.withRestPreview(latest)
      }
      const msg = args[0], s = this.state
      if (msg?.entryInstanceId && ['set','unset','weight','reps','add_set','remove_set','focus','effort'].includes(msg.t)) {
        const ex = s.workout.exercises.findIndex(e => e.entryInstanceId === msg.entryInstanceId)
        if (ex < 0) return
        const set = msg.setId ? s.workout.rows[ex].findIndex(r => r.setId === msg.setId) + 1 : msg.set
        if (msg.setId && !set) return
        args[0] = { ...msg, ex, set }
        if (msg.weight != null && msg.weight !== '' && msg.weightUnit && msg.weightUnit !== s.weightUnit) args[0].weight = Math.round(Number(msg.weight) * (msg.weightUnit === 'lb' ? 0.45359237 : 1 / 0.45359237) * 1000) / 1000
        if (['add_set','remove_set'].includes(msg.t)) { applyEdit(s, msg); save(s); this.refresh(); return }
      }
      return this[method](...args)
    }
    startServer({
      onPlan: (msg) => handle('onPlanUpdate', msg),
      onSync: (msg, options) => handle('onSyncUpdate', msg, options),
      onRest: (msg) => handle('onRemoteRest', msg),
      onPause: (msg) => handle('onRemotePause', msg),
      onStartAck: msg => {
        if (msg.status === 'conflict') { this.syncLabel = '手机已有训练'; router.replace({ uri: '/Index', params: { conflict: JSON.stringify(msg.snapshot) } }) }
      },
      onSet: (msg) => handle('onRemoteSet', msg),
      onUnset: (msg) => handle('onRemoteUnset', msg),
      onEffort: (msg) => handle('onRemoteEffort', msg),
      onWeight: (msg) => handle('onRemoteValue', msg, 'w'),
      onReps: (msg) => handle('onRemoteValue', msg, 'r'),
      onAddSet: (msg) => handle('onRemoteAddSet', msg),
      onRemoveSet: (msg) => handle('onRemoteRemoveSet', msg),
      onFocus: (msg) => handle('onRemoteFocus', msg),
      onEnded: () => this.onRemoteEnded(),
      onError: () => { this.syncLabel = '连接异常' },
    })
  },

  onHide() {
    this.logInteraction('page_hide', {}, true)
    this.cancelSetDotPick()
    this.touchCancel()
    this.trailingTapBlockedUntil = 0
    this.visible = false
    const pending = this.flushRestNudge()
    this.setRestScreenLock(false)
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    return pending
  },

  onDestroy() {
    this.logInteraction('page_destroy', {}, true)
    this.cancelSetDotPick()
    this.visible = false
    this.touchCancel()
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    const pending = this.flushRestNudge()
    this.setRestScreenLock(false)
    return pending
  },

  setRestScreenLock(keepOn) {
    if (!this.displayReady) return
    keepOn = !!keepOn
    if (this.screenLocked === keepOn) return
    this.screenLocked = keepOn
    try {
      brightness.setKeepScreenOn({ keepScreenOn: keepOn, success() {}, fail: (data, code) => {
        this.screenLocked = null
        console.log('rest screen lock failed', code)
      } })
    } catch (e) { this.screenLocked = null }
  },

  startHrCapture() { startSessionHr() },

  stopHrCapture() { stopSessionHr() },

  touchStart(e) {
    const t = e.touches && e.touches[0]
    if (t) { this.autoFocusIgnoreUntil = 0; this.trailingTapBlockedUntil = 0 }
    this.touch = t ? { x: t.clientX, y: t.clientY } : null
    this.touchLast = this.touch
    this.touchAxis = null
    this.effortSwipe = 0
  },

  touchMove(e) {
    if (!this.touch) return
    const t = e.touches && e.touches[0]
    if (t) {
      this.touchLast = { x: t.clientX, y: t.clientY }
      if (!this.touchAxis) {
        const dx = Math.abs(t.clientX - this.touch.x), dy = Math.abs(t.clientY - this.touch.y)
        if (Math.max(dx, dy) >= 24) this.touchAxis = dx > dy ? 'x' : 'y'
      }
    }
  },

  touchEnd(e) {
    if (this.diagnosticOn) { this.touchCancel(); return }
    if (!this.touch) return
    // 固件触摸回调未必带 changedTouches，用最后一次 move 的坐标兜底。
    const t = e.changedTouches && e.changedTouches[0] || e.touches && e.touches[0]
    const end = t ? { x: t.clientX, y: t.clientY } : this.touchLast
    const start = this.touch
    const axisAtRelease = this.touchAxis
    this.touchCancel()
    if (axisAtRelease || (end && Math.max(Math.abs(end.x - start.x), Math.abs(end.y - start.y)) >= 24)) this.trailingTapBlockedUntil = Date.now() + 400
    if (!end) return
    // 评分层独占横滑：只移动一个步长，不切页、不切组、不碰休息。
    if (this.effortOn) {
      if (Math.abs(end.x - start.x) >= 24 && Math.abs(end.x - start.x) > Math.abs(end.y - start.y)) {
        this.effortMove(end.x < start.x ? 1 : -1)
      }
      return
    }
    const dx = end.x - start.x
    const dy = end.y - start.y
    if (Math.abs(dx) < 60 && Math.abs(dy) < 60) return
    this.autoFocusIgnoreUntil = 0
    if (this.closeMode) return
    // 详情打开时右滑只关闭详情；结束入口打开时不切页、不切组、不碰休息。
    if (this.lastOpen) { if (dx > 60 && Math.abs(dx) > Math.abs(dy)) this.closeLast(); return }
    if (this.finishOn) { if (dy > 60) this.closeFinish(); return }
    if (this.isRest) {
      if (dx > 60 && Math.abs(dx) > Math.abs(dy)) this.openExercises(true)
      return
    }
    if (this.menuOn) {
      if (dy > 60) this.menuOn = false
      return
    }
    const axis = axisAtRelease || (Math.abs(dx) > Math.abs(dy) ? 'x' : 'y')
    if (axis === 'x') {
      // 右滑打开动作列表，左滑切换训练与操作页。
      if (dx > 60) this.openExercises(true)
      else if (dx < -60) this.pageIndex = this.pageIndex ? 0 : 1
    }
    // Vertical gestures belong to the visible native list; horizontal swipes navigate pages.
  },

  touchCancel() { this.touch = null; this.touchLast = null; this.touchAxis = null },

  closeMenu() { this.menuOn = false },

  continueTraining() { this.leaveChoice = false },

  leaveTraining() {
    this.leaveChoice = false
    this.stopHrCapture()
    save(this.dotPreview ? loadState() : this.state)
    router.push({ uri: '/Index' })
  },

  onMenuAddSet() {
    return commitPageAction(this, function() {
    const s = this.state
    this.weightUnit = s.weightUnit || 'kg'
    const ex = s.exIdx
    addSet(s, ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    s.setIdx = rows.length - 1
    this.menuOn = false
    this.emitEvent({ t: 'add_set', sid: s.sid, ex, set: s.setIdx + 1, sets: rows.length, weight: rows[s.setIdx].w, reps: rows[s.setIdx].r, at: Date.now() })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onMenuRemoveSet() {
    return commitPageAction(this, function() {
    const s = this.state
    const ex = s.exIdx
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1 || rows[rows.length - 1].done) { this.menuOn = false; return }
    const removed = rows.length
    const removedSetIds = [rows[rows.length - 1].setId].filter(Boolean)
    removeSet(s, ex)
    this.menuOn = false
    this.emitEvent({ t: 'remove_set', sid: s.sid, ex, removedSetIds, set: removed, sets: rows.length, at: Date.now() })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onMenuPrev() { this.menuOn = false; this.stepSet(-1) },
  onMenuNext() { this.menuOn = false; this.stepSet(1) },

  stepSet(dir) {
    if (this.setDotPicker?.pending()) return false
    return commitPageAction(this, function() {
    const s = this.state
    if (!s.workout || !s.workout.rows.length) return
    let nx = s.exIdx
    let ni = s.setIdx + dir
    while (nx >= 0 && nx < s.workout.rows.length) {
      const rows = s.workout.rows[nx] || []
      if (ni >= 0 && ni < rows.length) break
      nx += dir
      if (nx < 0 || nx >= s.workout.rows.length) return
      ni = dir > 0 ? 0 : (s.workout.rows[nx] || []).length - 1
    }
    if (nx < 0 || nx >= s.workout.rows.length || ni < 0) return
    this.autoFocusEx = nx; this.autoFocusIgnoreUntil = 0
    this.clearFieldSelection(); this.autoFocusSet = ni
    s.exIdx = nx; s.setIdx = ni
    s.focusAt = Date.now(); save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, ex: nx, set: ni + 1, at: s.focusAt, source: 'watch' })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  stepExercise(dir) {
    if (this.setDotPicker?.pending()) return false
    return commitPageAction(this, function() {
    const s = this.state
    if (!s.workout || !s.workout.exercises.length) return
    const nx = Math.max(0, Math.min(s.exIdx + dir, s.workout.exercises.length - 1))
    if (nx === s.exIdx) return
    const rows = s.workout.rows[nx] || []
    const first = rows.findIndex(r => !r.done)
    this.autoFocusEx = nx; this.autoFocusIgnoreUntil = 0
    s.exIdx = nx
    s.setIdx = first >= 0 ? first : 0
    this.clearFieldSelection(); this.autoFocusSet = s.setIdx
    save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, ex: nx, set: s.setIdx + 1, at: Date.now(), source: 'watch' })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onPrevSet() { this.stepSet(-1) },
  onNextSet() { this.stepSet(1) },

  clearFieldSelection() { this.selectedField = null; this.fieldTarget = null },
  flushPendingRowEdits() {
    // Reuse the original durable identities. RPC owns deduplication and ACK removal.
    replayPendingEvents()
    const latest = loadState()
    if (latest.sid === this.state.sid) this.state.pendingEdits = latest.pendingEdits || []
  },
  selectField(field) {
    if (this.interactionBlocked() || this.isRest || this.paused || this.closeMode || this.effortOn || this.lastOpen || this.finishOn) return
    const s = loadState(), target = captureRow(this.state), found = rowTarget(s, target)
    if (!found || found.row.done || s.pausedAt || s.restUntil) { this.clearFieldSelection(); return }
    if (target.weightUnit !== (s.weightUnit || 'kg')) { this.clearFieldSelection(); return }
    this.state = s
    if (this.selectedField === field && this.fieldTarget && this.fieldTarget.setId === target.setId) {
      router.push({ uri: '/Keypad', params: { ...target, field, inputMode: 'quick' } }); return
    }
    this.selectedField = field; this.fieldTarget = target; this.inputNotice = ''
    this.focusCrown()
  },
  editWeight() { this.selectField('w') },
  editReps() { this.selectField('r') },
  adjustSelectedField(direction) {
    return commitPageAction(this, function() {
    if (!direction || !this.selectedField || !this.fieldTarget || this.interactionBlocked()) return
    const s = loadState(), found = rowTarget(s, this.fieldTarget)
    if (!found || found.row.done || s.pausedAt || s.restUntil || this.fieldTarget.weightUnit !== (s.weightUnit || 'kg') || found.exIdx !== s.exIdx || found.setIdx !== s.setIdx) {
      this.clearFieldSelection(); this.inputNotice = '目标已变化，请重新选择'; return
    }
    // Conservative input-only backpressure; never trim accepted edits or completion events.
    if (persistenceStatus().failed || storageStatus().failed || pendingCount() >= 256 || (s.pendingEdits || []).length >= 256) {
      this.inputNotice = '请先同步或恢复存储后再编辑'; return
    }
    const value = valueStep(found.row[this.selectedField], this.selectedField, direction, storage.getSync({ key: 'weight_step' }))
    this.state = s
    setRowValue(s, found.exIdx, found.setIdx, this.selectedField, value, true)
    this.flushPendingRowEdits(); this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },
  refreshSetDots(page) {
    // Keep all five standard sets visible; larger plans use three-dot windows
    // plus two 48px navigation targets, including on the round safe width.
    const view = setDotWindow(this.state, page, 5)
    const dots = this.setDots || []
    if (dots.length !== view.dots.length || view.dots.some((dot, i) => dot.key !== dots[i].key)) this.setDots = view.dots
    else for (let i = 0; i < dots.length; i++) {
      if (dots[i].exIdx !== view.dots[i].exIdx) dots[i].exIdx = view.dots[i].exIdx
      if (dots[i].current !== view.dots[i].current) dots[i].current = view.dots[i].current
      if (dots[i].done !== view.dots[i].done) dots[i].done = view.dots[i].done
    }
    this.dotPage = view.page; this.dotSegmented = view.segmented
    this.dotHasPrev = view.hasPrev; this.dotHasNext = view.hasNext
  },
  prevDotSegment() { if (!this.interactionBlocked() && this.dotHasPrev) this.refreshSetDots(this.dotPage - 1) },
  nextDotSegment() { if (!this.interactionBlocked() && this.dotHasNext) this.refreshSetDots(this.dotPage + 1) },
  setDotBlockReason() {
    if (this.visible === false) return 'hidden'
    if (this.interactionBlocked(true)) {
      if (this.touchAxis) return 'touch_axis'
      if (Date.now() < (this.trailingTapBlockedUntil || 0)) return 'trailing_tap'
      if (Date.now() < (this.autoFocusIgnoreUntil || 0)) return 'auto_focus'
      return 'interaction'
    }
    if (this.isRest) return 'rest'
    if (this.paused) return 'paused'
    if (this.closeMode) return 'close'
    if (this.effortOn) return 'effort'
    if (this.lastOpen) return 'last'
    if (this.finishOn) return 'finish'
    return ''
  },
  logDotBlocked(target, detail, status) {
    this.logInteraction('dot_blocked', { entryInstanceId: target?.entryInstanceId, setId: target?.setId, set: target?.setIdx, detail, status })
    return false
  },
  pickSetDot(target) {
    this.logInteraction('dot_tap', { entryInstanceId: target?.entryInstanceId, setId: target?.setId, set: target?.setIdx })
    const reason = this.setDotBlockReason()
    if (reason || !target) return this.logDotBlocked(target, reason || 'missing_target', 'tap')
    const found = rowTarget(this.state, target)
    if (!found) return this.logDotBlocked(target, 'stale_target', 'tap')
    if (!this.setDotPicker?.pending() && found.exIdx === this.state.exIdx && found.setIdx === this.state.setIdx) return this.logDotBlocked(target, 'current_set', 'tap')
    if (!this.setDotPicker) this.setDotPicker = createSetDotPicker(next => this.commitSetDot(next))
    if (!this.setDotPicker.pending()) this.logInteraction('dot_queued', { setId: target.setId, set: target.setIdx })
    // Browsing a group is immediate; only the persisted focus intention waits for
    // coalescing/storage. Never put this view-only cursor into the shared cache.
    this.dotPreview = { sid: this.state.sid, entryInstanceId: target.entryInstanceId, setId: target.setId,
      exIdx: found.exIdx, setIdx: found.setIdx }
    this.autoFocusSid = this.state.sid
    this.autoFocusEx = found.exIdx; this.autoFocusSet = found.setIdx; this.autoFocusIgnoreUntil = 0
    this.clearFieldSelection()
    this.state = this.withDotPreview(this.state)
    this.refresh()
    const batch = this.setDotPicker.request({ sid: target.sid, entryInstanceId: target.entryInstanceId, setId: target.setId,
      exIdx: target.exIdx, setIdx: target.setIdx, baseCommitRev: this.state.commitRev || 0 })
    if (this.dotBatch !== batch) {
      this.dotBatch = batch
      batch.then(() => {
        if (this.dotBatch !== batch) return
        this.dotBatch = null; this.dotPreview = null
        const latest = loadState()
        if (this.visible !== false && latest.active && latest.sid === this.state.sid) {
          this.state = latest
          this.autoFocusSid = latest.sid
          this.autoFocusEx = latest.exIdx; this.autoFocusSet = latest.setIdx; this.autoFocusIgnoreUntil = 0
          this.refresh()
        }
      })
    }
    return batch
  },
  withDotPreview(state) {
    const target = this.dotPreview
    if (!target) return state
    const found = rowTarget(state, target)
    if (!found || state.sid !== target.sid || found.exIdx !== state.exIdx || state.pausedAt || state.restUntil || state.closeIntent) {
      this.cancelSetDotPick()
      return state
    }
    return { ...state, exIdx: found.exIdx, setIdx: found.setIdx }
  },
  cancelSetDotPick() {
    if (this.setDotPicker) this.setDotPicker.cancel()
    this.dotBatch = null; this.dotPreview = null; this.dotActionWaiting = null
  },
  logInteraction(stage, extra = {}, flush = false) {
    try {
      const s = this.state || {}
      recordDiagnostic(stage, { sid: s.sid, ex: s.exIdx, set: s.setIdx, rev: s.commitRev || 0,
        pending: !!this.localCommitPending, rest: !!this.isRest, paused: !!this.paused, ...extra })
      if (flush) flushDiagnosticLog()
    } catch { /* A diagnostic must never fail an interaction. */ }
  },
  commitSetDot(target) {
    this.logInteraction('dot_commit_begin', { setId: target?.setId, set: target?.setIdx })
    const reason = this.setDotBlockReason()
    if (reason) return this.logDotBlocked(target, reason, 'commit')
    const latest = loadState(), found = rowTarget(latest, target)
    if (!found) return this.logDotBlocked(target, 'stale_target', 'commit')
    if (latest.sid !== this.state.sid || found.exIdx !== latest.exIdx || latest.pausedAt || latest.restUntil || found.setIdx === latest.setIdx)
      return this.logDotBlocked(target, latest.sid !== this.state.sid ? 'session_changed' : found.exIdx !== latest.exIdx ? 'exercise_changed' : latest.pausedAt ? 'paused_state' : latest.restUntil ? 'rest_state' : 'current_set', 'commit')
    const pressure = persistenceStatus().failed ? 'persistence_failed' : storageStatus().failed ? 'storage_failed' : pendingCount() >= 256 ? 'outbox_full' : (latest.pendingEdits || []).length >= 256 ? 'edit_backlog_full' : ''
    if (pressure) { this.inputNotice = '等待同步后再切换'; return this.logDotBlocked(target, pressure, 'commit') }
    return commitPageAction(this, function() {
    if (this.interactionBlocked(true) || this.isRest || this.paused || this.closeMode || this.effortOn || this.lastOpen || this.finishOn) return this.logDotBlocked(target, this.setDotBlockReason() || 'interaction', 'draft')
    const s = loadState(), found = rowTarget(s, target)
    if (!found || s.sid !== this.state.sid || found.exIdx !== s.exIdx || s.pausedAt || s.restUntil || found.setIdx === s.setIdx) return this.logDotBlocked(target, !found ? 'stale_target' : s.sid !== this.state.sid ? 'session_changed' : found.exIdx !== s.exIdx ? 'exercise_changed' : s.pausedAt ? 'paused_state' : s.restUntil ? 'rest_state' : 'current_set', 'draft')
    this.logInteraction('dot_focus_staged', { setId: target.setId, set: target.setIdx })
    this.clearFieldSelection(); this.state = s
    this.autoFocusEx = found.exIdx; this.autoFocusSet = found.setIdx; this.autoFocusIgnoreUntil = 0
    s.exIdx = found.exIdx; s.setIdx = found.setIdx; s.focusAt = Date.now(); save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, entryInstanceId: s.workout.exercises[s.exIdx].entryInstanceId,
      setId: found.row.setId, ex: s.exIdx, set: s.setIdx + 1, baseCommitRev: target.baseCommitRev, at: s.focusAt, source: 'watch' })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onComplete(expectedTarget) {
    this.logInteraction('complete_tap')
    return commitPageAction(this, function() {
    if (this.isRest || this.paused || this.closeMode || this.interactionBlocked() || Date.now() < (this.completionIgnoreUntil || 0)) return
    const s = this.state
    const expected = expectedTarget && rowTarget(s, expectedTarget)
    if (expectedTarget && (!expected || expected.exIdx !== s.exIdx || expected.setIdx !== s.setIdx || expected.row.done)) return
    const exIdx = s.exIdx, setIdx = s.setIdx
    const current = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!current || current.done) return
    this.completionIgnoreUntil = Date.now() + 700
    this.clearFieldSelection()
    const row = toggleSet(s, true)
    if (!row) return
    // 评分归属必须在焦点前进之前捕获：完成后游标会去下一组，这里记住的是刚完成的这一组。
    this.effortEntryText = '未登记'
    this.effortTarget = { sid: s.sid, entryInstanceId: s.workout.exercises[exIdx]?.entryInstanceId,
      setId: row.setId, completedAt: row.at, exIdx, setIdx,
      name: s.workout.exercises[exIdx]?.name || '', setNo: setIdx + 1 }
    this.restStartAt = Date.now()
    this.setRestScreenLock(!!s.restUntil)
    this.emitEvent({ t: 'set', sid: s.sid, ex: exIdx, set: setIdx + 1, reps: row.r != null ? String(row.r) : '', weight: row.w != null ? String(row.w) : '', at: row.at, rest: restOf(s) })
    tick()
    const next = nextUndone(s)
    if (next) {
      s.exIdx = next.exIdx; s.setIdx = next.setIdx; save(s)
      this.emitEvent({ t: 'focus', sid: s.sid, ex: next.exIdx, set: next.setIdx + 1, at: Date.now(), source: 'watch' })
    }
    else this.allFinished = true
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onUndo(expectedTarget) {
    if (this.setDotPicker?.pending()) return false
    return commitPageAction(this, function() {
    const s = this.state
    const expected = expectedTarget && rowTarget(s, expectedTarget)
    if (expectedTarget && (!expected || expected.exIdx !== s.exIdx || expected.setIdx !== s.setIdx || !expected.row.done)) return
    const exIdx = s.exIdx, setIdx = s.setIdx
    const row = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!row || !row.done) return
    toggleSet(s, false)
    this.cancelRestNudge()
    this.restStartAt = 0
    this.allFinished = false
    this.emitEvent({ t: 'unset', sid: s.sid, ex: exIdx, set: setIdx + 1, at: Date.now() })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onCurrentSetAction() {
    if (this.setDotPicker?.pending()) {
      if (this.dotActionWaiting) return this.dotActionWaiting
      const target = this.dotPreview
      const undo = this.rowDone
      const waiting = this.setDotPicker.settled().then(ok => {
        if (this.dotActionWaiting !== waiting) return false
        this.dotActionWaiting = null
        const current = captureRow(this.state)
        if (!ok || this.visible === false || !target || !current || current.sid !== target.sid ||
            current.entryInstanceId !== target.entryInstanceId || current.setId !== target.setId) return false
        if (this.closeMode || this.paused || this.interactionBlocked() || Date.now() < (this.completionIgnoreUntil || 0)) return false
        return undo ? this.onUndo(target) : this.onComplete(target)
      })
      this.dotActionWaiting = waiting
      return waiting
    }
    if (this.closeMode || this.paused || this.interactionBlocked() || Date.now() < (this.completionIgnoreUntil || 0)) return
    const target = captureRow(this.state)
    if (this.rowDone) return this.onUndo(target)
    else return this.onComplete(target)
  },

  onRemoteSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || row.done) return
    row.done = true
    row.at = Number(msg.at) || Date.now()
    const next = nextUndoneFrom(s, Number(msg.ex), Number(msg.set) - 1)
    if (next) {
      s.exIdx = next.exIdx
      s.setIdx = next.setIdx
    } else {
      s.exIdx = Number(msg.ex)
      s.setIdx = Number(msg.set) - 1
    }
    this.allFinished = s.workout.rows.every(rows => rows.every(r => r.done))
    save(s)
    this.refresh()
  },

  onRemoteUnset(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || !row.done) return
    row.done = false
    row.at = 0
    s.exIdx = Number(msg.ex)
    s.setIdx = Number(msg.set) - 1
    this.allFinished = false
    save(s)
    this.refresh()
  },

  onRemoteValue(msg, field) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const value = field === 'w' ? msg.weight : msg.reps
    const type = field === 'w' ? 'weight' : 'reps'
    // 回传关联编辑时间戳，旧快照/旧确认不能覆盖更新的本地输入。
    s.pendingEdits = (s.pendingEdits || []).filter(edit => !(edit.t === type &&
      edit.ex === msg.ex && edit.set === msg.set && msg.editAt != null && edit.at <= msg.editAt))
    const pending = s.pendingEdits.filter(edit => edit.t === type && edit.ex === msg.ex && edit.set === msg.set)
    const latest = pending[pending.length - 1]
    setRowValue(s, msg.ex, msg.set - 1, field, latest ? latest[type] : value)
    this.refresh()
  },

  onRemoteAddSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length + 1
    if (target <= rows.length || target > 100) return
    while (rows.length < target) addSet(s, ex)
    const i = rows.length - 1
    if (msg.weight != null && msg.weight !== '') rows[i].w = msg.weight
    if (msg.reps != null && msg.reps !== '') rows[i].r = msg.reps
    save(s)
    this.refresh()
  },

  onRemoteRemoveSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length - 1
    if (target < 1 || target >= rows.length) return
    if (rows.slice(target).some(r => r.done)) return
    rows.splice(target)
    s.workout.exercises[ex].sets = rows.length
    if (s.exIdx === ex && s.setIdx >= rows.length) s.setIdx = rows.length - 1
    save(s)
    this.refresh()
  },

  onRemoteFocus(msg) {
    const s = this.state
    if (!applyFocus(s, msg)) return
    save(s)
    this.refresh()
  },

  withRestPreview(latest) {
    if (this.restCrownDirty) {
      const base = this.restCrownBase
      // A preview belongs to one exact durable round. A phone skip or a changed
      // round wins; only an unchanged echo may retain unsaved crown input.
      if (latest.sid === this.state.sid && base && latest.restId === base.restId && latest.restVersion === base.restVersion) {
        Object.assign(latest, { restUntil: this.state.restUntil, restTargetSec: this.state.restTargetSec,
          restLeftSec: this.state.restLeftSec, restVersion: this.state.restVersion,
          restId: this.state.restId, restStartedAt: this.state.restStartedAt })
      } else this.cancelRestNudge()
    }
    return latest
  },

  onSyncUpdate(msg, options) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    if (options && options.persisted) {
      // The receiver already committed the snapshot and replayed pending edits.
      // Never apply it twice, or let a late old-session notification replace UI.
      const latest = loadState()
      if (!latest.active || !latest.workout || latest.sid !== msg.sid) return { status: 'retained', page: 'Workout' }
      this.adoptSession(this.withRestPreview(latest))
    } else {
      const latest = loadState()
      applySync(latest, msg)
      this.adoptSession(this.withRestPreview(latest))
    }
    this.profile = this.state.profile || this.profile
    if (this.state.pausedAt) this.stopHrCapture()
    else this.startHrCapture()
    this.allFinished = (this.state.workout.rows || []).every(rows => rows.every(r => r.done))
    this.refresh()
    this.logInteraction('page_sync', { restUntil: this.state.restUntil || 0, restVersion: this.state.restVersion || 0,
      restId: this.state.restId || '', crownDirty: !!this.restCrownDirty, dotPending: !!this.setDotPicker?.pending() })
    return { status: 'applied', page: 'Workout', exercises: this.state.workout.exercises.length }
  },

  onRemoteEnded() {
    this.logInteraction('remote_end', {}, true)
    this.cancelSetDotPick()
    this.cancelRestNudge()
    this.setRestScreenLock(false)
    this.hrDirty = false
    this.state = loadState()
    this.stopHrCapture()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    router.replace({ uri: '/Index' })
  },

  onSkipRest() {
    return commitPageAction(this, function() {
    if (Date.now() < (this.autoFocusIgnoreUntil || 0)) return
    this.cancelRestNudge()
    const s = this.state
    if (s.restUntil && this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
    s.restUntil = 0
    this.restStartAt = 0
    this.setRestScreenLock(false)
    this.restSeq += 1
    s.restVersion = Math.max(Date.now(), (s.restVersion || 0) + 1); s.restTargetSec = 0; s.restLeftSec = 0
    this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) })
    save(s)
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  nudgeRest(deltaSec) {
    this.applyRestNudge(deltaSec)
    return this.flushRestNudge()
  },

  queueRestNudge(deltaSec) {
    if (!this.state || !this.state.restUntil || !deltaSec) return
    this.applyRestNudge(deltaSec)
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    // 旋转回调只改截止时间和数字，停转后才写存储/发 RPC，避免堵塞手表线程。
    this.restCrownTimer = setTimeout(() => {
      this.flushRestNudge()
    }, 300)
  },

  cancelRestNudge() {
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    this.restCrownTimer = null
    this.restCrownDirty = false
  },

  async flushRestNudge() {
    if (this.restFlushPending) {
      const result = await this.restFlushPending
      if (!result.ok) return false
      return this.restCrownDirty ? this.flushRestNudge() : true
    }
    if (!this.restCrownDirty) return true
    const sid = this.state.sid, generation = this.restInputGeneration
    const base = this.restCrownBase, round = { restUntil: this.state.restUntil, restTargetSec: this.state.restTargetSec,
      restLeftSec: this.state.restLeftSec, restVersion: this.state.restVersion, restId: this.state.restId }
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    this.restCrownTimer = null
    const operation = commitSessionAction(sid, state => {
      if (state.restId !== base.restId || state.restVersion !== base.restVersion) throw new Error('休息已变化，请重试')
      Object.assign(state, round)
      stageSessionEvent(state, { t: 'rest', sid, ...restOf(state) })
    })
    this.restFlushPending = operation
    try {
      const result = await operation
      if (!result.ok) { this.syncWarning = true; this.syncLabel = '存储失败，休息调整未保存，请重试'; return false }
      replayPendingEvents()
      // Isolated page adapters also use the same frozen intention (sendEvent deduplicates).
      const event = result.value.pendingEdits?.[result.value.pendingEdits.length - 1]
      if (event) sendEvent(event)
      if (this.state.sid !== sid || !loadState().active) return true
      if (this.restInputGeneration === generation) {
        this.restCrownDirty = false; this.restCrownBase = null
        this.state = loadState()
        if (this.visible) this.refresh()
      } else {
        // New input is a preview on top of this exact persisted round, not a rollback.
        this.restCrownBase = { restId: round.restId, restVersion: round.restVersion }
        this.restFlushPending = null
        return this.flushRestNudge()
      }
      return true
    } finally {
      if (this.restFlushPending === operation) this.restFlushPending = null
    }
  },

  applyRestNudge(deltaSec) {
    const s = this.state
    if (!s || !s.active || !s.restUntil || !Number.isFinite(deltaSec)) return
    if (!this.restCrownDirty) this.restCrownBase = { restId: s.restId, restVersion: s.restVersion }
    this.restInputGeneration = (this.restInputGeneration || 0) + 1
    const now = Date.now()
    const target = Math.min(now + 900000, s.restUntil + deltaSec * 1000)
    s.restTargetSec = Math.max(0, Math.min(900, (s.restTargetSec || 0) + (target - s.restUntil) / 1000))
    s.restVersion = Math.max(now, (s.restVersion || 0) + 1)
    this.restCrownDirty = true
    if (target <= now) {
      if (this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
      s.restUntil = 0
      this.restStartAt = 0
      this.setRestScreenLock(false)
      this.isRest = false
      this.syncClockTimer()
    } else {
      s.restUntil = target
    }
    this.restLabel = this.mmss(Math.max(0, Math.ceil((s.restUntil - now) / 1000)))
  },

  onRestMinus() { this.nudgeRest(-15) },
  onRestPlus() { this.nudgeRest(15) },

  reconcileRestClock() {
    const s = this.state
    if (!s || !s.restUntil || s.restUntil > Date.now()) return
    if (this.restStartAt) addRestTime(s, (s.restUntil - this.restStartAt) / 1000)
    this.cancelRestNudge()
    s.restUntil = 0
    this.restStartAt = 0
    this.setRestScreenLock(false)
    save(s)
    restOver()
  },

  onPlanUpdate(msg) {
    const s = this.state
    if (msg && msg.sid && s.sid && msg.sid !== s.sid) {
      return { status: 'rejected', page: 'Workout', reason: 'session_mismatch', activeSid: s.sid }
    }
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    if (msg && msg.profile) s.profile = msg.profile
    replacePlan(s, { ...msg, name: msg.workout })
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))
    save(s)
    this.refresh()
    return { status: 'applied', page: 'Workout', exercises: s.workout.exercises.length }
  },

  onRemoteRest(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    if (this.restCrownDirty) return
    if (!applyRest(s, msg)) return
    save(s)
    this.refresh()
  },

  isDoneRowCur() {
    const s = this.state
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    this.rowDone = !!(row && row.done)
    return !!(row && row.done)
  },

  // ---- 上次（只读历史）--------------------------------------------------------
  // 归一化模块只负责显示：拿不到（旧包、加载失败）就当作“没有上次”，训练页绝不因此崩。
  lastViewOf(ex, unit) {
    try { return typeof lastTimeView === 'function' ? lastTimeView(ex, unit) : null } catch (e) { return null }
  },
  // 打开时冻结视图和目标动作的稳定身份：训练在下面继续跑，浏览历史不改游标、不发事件。
  openLast() {
    if (!this.lastOn) return
    const s = this.state
    const ex = s.workout && s.workout.exercises[s.exIdx]
    const view = this.lastViewOf(ex, s.weightUnit)
    if (!view) return
    this.lastView = view
    this.lastTarget = { entryInstanceId: ex.entryInstanceId || null, exIdx: s.exIdx }
    this.lastTitle = '上次 · ' + (view.name || '')
    this.lastMeta = view.metaLabel
    this.lastRows = view.rows.map(r => ({ no: r.no, label: r.label, key: r.no }))
    this.lastOpen = true
    // 详情接管表冠：只滚动。关闭后恢复原来的训练页导航。
    setTimeout(() => { try { this.$element('history').requestFocus(true) } catch (e) {} }, 0)
  },
  closeLast() {
    this.lastOpen = false
    this.lastView = null
    this.lastTarget = null
    this.lastRows = []
    this.focusCrown()
    this.refresh()
  },
  // 结构更新（手机改计划/换动作）把目标动作移除了：关掉详情回当前有效训练页，不能按下标乱指。
  lastTargetStillThere(s) {
    if (!s || !s.workout || !s.workout.exercises) return false
    const t = this.lastTarget
    if (!t) return false
    if (t.entryInstanceId) return s.workout.exercises.some(e => e.entryInstanceId === t.entryInstanceId)
    return t.exIdx != null && !!s.workout.exercises[t.exIdx]
  },

  // ---- 结束入口 ---------------------------------------------------------------
  // 旗帜和“结束训练”只发起确认：不直接调 endSession/onEnd，也不补完成任何组。
  openFinish() {
    if (this.closeMode) return
    const s = this.state
    if (!s || !s.active) return
    this.lastOpen = false
    this.finishOn = true
    this.finishName = (s.workout && s.workout.name) || '自由训练'
    this.refresh()
  },
  closeFinish() {
    this.finishOn = false
    this.focusCrown()
    this.refresh()
  },
  // 末组补录：目标是最近一次真正完成的那一组（稳定 setId），不是游标的前一个索引。
  openLastEffort() {
    const s = this.state
    if (!s || !s.active) return
    const target = this.lastCompletedFromState(s)
    if (!target) return
    this.effortTarget = target
    this.openEffort(false)
  },

  // ---- 本组强度（RPE/RIR）----------------------------------------------------
  // 同页覆盖层：不新增页面，原计时器/RPC/心率 owner 全部继续运行，休息不会因为登记暂停或重置。
  effortTargetRow() {
    const t = this.effortTarget
    if (!t) return null
    const s = loadState()
    if (!s.active || s.sid !== t.sid || !s.workout) return null
    const exIdx = t.entryInstanceId
      ? s.workout.exercises.findIndex(ex => ex.entryInstanceId === t.entryInstanceId) : t.exIdx
    if (!(exIdx >= 0)) return null
    const rows = s.workout.rows[exIdx] || []
    const set = t.setId ? rows.findIndex(r => r.setId === t.setId) : t.setIdx
    if (!(set >= 0)) return null
    return rows[set] ? { s, exIdx, set, row: rows[set] } : null
  },
  // 重启后内存里的 lastCompleted 没了：用“最近完成的一组”重建补录目标。
  lastCompletedFromState(s) {
    let best = null
    ;(s.workout?.rows || []).forEach((rows, exIdx) => rows.forEach((r, setIdx) => {
      if (r.done && (!best || (r.at || 0) > best.completedAt)) best = { sid: s.sid,
        entryInstanceId: s.workout.exercises[exIdx]?.entryInstanceId, setId: r.setId,
        completedAt: r.at || 0, exIdx, setIdx, name: s.workout.exercises[exIdx]?.name || '', setNo: setIdx + 1 }
    }))
    return best
  },
  effortTargetValid() {
    const found = this.effortTargetRow()
    return !!(found && (!this.effortOn || !this.effortTargetWasDone || found.row.done))
  },
  openEffort(fromOp) {
    if (this.effortOn) return
    // 训练页登记当前组，休息页登记刚完成组；打开后固定目标，计时结束不换组。
    if (!this.effortTargetValid()) { this.effortNotice = ''; return }
    const found = this.effortTargetRow()
    const scale = this.state.effortScale === 'rpe' || this.state.effortScale === 'rir' ? this.state.effortScale : 'none'
    if (scale === 'none') return
    this.effortScale = scale
    this.effortScaleLabel = effortScaleOf(scale).label
    this.effortScaleAtOpen = scale
    this.effortTargetWasDone = !!found.row.done
    this.effortBaseVersion = Number.isFinite(found.row.effortVersion) ? found.row.effortVersion : 0
    const kind = effortKindOf(found.row)
    const saved = kind ? effortValueOf(found.row, kind) : null
    this.effortHasSaved = saved != null
    this.effortDraft = null
    this.effortStale = false
    this.effortNotice = ''
    this.effortTargetLabel = (this.effortTarget.name || '') + ' · 第' + this.effortTarget.setNo + '组'
      + (found.row.done ? ' · 已完成' : ' · 训练中')
    if (kind && kind === scale && saved != null) {
      // 已登记：显示已存值（旧值即使不是 0.5 步长也如实显示，不静默改写）。
      this.effortDraft = saved
      this.effortHint = '左右滑动调整'
    } else if (kind && saved != null) {
      // 旧值是另一个量表：如实告知，本次按当前量表重新登记。
      this.effortHint = '旧值 ' + effortScaleOf(kind).label + ' ' + formatEffort(saved) + ' · 左右滑动选择'
    } else {
      this.effortHint = '左右滑动选择'
    }
    this.effortOn = true
    this.effortFromOp = !!fromOp
    this.updateEffortText()
    this.refreshEffortRest()
    this.focusCrown()
  },
  closeEffort() {
    this.effortOn = false
    this.effortDraft = null
    this.effortNotice = ''
    this.effortStale = false
    this.effortFromOp = false
    this.focusCrown()
    this.refresh()
  },
  effortMinus() { this.effortMove(-1) },
  effortPlus() { this.effortMove(1) },
  effortMove(dir) {
    if (!this.effortOn) return
    const next = stepEffortValue(this.effortScale, this.effortDraft, dir)
    if (next === this.effortDraft) return
    this.effortDraft = next
    this.effortHint = '左右滑动调整'
    this.updateEffortText()
  },
  updateEffortText() {
    const v = this.effortDraft
    this.effortDraftLabel = v == null ? '—' : formatEffort(v)
    const m = v == null ? null : effortMeaning(this.effortScale, v)
    this.effortMeaning = m ? m.text : ''
  },
  refreshEffortRest() {
    const s = this.state
    const left = s && s.restUntil ? Math.max(0, Math.ceil((s.restUntil - Date.now()) / 1000)) : 0
    this.effortRestLabel = left > 0 ? '休息 ' + this.mmss(left)
      : this.effortTargetWasDone ? '休息已结束' : '训练中'
  },
  confirmEffort() {
    if (!this.effortOn) return
    if (this.state.effortScale !== this.effortScaleAtOpen) {
      // 手表中途换了量表：旧草稿按新量表保存会是错的，要求重新打开。
      this.effortNotice = '手机已切换量表，请重新打开'
      return
    }
    if (this.effortDraft == null) { this.closeEffort(); return }
    return this.commitEffort(this.effortDraft)
  },
  clearEffort() {
    if (!this.effortOn || !this.effortHasSaved) return
    return this.commitEffort(null)
  },
  commitEffort(value) {
    return commitPageAction(this, function() {
    const found = this.effortTargetRow()
    if (!this.effortTargetValid()) {
      this.effortNotice = '目标组已变化，无法登记'
      return
    }
    // 只把评分字段合并进最新状态：绝不保存打开覆盖层时的整份旧 state。
    const latest = found.s
    const at = Math.max(Date.now(), Number(latest.effortSeq || 0) + 1)
    latest.effortSeq = at
    setEffort(latest, found.exIdx, found.set, this.effortScale, value, at)
    save(latest)
    this.state = loadState()
    this.emitEvent({ t: 'effort', sid: latest.sid, ex: found.exIdx, set: found.set + 1,
      scale: this.effortScale, value: value == null ? null : value, clear: value == null,
      effortVersion: at, baseEffortVersion: this.effortBaseVersion, at })
    this.effortOn = false
    this.effortDraft = null
    this.effortNotice = ''
    this.focusCrown()
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },
  onRemoteEffort(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const set = Number(msg.set) - 1
    if (!(ex >= 0) || !(set >= 0)) return
    const row = s.workout.rows[ex] && s.workout.rows[ex][set]
    if (!row) return
    const version = Number(msg.effortVersion) || Date.now()
    if (Number.isFinite(row.effortVersion) && version < row.effortVersion) return
    setEffort(s, ex, set, msg.scale, msg.clear ? null : msg.value, version)
    save(s)
    if (this.effortOn && this.effortTarget && this.effortTarget.setId === row.setId) {
      if (this.effortScale !== s.effortScale) this.effortNotice = '手机已切换量表，请重新打开'
      else this.effortNotice = '手机已更新本组强度'
    }
    this.refresh()
  },

  // 自动切到另一动作后，挡住落在新“完成/跳过”按钮上的慢双击；手动切换立即放行。
  updateAutoFocusLock(s) {
    if (this.autoFocusSid === s.sid && this.autoFocusEx != null && (this.autoFocusEx !== s.exIdx || (this.autoFocusSet != null && this.autoFocusSet !== s.setIdx) || (this.autoFocusWasRest && !s.restUntil))) {
      this.autoFocusIgnoreUntil = Date.now() + 1000
    }
    this.autoFocusSid = s.sid
    this.autoFocusEx = s.exIdx; this.autoFocusSet = s.setIdx; this.autoFocusWasRest = !!s.restUntil
  },

  refresh() {
    this.state = this.withDotPreview(this.state)
    this.weightUnit = this.state?.weightUnit || 'kg'
    const s = this.state
    if (!s || !s.workout) return
    this.reconcileRestClock()
    if (this.dotPreview) {
      this.autoFocusSid = s.sid
      this.autoFocusEx = s.exIdx; this.autoFocusSet = s.setIdx; this.autoFocusIgnoreUntil = 0
    }
    this.updateAutoFocusLock(s)
    this.setRestScreenLock(this.visible !== false && !!s.restUntil)
    this.rowDone = this.isDoneRowCur()
    const ex = s.workout.exercises[s.exIdx]
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    if (this.fieldTarget) {
      const target = rowTarget(s, this.fieldTarget)
      if (!target || target.row.done || target.exIdx !== s.exIdx || target.setIdx !== s.setIdx || s.pausedAt || s.restUntil || this.fieldTarget.weightUnit !== (s.weightUnit || 'kg')) this.clearFieldSelection()
    }
    const cursorKey = s.sid + ':' + (ex && ex.entryInstanceId || s.exIdx) + ':' + (row && row.setId || s.setIdx)
    this.refreshSetDots(cursorKey === this.dotCursorKey ? this.dotPage : undefined); this.dotCursorKey = cursorKey
    this.exName = ex ? ex.name : ''
    const exerciseRows = s.workout.rows[s.exIdx] || []
    this.remainingLabel = '余 ' + exerciseRows.filter(r => !r.done).length + ' 组'
    this.groupLabel = ex ? '第 ' + (s.setIdx + 1) + ' / ' + (ex.sets || 1) + ' 组' : ''
    this.weightVal = row && row.w !== '' && row.w != null ? row.w + ' ' + (s.weightUnit || 'kg') : '—'
    this.repsVal = row && row.r !== '' && row.r != null ? row.r + (this.isTimed(ex) ? ' 秒' : ' 次') : '—'
    // 数值与单位分开渲染：数字大、单位弱一级。
    this.weightNum = row && row.w !== '' && row.w != null ? String(row.w) : '—'
    this.weightSuffix = s.weightUnit || 'kg'
    this.repsNum = row && row.r !== '' && row.r != null ? String(row.r) : '—'
    this.repsSuffix = this.isTimed(ex) ? '秒' : '次'
    this.isRest = !!s.restUntil
    if (this.isRest) this.pageIndex = 0
    this.paused = !!s.pausedAt
    this.pauseLabel = this.paused ? '继续训练' : '暂停训练'

    // 完成后游标已前进；休息提示优先展示当前待做组，避免跳过一组。
    const next = row && !row.done ? { exIdx: s.exIdx, setIdx: s.setIdx } : nextUndone(s)
    this.nextExIdx = next ? next.exIdx : -1
    const totalSets = s.workout.rows.reduce((n, r) => n + r.length, 0)
    const doneSets = s.workout.rows.reduce((n, r) => n + r.filter(x => x.done).length, 0)
    this.checkCompletion(totalSets, doneSets)
    this.setProgressLabel = '完成 ' + doneSets + ' / 剩余 ' + Math.max(0, totalSets - doneSets) + ' 组'
    let completedVolume = 0
    s.workout.rows.forEach((rows, exIdx) => {
      if (this.isTimed(s.workout.exercises[exIdx])) return
      rows.forEach(r => {
        const weight = parseFloat(r.w), reps = parseFloat(r.r)
        if (r.done && Number.isFinite(weight) && Number.isFinite(reps)) completedVolume += weight * reps
      })
    })
    this.volumeLabel = this.formatVolume(completedVolume)
    this.restProgLabel = '完成 ' + doneSets + '/' + totalSets + ' 组'
    let completed = null
    s.workout.rows.forEach((rows, exIdx) => rows.forEach((r, setIdx) => {
      if (r.done && (!completed || r.at > completed.at)) completed = { exIdx, setIdx, at: r.at || 0 }
    }))
    this.restExerciseName = completed
      ? s.workout.exercises[completed.exIdx].name
      : this.exName
    if (next) {
      const ne = s.workout.exercises[next.exIdx]
      const nr = s.workout.rows[next.exIdx][next.setIdx]
      const w = nr && nr.w !== '' && nr.w != null ? nr.w + (s.weightUnit || 'kg') : ''
      const timed = ne && String(ne.reps || '').indexOf('秒') >= 0
      const r = nr && nr.r !== '' && nr.r != null ? nr.r + (timed ? '秒' : '次') : ''
      this.nextTargetLabel = '下一组 · ' + ne.name
      this.nextSetLabel = '第 ' + (next.setIdx + 1) + ' / ' + (s.workout.rows[next.exIdx] || []).length + ' 组'
      this.nextValuesLabel = w && r ? w + ' × ' + r : (w || r || '待填写')
      this.nextLabel = next.exIdx !== (completed ? completed.exIdx : s.exIdx) ? '下一动作 · ' + ne.name : '下一组'
      this.nextDetails = '第 ' + (next.setIdx + 1) + ' / ' + (s.workout.rows[next.exIdx] || []).length + ' 组 · ' + (w && r ? w + ' × ' + r : (w || r || '待填写'))
    } else { this.nextLabel = '本次训练已完成'; this.nextDetails = this.restProgLabel; this.nextTargetLabel = this.nextLabel; this.nextSetLabel = this.restProgLabel; this.nextValuesLabel = this.nextDetails }

    // 展示目标跟随当前页面，编辑目标只在打开时固定，绝不把上一组评分带入下一组。
    this.effortScale = s.effortScale === 'rpe' || s.effortScale === 'rir' ? s.effortScale : 'none'
    if (!this.effortOn) this.effortScaleLabel = effortScaleOf(this.effortScale)?.label || ''
    if (!this.effortOn) {
      if (this.isRest || this.closeMode === 'complete') {
        this.effortTarget = this.lastCompletedFromState(s)
      } else {
        this.effortTarget = row && ex ? { sid: s.sid, entryInstanceId: ex.entryInstanceId,
          setId: row.setId, exIdx: s.exIdx, setIdx: s.setIdx,
          name: ex.name || '', setNo: s.setIdx + 1 } : null
      }
    }
    this.effortEntryLabel = this.effortTarget ? '第' + this.effortTarget.setNo + '组强度' : '本组强度'
    const target = this.effortTargetRow()
    const targetKind = target ? effortKindOf(target.row) : null
    const targetValue = target && targetKind ? effortValueOf(target.row, targetKind) : null
    // 普通页只显示评分，含义解释只在选择层出现；同步状态统一由顶部状态栏展示。
    this.effortEntryText = targetKind && targetValue != null
      ? effortScaleOf(targetKind).label + ' ' + formatEffort(targetValue)
      : '未登记'
    this.effortNumber = targetValue != null ? formatEffort(targetValue) : '—'
    this.effortEntryOn = this.effortScale !== 'none' && !!target
    if (this.effortOn) {
      if (!this.effortTargetValid()) { this.effortNotice = '目标组已变化，已停止编辑' ; this.effortOn = false }
      else if (this.state.effortScale !== this.effortScaleAtOpen) this.effortStale = true
      this.refreshEffortRest()
    }

    // 上次（只读参考）：当前动作的载荷 → 主数值下方一行摘要；没历史就整行隐藏。
    const lastView = this.lastViewOf(ex, s.weightUnit)
    this.lastLine = lastView ? '上次 ' + lastView.text + ' ›' : ''
    this.lastOn = !!lastView
    if (this.lastOpen && !this.lastTargetStillThere(s)) {
      // 结构更新把目标动作移除了：关掉详情回当前有效训练页，不按下标误指新动作。
      this.lastOpen = false; this.lastView = null; this.lastTarget = null; this.lastRows = []
    }
    // 结束入口：组数从当前 rows 的 done 状态算出来，不是示例数字。
    this.finishName = (s.workout && s.workout.name) || '自由训练'
    this.finishCount = '已完成 ' + doneSets + ' / ' + totalSets + ' 组'
    const remaining = Math.max(0, totalSets - doneSets)
    this.confirmRemain = remaining > 0
      ? '还有 ' + remaining + ' 组未完成，保存已完成的 ' + doneSets + ' 组'
      : '全部 ' + totalSets + ' 组已完成'
    // 末组评分入口：目标是最近一次实际完成的组；没有完成组或量表关闭则隐藏。
    // 量表关闭时 effortScaleOf('none') 返回 null，所以标签只在有量表时才取。
    const lastDone = this.lastCompletedFromState(s)
    const lastDoneRow = lastDone ? (s.workout.rows[lastDone.exIdx] || [])[lastDone.setIdx] : null
    const lastDoneKind = lastDoneRow ? effortKindOf(lastDoneRow) : null
    const lastDoneValue = lastDoneRow && lastDoneKind ? effortValueOf(lastDoneRow, lastDoneKind) : null
    const scaleLabel = this.effortScale === 'none' ? '' : (effortScaleOf(this.effortScale)?.label || '')
    this.lastEffortOn = this.effortScale !== 'none' && !!lastDone
    this.lastEffortText = '末组 ' + scaleLabel + '  '
      + (lastDoneKind && lastDoneValue != null ? formatEffort(lastDoneValue) : '未填写')

    this.syncClockTimer()
    this.tickClock(true)
  },
  isTimed(ex) { return ex && String(ex.reps || '').indexOf('秒') >= 0 },

  checkCompletion(total, done) {
    this.allFinished = total > 0 && done === total
    // 登记强度时不要被“全部完成”面板盖住；关闭后 refresh() 会重新判定一次。
    if (this.effortOn) return
    if (!this.allFinished) {
      if (this.state.completionAcknowledged) {
        const saved = this.dotPreview ? loadState() : this.state
        saved.completionAcknowledged = false
        this.state.completionAcknowledged = false
        save(saved)
      }
      if (this.closeMode === 'complete') this.closeMode = ''
      return
    }
    if (this.visible === false || !this.state.active || this.state.completionAcknowledged || this.closeMode) return
    this.menuOn = false
    this.closeMode = 'complete'
    this.completionIgnoreUntil = Date.now() + 400
    this.touchCancel()
    this.focusCrown()
  },

  formatVolume(value) {
    return String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
  },

  syncClockTimer() {
    if (this.visible === false) return
    // The UI displays whole seconds; 500ms keeps expiry responsive without rendering the
    // complete watch page four times a second during every rest interval.
    const period = this.state && this.state.restUntil ? 500 : 1000
    if (this.timer && this.clockPeriod === period) return
    if (this.timer) clearInterval(this.timer)
    this.clockPeriod = period
    this.timer = setInterval(() => this.tickClock(), period)
  },

  tickClock(force) {
    if (this.visible === false) return
    // 评分层先判目标是否还有效：会话被结束/组被撤销时 this.state 可能已经变成 blank。
    if (this.effortOn) {
      if (!this.effortTargetValid()) { this.effortOn = false; this.effortNotice = '目标组已变化，已停止编辑' }
      else this.refreshEffortRest()
    }
    const s = this.state
    if (!s || !s.workout) return
    const currentTime = new Date()
    const clockLabel = String(currentTime.getHours()).padStart(2, '0') + ':' + String(currentTime.getMinutes()).padStart(2, '0')
    if (this.clockLabel !== clockLabel) this.clockLabel = clockLabel
    if (Date.now() - (s.segmentStartedAt || s.startedAt) >= 21600000) { loadState(); this.onRemoteEnded(); return }
    const elapsed = Math.max(0, (s.pausedAt || Date.now()) - s.startedAt - (s.pausedMs || 0))
    const mins = Math.floor(elapsed / 60000)
    const secs = Math.floor((elapsed % 60000) / 1000)
    const elapsedLabel = mins + ':' + String(secs).padStart(2, '0')
    if (this.elapsedLabel !== elapsedLabel) this.elapsedLabel = elapsedLabel

    const left = s.restUntil ? Math.ceil((s.restUntil - Date.now()) / 1000) : 0
    if (s.restUntil && left <= 0) {
      this.reconcileRestClock()
      this.refresh()
      return
    }
    const restLabel = this.mmss(left)
    if (this.restLabel !== restLabel) this.restLabel = restLabel
    this.tickMetrics(force === true)
    this.tickSyncStatus(force === true)
  },

  tickMetrics(force) {
    const s = this.state, at = Date.now()
    // Keep all session samples; only the displayed HR has a two-second budget.
    // Explicit state changes refresh immediately, independently of idle timers.
    if (force || this.hrUpdatedAt == null || at - this.hrUpdatedAt >= 2000) {
      this.hrUpdatedAt = at
      const hr = readSessionHr(s.sid)
      if (hr) s.hr = hr
      const hrLabel = s.hr?.last && at - (s.hr.sampleAt || 0) < 15000 && !s.pausedAt ? '心率 ' + s.hr.last : '心率 --'
      if (this.hrLabel !== hrLabel) this.hrLabel = hrLabel
    }
    if (force || this.caloriesUpdatedAt == null || at - this.caloriesUpdatedAt >= 5000) {
      this.caloriesUpdatedAt = at
      const kcalLabel = String((s.baseCalories || 0) + calories(s, s.profile, Math.max(0, ((s.pausedAt || at) - (s.segmentStartedAt || s.startedAt) - (s.pausedMs || 0)) / 60000)))
      if (this.kcalLabel !== kcalLabel) this.kcalLabel = kcalLabel
    }
  },

  tickSyncStatus(force) {
    const second = Math.floor(Date.now() / 1000)
    if (!force && this.syncSecond === second) return
    this.syncSecond = second
    const failed = persistenceStatus().failed || storageStatus().failed
    const n = pendingCount(), sync = synchronizationStatus(), connected = isConnected()
    const syncWarning = !!(failed || sync.phonePending > 0 || n > 0 || !connected)
    const syncLabel = failed ? '存储失败，请保留应用' : sync.phonePending > 0 ? '手机待处理 ' + sync.phonePending + ' 条' : n > 0 ? '待上传 ' + n + ' 条' : connected ? (sync.lastCommitAt ? '已同步' : '已连接') : '离线记录'
    if (this.syncWarning !== syncWarning) this.syncWarning = syncWarning
    if (this.syncLabel !== syncLabel) this.syncLabel = syncLabel
  },

  showDiagnostics() {
    this.diagnosticSnapshot = transportDiagnostics()
    this.diagnosticPage = 0
    this.diagnosticOn = true
    this.renderDiagnostics()
  },
  renderDiagnostics() {
    const d = this.diagnosticSnapshot, head = d.head
    const events = d.events.slice().reverse(), pages = Math.max(1, Math.ceil(events.length / 2))
    this.diagnosticTitle = '同步诊断 ' + (this.diagnosticPage + 1) + '/' + pages
    this.diagnosticText = '队列 ' + d.pending + ' / 手机待处理 ' + d.phonePending + '\n连接 ' + d.connected + ' / ready ' + d.readyState + ' / v' + d.peerProtocol +
      '\n队头 ' + (head ? head.type + ' / 尝试 ' + head.attempts : '无') + '\n' +
      events.slice(this.diagnosticPage * 2, this.diagnosticPage * 2 + 2).map(e => new Date(e.at).toISOString().slice(11, 19) + 'Z ' + e.stage + ' ' + e.type +
        (e.code ? '\ncode=' + e.code : '') + (e.detail ? '\n' + e.detail : '')).join('\n')
  },
  nextDiagnostic() {
    const pages = Math.max(1, Math.ceil(this.diagnosticSnapshot.events.length / 2))
    this.diagnosticPage = (this.diagnosticPage + 1) % pages
    this.renderDiagnostics()
  },
  closeDiagnostics() { this.diagnosticOn = false; this.touchCancel(); this.focusCrown() },

  mmss(sec) {
    sec = Math.max(0, Math.round(sec))
    return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0')
  },

  emitEvent(ev) {
    sendEvent(ev)
    const latest = loadState()
    if (latest.sid === this.state.sid) this.state.pendingEdits = latest.pendingEdits || []
  },
  onPause() { return this.setPaused(!this.state.pausedAt, Date.now(), true) },
  onRemotePause(msg) {
    if (msg.sid !== this.state.sid || msg.seq <= (this.state.pauseVersion || 0)) return
    this.setPaused(!!msg.paused, msg.at || Date.now(), false)
  },
  async setPaused(paused, at, notify) {
    if ((await this.flushRestNudge()) === false) return false
    return commitPageAction(this, function() {
    const s = this.state
    if (paused && !s.pausedAt) {
      s.restLeftSec = restOf(s).leftSec; s.restUntil = 0; s.pausedAt = at
      this.stopHrCapture()
    } else if (!paused && s.pausedAt) {
      s.pausedMs = (s.pausedMs || 0) + Math.max(0, at - s.pausedAt); s.pausedAt = 0
      s.restUntil = s.restLeftSec ? Date.now() + s.restLeftSec * 1000 : 0
      this.startHrCapture()
    }
    s.pauseVersion = at; s.restVersion = at; save(s)
    if (!paused) this.startHrCapture()
    if (notify) { this.emitEvent({ t: 'pause', sid: s.sid, paused, seq: at, at }); this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) }) }
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },
  askEnd() { this.finishOn = false; this.closeMode = 'end' },
  askAbandon() { this.finishOn = false; this.closeMode = 'abandon' },
  cancelClose() {
    if (this.closeMode === 'complete') {
      if (Date.now() < this.completionIgnoreUntil) return
      // 继续训练后不因时钟、同步或页面恢复反复弹窗；出现未完成组才重新提示。
      this.state.completionAcknowledged = true
      save(this.state)
    }
    this.closeMode = ''
    this.focusCrown()
  },
  saveEnd() {
    if (this.closeMode === 'complete' && Date.now() < this.completionIgnoreUntil) return
    return this.onEnd('saved')
  },
  discardEnd() { return this.onEnd('discarded') },
  abandonEnd() { return this.onEnd('abandoned') },
  async onEnd(reason, notifyPhone = true) {
    this.logInteraction('local_end', { status: typeof reason === 'string' ? reason : 'manual' }, true)
    if (typeof reason !== 'string') reason = 'manual'
    if (this.localCommitPending || this.closeSaving || !this.state?.active) return
    this.cancelSetDotPick()
    this.closeSaving = true
    try {
      if ((await this.flushRestNudge()) === false) { this.syncWarning = true; this.syncLabel = '休息调整未保存，请重试'; return }
      const result = await commitLocalClose(this.state.sid, reason)
      if (!result.ok) { this.syncWarning = true; this.syncLabel = '存储失败，未结束，请重试'; return }
      this.cancelRestNudge(); this.setRestScreenLock(false); this.stopHrCapture()
      for (const event of [...(result.entry.pendingEvents || []), result.entry.closeEvent]) sendEvent(event)
      if (result.entry.delivery === 'pending') sendEvent(result.entry.summaryEvent)
      this.state = loadState()
      if (this.timer) clearInterval(this.timer)
      if (this.hrFlush) clearInterval(this.hrFlush)
      router.replace({ uri: reason === 'saved' ? '/Summary' : '/Index' })
    } catch (_) { this.syncWarning = true; this.syncLabel = '存储失败，未结束，请重试' }
    finally { this.closeSaving = false }
  },
}

export default pageDefinition
</script>

<template>
<div class="page" id="training" touch-focusable="true" onrotation="onRotation" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
  <div class="screen" if="{{ pageIndex === 0 && !closeMode && !effortOn && !lastOpen && !finishOn && !diagnosticOn }}">
    <div class="topbar">
      <text class="heart" if="{{ !syncWarning }}">{{ hrLabel }}</text>
      <text class="status" if="{{ syncWarning }}" onclick="showDiagnostics">{{ syncLabel }} ›</text>
      <text class="clock">{{ clockLabel }}</text>
    </div>
    <div class="training-panel compact" if="{{ !isRest }}">
      <div class="training-content">
        <div class="ex" onclick="openExercises"><text class="ex-name">{{ exName }} ›</text><text class="remaining {{ remainingLabel.length > 7 ? 'remaining-wide' : '' }}">{{ remainingLabel }}</text></div>
        <text class="group {{ rowDone ? 'group-done' : '' }}">{{ inputNotice || (groupLabel + (rowDone ? ' · 已完成 · 可撤回' : '')) }}</text>
        <div class="inputs">
          <div class="field weight-field {{ rowDone ? 'field-done' : selectedField === 'w' ? 'field-selected' : '' }}" onclick="editWeight">
            <text class="fval {{ weightNum.length > 7 ? 'extra-long-value' : weightNum.length > 4 ? 'long-value' : '' }}">{{ weightNum }}</text><text class="funit">{{ weightSuffix }}</text>
          </div>
          <text class="times">×</text>
          <div class="field reps-field {{ rowDone ? 'field-done' : selectedField === 'r' ? 'field-selected' : '' }}" onclick="editReps">
            <text class="fval {{ repsNum.length > 7 ? 'extra-long-value' : repsNum.length > 4 ? 'long-value' : '' }}">{{ repsNum }}</text><text class="funit">{{ repsSuffix || '次' }}</text>
          </div>
        </div>
        <div class="last-row" if="{{ lastOn }}" onclick="openLast"><text class="last-text">{{ lastLine }}</text></div><div class="last-space" if="{{ !lastOn }}"></div>
        <div class="navrow">
          <div class="complete {{ rowDone || paused ? 'secondary' : '' }}" onclick="onCurrentSetAction"><image class="complete-icon" src="{{ paused ? '/common/icons/pause.svg' : rowDone ? '/common/icons/undo.svg' : '/common/icons/check.svg' }}" /></div>
          <div class="effort-circle" if="{{ effortEntryOn }}" onclick="openEffort"><text class="effort-caption">{{ effortScaleLabel }}</text><text class="effort-entry-value">{{ effortNumber }}</text></div>
        </div>
        <div class="set-dots">
          <input class="set-hit segment" if="{{ dotSegmented }}" type="button" value="‹" disabled="{{ !dotHasPrev }}" onclick="prevDotSegment" />
          <div class="set-hit" for="{{ item in setDots }}" tid="key" onclick="pickSetDot(item)"><div class="set-dot {{ item.current ? 'set-current' : item.done ? 'set-done' : '' }}"></div></div>
          <input class="set-hit segment" if="{{ dotSegmented }}" type="button" value="›" disabled="{{ !dotHasNext }}" onclick="nextDotSegment" />
        </div>
      </div>
    </div>
    <div class="training-panel rest-panel" if="{{ isRest }}">
      <div class="rest-content">
        <text class="rest-ex" onclick="openRestExercise">{{ restExerciseName }}</text>
        <text class="rest">{{ restLabel }}</text>
        <div class="next" onclick="openNextExercise"><text class="next-name">{{ nextTargetLabel }}</text><text class="next-set">{{ nextSetLabel }}</text></div>
        <input class="effort-row" type="button" if="{{ effortEntryOn }}" value="{{ effortEntryLabel + '  ' + effortEntryText + '  ›' }}" onclick="openEffort" />
      </div>
    </div>
    <div class="primary-footer" if="{{ !isRest }}"><text class="list-link" onclick="openExercises">动作列表</text><text class="end-link" onclick="openFinish">结束 ›</text></div>
    <div class="rrow" if="{{ isRest }}"><input class="rbtn" type="button" value="−15s" onclick="onRestMinus" /><input class="rbtn" type="button" value="+15s" onclick="onRestPlus" /><input class="skip" type="button" value="跳过" onclick="onSkipRest" /></div>
  </div>
  <div class="screen operation-screen" if="{{ pageIndex === 1 && !closeMode && !effortOn && !lastOpen && !finishOn && !diagnosticOn }}">
    <div class="topbar"><text class="status" onclick="showDiagnostics">{{ syncLabel }} ›</text><text class="clock">{{ clockLabel }}</text></div>
    <list class="operation-scroll"><list-item type="operation-content" class="scroll-content">
      <text class="elapsed-label">已用时</text><text class="elapsed-value">{{ elapsedLabel }}</text>
      <input class="history-button" type="button" if="{{ lastOn }}" value="上次训练详情 ›" onclick="openLast" />
      <div class="metrics"><text class="hr">{{ hrLabel }}</text><text class="energy">{{ kcalLabel }} 千卡</text></div>
      <text class="op-title" onclick="openExercises">{{ exName }} ›</text><text class="op-group">{{ groupLabel }}</text><div class="op-prescription"><div class="op-metric"><text class="op-label">重量</text><text class="op-detail">{{ weightNum }} {{ weightSuffix }}</text></div><div class="op-metric"><text class="op-label">次数</text><text class="op-detail">{{ repsNum }} {{ repsSuffix }}</text></div></div><text class="op-group">容量 {{ volumeLabel }} {{ weightUnit }}</text>
      <div class="mrow"><input class="m" type="button" value="上一组" onclick="onPrevSet" /><input class="m" type="button" value="下一组" onclick="onNextSet" /></div>
      <div class="mrow"><input class="m" type="button" value="加组" onclick="onMenuAddSet" /><input class="m" type="button" value="减组" onclick="onMenuRemoveSet" /></div>
      <div class="mrow"><input class="m" type="button" value="{{ pauseLabel }}" onclick="onPause" /><input class="m m-end" type="button" value="结束训练" onclick="openFinish" /></div>
      <input class="abandon-button" type="button" value="放弃训练" onclick="askAbandon" />
      <div class="return-button" onclick="showCurrent"><image class="back-icon" src="/common/icons/back.svg" /><text class="back-label">返回当前组</text></div>
    </list-item></list>
  </div>
  <div class="completion-panel" if="{{ closeMode === 'complete' && !effortOn }}">
    <list class="modal-scroll"><list-item type="confirmation" class="modal-content">
    <text class="completion-title">全部组已完成</text><text class="completion-progress">{{ setProgressLabel }}</text>
    <input class="completion-btn effort" type="button" if="{{ effortEntryOn }}" value="{{ '登记本组强度 · ' + effortEntryText }}" onclick="openEffort" />
    <input class="completion-btn finish" type="button" value="保存结束" onclick="saveEnd" /><input class="completion-btn continue" type="button" value="继续训练" onclick="cancelClose" />
    </list-item></list>
  </div>
  <div class="completion-panel confirm-panel" if="{{ closeMode === 'end' }}">
    <list class="modal-scroll"><list-item type="confirmation" class="modal-content">
    <text class="confirm-title">结束本次训练？</text><text class="confirm-remain">{{ confirmRemain }}</text><text class="confirm-note">保留已记录的 RPE / RIR</text>
    <input class="pill confirm-save" type="button" value="保存并结束" onclick="saveEnd" /><input class="pill confirm-back" type="button" value="继续训练" onclick="cancelClose" />
    </list-item></list>
  </div>
  <div class="completion-panel confirm-panel" if="{{ closeMode === 'abandon' }}">
    <list class="modal-scroll"><list-item type="confirmation" class="modal-content">
    <text class="confirm-title">放弃本次训练？</text><text class="confirm-note">本次训练不会保存到历史</text>
    <input class="pill confirm-abandon" type="button" value="确认放弃" onclick="abandonEnd" /><input class="pill confirm-back" type="button" value="继续训练" onclick="cancelClose" />
    </list-item></list>
  </div>
  <div class="effort-layer finish-layer" if="{{ finishOn && !closeMode && !effortOn }}">
    <div class="topbar"><text class="heart">{{ hrLabel }}</text><text class="clock">{{ clockLabel }}</text></div>
    <list class="finish-scroll"><list-item type="finish-content" class="scroll-content finish-content">
    <text class="finish-name">{{ finishName }}</text>
    <div class="flag" onclick="askEnd"><div class="flag-inner"><div class="pole"></div><div class="pennant"></div></div></div>
    <text class="finish-title" onclick="askEnd">结束训练</text><text class="finish-count">{{ finishCount }}</text>
    <input class="last-effort" type="button" if="{{ lastEffortOn }}" value="{{ lastEffortText + '  ›' }}" onclick="openLastEffort" /><text class="finish-back" onclick="closeFinish">继续训练</text>
    <input class="abandon-button" type="button" value="放弃训练" onclick="askAbandon" />
    </list-item></list>
  </div>
  <div class="effort-layer last-layer" if="{{ lastOpen && !closeMode && !finishOn }}">
    <div class="last-head"><div class="last-back" onclick="closeLast"><image class="back-icon" src="/common/icons/back.svg" /><text class="back-label">返回训练</text></div></div><text class="last-title">{{ lastTitle }}</text><text class="last-meta">{{ lastMeta }}</text>
    <list class="last-list" id="history" touch-focusable="true"><list-item class="last-item" type="historyRow" for="{{ r in lastRows }}" tid="key"><text class="last-no">{{ r.no }}</text><text class="last-value">{{ r.label }}</text></list-item></list>
    <text class="last-hint">仅显示实际完成的工作组 · 不影响本次记录</text>
  </div>
  <div class="effort-layer diagnostic-layer" if="{{ diagnosticOn }}"><text class="diagnostic-title">{{ diagnosticTitle }}</text><list class="diagnostic-scroll"><list-item type="diagnostic"><text class="diagnostic-text">{{ diagnosticText }}</text></list-item></list><div class="diagnostic-buttons"><input class="m" type="button" value="返回" onclick="closeDiagnostics" /><input class="m" type="button" value="下一页" onclick="nextDiagnostic" /></div></div>
  <div class="effort-layer" if="{{ effortOn && !diagnosticOn }}">
    <list class="effort-scroll"><list-item type="effort-content" class="scroll-content">
      <div class="effort-head"><div class="effort-back" onclick="closeEffort"><image class="back-icon" src="/common/icons/back.svg" /><text class="back-label">返回</text></div><text class="effort-timer">{{ effortRestLabel }}</text></div>
      <text class="effort-target">{{ effortTargetLabel }}</text><text class="effort-scale">{{ effortScaleLabel }}</text>
      <div class="effort-pick"><input class="effort-arrow" type="button" value="−" onclick="effortMinus" /><text class="effort-value">{{ effortDraftLabel }}</text><input class="effort-arrow" type="button" value="+" onclick="effortPlus" /></div>
      <text class="effort-meaning" if="{{ effortDraft != null }}">{{ effortMeaning }}</text><text class="effort-meaning" if="{{ effortDraft == null }}">尚未登记</text><text class="effort-hint">{{ effortNotice || effortHint }}</text>
      <div class="effort-actions"><input class="effort-cancel" type="button" value="取消" onclick="closeEffort" /><input class="effort-ok" type="button" value="保存" onclick="confirmEffort" /></div>
      <text class="effort-clear" if="{{ effortHasSaved }}" onclick="clearEffort">清除评分</text>
    </list-item></list>
  </div>
</div>
</template>

