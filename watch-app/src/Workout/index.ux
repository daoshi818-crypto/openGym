<script>
import { commitPageAction } from '../lib/local-action.js'
import { bindRuntime, runtime } from '../lib/runtime.js'
import { appTimeout } from '../lib/app-timers.js'
import { recordDiagnostic, flushDiagnosticLog } from '../lib/diagnostic-log.js'
// Source: openGym v1.4.5 Screens.kt / Components.kt / Theme.kt, square branch.
// BlueOS design pixels use 1.6 px per source dp/sp; no new visual system.
import router from '@blueos.app.appmanager.router'
import storage from '@blueos.storage.storage'
import { rotationStep, valueStep } from '../lib/value-step.js'
import { numberDraft, changeNumber, applyNumberDraft, keypadPress } from '../lib/number-draft.js'
import { captureRow, rowTarget, setDotWindow, createSetDotPicker } from '../lib/workout-interaction.js'
import brightness from '@blueos.hardware.display.brightness'
import {
  loadState, readSessionHr, save, commitSessionAction, stageSessionEvent, replacePlan, applySync, toggleSet, nextUndone, nextUndoneFrom,
  endSession, closeSession, commitLocalClose, addSet, removeSet, addRestTime, setRowValue, setEffort, calories,
} from '../lib/session.js'
import {
  effortScaleOf, effortValueOf, effortKindOf, stepEffortValue, effortMeaning,
  formatEffort,
} from '../lib/effort-scale.js'
import { startSessionHr, stopSessionHr, tick, restOver, crownTick } from '../lib/sensors.js'
import { startServer, sendEvent, sendLiveValue, canSendLiveEvent, replayPendingEvents, sendControl, pendingCount, persistenceStatus, synchronizationStatus, transportDiagnostics } from '../lib/rpc.js'
import { storageStatus, readStored } from '../lib/persistence.js'
import { journalEntry } from '../lib/close-journal.js'
import { applyEdit, applyFocus, applyRest, restOf } from '../lib/protocol.js'
import { lastTimeView } from '../lib/watch-last-time.js'
import { zoneView, muscleView } from '../lib/official-metrics.js'
import { summarizeWorkoutRows } from '../lib/workout-summary.js'

const pageDefinition = {
  // Native reactiveMap retains proxies until Page destruction. Business documents
  // must stay in staticData; only the small display projection belongs in data.
  staticData: { sessionModel: { current: null, restFlush: null, numberDraft: null, numberFlush: null, numberTimer: null, numberGeneration: 0, keypadDraft: null, touchPoints: { start: { x: 0, y: 0 }, last: { x: 0, y: 0 } } } },
  stateOf(value) {
    // Detached transaction drafts (and legacy page callers) own their state.
    if (this.sessionActionDraft || !this.sessionModel) {
      if (arguments.length) this.state = value
      return this.state
    }
    if (arguments.length) this.sessionModel.current = value
    return this.sessionModel.current
  },
  restFlushOf(value) {
    // A Promise must remain raw: native Page proxies change its identity and its
    // `then` receiver. In particular, a finished rest edit must not block closing.
    const owner = this.sessionModel || this
    if (arguments.length) owner.restFlush = value
    return owner.restFlush
  },
  numberDraftOf(value) {
    const owner = this.sessionModel || this
    if (arguments.length) owner.numberDraft = value
    return owner.numberDraft
  },
  numberFlushOf(value) {
    const owner = this.sessionModel || this
    if (arguments.length) owner.numberFlush = value
    return owner.numberFlush
  },
  numberTimerOf(value) {
    const owner = this.sessionModel || this
    if (arguments.length) owner.numberTimer = value
    return owner.numberTimer
  },
  numberGenerationOf(value) {
    const owner = this.sessionModel || this
    if (arguments.length) owner.numberGeneration = value
    return owner.numberGeneration || 0
  },
  keypadDraftOf(value) {
    const owner = this.sessionModel || this
    if (arguments.length) owner.keypadDraft = value
    return owner.keypadDraft
  },
  updateNumbers() {
    const draft = numberDraft(this.stateOf(), this.numberDraftOf())
    this.numberDraftOf(draft)
    if (this.keypadOn && (!draft || this.keypadDraftOf() !== draft)) this.closeNumberKeypad()
    if (draft) {
      this.weightNum = draft.w || '—'; this.repsNum = draft.r || '—'
    }
    return draft
  },
  data: {
    exName: '', remainingLabel: '', syncWarning: false,
    selectedField: null, setDots: [], dotSegmented: false, dotHasPrev: false, dotHasNext: false, inputNotice: '',
    keypadOn: false, keypadValue: '', keypadUnit: '', keypadField: 'w', keypadNotice: '',
    groupLabel: '',
    setProgressLabel: '',
    elapsedLabel: '',
    clockLabel: '',
    weightVal: '—',
    repsVal: '—',
    restLabel: '0:00',
    restProgLabel: '',
    restExerciseName: '',
    nextLabel: '',
    nextDetails: '', nextTargetLabel: '', nextExerciseName: '', nextSetLabel: '', nextValuesLabel: '', effortNumber: '—',
    hrLabel: '心率 --', weightUnit: 'kg',
    syncLabel: '',
    diagnosticOn: false, diagnosticPage: 0, diagnosticTitle: '', diagnosticText: '',
    isRest: false,
    menuOn: false,
    leaveChoice: false,
    allFinished: false,
    rowDone: false,
    kcalLabel: '0',
    volumeLabel: '0',
    pageIndex: 1, metricIndex: 0, metricKind: 'numbers', metricPages: [{key:'numbers'}, {key:'effort'}, {key:'muscles'}], hasPulse: false, overviewRows: [], effortChips: [], metricEfforts: [],
    doneTotal: '0/0', nextOfficial: '', hrNumber: '--', hrAverage: '--', hrMaximum: '--', hrMinimum: '--',
    zoneRows: [], hasAge: false, muscleRows: [], muscleMore: 0, muscleEmpty: '还没有组',
    restPercent: '100%', restWarn: false, holdingFinish: false, finishProgress: '0%',
    closeMode: '', closeError: '', closeSaving: false, closeFrozen: false,
    paused: false,
    pauseLabel: '暂停训练',
    // 视觉：数值与单位分开，单位弱一级
    weightNum: '—', weightSuffix: 'kg', repsNum: '—', repsSuffix: '次',
    // 本组强度登记（同页覆盖层）
    effortOn: false,
    effortScale: 'none',            // 手机设置：'rpe' | 'rir' | 'none'
    effortScaleLabel: '',
    effortDraft: null,
    effortDraftLabel: '—',
    effortHint: '左右滑动选择',
    effortMeaning: '',
    effortEntryText: '未登记',
    effortEntryLabel: '本组强度',
    effortEntryOn: false,
    effortHasSaved: false,
    effortNotice: '',
    effortTargetLabel: '',
    effortRestLabel: '',
    effortStale: false,
    // 上次（只读参考）：摘要行 + 同页详情。不写本次处方、不发任何事件。
    lastLine: '',
    lastOn: false,
    lastOpen: false,
    lastTitle: '',
    lastMeta: '',
    lastRows: [],
    // 结束入口与确认（旗帜只发起确认，不直接结束）
    finishOn: false,
    finishName: '',
    finishCount: '',
    confirmRemain: '',
    lastEffortOn: false,
    lastEffortText: '',
  },

  onInit(params) {
    if (this.$app && this.$app.$def) bindRuntime(this.$app.$def)
    const s = loadState()
    if (!s.active || !s.workout) { router.push({ uri: '/Index' }); return }
    this.stateOf(s)
    this.profile = s.profile || null
    this.restSeq = 0
    this.remoteRestSeq = 0
    this.restStartAt = 0
    this.hrLast = 0
    this.hrDirty = false
    this.hrActive = false
    this.clockPeriod = 0
    this.hrUpdatedAt = null
    this.caloriesUpdatedAt = null
    this.syncSecond = null
    this.nextExIdx = -1
    this.resetInteraction()
    this.restCrownTimer = null
    this.restCrownDirty = false
    this.visible = true
    this.effortTarget = null
    this.effortBaseVersion = 0
    this.effortScaleAtOpen = 'none'

    this.bindRpc()

    if (this.freezeCloseView()) return

    // 保存的游标就是当前组；nextUndone 仅用于完成后找下一组。
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))

    if (s.restUntil && s.restUntil <= Date.now()) {
      s.restUntil = 0
      save(s)
      restOver()
    }
    this.setRestScreenLock(!!s.restUntil)

    this.startHrCapture()
    this.refresh()
    if (params && params.requestFinish) this.openFinish()
  },

  onShow() {
    this.logInteraction('page_show')
    this.resetInteraction()
    this.visible = true
    this.needsRefresh = false
    // Keypad/动作列表独立读取并保存会话，返回训练页时重新读取，确保重量立即回显。
    const latest = loadState()
    if (!latest.active || !latest.workout) { this.stopHrCapture(); router.replace({ uri: '/Index' }); return }
    if (latest.active && latest.workout) {
      this.adoptSession(latest)
      this.autoFocusEx = latest.exIdx; this.autoFocusSet = latest.setIdx; this.autoFocusIgnoreUntil = 0
      this.profile = latest.profile || null
    }
    if (this.stateOf()) this.bindRpc()
    if (this.freezeCloseView()) return
    // 熄屏时系统可能暂停 JS 定时器，回到页面先按绝对截止时间校准。
    this.reconcileRestClock()
    // 与输入页通过持久化状态交接，使用当前连接的可靠事件队列发送。
    this.flushPendingRowEdits()
    this.startHrCapture()
    this.refresh()
    this.focusCrown()
    const finish = runtime().finishRequest
    if (finish) {
      delete runtime().finishRequest
      if (finish.sid === this.stateOf().sid) this.openFinish()
    }
  },

  onReady() {
    this.displayReady = true
    this.setRestScreenLock(this.visible !== false && !!(this.stateOf() && this.stateOf().restUntil))
    this.focusCrown()
  },
  focusCrown() {
    try { this.$element('training').requestFocus(true) } catch (e) {}
    // The destination list can take the default focus when its native tree mounts.
    // Reclaim once after this render; never keep a polling focus timer alive.
    if (this.crownFocusTimer != null) clearTimeout(this.crownFocusTimer)
    this.crownFocusTimer = setTimeout(() => {
      this.crownFocusTimer = null
      if (this.visible === false || this.lastOpen || this.diagnosticOn) return
      try { this.$element('training').requestFocus(true) } catch (e) {}
    }, 0)
  },
  onRotation(ev) {
    if (this.closeSaving || this.stateOf()?.closeIntent) return
    ev = ev?.detail && typeof ev.detail === 'object' ? ev.detail : ev
    if (!ev || this.visible === false || ev.state === 3) return
    if (this.keypadOn) {
      const direction = rotationStep(ev)
      if (direction) {
        crownTick()
        this.keypadBuffer = valueStep(this.keypadBuffer, this.keypadField, direction, this.weightStep)
        this.keypadValue = this.keypadBuffer; this.keypadReplace = false
      }
      return
    }
    this.logInteraction('crown_input', { detail: this.selectedField || (this.isRest ? 'rest' : 'page'), type: String(this.pageIndex) })
    if (this.pageIndex === 2 && !this.effortOn && !this.closeMode && !this.diagnosticOn) {
      const direction = rotationStep(ev); if (direction) { crownTick(); this.stepMetrics(direction) } return
    }
    if (this.diagnosticOn) return
    if (ev && this.effortOn && ev.state !== 3) {
      const d = rotationStep(ev)
      if (d) { crownTick(); this.effortMove(d > 0 ? 1 : -1) }
      return
    }
    if (!ev || this.visible === false || ev.state === 3 || this.menuOn || this.closeMode || this.pageIndex !== 1 || this.paused || this.lastOpen || this.finishOn) return
    const delta = rotationStep(ev)
    if (!delta) return
    crownTick()
    if (this.isRest || this.restCrownDirty) this.queueRestNudge(delta > 0 ? 5 : -5)
    else return this.adjustSelectedField(rotationStep(ev))
  },
  onBackPress() {
    if (this.closeSaving || this.stateOf()?.closeIntent) return true
    this.cancelFinishHold()
    if (this.keypadOn) { this.closeNumberKeypad(); return true }
    if (this.diagnosticOn) { this.closeDiagnostics(); return true }
    if (this.effortOn) { this.closeEffort(); return true }
    // 详情/结束入口只关闭自己，不切组、不停表、不退出会话。
    if (this.lastOpen) { this.closeLast(); return true }
    if (this.finishOn) { this.closeFinish(); return true }
    if (this.closeMode) this.cancelClose()
    else if (this.menuOn) this.menuOn = false
    else if (this.pageIndex !== 1) this.pageIndex = 1
    else this.pageIndex = 0
    return true
  },
  showCurrent() { this.pageIndex = 1; this.focusCrown() },
  openMenu() { this.menuOn = true; this.leaveChoice = false },
  openActions() { this.pageIndex = 0; this.menuOn = false },
  resetInteraction() {
    this.logInteraction('interaction_reset')
    this.cancelSetDotPick()
    this.touchCancel()
    this.trailingTapBlockedUntil = 0
    this.autoFocusIgnoreUntil = 0
    this.navPending = false
  },
  interactionBlocked(allowSetPick, allowCloseRetry) { return !!this.closeSaving || !allowCloseRetry && !!this.stateOf()?.closeIntent || !!this.touchAxis || Date.now() < (this.trailingTapBlockedUntil || 0) || Date.now() < (this.autoFocusIgnoreUntil || 0) || allowSetPick !== true && !!this.setDotPicker?.pending() },
  openExercises(fromGesture) {
    if (this.navPending) return
    if (fromGesture !== true && this.interactionBlocked()) return
    this.navPending = true
    this.clearFieldSelection(); router.push({ uri: '/ExerciseList', params: { detailEx: String(this.stateOf().exIdx) } })
  },
  openRestExercise() {
    if (this.navPending || this.interactionBlocked()) return
    const completed = this.lastCompletedFromState(this.stateOf())
    this.navPending = true
    router.push({ uri: '/ExerciseList', params: { detailEx: String(completed ? completed.exIdx : this.stateOf().exIdx) } })
  },
  openNextExercise() {
    if (this.navPending || this.interactionBlocked() || this.nextExIdx < 0) return
    this.navPending = true
    router.push({ uri: '/ExerciseList', params: { detailEx: String(this.nextExIdx) } })
  },

  adoptSession(latest) {
    if (this.stateOf() && this.stateOf().sid !== latest.sid) {
      this.cancelRestNudge()
      this.resetInteraction()
      this.closeMode = ''; this.closeFrozen = false; this.effortOn = false; this.menuOn = false
      this.finishOn = false; this.lastOpen = false; this.leaveChoice = false
      this.diagnosticOn = false; this.pageIndex = 1; this.selectedField = null; this.inputNotice = ''
      this.effortTarget = null; this.effortDraft = null; this.effortBaseVersion = 0
      this.effortStale = false; this.effortNotice = ''; this.effortScaleAtOpen = 'none'
      this.completionIgnoreUntil = 0; this.restStartAt = 0
      this.restSeq = 0; this.remoteRestSeq = 0; this.restCrownBase = null
      this.autoFocusEx = latest.exIdx; this.autoFocusSet = latest.setIdx
    }
    this.stateOf(latest)
    this.profile = latest.profile || null
  },

  bindRpc() {
    const handle = (method, ...args) => {
      // Persisted snapshots already updated the single durable session. Hidden pages
      // adopt it once onShow, rather than rebuilding every view behind the keypad.
      if (method === 'onSyncUpdate' && args[1]?.persisted && this.visible === false) {
        this.needsRefresh = true
        return { status: 'applied', page: 'Workout', deferred: true }
      }
      // Legacy commands still need their business mutation while hidden.
      const latest = loadState()
      if (latest.active && latest.sid === this.stateOf().sid) {
        this.stateOf(this.withRestPreview(latest))
      }
      const msg = args[0], s = this.stateOf()
      if (s?.closeIntent && method !== 'onRemoteEnded') return { status: 'retained', reason: 'session_closing' }
      if (msg?.entryInstanceId && ['set','unset','weight','reps','add_set','remove_set','focus','effort'].includes(msg.t)) {
        const ex = s.workout.exercises.findIndex(e => e.entryInstanceId === msg.entryInstanceId)
        if (ex < 0) return
        const set = msg.setId ? s.workout.rows[ex].findIndex(r => r.setId === msg.setId) + 1 : msg.set
        if (msg.setId && !set) return
        args[0] = { ...msg, ex, set }
        if (msg.weight != null && msg.weight !== '' && msg.weightUnit && msg.weightUnit !== s.weightUnit) args[0].weight = Math.round(Number(msg.weight) * (msg.weightUnit === 'lb' ? 0.45359237 : 1 / 0.45359237) * 1000) / 1000
        if (['add_set','remove_set'].includes(msg.t)) { applyEdit(s, msg); save(s); this.refresh(); return }
      }
      return this[method](...args)
    }
    const rpcOwner = this.sessionModel || this
    rpcOwner.rpcDetach = startServer({
      onPlan: (msg) => handle('onPlanUpdate', msg),
      onSync: (msg, options) => handle('onSyncUpdate', msg, options),
      onRest: (msg) => handle('onRemoteRest', msg),
      onPause: (msg) => handle('onRemotePause', msg),
      onConflict: () => { this.syncLabel = '存在冲突训练'; router.replace({ uri: '/Index' }) },
      onSet: (msg) => handle('onRemoteSet', msg),
      onUnset: (msg) => handle('onRemoteUnset', msg),
      onEffort: (msg) => handle('onRemoteEffort', msg),
      onWeight: (msg) => handle('onRemoteValue', msg, 'w'),
      onReps: (msg) => handle('onRemoteValue', msg, 'r'),
      onAddSet: (msg) => handle('onRemoteAddSet', msg),
      onRemoveSet: (msg) => handle('onRemoteRemoveSet', msg),
      onFocus: (msg) => handle('onRemoteFocus', msg),
      onEnded: () => this.onRemoteEnded(),
      onError: (error) => {
        this.syncWarning = true
        const operation = error?.operation
        if (error?.code === 'live_event_busy') {
          this.syncLabel = operation === 'set' ? '同步繁忙，已阻止重复完成；请稍后重试' :
            operation === 'unset' ? '同步繁忙，已阻止重复撤销；请稍后重试' :
            operation === 'add_set' || operation === 'remove_set' ? '同步繁忙，已阻止重复调整组数；请稍后重试' : '同步繁忙，请稍后重试'
        } else if (error?.code === 'live_event_send_failed') {
          this.syncLabel = operation === 'set' ? '本组已保存在手表，手机同步未确认，可稍后核对' :
            operation === 'unset' ? '撤销已保存在手表，手机同步未确认，可稍后核对' :
            operation === 'add_set' || operation === 'remove_set' ? '组数已保存在手表，手机同步未确认，可稍后核对' :
            operation === 'effort' ? '评分已保存在手表，手机同步未确认，可稍后核对' : '手表记录已保存，手机同步未确认，可稍后核对'
        } else if (error?.code === 'live_state_send_failed') {
          this.syncLabel = operation === 'weight' ? '重量已保存在手表，手机同步未确认，可稍后核对' :
            operation === 'reps' ? '次数已保存在手表，手机同步未确认，可稍后核对' :
            operation === 'focus' ? '当前组同步未确认，可稍后核对' :
            operation === 'rest' || operation === 'pause' ? '训练状态同步未确认，可稍后核对' : '手表状态同步未确认，可稍后核对'
        } else this.syncLabel = '连接异常'
      },
    })
  },

  onHide() {
    if (this.crownFocusTimer != null) clearTimeout(this.crownFocusTimer)
    this.crownFocusTimer = null
    this.cancelFinishHold()
    this.logInteraction('page_hide', {}, true)
    this.cancelSetDotPick()
    this.touchCancel()
    this.trailingTapBlockedUntil = 0
    this.visible = false
    const pending = Promise.all([this.flushRestNudge(), this.flushNumberDraft()])
    this.setRestScreenLock(false)
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    return pending
  },

  onDestroy() {
    this.flushNumberDraft()
    const rpcOwner = this.sessionModel || this
    if (typeof rpcOwner.rpcDetach === 'function') rpcOwner.rpcDetach()
    rpcOwner.rpcDetach = null
    if (this.crownFocusTimer != null) clearTimeout(this.crownFocusTimer)
    this.crownFocusTimer = null
    this.cancelFinishHold()
    this.logInteraction('page_destroy', {}, true)
    this.cancelSetDotPick()
    this.visible = false
    this.touchCancel()
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    const pending = this.flushRestNudge()
    this.setRestScreenLock(false)
    if (this.sessionModel) { this.sessionModel.current = null; this.sessionModel.numberDraft = null; this.sessionModel.keypadDraft = null }
    return pending
  },

  setRestScreenLock(keepOn) {
    // App owns the foreground training policy across all workout pages.
    if (runtime().trainingRuntime) { runtime().trainingRuntime.syncScreen(); return }
    if (!this.displayReady) return
    keepOn = !!keepOn
    if (this.screenLocked === keepOn) return
    this.screenLocked = keepOn
    try {
      brightness.setKeepScreenOn({ keepScreenOn: keepOn, success() {}, fail: (data, code) => {
        this.screenLocked = null
        console.log('rest screen lock failed', code)
      } })
    } catch (e) { this.screenLocked = null }
  },

  startHrCapture() { startSessionHr() },

  stopHrCapture() { stopSessionHr() },

  touchStart(e) {
    const t = e.touches && e.touches[0]
    if (t) { this.autoFocusIgnoreUntil = 0; this.trailingTapBlockedUntil = 0 }
    const points = this.sessionModel?.touchPoints || this.touchPoints || (this.touchPoints = { start: { x: 0, y: 0 }, last: { x: 0, y: 0 } })
    if (t) { points.start.x = t.clientX; points.start.y = t.clientY; points.last.x = t.clientX; points.last.y = t.clientY }
    this.touch = t ? points.start : null
    this.touchLast = t ? points.last : null
    this.touchAxis = null
    this.effortSwipe = 0
  },

  touchMove(e) {
    if (!this.touch) return
    const t = e.touches && e.touches[0]
    if (t) {
      this.touchLast.x = t.clientX; this.touchLast.y = t.clientY
      if (this.holdingFinish && Math.max(Math.abs(t.clientX - this.touch.x), Math.abs(t.clientY - this.touch.y)) >= 24) this.cancelFinishHold()
      if (!this.touchAxis) {
        const dx = Math.abs(t.clientX - this.touch.x), dy = Math.abs(t.clientY - this.touch.y)
        if (Math.max(dx, dy) >= 24) this.touchAxis = dx > dy ? 'x' : 'y'
      }
    }
  },

  touchEnd(e) {
    this.endFinishHold()
    if (this.keypadOn) { this.touchCancel(); return }
    if (this.diagnosticOn) { this.touchCancel(); return }
    if (!this.touch) return
    // 固件触摸回调未必带 changedTouches，用最后一次 move 的坐标兜底。
    const t = e.changedTouches && e.changedTouches[0] || e.touches && e.touches[0]
    const end = t ? { x: t.clientX, y: t.clientY } : this.touchLast
    const start = this.touch
    const axisAtRelease = this.touchAxis
    this.touchCancel()
    if (axisAtRelease || (end && Math.max(Math.abs(end.x - start.x), Math.abs(end.y - start.y)) >= 24)) this.trailingTapBlockedUntil = Date.now() + 400
    if (!end) return
    // 评分层独占横滑：只移动一个步长，不切页、不切组、不碰休息。
    if (this.effortOn) {
      if (Math.abs(end.x - start.x) >= 24 && Math.abs(end.x - start.x) > Math.abs(end.y - start.y)) {
        this.effortMove(end.x < start.x ? 1 : -1)
      }
      return
    }
    const dx = end.x - start.x
    const dy = end.y - start.y
    if (Math.abs(dx) < 60 && Math.abs(dy) < 60) return
    this.autoFocusIgnoreUntil = 0
    if (this.closeMode) return
    // 详情打开时右滑只关闭详情；结束入口打开时不切页、不切组、不碰休息。
    if (this.lastOpen) { if (dx > 60 && Math.abs(dx) > Math.abs(dy)) this.closeLast(); return }
    if (this.finishOn) { if (dy > 60) this.closeFinish(); return }
    const axis = axisAtRelease || (Math.abs(dx) > Math.abs(dy) ? 'x' : 'y')
    if (axis === 'x') {
      this.cancelFinishHold()
      this.pageIndex = (this.pageIndex + (dx < 0 ? 1 : 2)) % 3
      this.focusCrown()
    } else if (this.pageIndex === 2) this.stepMetrics(dy < 0 ? 1 : -1)
    // Vertical gestures belong to the visible native list; horizontal swipes navigate pages.
  },

  touchCancel() { this.cancelFinishHold(); this.touch = null; this.touchLast = null; this.touchAxis = null },

  closeMenu() { this.menuOn = false },
  continueTraining() { this.leaveChoice = false },

  leaveTraining() {
    this.leaveChoice = false
    this.stopHrCapture()
    save(this.dotPreview ? loadState() : this.stateOf())
    router.push({ uri: '/Index' })
  },

  onMenuAddSet() {
    if (!this.canSendEventNow('add_set')) return false
    return commitPageAction(this, function() {
    const s = this.stateOf()
    this.weightUnit = s.weightUnit || 'kg'
    const ex = s.exIdx
    addSet(s, ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    s.setIdx = rows.length - 1
    this.menuOn = false
    this.emitEvent({ t: 'add_set', sid: s.sid, ex, set: s.setIdx + 1, sets: rows.length, weight: rows[s.setIdx].w, reps: rows[s.setIdx].r, at: Date.now() })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onMenuRemoveSet() {
    if (!this.canSendEventNow('remove_set')) return false
    return commitPageAction(this, function() {
    const s = this.stateOf()
    const ex = s.exIdx
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1 || rows[rows.length - 1].done) { this.menuOn = false; return }
    const removed = rows.length
    const removedSetIds = [rows[rows.length - 1].setId].filter(Boolean)
    removeSet(s, ex)
    this.menuOn = false
    this.emitEvent({ t: 'remove_set', sid: s.sid, ex, removedSetIds, set: removed, sets: rows.length, at: Date.now() })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onMenuPrev() { this.menuOn = false; this.stepSet(-1) },
  onMenuNext() { this.menuOn = false; this.stepSet(1) },

  stepSet(dir) {
    if (this.setDotPicker?.pending()) return false
    if (this.numberDraftDirty()) return this.flushNumberDraft().then(ok => ok ? this.stepSet(dir) : false)
    return commitPageAction(this, function() {
    const s = this.stateOf()
    if (!s.workout || !s.workout.rows.length) return
    let nx = s.exIdx
    let ni = s.setIdx + dir
    while (nx >= 0 && nx < s.workout.rows.length) {
      const rows = s.workout.rows[nx] || []
      if (ni >= 0 && ni < rows.length) break
      nx += dir
      if (nx < 0 || nx >= s.workout.rows.length) return
      ni = dir > 0 ? 0 : (s.workout.rows[nx] || []).length - 1
    }
    if (nx < 0 || nx >= s.workout.rows.length || ni < 0) return
    this.autoFocusEx = nx; this.autoFocusIgnoreUntil = 0
    this.clearFieldSelection(); this.autoFocusSet = ni
    s.exIdx = nx; s.setIdx = ni
    s.focusAt = Date.now(); save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, ex: nx, set: ni + 1, at: s.focusAt, source: 'watch' })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  stepExercise(dir) {
    if (this.setDotPicker?.pending()) return false
    if (this.numberDraftDirty()) return this.flushNumberDraft().then(ok => ok ? this.stepExercise(dir) : false)
    return commitPageAction(this, function() {
    const s = this.stateOf()
    if (!s.workout || !s.workout.exercises.length) return
    const nx = Math.max(0, Math.min(s.exIdx + dir, s.workout.exercises.length - 1))
    if (nx === s.exIdx) return
    const rows = s.workout.rows[nx] || []
    const first = rows.findIndex(r => !r.done)
    this.autoFocusEx = nx; this.autoFocusIgnoreUntil = 0
    s.exIdx = nx
    s.setIdx = first >= 0 ? first : 0
    this.clearFieldSelection(); this.autoFocusSet = s.setIdx
    save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, ex: nx, set: s.setIdx + 1, at: Date.now(), source: 'watch' })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onPrevSet() { this.stepSet(-1) },
  onNextSet() { this.stepSet(1) },

  clearFieldSelection() { this.selectedField = null; this.fieldTarget = null },
  numberDraftDirty() {
    const draft = this.numberDraftOf()
    return !!(draft && (draft.dirtyW || draft.dirtyR))
  },
  scheduleNumberDraftFlush() {
    const old = this.numberTimerOf()
    if (old != null) clearTimeout(old)
    this.numberTimerOf(setTimeout(() => {
      this.numberTimerOf(null)
      this.flushNumberDraft()
    }, 350))
  },
  async flushNumberDraft() {
    const timer = this.numberTimerOf()
    if (timer != null) clearTimeout(timer)
    this.numberTimerOf(null)
    for (;;) {
      const pending = this.numberFlushOf()
      if (pending) {
        const ok = await pending
        if (!ok) return false
        continue
      }
      const draft = this.numberDraftOf()
      if (!draft || !draft.dirtyW && !draft.dirtyR) return true
      const snapshot = { ...draft, target: { ...draft.target } }
      const generation = this.numberGenerationOf()
      const sid = snapshot.target.sid
      const operation = commitSessionAction(sid, state => {
        const found = rowTarget(state, snapshot.target)
        if (!found || found.row.done) return 'superseded'
        applyNumberDraft(state, snapshot)
        // Phone-led v4 edits become single-field live events only after local durability.
        if (state.protocolVersion === 4 && state.sessionOrigin === 'phone') {
          const target = snapshot.target, fields = []
          if (snapshot.dirtyW) fields.push({ t: 'weight', weight: snapshot.w })
          if (snapshot.dirtyR) fields.push({ t: 'reps', reps: snapshot.r })
          for (const field of fields) {
            const event = stageSessionEvent(state, { ...field, sid, ex: target.exIdx, set: target.setIdx + 1,
              entryInstanceId: target.entryInstanceId, setId: target.setId, weightUnit: target.weightUnit, at: Date.now() })
            if (event?.protocolVersion === 4) state.rev = Math.max(state.rev || 0, event.rev || 0)
          }
        }
        return 'saved'
      })
      this.numberFlushOf(operation)
      let result
      try { result = await operation }
      catch (error) {
        this.syncWarning = true
        this.syncLabel = 'Weight or reps could not be saved; retry'
        return false
      }
      finally { if (this.numberFlushOf() === operation) this.numberFlushOf(null) }
      if (!result?.ok) {
        this.syncWarning = true
        this.syncLabel = 'Weight or reps could not be saved; retry'
        return false
      }
      const latest = loadState()
      if (latest.sid !== sid || !latest.active) return true
      if (generation === this.numberGenerationOf()) {
        const current = this.numberDraftOf()
        if (current && current.target.setId === snapshot.target.setId) {
          current.dirtyW = false; current.dirtyR = false
        }
        this.stateOf(latest)
        return true
      }
    }
  },
  flushPendingRowEdits() {
    // Reuse the original durable identities. RPC owns deduplication and ACK removal.
    replayPendingEvents()
    const latest = loadState()
    if (latest.sid === this.stateOf().sid) this.stateOf().pendingEdits = latest.pendingEdits || []
  },
  selectField(field) {
    if (this.interactionBlocked() || this.isRest || this.paused || this.closeMode || this.effortOn || this.lastOpen || this.finishOn) return
    const s = loadState(), target = captureRow(this.stateOf()), found = rowTarget(s, target)
    if (!found || found.row.done || s.pausedAt || s.restUntil) { this.clearFieldSelection(); return }
    if (target.weightUnit !== (s.weightUnit || 'kg')) { this.clearFieldSelection(); return }
    this.stateOf(s)
    if (this.selectedField === field && this.fieldTarget && this.fieldTarget.setId === target.setId) {
      this.openNumberKeypad(field); return
    }
    this.weightStep = storage.getSync({ key: 'weight_step' })
    this.updateNumbers()
    this.selectedField = field; this.fieldTarget = target; this.inputNotice = ''
    this.logInteraction('field_selected', { detail: field })
    this.focusCrown()
  },
  editWeight() { this.selectField('w') },
  editReps() { this.selectField('r') },
  adjustSelectedField(direction) {
    // A stray crown callback must not clone and persist an unchanged session.
    if (!direction || !this.selectedField || !this.fieldTarget || this.interactionBlocked()) return
    if (this.numberEditLocked || this.keypadOn) return
    const s = this.stateOf(), found = rowTarget(s, this.fieldTarget)
    if (!found || found.row.done || s.pausedAt || s.restUntil || this.fieldTarget.weightUnit !== (s.weightUnit || 'kg') || found.exIdx !== s.exIdx || found.setIdx !== s.setIdx) {
      this.clearFieldSelection(); this.inputNotice = '目标已变化，请重新选择'; return
    }
    const draft = this.updateNumbers()
    if (!draft) { this.clearFieldSelection(); return }
    const value = valueStep(draft[this.selectedField], this.selectedField, direction, this.weightStep)
    changeNumber(draft, this.selectedField, value)
    this.numberGenerationOf(this.numberGenerationOf() + 1)
    this.scheduleNumberDraftFlush()
    if (this.selectedField === 'w') this.weightNum = value
    else this.repsNum = value
    const target = draft.target, type = this.selectedField === 'w' ? 'weight' : 'reps'
    sendLiveValue({ t: type, sid: s.sid, ex: target.exIdx, set: target.setIdx + 1,
      entryInstanceId: target.entryInstanceId, setId: target.setId, weightUnit: target.weightUnit,
      [type]: value, at: Date.now(), source: 'watch' })
  },
  openNumberKeypad(field) {
    if (this.localCommitPending || this.interactionBlocked()) return
    const draft = this.updateNumbers()
    if (!draft) return
    this.keypadDraftOf(draft); this.keypadField = field
    this.keypadBuffer = draft[field]; this.keypadValue = draft[field] || '—'
    this.keypadUnit = field === 'w' ? draft.target.weightUnit : this.repsSuffix === '秒' ? 's' : ''
    this.keypadReplace = true; this.keypadNotice = ''; this.keypadOn = true
    this.focusCrown()
  },
  closeNumberKeypad() { this.keypadOn = false; this.keypadDraftOf(null); this.keypadNotice = ''; this.focusCrown() },
  numberKey(key) {
    if (!this.keypadOn) return
    this.keypadBuffer = keypadPress(this.keypadBuffer, key, this.keypadField, this.keypadReplace)
    this.keypadReplace = false; this.keypadValue = this.keypadBuffer || '—'
  },
  saveNumberKeypad() {
    const expected = this.keypadDraftOf(), draft = this.updateNumbers()
    if (!this.keypadOn || draft !== expected || !draft) return
    if (!changeNumber(draft, this.keypadField, this.keypadBuffer)) { this.keypadNotice = '请输入有效数值'; return }
    this.numberGenerationOf(this.numberGenerationOf() + 1)
    this.scheduleNumberDraftFlush()
    const target = draft.target, type = this.keypadField === 'w' ? 'weight' : 'reps'
    sendLiveValue({ t: type, sid: target.sid, ex: target.exIdx, set: target.setIdx + 1,
      entryInstanceId: target.entryInstanceId, setId: target.setId, weightUnit: target.weightUnit,
      [type]: draft[this.keypadField], at: Date.now(), source: 'watch' })
    this.closeNumberKeypad(); this.updateNumbers()
  },
  numberKey1() { this.numberKey('1') },
  numberKey2() { this.numberKey('2') },
  numberKey3() { this.numberKey('3') },
  numberKey4() { this.numberKey('4') },
  numberKey5() { this.numberKey('5') },
  numberKey6() { this.numberKey('6') },
  numberKey7() { this.numberKey('7') },
  numberKey8() { this.numberKey('8') },
  numberKey9() { this.numberKey('9') },
  numberKey0() { this.numberKey('0') },
  numberKeyDot() { this.numberKey('.') },
  numberBackspace() { this.numberKey('back') },
  refreshSetDots(page) {
    // Keep all five standard sets visible; larger plans use three-dot windows
    // plus two 48px navigation targets, including on the round safe width.
    const view = setDotWindow(this.stateOf(), page, 5)
    const dots = this.setDots || []
    if (dots.length !== view.dots.length || view.dots.some((dot, i) => dot.key !== dots[i].key)) this.setDots = view.dots
    else for (let i = 0; i < dots.length; i++) {
      if (dots[i].exIdx !== view.dots[i].exIdx) dots[i].exIdx = view.dots[i].exIdx
      if (dots[i].current !== view.dots[i].current) dots[i].current = view.dots[i].current
      if (dots[i].done !== view.dots[i].done) dots[i].done = view.dots[i].done
    }
    this.dotPage = view.page; this.dotSegmented = view.segmented
    this.dotHasPrev = view.hasPrev; this.dotHasNext = view.hasNext
  },
  prevDotSegment() { if (!this.interactionBlocked() && this.dotHasPrev) this.refreshSetDots(this.dotPage - 1) },
  nextDotSegment() { if (!this.interactionBlocked() && this.dotHasNext) this.refreshSetDots(this.dotPage + 1) },
  setDotBlockReason() {
    if (this.visible === false) return 'hidden'
    if (this.interactionBlocked(true)) {
      if (this.touchAxis) return 'touch_axis'
      if (Date.now() < (this.trailingTapBlockedUntil || 0)) return 'trailing_tap'
      if (Date.now() < (this.autoFocusIgnoreUntil || 0)) return 'auto_focus'
      return 'interaction'
    }
    if (this.isRest) return 'rest'
    if (this.paused) return 'paused'
    if (this.closeMode) return 'close'
    if (this.effortOn) return 'effort'
    if (this.lastOpen) return 'last'
    if (this.finishOn) return 'finish'
    return ''
  },
  logDotBlocked(target, detail, status) {
    this.logInteraction('dot_blocked', { entryInstanceId: target?.entryInstanceId, setId: target?.setId, set: target?.setIdx, detail, status })
    return false
  },
  pickSetDot(target) {
    this.logInteraction('dot_tap', { entryInstanceId: target?.entryInstanceId, setId: target?.setId, set: target?.setIdx })
    const reason = this.setDotBlockReason()
    if (reason || !target) return this.logDotBlocked(target, reason || 'missing_target', 'tap')
    const found = rowTarget(this.stateOf(), target)
    if (!found) return this.logDotBlocked(target, 'stale_target', 'tap')
    if (!this.setDotPicker?.pending() && found.exIdx === this.stateOf().exIdx && found.setIdx === this.stateOf().setIdx) return this.logDotBlocked(target, 'current_set', 'tap')
    if (!this.setDotPicker) this.setDotPicker = createSetDotPicker(next => this.commitSetDot(next))
    if (!this.setDotPicker.pending()) this.logInteraction('dot_queued', { setId: target.setId, set: target.setIdx })
    // Browsing a group is immediate; only the persisted focus intention waits for
    // coalescing/storage. Never put this view-only cursor into the shared cache.
    this.dotPreview = { sid: this.stateOf().sid, entryInstanceId: target.entryInstanceId, setId: target.setId,
      exIdx: found.exIdx, setIdx: found.setIdx }
    this.autoFocusSid = this.stateOf().sid
    this.autoFocusEx = found.exIdx; this.autoFocusSet = found.setIdx; this.autoFocusIgnoreUntil = 0
    this.clearFieldSelection()
    this.stateOf(this.withDotPreview(this.stateOf()))
    this.refresh()
    const batch = this.setDotPicker.request({ sid: target.sid, entryInstanceId: target.entryInstanceId, setId: target.setId,
      exIdx: target.exIdx, setIdx: target.setIdx, baseCommitRev: this.stateOf().commitRev || 0 })
    if (this.dotBatch !== batch) {
      this.dotBatch = batch
      batch.then(() => {
        if (this.dotBatch !== batch) return
        this.dotBatch = null; this.dotPreview = null
        const latest = loadState()
        if (this.visible !== false && latest.active && latest.sid === this.stateOf().sid) {
          this.stateOf(latest)
          this.autoFocusSid = latest.sid
          this.autoFocusEx = latest.exIdx; this.autoFocusSet = latest.setIdx; this.autoFocusIgnoreUntil = 0
          this.refresh()
        }
      })
    }
    return batch
  },
  withDotPreview(state) {
    const target = this.dotPreview
    if (!target) return state
    const found = rowTarget(state, target)
    if (!found || state.sid !== target.sid || found.exIdx !== state.exIdx || state.pausedAt || state.restUntil || state.closeIntent) {
      this.cancelSetDotPick()
      return state
    }
    return state.setIdx === found.setIdx ? state : { ...state, exIdx: found.exIdx, setIdx: found.setIdx }
  },
  cancelSetDotPick() {
    if (this.setDotPicker) this.setDotPicker.cancel()
    this.dotBatch = null; this.dotPreview = null; this.dotActionWaiting = null
  },
  logInteraction(stage, extra = {}, flush = false) {
    try {
      const s = this.stateOf() || {}
      const owner = this.sessionModel || this
      if (stage === 'local_commit_begin') owner.refreshProbeAt = Date.now()
      else if (stage === 'local_commit_busy' || stage === 'local_commit_failed' || stage === 'local_commit_exception' ||
          stage === 'page_show' || stage === 'page_hide' || stage === 'page_destroy') owner.refreshProbeAt = 0
      recordDiagnostic(stage, { sid: s.sid, ex: s.exIdx, set: s.setIdx, rev: s.commitRev || 0,
        pending: !!this.localCommitPending, rest: !!this.isRest, paused: !!this.paused, ...extra })
      if (flush) flushDiagnosticLog()
    } catch { /* A diagnostic must never fail an interaction. */ }
  },
  commitSetDot(target) {
    if (this.numberDraftDirty()) return this.flushNumberDraft().then(ok => ok ? this.commitSetDot(target) : false)
    this.logInteraction('dot_commit_begin', { setId: target?.setId, set: target?.setIdx })
    const reason = this.setDotBlockReason()
    if (reason) return this.logDotBlocked(target, reason, 'commit')
    const latest = loadState(), found = rowTarget(latest, target)
    if (!found) return this.logDotBlocked(target, 'stale_target', 'commit')
    if (latest.sid !== this.stateOf().sid || found.exIdx !== latest.exIdx || latest.pausedAt || latest.restUntil || found.setIdx === latest.setIdx)
      return this.logDotBlocked(target, latest.sid !== this.stateOf().sid ? 'session_changed' : found.exIdx !== latest.exIdx ? 'exercise_changed' : latest.pausedAt ? 'paused_state' : latest.restUntil ? 'rest_state' : 'current_set', 'commit')
    const pressure = persistenceStatus().failed ? 'persistence_failed' : storageStatus().failed ? 'storage_failed' : pendingCount() >= 256 ? 'outbox_full' : (latest.pendingEdits || []).length >= 256 ? 'edit_backlog_full' : ''
    if (pressure) { this.inputNotice = '等待同步后再切换'; return this.logDotBlocked(target, pressure, 'commit') }
    return commitPageAction(this, function() {
    if (this.interactionBlocked(true) || this.isRest || this.paused || this.closeMode || this.effortOn || this.lastOpen || this.finishOn) return this.logDotBlocked(target, this.setDotBlockReason() || 'interaction', 'draft')
    const s = this.stateOf(), found = rowTarget(s, target)
    if (!found || s.sid !== target.sid || found.exIdx !== s.exIdx || s.pausedAt || s.restUntil || found.setIdx === s.setIdx) return this.logDotBlocked(target, !found ? 'stale_target' : s.sid !== target.sid ? 'session_changed' : found.exIdx !== s.exIdx ? 'exercise_changed' : s.pausedAt ? 'paused_state' : s.restUntil ? 'rest_state' : 'current_set', 'draft')
    this.logInteraction('dot_focus_staged', { setId: target.setId, set: target.setIdx })
    this.clearFieldSelection()
    this.autoFocusEx = found.exIdx; this.autoFocusSet = found.setIdx; this.autoFocusIgnoreUntil = 0
    s.exIdx = found.exIdx; s.setIdx = found.setIdx; s.focusAt = Date.now(); save(s)
    this.emitEvent({ t: 'focus', sid: s.sid, entryInstanceId: s.workout.exercises[s.exIdx].entryInstanceId,
      setId: found.row.setId, ex: s.exIdx, set: s.setIdx + 1, baseCommitRev: target.baseCommitRev, at: s.focusAt, source: 'watch' })
    // Preserve any newer preview while this write completes. The batch performs
    // the single reconciliation render when the last requested group settles.
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition, previewState: (page, state) => page.withDotPreview(state) })
  },

  onComplete(expectedTarget) {
    this.logInteraction('complete_tap')
    if (!this.canSendEventNow('set')) return false
    if (this.keypadOn || this.numberEditLocked) return
    const pending = this.numberFlushOf()
    if (pending) {
      this.numberEditLocked = true
      return pending.then(ok => {
        this.numberEditLocked = false
        return ok ? this.onComplete(expectedTarget) : false
      })
    }
    const timer = this.numberTimerOf()
    if (timer != null) clearTimeout(timer)
    this.numberTimerOf(null)
    this.numberEditLocked = true
    const input = this.numberDraftOf()
    // Freeze only these bounded scalars; an arriving phone snapshot may reconcile the live draft.
    const numbers = input ? { ...input, target: { ...input.target } } : null
    const completion = commitPageAction(this, function() {
    if (this.isRest || this.paused || this.closeMode || this.interactionBlocked() || Date.now() < (this.completionIgnoreUntil || 0)) return
    const s = this.stateOf()
    const expected = expectedTarget && rowTarget(s, expectedTarget)
    if (expectedTarget && (!expected || expected.exIdx !== s.exIdx || expected.setIdx !== s.setIdx || expected.row.done)) return
    const exIdx = s.exIdx, setIdx = s.setIdx
    const current = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!current || current.done) return
    applyNumberDraft(s, numbers)
    this.completionIgnoreUntil = Date.now() + 700
    this.clearFieldSelection()
    const row = toggleSet(s, true)
    if (!row) return
    // 评分归属必须在焦点前进之前捕获：完成后游标会去下一组，这里记住的是刚完成的这一组。
    this.effortEntryText = '未登记'
    this.effortTarget = { sid: s.sid, entryInstanceId: s.workout.exercises[exIdx]?.entryInstanceId,
      setId: row.setId, completedAt: row.at, exIdx, setIdx,
      name: s.workout.exercises[exIdx]?.name || '', setNo: setIdx + 1 }
    this.restStartAt = Date.now()
    this.setRestScreenLock(!!s.restUntil)
    const phoneLedV4 = s.protocolVersion === 4 && s.sessionOrigin === 'phone' && s.phoneSession?.sid === s.sid
    // Legacy sessions carry the saved row values with the completion event.
    this.emitEvent({ t: 'set', sid: s.sid, ex: exIdx, set: setIdx + 1, at: row.at, rest: restOf(s),
      ...(phoneLedV4 ? {} : { weight: String(row.w ?? ''), reps: String(row.r ?? '') }) })
    tick()
    const next = nextUndone(s)
    if (next) {
      s.exIdx = next.exIdx; s.setIdx = next.setIdx; save(s)
      this.emitEvent({ t: 'focus', sid: s.sid, ex: next.exIdx, set: next.setIdx + 1, at: Date.now(), source: 'watch' })
    }
    else this.allFinished = true
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
    return Promise.resolve(completion).then(ok => {
      this.numberEditLocked = false
      if (!ok && this.numberDraftDirty()) this.scheduleNumberDraftFlush()
      return ok
    }, error => { this.numberEditLocked = false; throw error })
  },

  onUndo(expectedTarget) {
    if (!this.canSendEventNow('unset')) return false
    if (this.setDotPicker?.pending()) return false
    return commitPageAction(this, function() {
    const s = this.stateOf()
    const expected = expectedTarget && rowTarget(s, expectedTarget)
    if (expectedTarget && (!expected || expected.exIdx !== s.exIdx || expected.setIdx !== s.setIdx || !expected.row.done)) return
    const exIdx = s.exIdx, setIdx = s.setIdx
    const row = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!row || !row.done) return
    toggleSet(s, false)
    this.cancelRestNudge()
    this.restStartAt = 0
    this.allFinished = false
    this.emitEvent({ t: 'unset', sid: s.sid, ex: exIdx, set: setIdx + 1, at: Date.now() })
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  onCurrentSetAction() {
    if (this.paused && !this.closeMode && !this.interactionBlocked()) return this.onPause()
    if (this.setDotPicker?.pending()) {
      if (this.dotActionWaiting) return this.dotActionWaiting
      const target = this.dotPreview
      const undo = this.rowDone
      const waiting = this.setDotPicker.settled().then(ok => {
        if (this.dotActionWaiting !== waiting) return false
        this.dotActionWaiting = null
        const current = captureRow(this.stateOf())
        if (!ok || this.visible === false || !target || !current || current.sid !== target.sid ||
            current.entryInstanceId !== target.entryInstanceId || current.setId !== target.setId) return false
        if (this.closeMode || this.paused || this.interactionBlocked() || Date.now() < (this.completionIgnoreUntil || 0)) return false
        return undo ? this.onUndo(target) : this.onComplete(target)
      })
      this.dotActionWaiting = waiting
      return waiting
    }
    if (this.closeMode || this.paused || this.interactionBlocked() || Date.now() < (this.completionIgnoreUntil || 0)) return
    const target = captureRow(this.stateOf())
    if (this.rowDone) return this.onUndo(target)
    else return this.onComplete(target)
  },

  onRemoteSet(msg) {
    const s = this.stateOf()
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || row.done) return
    row.done = true
    row.at = Number(msg.at) || Date.now()
    const next = nextUndoneFrom(s, Number(msg.ex), Number(msg.set) - 1)
    if (next) {
      s.exIdx = next.exIdx
      s.setIdx = next.setIdx
    } else {
      s.exIdx = Number(msg.ex)
      s.setIdx = Number(msg.set) - 1
    }
    this.allFinished = s.workout.rows.every(rows => rows.every(r => r.done))
    save(s)
    this.refresh()
  },

  onRemoteUnset(msg) {
    const s = this.stateOf()
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || !row.done) return
    row.done = false
    row.at = 0
    s.exIdx = Number(msg.ex)
    s.setIdx = Number(msg.set) - 1
    this.allFinished = false
    save(s)
    this.refresh()
  },

  onRemoteValue(msg, field) {
    const s = this.stateOf()
    if (!msg || msg.sid !== s.sid) return
    const value = field === 'w' ? msg.weight : msg.reps
    const type = field === 'w' ? 'weight' : 'reps'
    // 回传关联编辑时间戳，旧快照/旧确认不能覆盖更新的本地输入。
    s.pendingEdits = (s.pendingEdits || []).filter(edit => !(edit.t === type &&
      edit.ex === msg.ex && edit.set === msg.set && msg.editAt != null && edit.at <= msg.editAt))
    const pending = s.pendingEdits.filter(edit => edit.t === type && edit.ex === msg.ex && edit.set === msg.set)
    const latest = pending[pending.length - 1]
    setRowValue(s, msg.ex, msg.set - 1, field, latest ? latest[type] : value)
    this.refresh()
  },

  onRemoteAddSet(msg) {
    const s = this.stateOf()
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length + 1
    if (target <= rows.length || target > 100) return
    while (rows.length < target) addSet(s, ex)
    const i = rows.length - 1
    if (msg.weight != null && msg.weight !== '') rows[i].w = msg.weight
    if (msg.reps != null && msg.reps !== '') rows[i].r = msg.reps
    save(s)
    this.refresh()
  },

  onRemoteRemoveSet(msg) {
    const s = this.stateOf()
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length - 1
    if (target < 1 || target >= rows.length) return
    if (rows.slice(target).some(r => r.done)) return
    rows.splice(target)
    s.workout.exercises[ex].sets = rows.length
    if (s.exIdx === ex && s.setIdx >= rows.length) s.setIdx = rows.length - 1
    save(s)
    this.refresh()
  },

  onRemoteFocus(msg) {
    const s = this.stateOf()
    if (!applyFocus(s, msg)) return
    save(s)
    this.refresh()
  },

  withRestPreview(latest) {
    if (this.restCrownDirty) {
      const base = this.restCrownBase
      // A preview belongs to one exact durable round. A phone skip or a changed
      // round wins; only an unchanged echo may retain unsaved crown input.
      if (latest.sid === this.stateOf().sid && base && latest.restId === base.restId && latest.restVersion === base.restVersion) {
        Object.assign(latest, { restUntil: this.stateOf().restUntil, restTargetSec: this.stateOf().restTargetSec,
          restLeftSec: this.stateOf().restLeftSec, restVersion: this.stateOf().restVersion,
          restId: this.stateOf().restId, restStartedAt: this.stateOf().restStartedAt })
      } else this.cancelRestNudge()
    }
    return latest
  },

  onSyncUpdate(msg, options) {
    if (options?.persisted && this.visible === false) { this.needsRefresh = true; return { status: 'applied', page: 'Workout', deferred: true } }
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    if (options && options.persisted) {
      // The receiver already committed the snapshot and replayed pending edits.
      // Never apply it twice, or let a late old-session notification replace UI.
      const latest = loadState()
      if (!latest.active || !latest.workout || latest.sid !== msg.sid) return { status: 'retained', page: 'Workout' }
      this.adoptSession(this.withRestPreview(latest))
    } else {
      const latest = loadState()
      applySync(latest, msg)
      this.adoptSession(this.withRestPreview(latest))
    }
    this.profile = this.stateOf().profile || this.profile
    if (this.stateOf().pausedAt) this.stopHrCapture()
    else this.startHrCapture()
    this.allFinished = (this.stateOf().workout.rows || []).every(rows => rows.every(r => r.done))
    this.refresh()
    this.logInteraction('page_sync', { restUntil: this.stateOf().restUntil || 0, restVersion: this.stateOf().restVersion || 0,
      restId: this.stateOf().restId || '', crownDirty: !!this.restCrownDirty, dotPending: !!this.setDotPicker?.pending() })
    return { status: 'applied', page: 'Workout', exercises: this.stateOf().workout.exercises.length }
  },

  onRemoteEnded() {
    this.logInteraction('remote_end', {}, true)
    this.cancelSetDotPick()
    this.cancelRestNudge()
    this.setRestScreenLock(false)
    this.hrDirty = false
    this.stateOf(loadState())
    this.stopHrCapture()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    router.replace({ uri: '/Index' })
  },

  onSkipRest() {
    return commitPageAction(this, function() {
    if (Date.now() < (this.autoFocusIgnoreUntil || 0)) return
    this.cancelRestNudge()
    const s = this.stateOf()
    if (s.restUntil && this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
    s.restUntil = 0
    this.restStartAt = 0
    this.setRestScreenLock(false)
    this.restSeq += 1
    s.restVersion = Math.max(Date.now(), (s.restVersion || 0) + 1); s.restTargetSec = 0; s.restLeftSec = 0
    this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) })
    save(s)
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },

  nudgeRest(deltaSec) {
    this.applyRestNudge(deltaSec)
    return this.flushRestNudge()
  },

  queueRestNudge(deltaSec) {
    if (!this.stateOf() || !this.stateOf().restUntil || !deltaSec) return
    this.applyRestNudge(deltaSec)
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    // 旋转回调只改截止时间和数字，停转后才写存储/发 RPC，避免堵塞手表线程。
    this.restCrownTimer = setTimeout(() => {
      this.flushRestNudge()
    }, 300)
  },

  cancelRestNudge() {
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    this.restCrownTimer = null
    this.restCrownDirty = false
  },

  async flushRestNudge() {
    const pending = this.restFlushOf()
    if (pending) {
      const result = await pending
      if (!result.ok) return false
      return this.restCrownDirty ? this.flushRestNudge() : true
    }
    if (!this.restCrownDirty) return true
    const sid = this.stateOf().sid, generation = this.restInputGeneration
    const base = this.restCrownBase, round = { restUntil: this.stateOf().restUntil, restTargetSec: this.stateOf().restTargetSec,
      restLeftSec: this.stateOf().restLeftSec, restVersion: this.stateOf().restVersion, restId: this.stateOf().restId }
    if (this.restCrownTimer) clearTimeout(this.restCrownTimer)
    this.restCrownTimer = null
    const operation = commitSessionAction(sid, state => {
      if (state.restId !== base.restId || state.restVersion !== base.restVersion) throw new Error('休息已变化，请重试')
      Object.assign(state, round)
      stageSessionEvent(state, { t: 'rest', sid, ...restOf(state) })
    })
    this.restFlushOf(operation)
    try {
      const result = await operation
      if (!result.ok) { this.syncWarning = true; this.syncLabel = '存储失败，休息调整未保存，请重试'; return false }
      replayPendingEvents()
      // Isolated page adapters also use the same frozen intention (sendEvent deduplicates).
      const event = result.value.pendingEdits?.[result.value.pendingEdits.length - 1]
      if (event) sendEvent(event)
      if (this.stateOf().sid !== sid || !loadState().active) return true
      if (this.restInputGeneration === generation) {
        this.restCrownDirty = false; this.restCrownBase = null
        this.stateOf(loadState())
        if (this.visible) this.refresh()
      } else {
        // New input is a preview on top of this exact persisted round, not a rollback.
        this.restCrownBase = { restId: round.restId, restVersion: round.restVersion }
        this.restFlushOf(null)
        return this.flushRestNudge()
      }
      return true
    } finally {
      if (this.restFlushOf() === operation) this.restFlushOf(null)
    }
  },

  applyRestNudge(deltaSec) {
    const s = this.stateOf()
    if (this.closeSaving || s?.closeIntent || !s || !s.active || !s.restUntil || !Number.isFinite(deltaSec)) return
    if (!this.restCrownDirty) this.restCrownBase = { restId: s.restId, restVersion: s.restVersion }
    this.restInputGeneration = (this.restInputGeneration || 0) + 1
    const now = Date.now()
    const target = Math.min(now + 900000, s.restUntil + deltaSec * 1000)
    s.restTargetSec = Math.max(0, Math.min(900, (s.restTargetSec || 0) + (target - s.restUntil) / 1000))
    s.restVersion = Math.max(now, (s.restVersion || 0) + 1)
    this.restCrownDirty = true
    if (target <= now) {
      if (this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
      s.restUntil = 0
      this.restStartAt = 0
      this.setRestScreenLock(false)
      this.isRest = false
      this.syncClockTimer()
    } else {
      s.restUntil = target
    }
    this.restLabel = this.mmss(Math.max(0, Math.ceil((s.restUntil - now) / 1000)))
  },

  onRestMinus() { this.nudgeRest(-15) },
  onRestPlus() { this.nudgeRest(15) },

  reconcileRestClock() {
    const s = this.stateOf()
    if (!s || !s.restUntil || s.restUntil > Date.now()) return
    if (this.restStartAt) addRestTime(s, (s.restUntil - this.restStartAt) / 1000)
    this.cancelRestNudge()
    s.restUntil = 0
    this.restStartAt = 0
    this.setRestScreenLock(false)
    save(s)
    restOver()
  },

  onPlanUpdate(msg) {
    const s = this.stateOf()
    if (msg && msg.sid && s.sid && msg.sid !== s.sid) {
      return { status: 'rejected', page: 'Workout', reason: 'session_mismatch', activeSid: s.sid }
    }
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    if (msg && msg.profile) s.profile = msg.profile
    replacePlan(s, { ...msg, name: msg.workout })
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))
    save(s)
    this.refresh()
    return { status: 'applied', page: 'Workout', exercises: s.workout.exercises.length }
  },

  onRemoteRest(msg) {
    const s = this.stateOf()
    if (!msg || msg.sid !== s.sid) return
    if (this.restCrownDirty) return
    if (!applyRest(s, msg)) return
    save(s)
    this.refresh()
  },

  isDoneRowCur() {
    const s = this.stateOf()
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    this.rowDone = !!(row && row.done)
    return !!(row && row.done)
  },

  // ---- 上次（只读历史）--------------------------------------------------------
  // 归一化模块只负责显示：拿不到（旧包、加载失败）就当作“没有上次”，训练页绝不因此崩。
  lastViewOf(ex, unit) {
    try { return typeof lastTimeView === 'function' ? lastTimeView(ex, unit) : null } catch (e) { return null }
  },
  // 打开时冻结视图和目标动作的稳定身份：训练在下面继续跑，浏览历史不改游标、不发事件。
  openLast() {
    if (!this.lastOn) return
    const s = this.stateOf()
    const ex = s.workout && s.workout.exercises[s.exIdx]
    const view = this.lastViewOf(ex, s.weightUnit)
    if (!view) return
    this.lastView = view
    this.lastTarget = { entryInstanceId: ex.entryInstanceId || null, exIdx: s.exIdx }
    this.lastTitle = '上次 · ' + (view.name || '')
    this.lastMeta = view.metaLabel
    this.lastRows = view.rows.map(r => ({ no: r.no, label: r.label, key: r.no }))
    this.lastOpen = true
    // 详情接管表冠：只滚动。关闭后恢复原来的训练页导航。
    setTimeout(() => { try { this.$element('history').requestFocus(true) } catch (e) {} }, 0)
  },
  closeLast() {
    this.lastOpen = false
    this.lastView = null
    this.lastTarget = null
    this.lastRows = []
    this.focusCrown()
    this.refresh()
  },
  // 结构更新（手机改计划/换动作）把目标动作移除了：关掉详情回当前有效训练页，不能按下标乱指。
  lastTargetStillThere(s) {
    if (!s || !s.workout || !s.workout.exercises) return false
    const t = this.lastTarget
    if (!t) return false
    if (t.entryInstanceId) return s.workout.exercises.some(e => e.entryInstanceId === t.entryInstanceId)
    return t.exIdx != null && !!s.workout.exercises[t.exIdx]
  },

  // ---- 结束入口 ---------------------------------------------------------------
  // 旗帜和“结束训练”只发起确认：不直接调 endSession/onEnd，也不补完成任何组。
  openFinish() {
    this.cancelSetDotPick(); this.clearFieldSelection()
    this.finishOn = false; this.pageIndex = 0; this.focusCrown()
  },
  closeFinish() {
    this.finishOn = false
    this.focusCrown()
    this.refresh()
  },
  // 末组补录：目标是最近一次真正完成的那一组（稳定 setId），不是游标的前一个索引。
  openLastEffort() {
    const s = this.stateOf()
    if (!s || !s.active) return
    const target = this.lastCompletedFromState(s)
    if (!target) return
    this.effortTarget = target
    this.openEffort(false)
  },

  // ---- 本组强度（RPE/RIR）----------------------------------------------------
  // 同页覆盖层：不新增页面，原计时器/RPC/心率 owner 全部继续运行，休息不会因为登记暂停或重置。
  effortTargetRow(state) {
    const t = this.effortTarget
    if (!t) return null
    const s = state || loadState()
    if (!s.active || s.sid !== t.sid || !s.workout) return null
    const exIdx = t.entryInstanceId
      ? s.workout.exercises.findIndex(ex => ex.entryInstanceId === t.entryInstanceId) : t.exIdx
    if (!(exIdx >= 0)) return null
    const rows = s.workout.rows[exIdx] || []
    const set = t.setId ? rows.findIndex(r => r.setId === t.setId) : t.setIdx
    if (!(set >= 0)) return null
    return rows[set] ? { s, exIdx, set, row: rows[set] } : null
  },
  // 重启后内存里的 lastCompleted 没了：用“最近完成的一组”重建补录目标。
  lastCompletedFromState(s) {
    let best = null
    ;(s.workout?.rows || []).forEach((rows, exIdx) => rows.forEach((r, setIdx) => {
      if (r.done && (!best || (r.at || 0) > best.completedAt)) best = { sid: s.sid,
        entryInstanceId: s.workout.exercises[exIdx]?.entryInstanceId, setId: r.setId,
        completedAt: r.at || 0, exIdx, setIdx, name: s.workout.exercises[exIdx]?.name || '', setNo: setIdx + 1 }
    }))
    return best
  },
  effortTargetValid(state) {
    const found = this.effortTargetRow(state)
    return !!(found && (!this.effortOn || !this.effortTargetWasDone || found.row.done))
  },
  openEffort(fromOp) {
    if (this.effortOn) return
    // 训练页登记当前组，休息页登记刚完成组；打开后固定目标，计时结束不换组。
    if (!this.effortTargetValid()) { this.effortNotice = ''; return }
    const found = this.effortTargetRow()
    const scale = this.stateOf().effortScale === 'rpe' || this.stateOf().effortScale === 'rir' ? this.stateOf().effortScale : 'none'
    if (scale === 'none') return
    this.effortScale = scale
    this.effortScaleLabel = effortScaleOf(scale).label
    this.effortScaleAtOpen = scale
    this.effortTargetWasDone = !!found.row.done
    this.effortBaseVersion = Number.isFinite(found.row.effortVersion) ? found.row.effortVersion : 0
    const kind = effortKindOf(found.row)
    const saved = kind ? effortValueOf(found.row, kind) : null
    this.effortHasSaved = saved != null
    this.effortDraft = null
    this.effortStale = false
    this.effortNotice = ''
    this.effortTargetLabel = (this.effortTarget.name || '') + ' · 第' + this.effortTarget.setNo + '组'
      + (found.row.done ? ' · 已完成' : ' · 训练中')
    if (kind && kind === scale && saved != null) {
      // 已登记：显示已存值（旧值即使不是 0.5 步长也如实显示，不静默改写）。
      this.effortDraft = saved
      this.effortHint = '左右滑动调整'
    } else if (kind && saved != null) {
      // 旧值是另一个量表：如实告知，本次按当前量表重新登记。
      this.effortHint = '旧值 ' + effortScaleOf(kind).label + ' ' + formatEffort(saved) + ' · 左右滑动选择'
    } else {
      this.effortHint = '左右滑动选择'
    }
    this.effortOn = true
    this.effortFromOp = !!fromOp
    this.updateEffortText()
    this.refreshEffortRest()
    this.focusCrown()
  },
  closeEffort() {
    this.effortOn = false
    this.effortDraft = null
    this.effortNotice = ''
    this.effortStale = false
    this.effortFromOp = false
    this.focusCrown()
    this.refresh()
  },
  effortMinus() { this.effortMove(-1) },
  effortPlus() { this.effortMove(1) },
  effortMove(dir) {
    if (!this.effortOn) return
    const next = stepEffortValue(this.effortScale, this.effortDraft, dir)
    if (next === this.effortDraft) return
    this.effortDraft = next
    this.effortHint = '左右滑动调整'
    this.updateEffortText()
  },
  updateEffortText() {
    const v = this.effortDraft
    this.effortDraftLabel = v == null ? '—' : formatEffort(v)
    const m = v == null ? null : effortMeaning(this.effortScale, v)
    this.effortMeaning = m ? m.text : ''
  },
  refreshEffortRest() {
    const s = this.stateOf()
    const left = s && s.restUntil ? Math.max(0, Math.ceil((s.restUntil - Date.now()) / 1000)) : 0
    this.effortRestLabel = left > 0 ? '休息 ' + this.mmss(left)
      : this.effortTargetWasDone ? '休息已结束' : '训练中'
  },
  confirmEffort() {
    if (!this.effortOn) return
    if (this.stateOf().effortScale !== this.effortScaleAtOpen) {
      // 手表中途换了量表：旧草稿按新量表保存会是错的，要求重新打开。
      this.effortNotice = '手机已切换量表，请重新打开'
      return
    }
    if (this.effortDraft == null) { this.closeEffort(); return }
    return this.commitEffort(this.effortDraft)
  },
  clearEffort() {
    if (!this.effortOn || !this.effortHasSaved) return
    return this.commitEffort(null)
  },
  commitEffort(value) {
    if (!this.canSendEventNow('effort')) { this.effortNotice = this.syncLabel; return false }
    return commitPageAction(this, function() {
    const found = this.effortTargetRow()
    if (!this.effortTargetValid()) {
      this.effortNotice = '目标组已变化，无法登记'
      return
    }
    // 只把评分字段合并进最新状态：绝不保存打开覆盖层时的整份旧 state。
    const latest = found.s
    const at = Math.max(Date.now(), Number(latest.effortSeq || 0) + 1)
    latest.effortSeq = at
    setEffort(latest, found.exIdx, found.set, this.effortScale, value, at)
    save(latest)
    this.stateOf(loadState())
    this.emitEvent({ t: 'effort', sid: latest.sid, ex: found.exIdx, set: found.set + 1,
      scale: this.effortScale, value: value == null ? null : value, clear: value == null,
      effortVersion: at, baseEffortVersion: this.effortBaseVersion, at })
    this.effortOn = false
    this.effortDraft = null
    this.effortNotice = ''
    this.focusCrown()
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },
  onRemoteEffort(msg) {
    const s = this.stateOf()
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const set = Number(msg.set) - 1
    if (!(ex >= 0) || !(set >= 0)) return
    const row = s.workout.rows[ex] && s.workout.rows[ex][set]
    if (!row) return
    const version = Number(msg.effortVersion) || Date.now()
    if (Number.isFinite(row.effortVersion) && version < row.effortVersion) return
    setEffort(s, ex, set, msg.scale, msg.clear ? null : msg.value, version)
    save(s)
    if (this.effortOn && this.effortTarget && this.effortTarget.setId === row.setId) {
      if (this.effortScale !== s.effortScale) this.effortNotice = '手机已切换量表，请重新打开'
      else this.effortNotice = '手机已更新本组强度'
    }
    this.refresh()
  },

  // 自动切到另一动作后，挡住落在新“完成/跳过”按钮上的慢双击；手动切换立即放行。
  updateAutoFocusLock(s) {
    if (this.autoFocusSid === s.sid && this.autoFocusEx != null && (this.autoFocusEx !== s.exIdx || (this.autoFocusSet != null && this.autoFocusSet !== s.setIdx) || (this.autoFocusWasRest && !s.restUntil))) {
      this.autoFocusIgnoreUntil = Date.now() + 1000
    }
    this.autoFocusSid = s.sid
    this.autoFocusEx = s.exIdx; this.autoFocusSet = s.setIdx; this.autoFocusWasRest = !!s.restUntil
  },

  refresh() {
    // BlueOS advises pausing background UI updates to avoid a growing render queue.
    // onShow reloads persisted state and performs the deferred refresh.
    if (this.visible === false) { this.needsRefresh = true; return }
    this.needsRefresh = false
    const startedAt = Date.now()
    const owner = this.sessionModel || this
    const actionAt = owner.refreshProbeAt || 0
    const data = {}
    try { return this.refreshView(data) }
    finally {
      const endedAt = Date.now(), state = this.stateOf() || {}
      data.sid = state.sid || ''; data.active = !!state.active; data.duration = Math.max(0, endedAt - startedAt)
      if (actionAt > 0 && endedAt - actionAt <= 30000) data.actionDuration = Math.max(0, endedAt - actionAt)
      if (owner.refreshProbeAt === actionAt) owner.refreshProbeAt = 0
      try { recordDiagnostic('workout_refresh', data) } catch { /* Diagnostics must never block a refresh. */ }
    }
  },

  refreshView(diagnostic = null) {
    const current = this.stateOf(), s = this.withDotPreview(current)
    if (s !== current) this.stateOf(s)
    this.weightUnit = s?.weightUnit || 'kg'
    if (!s || !s.workout) return
    if (this.freezeCloseView()) return
    this.reconcileRestClock()
    if (this.dotPreview) {
      this.autoFocusSid = s.sid
      this.autoFocusEx = s.exIdx; this.autoFocusSet = s.setIdx; this.autoFocusIgnoreUntil = 0
    }
    this.updateAutoFocusLock(s)
    this.setRestScreenLock(this.visible !== false && !!s.restUntil)
    this.rowDone = this.isDoneRowCur()
    const ex = s.workout.exercises[s.exIdx]
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    if (this.fieldTarget) {
      const target = rowTarget(s, this.fieldTarget)
      if (!target || target.row.done || target.exIdx !== s.exIdx || target.setIdx !== s.setIdx || s.pausedAt || s.restUntil || this.fieldTarget.weightUnit !== (s.weightUnit || 'kg')) this.clearFieldSelection()
    }
    const cursorKey = s.sid + ':' + (ex && ex.entryInstanceId || s.exIdx) + ':' + (row && row.setId || s.setIdx)
    this.refreshSetDots(cursorKey === this.dotCursorKey ? this.dotPage : undefined); this.dotCursorKey = cursorKey
    this.exName = ex ? ex.name : ''
    const exerciseRows = s.workout.rows[s.exIdx] || []
    this.remainingLabel = '余 ' + exerciseRows.filter(r => !r.done).length + ' 组'
    this.groupLabel = ex ? '第 ' + (s.setIdx + 1) + ' 组，共 ' + exerciseRows.length + ' 组' : ''
    this.weightVal = row && row.w !== '' && row.w != null ? row.w + ' ' + (s.weightUnit || 'kg') : '—'
    this.repsVal = row && row.r !== '' && row.r != null ? row.r + (this.isTimed(ex) ? ' 秒' : ' 次') : '—'
    // 数值与单位分开渲染：数字大、单位弱一级。
    this.weightNum = row && row.w !== '' && row.w != null ? String(row.w) : '—'
    this.weightSuffix = s.weightUnit || 'kg'
    this.repsNum = row && row.r !== '' && row.r != null ? String(row.r) : '—'
    this.repsSuffix = this.isTimed(ex) ? '秒' : '次'
    this.updateNumbers()
    this.isRest = !!s.restUntil
    this.paused = !!s.pausedAt
    this.pauseLabel = this.paused ? '继续训练' : '暂停训练'

    // 完成后游标已前进；休息提示优先展示当前待做组，避免跳过一组。
    const next = row && !row.done ? { exIdx: s.exIdx, setIdx: s.setIdx } : nextUndone(s)
    this.nextExIdx = next ? next.exIdx : -1
    // This refresh runs after most watch interactions. Summarize all set-derived
    // labels in one pass so larger workouts do not trigger repeated row scans.
    const summaryStartedAt = Date.now()
    const { totalSets, doneSets, completedVolume, completed } = summarizeWorkoutRows(s.workout)
    if (diagnostic) diagnostic.summaryDuration = Math.max(0, Date.now() - summaryStartedAt)
    this.checkCompletion(totalSets, doneSets)
    this.setProgressLabel = '完成 ' + doneSets + ' / 剩余 ' + Math.max(0, totalSets - doneSets) + ' 组'
    this.volumeLabel = this.formatVolume(completedVolume)
    this.restProgLabel = '完成 ' + doneSets + '/' + totalSets + ' 组'
    this.restExerciseName = completed
      ? s.workout.exercises[completed.exIdx].name
      : this.exName
    if (next) {
      const ne = s.workout.exercises[next.exIdx]
      const nr = s.workout.rows[next.exIdx][next.setIdx]
      const w = nr && nr.w !== '' && nr.w != null ? nr.w + (s.weightUnit || 'kg') : ''
      const timed = ne && String(ne.reps || '').indexOf('秒') >= 0
      const r = nr && nr.r !== '' && nr.r != null ? nr.r + (timed ? '秒' : '次') : ''
      this.nextTargetLabel = '下一组 · ' + ne.name
      this.nextExerciseName = ne.name
      this.nextSetLabel = '第 ' + (next.setIdx + 1) + ' / ' + (s.workout.rows[next.exIdx] || []).length + ' 组'
      this.nextValuesLabel = w && r ? w + ' × ' + r : (w || r || '待填写')
      this.nextLabel = next.exIdx !== (completed ? completed.exIdx : s.exIdx) ? '下一动作 · ' + ne.name : '下一组'
      this.nextDetails = '第 ' + (next.setIdx + 1) + ' / ' + (s.workout.rows[next.exIdx] || []).length + ' 组 · ' + (w && r ? w + ' × ' + r : (w || r || '待填写'))
    } else { this.nextLabel = '本次训练已完成'; this.nextExerciseName = '所有组已完成'; this.nextDetails = this.restProgLabel; this.nextTargetLabel = this.nextLabel; this.nextSetLabel = ''; this.nextValuesLabel = this.nextDetails }

    // 展示目标跟随当前页面，编辑目标只在打开时固定，绝不把上一组评分带入下一组。
    this.effortScale = s.effortScale === 'rpe' || s.effortScale === 'rir' ? s.effortScale : 'none'
    if (!this.effortOn) this.effortScaleLabel = effortScaleOf(this.effortScale)?.label || ''
    if (!this.effortOn) {
      if (this.isRest || this.closeMode === 'complete') {
        this.effortTarget = this.lastCompletedFromState(s)
      } else {
        this.effortTarget = row && ex ? { sid: s.sid, entryInstanceId: ex.entryInstanceId,
          setId: row.setId, exIdx: s.exIdx, setIdx: s.setIdx,
          name: ex.name || '', setNo: s.setIdx + 1 } : null
      }
    }
    this.effortEntryLabel = this.effortTarget ? '第' + this.effortTarget.setNo + '组强度' : '本组强度'
    const target = this.effortTargetRow(s)
    const targetKind = target ? effortKindOf(target.row) : null
    const targetValue = target && targetKind ? effortValueOf(target.row, targetKind) : null
    // 普通页只显示评分，含义解释只在选择层出现；同步状态统一由顶部状态栏展示。
    this.effortEntryText = targetKind && targetValue != null
      ? effortScaleOf(targetKind).label + ' ' + formatEffort(targetValue)
      : '未登记'
    this.effortNumber = targetValue != null ? formatEffort(targetValue) : '—'
    this.effortEntryOn = this.effortScale !== 'none' && !!target
    if (this.effortOn) {
      if (!this.effortTargetValid(s)) { this.effortNotice = '目标组已变化，已停止编辑' ; this.effortOn = false }
      else if (this.stateOf().effortScale !== this.effortScaleAtOpen) this.effortStale = true
      this.refreshEffortRest()
    }

    // 上次（只读参考）：当前动作的载荷 → 主数值下方一行摘要；没历史就整行隐藏。
    const lastView = this.lastViewOf(ex, s.weightUnit)
    this.lastLine = lastView ? '上次: ' + lastView.text : ''
    this.lastOn = !!lastView
    if (this.lastOpen && !this.lastTargetStillThere(s)) {
      // 结构更新把目标动作移除了：关掉详情回当前有效训练页，不按下标误指新动作。
      this.lastOpen = false; this.lastView = null; this.lastTarget = null; this.lastRows = []
    }
    // 结束入口：组数从当前 rows 的 done 状态算出来，不是示例数字。
    this.finishName = (s.workout && s.workout.name) || '自由训练'
    this.finishCount = '已完成 ' + doneSets + ' / ' + totalSets + ' 组'
    const remaining = Math.max(0, totalSets - doneSets)
    this.confirmRemain = remaining > 0
      ? '还有 ' + remaining + ' 组未完成，保存已完成的 ' + doneSets + ' 组'
      : '全部 ' + totalSets + ' 组已完成'
    // 末组评分入口：目标是最近一次实际完成的组；没有完成组或量表关闭则隐藏。
    // 量表关闭时 effortScaleOf('none') 返回 null，所以标签只在有量表时才取。
    const lastDone = this.lastCompletedFromState(s)
    const lastDoneRow = lastDone ? (s.workout.rows[lastDone.exIdx] || [])[lastDone.setIdx] : null
    const lastDoneKind = lastDoneRow ? effortKindOf(lastDoneRow) : null
    const lastDoneValue = lastDoneRow && lastDoneKind ? effortValueOf(lastDoneRow, lastDoneKind) : null
    const scaleLabel = this.effortScale === 'none' ? '' : (effortScaleOf(this.effortScale)?.label || '')
    this.lastEffortOn = this.effortScale !== 'none' && !!lastDone
    this.lastEffortText = '末组 ' + scaleLabel + '  '
      + (lastDoneKind && lastDoneValue != null ? formatEffort(lastDoneValue) : '未填写')

    const officialViewsStartedAt = Date.now()
    this.updateOfficialViews(s, next)
    if (diagnostic) diagnostic.officialViewDuration = Math.max(0, Date.now() - officialViewsStartedAt)
    this.syncClockTimer()
    this.tickClock(true)
  },
  // These map existing business state to the official views; they do not mutate it.
  displayRows(name, rows) {
    const current = this[name]
    if (!Array.isArray(current) || current.length !== rows.length || rows.some((row, i) => row.key !== current[i].key)) {
      this[name] = rows
      return
    }
    // Reuse proxy identities. Replacing five zone objects every two seconds
    // otherwise grows the native Page's strong reactiveMap for an entire workout.
    rows.forEach((row, i) => {
      for (const key of Object.keys(row)) if (current[i][key] !== row[key]) current[i][key] = row[key]
    })
  },
  updateOfficialViews(s = this.stateOf(), next) {
    if (!s?.workout) return
    if (next === undefined) {
      const row = s.workout.rows[s.exIdx]?.[s.setIdx]
      next = row && !row.done ? { exIdx: s.exIdx, setIdx: s.setIdx } : nextUndone(s)
    }
    let done = 0, total = 0
    this.displayRows('overviewRows', s.workout.exercises.map((ex, i) => {
      const rows = s.workout.rows[i] || [], n = rows.filter(r => r.done).length
      done += n; total += rows.length
      return { key: ex.entryInstanceId || String(i), index: i, name: ex.name, count: n + '/' + rows.length,
        current: i === s.exIdx, finished: rows.length > 0 && n === rows.length }
    }))
    this.doneTotal = done + '/' + total
    this.nextOfficial = next ? s.workout.exercises[next.exIdx].name + '，第 ' + (next.setIdx + 1) + ' 组' : '所有组已完成'
    // Effort.chips / Og.effortColor: the exact four shortcuts from upstream.
    this.displayRows('effortChips', (this.effortScale === 'rpe' ? [10, 9, 8, 7] : [0, 1, 2, 3]).map((value, i) => ({
      key: String(value), value, label: this.effortScale === 'rpe' && value === 7 ? '≤7' : this.effortScale === 'rir' && value === 3 ? '3+' : String(value), cls: ['band-0','band-2','band-3','band-4'][i] })))
    this.displayRows('metricEfforts', s.workout.exercises.map((ex, i) => {
      const values = (s.workout.rows[i] || []).filter(r => r.done).map(r => effortValueOf(r, this.effortScale)).filter(v => v != null)
      return { key: ex.entryInstanceId || String(i), name: ex.name, value: values.length ? (values.reduce((a,b) => a+b, 0) / values.length).toFixed(1) : null }
    }).filter(r => r.value != null).slice(-4))
    const muscles = muscleView(s.workout)
    this.displayRows('muscleRows', muscles.rows); this.muscleMore = muscles.more
    this.muscleEmpty = done > 0 ? '该动作暂无肌群数据' : '还没有组'
  },
  stepMetrics(d) {
    this.metricIndex = Math.max(0, Math.min(this.metricPages.length - 1, this.metricIndex + d))
    this.metricKind = this.metricPages[this.metricIndex].key
  },
  updateMetricPages(hasPulse) {
    if (this.hasPulse === hasPulse) return
    this.hasPulse = hasPulse
    this.metricPages = (hasPulse ? ['numbers','pulse','effort','zones','muscles'] : ['numbers','effort','muscles']).map(key => ({key}))
    this.metricIndex = 0; this.metricKind = 'numbers'
  },
  async jumpOverview(item) {
    if (this.interactionBlocked() || this.localCommitPending) return
    // Overview jumps may cross exercises and may happen during rest. Resolve the
    // durable entry identity inside the transaction, never use the old row index.
    const id = item.key
    return commitPageAction(this, function() {
      const s = this.stateOf(), index = s.workout.exercises.findIndex(ex => (ex.entryInstanceId || '') === id)
      if (index < 0) throw new Error('该动作已被删除')
      const rows = s.workout.rows[index] || [], set = Math.max(0, rows.findIndex(r => !r.done))
      if (!rows[set]) return
      s.exIdx = index; s.setIdx = set; s.focusAt = Date.now()
      stageSessionEvent(s, { t: 'focus', sid: s.sid, entryInstanceId: id, setId: rows[set].setId, ex: index, set: set + 1, at: s.focusAt, source: 'watch' })
      this.clearFieldSelection(); this.pageIndex = 1; this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },
  rateChip(item) {
    if (this.interactionBlocked()) return
    this.openEffort()
    if (this.effortOn) { this.effortDraft = item.value; return this.confirmEffort() }
  },
  startFinishHold(event) {
    // Duplicate native starts for the same contact must not postpone completion.
    if (this.holdingFinish) return
    // Child touchstart bubbles before the root resets the previous swipe guard.
    if (event && event.touches && event.touches.length) this.touchStart(event)
    if (this.closeSaving || this.visible === false || this.closeMode === 'abandon' || this.interactionBlocked(false, true)) return
    this.cancelFinishHold()
    this.holdingFinish = true; this.finishHoldAt = Date.now()
    const epoch = this.finishHoldEpoch = (this.finishHoldEpoch || 0) + 1
    // Completion owns a deadline, independently of paint/progress callbacks.
    this.finishDeadlineTimer = setTimeout(() => {
      if (this.finishHoldEpoch !== epoch || !this.holdingFinish || this.visible === false) return
      this.finishDeadlineTimer = null
      this.cancelFinishHold()
      this.saveEnd()
    }, 1000)
    this.finishHoldTimer = setInterval(() => {
      if (this.finishHoldEpoch !== epoch || !this.holdingFinish || this.visible === false) return
      const percent = Math.max(0, Math.min(100, Math.floor((Date.now() - this.finishHoldAt) / 10)))
      // Paint is also a deadline fallback when a native one-shot callback is lost.
      if (percent >= 100) { this.endFinishHold(); return }
      const progress = String(percent) + '%'
      if (this.finishProgress !== progress) this.finishProgress = progress
    }, 100)
  },
  endFinishHold() {
    const complete = this.holdingFinish && this.visible !== false && Date.now() - this.finishHoldAt >= 1000
    this.cancelFinishHold()
    if (complete) return this.saveEnd()
  },
  cancelFinishHold() {
    this.finishHoldEpoch = (this.finishHoldEpoch || 0) + 1
    if (this.finishHoldTimer != null) clearInterval(this.finishHoldTimer)
    if (this.finishDeadlineTimer != null) clearTimeout(this.finishDeadlineTimer)
    this.finishDeadlineTimer = null
    this.finishHoldTimer = null; this.holdingFinish = false; this.finishProgress = '0%'
  },
  isTimed(ex) { return ex && String(ex.reps || '').indexOf('秒') >= 0 },

  checkCompletion(total, done) {
    this.allFinished = total > 0 && done === total
    // 登记强度时不要被“全部完成”面板盖住；关闭后 refresh() 会重新判定一次。
    if (this.effortOn) return
    if (!this.allFinished) {
      if (this.stateOf().completionAcknowledged) {
        const saved = this.dotPreview ? loadState() : this.stateOf()
        saved.completionAcknowledged = false
        this.stateOf().completionAcknowledged = false
        save(saved)
      }
      if (this.closeMode === 'complete') this.closeMode = ''
      return
    }
    if (this.visible === false || !this.stateOf().active || this.stateOf().completionAcknowledged || this.closeMode) return
    this.menuOn = false
    this.closeMode = 'complete'
    this.completionIgnoreUntil = Date.now() + 400
    this.touchCancel()
    this.focusCrown()
  },

  formatVolume(value) {
    return String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
  },

  syncClockTimer() {
    if (this.visible === false) return
    // The UI displays whole seconds; 500ms keeps expiry responsive without rendering the
    // complete watch page four times a second during every rest interval.
    const period = this.stateOf() && this.stateOf().restUntil ? 500 : 1000
    if (this.timer && this.clockPeriod === period) return
    if (this.timer) clearInterval(this.timer)
    this.clockPeriod = period
    this.timer = setInterval(() => this.tickClock(), period)
  },

  tickClock(force) {
    if (this.visible === false || this.closeSaving || this.stateOf()?.closeIntent) return
    // 评分层先判目标是否还有效：会话被结束/组被撤销时 this.stateOf() 可能已经变成 blank。
    if (this.effortOn) {
      if (!this.effortTargetValid()) { this.effortOn = false; this.effortNotice = '目标组已变化，已停止编辑' }
      else this.refreshEffortRest()
    }
    const s = this.stateOf()
    if (!s || !s.workout) return
    const currentTime = new Date()
    const clockLabel = String(currentTime.getHours()).padStart(2, '0') + ':' + String(currentTime.getMinutes()).padStart(2, '0')
    if (this.clockLabel !== clockLabel) this.clockLabel = clockLabel
    if (Date.now() - (s.segmentStartedAt || s.startedAt) >= 21600000) { loadState(); this.onRemoteEnded(); return }
    const elapsed = Math.max(0, (s.pausedAt || Date.now()) - s.startedAt - (s.pausedMs || 0))
    const mins = Math.floor(elapsed / 60000)
    const secs = Math.floor((elapsed % 60000) / 1000)
    const elapsedLabel = mins + ':' + String(secs).padStart(2, '0')
    if (this.elapsedLabel !== elapsedLabel) this.elapsedLabel = elapsedLabel

    const left = s.restUntil ? Math.ceil((s.restUntil - Date.now()) / 1000) : 0
    if (s.restUntil && left <= 0) {
      this.reconcileRestClock()
      this.refresh()
      return
    }
    const restLabel = this.mmss(left)
    if (this.restLabel !== restLabel) this.restLabel = restLabel
    this.restWarn = left > 0 && left <= 5
    const total = Math.max(1, (s.restUntil - (this.restStartAt || s.restUntil - 90000)))
    const percent = String(Math.max(0, Math.min(100, (s.restUntil - Date.now()) * 100 / total))) + '%'
    if (percent !== this.restPercent) this.restPercent = percent
    this.tickMetrics(force === true)
    this.tickSyncStatus(force === true)
  },

  tickMetrics(force) {
    const s = this.stateOf(), at = Date.now()
    // Keep all session samples; only the displayed HR has a two-second budget.
    // Explicit state changes refresh immediately, independently of idle timers.
    if (force || this.hrUpdatedAt == null || at - this.hrUpdatedAt >= 2000) {
      this.hrUpdatedAt = at
      const hr = readSessionHr(s.sid)
      if (hr) s.hr = hr
      const hrLabel = s.hr?.last && at - (s.hr.sampleAt || 0) < 15000 && !s.pausedAt ? '心率 ' + s.hr.last : '心率 --'
      if (this.hrLabel !== hrLabel) this.hrLabel = hrLabel
      this.updateMetricPages(!!s.hr?.count)
      this.hrNumber = hrLabel.replace('心率 ', '')
      this.hrAverage = s.hr?.count ? String(Math.round(s.hr.sum / s.hr.count)) : '--'
      this.hrMaximum = s.hr?.max ? String(s.hr.max) : '--'
      this.hrMinimum = s.hr?.min ? String(s.hr.min) : '--'
      const zones = zoneView(s.hr, s.profile?.birthYear)
      this.hasAge = zones.max != null; this.displayRows('zoneRows', zones.rows)
    }
    if (force || this.caloriesUpdatedAt == null || at - this.caloriesUpdatedAt >= 5000) {
      this.caloriesUpdatedAt = at
      const kcalLabel = String((s.baseCalories || 0) + calories(s, s.profile, Math.max(0, ((s.pausedAt || at) - (s.segmentStartedAt || s.startedAt) - (s.pausedMs || 0)) / 60000)))
      if (this.kcalLabel !== kcalLabel) this.kcalLabel = kcalLabel
    }
  },

  tickSyncStatus(force) {
    const second = Math.floor(Date.now() / 1000)
    if (!force && this.syncSecond === second) return
    this.syncSecond = second
    const failed = persistenceStatus().failed || storageStatus().failed
    const physicalQueue = pendingCount(), sync = synchronizationStatus(), n = sync.pending
    const syncWarning = !!(failed || sync.phonePending > 0 || n > 0)
    const syncLabel = failed ? '存储失败，请保留应用' : sync.phonePending > 0 ? '待确认 ' + sync.phonePending + ' 条' : n > 0 ? '待上传 ' + n + ' 条' : ''
    if (this.syncWarning !== syncWarning) this.syncWarning = syncWarning
    if (this.syncLabel !== syncLabel) this.syncLabel = syncLabel
  },

  showDiagnostics() {
    this.diagnosticSnapshot = transportDiagnostics()
    this.diagnosticPage = 0
    this.diagnosticOn = true
    this.renderDiagnostics()
  },
  renderDiagnostics() {
    const d = this.diagnosticSnapshot, head = d.head
    const sync = synchronizationStatus(), physicalQueue = pendingCount()
    const events = d.events.slice().reverse(), pages = Math.max(1, Math.ceil(events.length / 2))
    this.diagnosticTitle = '同步诊断 ' + (this.diagnosticPage + 1) + '/' + pages
    this.diagnosticText = '待上传 ' + sync.pending + ' / 旧版留存 ' + (sync.historicalPending || 0) + ' / 手机待确认 ' + sync.phonePending + ' / 本地事件 ' + physicalQueue + '\n连接 ' + d.connected + ' / ready ' + d.readyState + ' / v' + d.peerProtocol +
      '\n队头 ' + (head ? head.type + ' / 尝试 ' + head.attempts : '无') + '\n' +
      events.slice(this.diagnosticPage * 2, this.diagnosticPage * 2 + 2).map(e => new Date(e.at).toISOString().slice(11, 19) + 'Z ' + e.stage + ' ' + e.type +
        (e.code ? '\ncode=' + e.code : '') + (e.detail ? '\n' + e.detail : '')).join('\n')
  },
  nextDiagnostic() {
    const pages = Math.max(1, Math.ceil(this.diagnosticSnapshot.events.length / 2))
    this.diagnosticPage = (this.diagnosticPage + 1) % pages
    this.renderDiagnostics()
  },
  closeDiagnostics() { this.diagnosticOn = false; this.touchCancel(); this.focusCrown() },

  mmss(sec) {
    sec = Math.max(0, Math.round(sec))
    return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0')
  },

  emitEvent(ev) {
    sendEvent(ev)
    // The draft already owns staged events. Outside a transaction, read only
    // the outstanding intentions, not another copy of the workout.
    if (this.sessionActionDraft) return
    const latest = loadState('replay')
    if (latest.sid === this.stateOf().sid) this.stateOf().pendingEdits = latest.pendingEdits || []
  },
  canSendEventNow(type) {
    const sid = this.stateOf()?.sid
    if (canSendLiveEvent({ t: type, sid })) return true
    this.inputNotice = '同步繁忙，请稍后再操作'
    this.syncWarning = true
    this.syncLabel = '同步繁忙，请稍后再操作'
    return false
  },
  onPause() { return this.setPaused(!this.stateOf().pausedAt, Date.now(), true) },
  onRemotePause(msg) {
    if (msg.sid !== this.stateOf().sid || msg.seq <= (this.stateOf().pauseVersion || 0)) return
    this.setPaused(!!msg.paused, msg.at || Date.now(), false)
  },
  async setPaused(paused, at, notify) {
    if ((await this.flushRestNudge()) === false) return false
    return commitPageAction(this, function() {
    const s = this.stateOf()
    if (paused && !s.pausedAt) {
      s.restLeftSec = restOf(s).leftSec; s.restUntil = 0; s.pausedAt = at
      this.stopHrCapture()
    } else if (!paused && s.pausedAt) {
      s.pausedMs = (s.pausedMs || 0) + Math.max(0, at - s.pausedAt); s.pausedAt = 0
      s.restUntil = s.restLeftSec ? Date.now() + s.restLeftSec * 1000 : 0
      this.startHrCapture()
    }
    s.pauseVersion = at; s.restVersion = at; save(s)
    if (!paused) this.startHrCapture()
    if (notify) { this.emitEvent({ t: 'pause', sid: s.sid, paused, seq: at, at }); this.emitEvent({ t: 'rest', sid: s.sid, ...restOf(s) }) }
    this.refresh()
    }, { commitSessionAction, loadState, replayPendingEvents, pageDefinition })
  },
  askEnd() { if (this.closeSaving || this.stateOf()?.closeIntent) return; this.cancelFinishHold(); this.closeError = ''; this.finishOn = false; this.closeMode = 'end' },
  askAbandon() { if (this.closeSaving || this.stateOf()?.closeIntent) return; this.cancelFinishHold(); this.closeError = ''; this.finishOn = false; this.closeMode = 'abandon' },
  cancelClose() {
    if (this.closeSaving || this.stateOf()?.closeIntent) return
    this.cancelFinishHold(); this.closeError = ''
    if (this.closeMode === 'complete') {
      if (Date.now() < this.completionIgnoreUntil) return
      // 继续训练后不因时钟、同步或页面恢复反复弹窗；出现未完成组才重新提示。
      this.stateOf().completionAcknowledged = true
      save(this.stateOf())
    }
    this.closeMode = ''
    this.focusCrown()
  },
  saveEnd() {
    if (this.closeMode === 'complete' && Date.now() < this.completionIgnoreUntil) return
    return this.onEnd('saved')
  },
  discardEnd() { return this.onEnd('discarded') },
  abandonEnd() { return this.onEnd('abandoned') },
  freezeCloseView() {
    const intent = this.stateOf()?.closeIntent
    if (!intent) return false
    this.closeFrozen = true
    this.cancelFinishHold(); this.cancelRestNudge()
    this.setRestScreenLock(false); this.stopHrCapture()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    this.timer = null; this.hrFlush = null
    this.closeMode = intent.close.disposition === 'saved' ? (this.allFinished ? 'complete' : 'end') : 'abandon'
    this.completionIgnoreUntil = 0
    this.syncWarning = true
    if (!this.closeError) this.closeError = '训练记录已保留，请重试完成保存'
    return true
  },
  async onEnd(reason, notifyPhone = true) {
    this.logInteraction('local_end', { status: typeof reason === 'string' ? reason : 'manual' }, true)
    if (typeof reason !== 'string') reason = 'manual'
    if (this.closeSaving || !this.stateOf()?.active) return
    const sid = this.stateOf().sid
    this.cancelFinishHold(); this.closeError = ''
    if (this.stateOf().protocolVersion === 4 && (this.localCommitPending || !this.canSendEventNow('session_close'))) {
      this.closeError = '同步繁忙，请稍后再操作'
      return false
    }
    this.cancelSetDotPick()
    this.closeSaving = true
    try {
      if ((await this.flushRestNudge()) === false) { this.syncWarning = true; this.closeError = '休息调整未保存，请重试'; this.syncLabel = this.closeError; return }
      // The per-session storage queue already orders this after an in-flight set.
      let result = await commitLocalClose(sid, reason)
      const latest = loadState()
      // App recovery may have finished this exact frozen close while the old
      // Page was displaying retry. Reconcile durable evidence, never close again.
      const intent = this.stateOf()?.closeIntent
      if (!result.ok && intent && !latest.active && (readStored('closed_sessions') || []).includes(sid)) {
        const entry = journalEntry(sid)
        if (entry?.localClose && entry.closeEvent?.eventId === intent.close.eventId &&
            (entry.disposition !== 'saved' || readStored('summary_last')?.sid === sid)) result = { ok: true, entry }
      }
      if (latest.sid === sid || !latest.active) this.stateOf(latest)
      if (!result.ok) {
        const frozen = this.freezeCloseView()
        this.syncWarning = true; this.closeError = frozen ? '训练记录已保留，存储收尾未完成，请重试' : '存储失败，未结束，请重试'; this.syncLabel = this.closeError; return
      }
      // The close journal is the recovery source. Upload must not keep a saved
      // workout on this page or turn a transport error into a save failure.
      try { appTimeout(() => { try { replayPendingEvents() } catch (_) {} }, 1) } catch (_) {}
      if (this.visible === false) return
      if (result.pendingRecovery) { this.freezeCloseView(); this.closeError = '训练记录已保留，存储收尾未完成，请重试'; return }
      this.cancelRestNudge(); this.setRestScreenLock(false); this.stopHrCapture()
      if (this.timer) clearInterval(this.timer)
      if (this.hrFlush) clearInterval(this.hrFlush)
      router.replace({ uri: result.entry.disposition === 'saved' ? '/Summary' : '/Index' })
    } catch (_) { this.syncWarning = true; this.closeError = '存储失败，未结束，请重试'; this.syncLabel = this.closeError }
    finally { this.closeSaving = false }
  },
}

export default pageDefinition
</script>
<template>
<div class="page" id="training" touch-focusable="true" vibration-effectEnabled="false" rotation-sensitivity="1" onrotation="onRotation" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
  <div class="topbar" if="{{ !effortOn && !lastOpen && !diagnosticOn && !keypadOn }}"><text class="top-lead" if="{{ !syncWarning }}">{{ hrLabel }}</text><text class="sync-pill" if="{{ syncWarning }}">{{ syncLabel }}</text><text class="clock">{{ clockLabel }}</text></div>
  <div class="pager" if="{{ !closeMode && !effortOn && !lastOpen && !diagnosticOn && !keypadOn }}">
    <div class="screen overview-screen" show="{{ pageIndex === 0 }}">
      <list class="overview-scroll"><list-item type="overview-title" class="overview-head"><text class="overview-name">{{ finishName }}</text><text class="quiet">{{ doneTotal }} 组</text></list-item>
        <list-item type="exercise" class="overview-row {{ item.current ? 'overview-current' : '' }}" for="{{ item in overviewRows }}" tid="key" onclick="jumpOverview(item)"><div class="exercise-mark"><image class="mark-icon" src="/common/icons/wear-play-accent.svg" if="{{ item.current }}" /><image class="mark-icon" src="/common/icons/wear-check.svg" if="{{ !item.current && item.finished }}" /></div><div class="overview-copy"><text class="overview-ex {{ item.finished ? 'muted' : '' }}">{{ item.name }}</text><text class="overview-count">{{ item.count }}</text></div></list-item>
        <list-item type="overview-actions" class="overview-actions"><text class="quiet sync-line" if="{{ closeError || syncLabel }}">{{ closeError || syncLabel }}</text><div class="hold-finish"><image class="button-icon" src="/common/icons/wear-flag.svg" /><text class="button-word">{{ closeSaving ? '正在保存…' : '按住以结束' }}</text><div class="hold-fill" style="width: {{ finishProgress }};"><div class="hold-ink-label"><image class="button-icon" src="/common/icons/wear-flag-ink.svg" /><text class="button-word ink">{{ closeSaving ? '正在保存…' : '按住以结束' }}</text></div></div><div class="hold-touch" ontouchstart="startFinishHold" ontouchend="endFinishHold" ontouchcancel="cancelFinishHold"></div></div><input class="row-button danger" type="button" value="放弃训练" onclick="askAbandon" /></list-item>
      </list>
    </div>
    <div class="screen live-screen" show="{{ pageIndex === 1 }}">
      <div class="training-content" if="{{ !isRest }}">
        <div class="set-lines"><text class="ex-name" onclick="openExercises">{{ exName }}</text><text class="place">{{ inputNotice || (groupLabel + (rowDone ? ' · 完成' : '')) }}</text>
        <div class="inputs"><div class="field {{ selectedField === 'w' ? 'field-selected' : '' }}" onclick="editWeight"><text class="field-label">重量</text><div class="field-number"><text class="fval {{ weightNum.length > 4 ? 'long-value' : '' }}">{{ weightNum }}</text><text class="funit">{{ weightSuffix }}</text></div></div><div class="field {{ selectedField === 'r' ? 'field-selected' : '' }}" onclick="editReps"><text class="field-label">{{ repsSuffix === '秒' ? '保持' : '次数' }}</text><div class="field-number"><text class="fval {{ repsNum.length > 4 ? 'long-value' : '' }}">{{ repsNum }}</text><text class="funit" if="{{ repsSuffix === '秒' }}">s</text></div></div></div>
        <text class="last-text" if="{{ lastOn }}">{{ lastLine }}</text><text class="quiet done-effort" if="{{ effortEntryOn && rowDone }}" onclick="openEffort">{{ effortEntryText }}</text></div>
        <div class="navrow"><div class="arrow-button" onclick="onPrevSet"><image class="arrow-icon" src="/common/icons/wear-left.svg" /></div><div class="primary-button" onclick="onCurrentSetAction"><image class="button-icon" src="{{ rowDone ? '/common/icons/wear-undo-ink.svg' : '/common/icons/wear-check-ink.svg' }}" /><text class="primary-word">{{ paused ? '继续训练' : rowDone ? '撤回' : '完成' }}</text></div><div class="arrow-button" onclick="onNextSet"><image class="arrow-icon" src="/common/icons/wear-right.svg" /></div></div>
      </div>
      <div class="rest-content" if="{{ isRest }}"><div class="countdown-row"><div class="arrow-button" onclick="openRestExercise"><image class="arrow-icon" src="/common/icons/wear-left.svg" /></div><text class="rest {{ restWarn ? 'rest-warning' : '' }}">{{ restLabel }}</text><div class="arrow-spacer"></div></div><div class="time-track"><div class="time-fill" style="width: {{ restPercent }};"></div></div>
        <div class="rrow"><input class="edge-button" type="button" value="−15" onclick="onRestMinus" /><div class="skip-button" onclick="onSkipRest"><image class="button-icon" src="/common/icons/wear-next.svg" /><text class="button-word">跳过</text></div><input class="edge-button" type="button" value="+15" onclick="onRestPlus" /></div>
        <div class="effort-slot" if="{{ effortEntryOn }}"><text class="quiet effort-question" if="{{ effortNumber === '—' }}">{{ effortScaleLabel }} · 这组有多吃力？</text><div class="chip-row" if="{{ effortNumber === '—' }}"><input class="effort-chip {{ item.cls }}" type="button" for="{{ item in effortChips }}" tid="key" value="{{ item.label }}" onclick="rateChip(item)" /></div><input class="rated-pill" type="button" if="{{ effortNumber !== '—' }}" value="{{ effortEntryText }}" onclick="openEffort" /></div>
        <div class="up-next" onclick="openNextExercise"><div class="up-next-head"><text class="next-label">下一个</text><text class="quiet next-elapsed">{{ elapsedLabel }}</text></div><text class="next-name">{{ nextExerciseName }}</text><div class="next-meta"><text class="next-set">{{ nextSetLabel }}</text><text class="next-values {{ nextValuesLabel.length > 17 ? 'next-values-long' : '' }}">{{ nextValuesLabel }}</text></div></div>
      </div>
    </div>
    <div class="screen metrics-screen" show="{{ pageIndex === 2 }}"><div class="metrics-main" if="{{ metricKind === 'numbers' }}"><text class="metric-time {{ elapsedLabel.length > 5 ? 'metric-time-long' : '' }}">{{ elapsedLabel }}</text><div class="metric-line"><text class="metric-number red">{{ hrNumber }}</text><image class="metric-heart" src="/common/icons/wear-heart-red.svg" /></div><div class="metric-line"><text class="metric-number {{ kcalLabel.length > 5 ? 'metric-number-long' : '' }}">{{ kcalLabel }}</text><text class="metric-unit">KCAL</text></div><div class="metric-line" if="{{ volumeLabel !== '0' }}"><text class="metric-number {{ volumeLabel.length > 7 ? 'metric-number-long' : '' }}">{{ volumeLabel }}</text><text class="metric-unit">{{ weightUnit }}</text></div><div class="metric-line"><text class="metric-number {{ doneTotal.length > 8 ? 'metric-number-long' : '' }}">{{ doneTotal }}</text><text class="metric-unit">组数</text></div></div>
      <div class="metrics-main" if="{{ metricKind === 'pulse' }}"><div class="metric-line"><text class="metric-number red">{{ hrAverage }}</text><image class="metric-heart" src="/common/icons/wear-heart-red.svg" /><text class="metric-unit red">平均</text></div><div class="metric-line"><text class="metric-number">{{ hrMaximum }}</text><text class="metric-unit">最高</text><text class="pulse-min">{{ hrMinimum }}</text><text class="metric-unit">最低</text></div></div>
      <div class="metric-efforts" if="{{ metricKind === 'effort' }}"><text class="quiet" if="{{ !metricEfforts.length }}">尚未评定强度</text><div class="metric-effort-row" for="{{ item in metricEfforts }}" tid="key"><text class="effort-ex">{{ item.name }}</text><text class="effort-average">{{ item.value }}</text></div></div>
      <div class="zone-page" if="{{ metricKind === 'zones' }}"><div class="zone-track {{ item.cls }} {{ item.current ? 'zone-current' : '' }} {{ item.dim ? 'zone-dim' : '' }} {{ !hasAge ? 'zone-no-age' : '' }}" style="border-color: {{ item.border }};" for="{{ item in zoneRows }}" tid="key"><div class="zone-fill" style="width: {{ item.fill }}; background-color: {{ item.color }};"></div><div class="zone-copy" if="{{ hasAge }}"><text class="zone-name">{{ item.zone }}</text><text class="zone-band">{{ item.band }}</text><text class="zone-time">{{ item.time }}</text></div></div><div class="no-age" if="{{ !hasAge }}"><text class="no-age-title">未设置年龄</text><text class="quiet">在手机应用中添加出生年份</text></div></div>
      <div class="muscles-page" if="{{ metricKind === 'muscles' }}"><div class="muscle-track"></div><div class="muscle-segment" for="{{ item in muscleRows }}" tid="key" style="top: {{ item.top }}; height: {{ item.height }}; background-color: {{ item.color }};"></div><div class="muscle-list" if="{{ muscleRows.length }}"><div class="muscle-row" for="{{ item in muscleRows }}" tid="key"><div class="muscle-dot" style="background-color: {{ item.color }};"></div><text class="muscle-number">{{ item.value }}</text><text class="muscle-name">{{ item.name }}</text></div><text class="quiet more-muscles" if="{{ muscleMore > 0 }}">另有 {{ muscleMore }} 项</text></div><text class="quiet muscle-empty" if="{{ !muscleRows.length }}">{{ muscleEmpty }}</text></div>
      <div class="vertical-dots"><div class="pager-dot {{ metricKind === item.key ? 'pager-current' : '' }}" for="{{ item in metricPages }}" tid="key"></div></div>
    </div>
  </div>
  <div class="page-dots" if="{{ !closeMode && !effortOn && !lastOpen && !diagnosticOn && !keypadOn }}"><div class="pager-dot {{ pageIndex === 0 ? 'pager-current' : '' }}"></div><div class="pager-dot {{ pageIndex === 1 ? 'pager-current' : '' }}"></div><div class="pager-dot {{ pageIndex === 2 ? 'pager-current' : '' }}"></div></div>
  <div class="overlay" if="{{ closeMode && !effortOn }}"><list class="modal-scroll"><list-item type="confirm" class="modal-content"><div class="done-mark" if="{{ closeMode === 'complete' }}"><image class="done-icon" src="/common/icons/wear-check-ink.svg" /></div><text class="confirm-title">{{ closeMode === 'complete' ? '所有组已完成' : closeMode === 'abandon' ? '放弃训练？' : '结束训练？' }}</text><text class="quiet confirm-note">{{ closeError || confirmRemain }}</text><input class="row-button" type="button" if="{{ closeMode === 'complete' && effortEntryOn && !closeFrozen }}" disabled="{{ closeSaving }}" value="{{ effortEntryText }}" onclick="openEffort" /><input class="row-button danger" type="button" if="{{ closeMode === 'abandon' }}" value="放弃训练" onclick="abandonEnd" /><input class="primary-input" type="button" if="{{ closeMode === 'end' }}" value="结束并保存" onclick="saveEnd" /><div class="hold-finish" if="{{ closeMode === 'complete' }}"><image class="button-icon" src="/common/icons/wear-flag.svg" /><text class="button-word">{{ closeSaving ? '正在保存…' : '按住以结束' }}</text><div class="hold-fill" style="width: {{ finishProgress }};"><div class="hold-ink-label modal-ink-label"><image class="button-icon" src="/common/icons/wear-flag-ink.svg" /><text class="button-word ink">{{ closeSaving ? '正在保存…' : '按住以结束' }}</text></div></div><div class="hold-touch" ontouchstart="startFinishHold" ontouchend="endFinishHold" ontouchcancel="cancelFinishHold"></div></div><input class="row-button" type="button" if="{{ !closeFrozen }}" disabled="{{ closeSaving }}" value="继续训练" onclick="cancelClose" /></list-item></list></div>
  <div class="overlay" if="{{ lastOpen && !closeMode }}"><list class="modal-scroll" id="history" touch-focusable="true"><list-item type="last-title" class="modal-content"><text class="confirm-title">{{ lastTitle }}</text><text class="quiet">{{ lastMeta }}</text></list-item><list-item type="last-row" class="history-row" for="{{ r in lastRows }}" tid="key"><text class="history-no">{{ r.no }}</text><text class="history-value">{{ r.label }}</text></list-item><list-item type="last-back" class="modal-content"><input class="row-button" type="button" value="继续训练" onclick="closeLast" /></list-item></list></div>
  <div class="overlay" if="{{ effortOn && !diagnosticOn }}"><list class="modal-scroll"><list-item type="effort" class="modal-content"><text class="quiet">{{ effortRestLabel }}</text><text class="confirm-title">这组有多吃力？</text><text class="quiet">{{ effortTargetLabel }}</text><text class="quiet">{{ effortScaleLabel }}</text><div class="effort-pick"><input class="edge-button" type="button" value="−" onclick="effortMinus" /><text class="effort-value">{{ effortDraftLabel }}</text><input class="edge-button" type="button" value="+" onclick="effortPlus" /></div><text class="quiet effort-description">{{ effortNotice || effortMeaning || effortHint }}</text><input class="primary-input" type="button" value="保存" onclick="confirmEffort" /><input class="row-button" type="button" value="取消" onclick="closeEffort" /><input class="row-button danger" type="button" if="{{ effortHasSaved }}" value="清除评分" onclick="clearEffort" /></list-item></list></div>
  <div class="overlay" if="{{ diagnosticOn }}"><list class="modal-scroll"><list-item type="diagnostic" class="modal-content"><text class="confirm-title">{{ diagnosticTitle }}</text><text class="diagnostic-text">{{ diagnosticText }}</text><input class="row-button" type="button" value="下一页" onclick="nextDiagnostic" /><input class="row-button" type="button" value="返回" onclick="closeDiagnostics" /></list-item></list></div>
  <div class="number-keypad" id="keypad" if="{{ keypadOn }}"><div class="num-number-row"><div class="num-cancel" onclick="closeNumberKeypad"><image class="num-cancel-icon" src="/common/icons/wear-left.svg" /></div><text class="num-keyboard-value {{ keypadValue.length > 6 ? 'num-long-value' : '' }}">{{ keypadValue }}</text><text class="num-unit">{{ keypadUnit }}</text></div><text class="num-notice" if="{{ keypadNotice }}">{{ keypadNotice }}</text><div class="num-grid"><div class="num-key-row"><input class="num-key" type="button" value="1" onclick="numberKey1" /><input class="num-key" type="button" value="2" onclick="numberKey2" /><input class="num-key" type="button" value="3" onclick="numberKey3" /></div><div class="num-key-row"><input class="num-key" type="button" value="4" onclick="numberKey4" /><input class="num-key" type="button" value="5" onclick="numberKey5" /><input class="num-key" type="button" value="6" onclick="numberKey6" /></div><div class="num-key-row"><input class="num-key" type="button" value="7" onclick="numberKey7" /><input class="num-key" type="button" value="8" onclick="numberKey8" /><input class="num-key" type="button" value="9" onclick="numberKey9" /></div><div class="num-key-row"><input class="num-key num-decimal" type="button" value="." disabled="{{ keypadField !== 'w' }}" onclick="numberKeyDot" /><input class="num-key" type="button" value="0" onclick="numberKey0" /><div class="num-key num-symbol" onclick="numberBackspace"><image class="num-key-icon" src="/common/icons/wear-back.svg" /></div></div></div><div class="num-ok" onclick="saveNumberKeypad"><image class="num-ok-icon" src="/common/icons/wear-check-ink.svg" /></div></div>
</div>
</template>
<style>
/* openGym v1.4.5 square Wear UI. Source dp/sp ×1.6, 390×450 design canvas. */
.page { width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; }
.topbar { position: absolute; top: 8px; left: 64px; width: 262px; height: 28px; flex-direction: row; justify-content: space-between; align-items: center; }
.top-lead { font-size: 19px; color: #FF453A; width: 180px; lines: 1; }
.clock { color: #FFFFFF; font-size: 19px; width: 70px; text-align: right; }
.sync-pill { max-width: 180px; height: 26px; border-radius: 13px; background-color: #2E1D02; color: #FF9F0A; font-size: 19px; lines: 1; }
/* Native flex minima differ from browsers: reserve an explicit content viewport. */
.pager { position: absolute; left: 0px; top: 44px; width: 390px; height: 356px; }
.screen { width: 390px; height: 356px; flex-direction: column; align-items: center; }
.page-dots { position: absolute; left: 0px; top: 414px; width: 390px; height: 12px; flex-direction: row; justify-content: center; align-items: center; }
.pager-dot { width: 6px; height: 6px; border-radius: 3px; background-color: #4A4A4D; margin-left: 4px; margin-right: 4px; }
.pager-current { background-color: #FFFFFF; }
.overview-scroll { width: 336px; height: 356px; padding-top: 6px; padding-bottom: 16px; }
.overview-head { width: 336px; flex-direction: column; align-items: center; margin-bottom: 5px; }
.overview-name { width: 328px; font-size: 22px; line-height: 28px; font-weight: bold; color: #FFFFFF; text-align: center; lines: 2; }
.quiet { color: #8D8D93; font-size: 19px; line-height: 26px; text-align: center; lines: 2; }
.overview-row { width: 336px; min-height: 68px; padding: 9px 11px; background-color: #1C1C1E; border-radius: 19px; margin-bottom: 5px; flex-direction: row; align-items: center; border-width: 2px; border-color: #1C1C1E; }
.overview-current { background-color: #2C2C2E; border-color: #A3E635; }
.exercise-mark { width: 48px; height: 48px; border-radius: 11px; background-color: #2C2C2E; align-items: center; justify-content: center; margin-right: 13px; }
.mark-icon { width: 19px; height: 19px; }
.overview-copy { flex: 1; min-width: 0px; flex-direction: column; }
.overview-ex { font-size: 21px; font-weight: bold; color: #FFFFFF; lines: 2;  text-overflow: ellipsis; }
.overview-count { font-size: 19px; color: #8D8D93; }
.muted { color: #8D8D93; }
.overview-actions { width: 336px; flex-direction: column; align-items: center; }
.sync-line { margin-top: 10px; margin-bottom: 6px; }
.hold-finish { width: 100%; height: 64px; border-radius: 32px; background-color: #2C2C2E; border-width: 2px; border-color: #A3E635; align-items: center; justify-content: center; margin-top: 6px; margin-bottom: 5px; }
/* A stable last-painted touch surface prevents the growing fill stealing contact. */
.hold-touch { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; border-radius: 32px; }
.hold-fill { overflow: hidden; position: absolute; top: 0px; left: 0px; height: 100%; background-color: #A3E635; border-radius: 39px; }
.hold-ink-label { width: 332px; height: 60px; flex-shrink: 0; align-items: center; justify-content: center; }
.modal-ink-label { width: 316px; }
.button-word.ink { color: #0C0E12; }
