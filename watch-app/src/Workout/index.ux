<script>
// 主训练页（单屏 + 手势）：重量/次数保持可见，休息态只保留必要操作。
import router from '@blueos.app.appmanager.router'
import {
  loadState, save, replacePlan, applySync, toggleSet, nextUndone,
  addHr, flushHr, endSession, addSet, removeSet, addRestTime, setRowValue, calories,
} from '../lib/session.js'
import { startHr, stopHr, tick, restOver } from '../lib/sensors.js'
import { startServer, sendEvent, sendControl, pendingCount, isConnected } from '../lib/rpc.js'

export default {
  data: {
    exName: '',
    groupLabel: '',
    elapsedLabel: '',
    weightVal: '—',
    repsVal: '—',
    restLabel: '0:00',
    restTotalLabel: '0:00',
    restProgLabel: '',
    nextLabel: '',
    hrLabel: '♥ --',
    syncLabel: '',
    isRest: false,
    menuOn: false,
    leaveChoice: false,
    allFinished: false,
    rowDone: false,
    kcalLabel: '0',
  },

  onInit() {
    const s = loadState()
    if (!s.active || !s.workout) { router.push({ uri: '/Index' }); return }
    this.state = s
    this.profile = s.profile || null
    this.restSeq = 0
    this.remoteRestSeq = 0
    this.restStartAt = 0
    this.hrLast = 0
    this.hrDirty = false
    this.hrActive = false
    this.clockPeriod = 0
    this.touch = null

    this.bindRpc()

    // 保存的游标就是当前组；nextUndone 仅用于完成后找下一组。
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))

    if (s.restUntil && s.restUntil <= Date.now()) {
      s.restUntil = 0
      save(s)
      restOver()
    }

    this.hrFlush = setInterval(() => {
      if (this.hrDirty) {
        flushHr(this.state)
        this.hrDirty = false
      }
    }, 15000)

    this.startHrCapture()
    this.refresh()
  },

  onShow() {
    // Keypad/动作列表独立读取并保存会话，返回训练页时重新读取，确保重量立即回显。
    const latest = loadState()
    if (!latest.active || !latest.workout) { this.stopHrCapture(); router.replace({ uri: '/Summary' }); return }
    if (latest.active && latest.workout) {
      this.state = latest
      this.profile = latest.profile || null
    }
    if (this.state) this.bindRpc()
    // 与输入页通过持久化状态交接，使用当前连接的可靠事件队列发送。
    const edits = this.state && this.state.pendingEdits || []
    for (const edit of edits) sendEvent(edit)
    this.startHrCapture()
    this.refresh()
    this.focusCrown()
  },

  onReady() { this.focusCrown() },
  focusCrown() {
    try { this.$element('training').requestFocus(true) } catch (e) {}
  },
  onRotation(ev) {
    if (!ev || ev.state === 3 || this.menuOn || this.leaveChoice) return
    const delta = Number(ev.delta) || (ev.direction === true ? 1 : ev.direction === false ? -1 : 0)
    if (!delta) return
    if (this.isRest) this.nudgeRest(delta > 0 ? 5 : -5)
    else this.stepSet(delta > 0 ? 1 : -1)
  },
  onBackPress() {
    if (this.menuOn) this.menuOn = false
    else this.leaveChoice = true
    return true
  },
  openMenu() { this.menuOn = true; this.leaveChoice = false },
  openActions() { this.leaveChoice = true; this.menuOn = false },
  openExercises() { router.push({ uri: '/ExerciseList' }) },

  bindRpc() {
    const handle = (method, ...args) => {
      // 隐藏的训练页仍会收到 RPC；保留输入页刚保存的编辑和其他页面的更新。
      const latest = loadState()
      if (latest.active && latest.sid === this.state.sid) this.state = latest
      return this[method](...args)
    }
    startServer({
      onPlan: (msg) => handle('onPlanUpdate', msg),
      onSync: (msg) => handle('onSyncUpdate', msg),
      onRest: (msg) => handle('onRemoteRest', msg),
      onSet: (msg) => handle('onRemoteSet', msg),
      onUnset: (msg) => handle('onRemoteUnset', msg),
      onWeight: (msg) => handle('onRemoteValue', msg, 'w'),
      onReps: (msg) => handle('onRemoteValue', msg, 'r'),
      onAddSet: (msg) => handle('onRemoteAddSet', msg),
      onRemoveSet: (msg) => handle('onRemoteRemoveSet', msg),
      onFocus: (msg) => handle('onRemoteFocus', msg),
      onEnded: () => this.onRemoteEnded(),
      onError: () => { this.syncLabel = '连接异常' },
    })
  },

  onHide() {
    this.stopHrCapture()
  },

  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    this.stopHrCapture()
  },

  startHrCapture() {
    if (this.hrActive || !this.state || !this.state.active) return
    this.hrActive = true
    startHr((bpm) => {
      addHr(this.state, bpm)
      this.hrLast = bpm
      this.hrDirty = true
    })
  },

  stopHrCapture() {
    if (!this.hrActive) return
    stopHr()
    this.hrActive = false
    if (this.hrDirty && this.state) {
      flushHr(this.state)
      this.hrDirty = false
    }
  },

  touchStart(e) {
    const t = e.touches && e.touches[0]
    this.touch = t ? { x: t.clientX, y: t.clientY } : null
    this.touchLast = this.touch
  },

  touchMove(e) {
    if (!this.touch) return
    const t = e.touches && e.touches[0]
    if (t) this.touchLast = { x: t.clientX, y: t.clientY }
  },

  touchEnd(e) {
    if (!this.touch) return
    // 固件触摸回调未必带 changedTouches，用最后一次 move 的坐标兜底。
    const t = e.changedTouches && e.changedTouches[0] || e.touches && e.touches[0]
    const end = t ? { x: t.clientX, y: t.clientY } : this.touchLast
    const start = this.touch
    this.touchCancel()
    if (!end) return
    const dx = end.x - start.x
    const dy = end.y - start.y
    if (Math.abs(dx) < 60 && Math.abs(dy) < 60) return
    if (this.leaveChoice) return
    if (this.menuOn) {
      if (dy > 60) this.menuOn = false
      return
    }
    if (Math.abs(dx) > Math.abs(dy)) {
      // 右滑：训练操作面板；左滑：组菜单。
      if (dx > 60) this.leaveChoice = true
      else if (dx < -60) this.menuOn = true
    } else {
      // 上滑：上一个动作；下滑：下一个动作。
      if (dy < -60) this.stepExercise(-1)
      else if (dy > 60) this.stepExercise(1)
    }
  },

  touchCancel() { this.touch = null; this.touchLast = null },

  closeMenu() { this.menuOn = false },

  continueTraining() { this.leaveChoice = false },

  leaveTraining() {
    this.leaveChoice = false
    this.stopHrCapture()
    save(this.state)
    router.push({ uri: '/Index' })
  },

  onMenuAddSet() {
    const s = this.state
    const ex = s.exIdx
    addSet(s, ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    s.setIdx = rows.length - 1
    this.menuOn = false
    sendEvent({ t: 'add_set', sid: s.sid, ex, set: s.setIdx + 1, weight: rows[s.setIdx].w, reps: rows[s.setIdx].r, at: Date.now() })
    this.refresh()
  },

  onMenuRemoveSet() {
    const s = this.state
    const ex = s.exIdx
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1 || rows[rows.length - 1].done) { this.menuOn = false; return }
    const removed = rows.length
    removeSet(s, ex)
    this.menuOn = false
    sendEvent({ t: 'remove_set', sid: s.sid, ex, set: removed, at: Date.now() })
    this.refresh()
  },

  onMenuPrev() { this.menuOn = false; this.stepSet(-1) },
  onMenuNext() { this.menuOn = false; this.stepSet(1) },

  stepSet(dir) {
    const s = this.state
    const rows = s.workout.rows[s.exIdx]
    if (!rows) return
    const prevEx = s.exIdx
    let ni = s.setIdx + dir
    let nx = s.exIdx
    if (ni < 0) {
      if (nx <= 0) return
      nx -= 1; ni = s.workout.rows[nx].length - 1
    } else if (ni >= rows.length) {
      if (nx >= s.workout.rows.length - 1) return
      nx += 1; ni = 0
    }
    s.exIdx = nx; s.setIdx = ni
    save(s)
    if (nx !== prevEx) sendControl({ t: 'focus', sid: s.sid, ex: nx, set: ni + 1, at: Date.now() })
    this.refresh()
  },

  stepExercise(dir) {
    const s = this.state
    if (!s.workout || !s.workout.exercises.length) return
    const nx = Math.max(0, Math.min(s.exIdx + dir, s.workout.exercises.length - 1))
    if (nx === s.exIdx) return
    const rows = s.workout.rows[nx] || []
    const first = rows.findIndex(r => !r.done)
    s.exIdx = nx
    s.setIdx = first >= 0 ? first : 0
    save(s)
    sendControl({ t: 'focus', sid: s.sid, ex: nx, set: s.setIdx + 1, at: Date.now() })
    this.refresh()
  },

  onPrevSet() { this.stepSet(-1) },
  onNextSet() { this.stepSet(1) },

  editWeight() {
    if (this.isRest || this.isDoneRowCur()) return
    router.push({ uri: '/Keypad', params: { exIdx: this.state.exIdx, setIdx: this.state.setIdx, field: 'w' } })
  },

  editReps() {
    if (this.isRest || this.isDoneRowCur()) return
    router.push({ uri: '/Keypad', params: { exIdx: this.state.exIdx, setIdx: this.state.setIdx, field: 'r' } })
  },

  onComplete() {
    const s = this.state
    const exIdx = s.exIdx, setIdx = s.setIdx
    const row = toggleSet(s, true)
    if (!row) return
    sendEvent({ t: 'set', sid: s.sid, ex: exIdx, set: setIdx + 1, reps: row.r != null ? String(row.r) : '', weight: row.w != null ? String(row.w) : '', at: row.at })
    tick()
    const next = nextUndone(s)
    if (next) { s.exIdx = next.exIdx; s.setIdx = next.setIdx; save(s) }
    else this.allFinished = true
    this.refresh()
  },

  onUndo() {
    const s = this.state
    const exIdx = s.exIdx, setIdx = s.setIdx
    const row = s.workout.rows[exIdx] && s.workout.rows[exIdx][setIdx]
    if (!row || !row.done) return
    toggleSet(s, false)
    this.allFinished = false
    sendEvent({ t: 'unset', sid: s.sid, ex: exIdx, set: setIdx + 1, at: Date.now() })
    this.refresh()
  },

  onRemoteSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || row.done) return
    row.done = true
    row.at = Date.now()
    if (s.exIdx === msg.ex && s.setIdx === msg.set - 1) {
      const next = nextUndone(s)
      if (next) { s.exIdx = next.exIdx; s.setIdx = next.setIdx }
    }
    this.allFinished = s.workout.rows.every(rows => rows.every(r => r.done))
    save(s)
    this.refresh()
  },

  onRemoteUnset(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const row = s.workout.rows[msg.ex] && s.workout.rows[msg.ex][msg.set - 1]
    if (!row || !row.done) return
    row.done = false
    row.at = 0
    this.allFinished = false
    save(s)
    this.refresh()
  },

  onRemoteValue(msg, field) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const value = field === 'w' ? msg.weight : msg.reps
    const type = field === 'w' ? 'weight' : 'reps'
    // 回传关联编辑时间戳，旧快照/旧确认不能覆盖更新的本地输入。
    s.pendingEdits = (s.pendingEdits || []).filter(edit => !(edit.t === type &&
      edit.ex === msg.ex && edit.set === msg.set && msg.editAt != null && edit.at <= msg.editAt))
    const pending = s.pendingEdits.filter(edit => edit.t === type && edit.ex === msg.ex && edit.set === msg.set)
    const latest = pending[pending.length - 1]
    setRowValue(s, msg.ex, msg.set - 1, field, latest ? latest[type] : value)
    this.refresh()
  },

  onRemoteAddSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length + 1
    if (target <= rows.length || target > 100) return
    while (rows.length < target) addSet(s, ex)
    const i = rows.length - 1
    if (msg.weight != null && msg.weight !== '') rows[i].w = msg.weight
    if (msg.reps != null && msg.reps !== '') rows[i].r = msg.reps
    s.exIdx = ex
    s.setIdx = i
    save(s)
    this.refresh()
  },

  onRemoteRemoveSet(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Number(msg.ex)
    const rows = s.workout.rows[ex]
    if (!rows || rows.length <= 1) return
    const target = Number.isInteger(msg.sets) ? msg.sets : rows.length - 1
    if (target < 1 || target >= rows.length) return
    rows.splice(target)
    s.workout.exercises[ex].sets = rows.length
    if (s.exIdx === ex && s.setIdx >= rows.length) s.setIdx = rows.length - 1
    save(s)
    this.refresh()
  },

  onRemoteFocus(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    const ex = Math.max(0, Math.min(Number(msg.ex) || 0, s.workout.exercises.length - 1))
    const rows = s.workout.rows[ex] || []
    s.exIdx = ex
    s.setIdx = Math.max(0, Math.min(Number(msg.set) - 1 || 0, Math.max(0, rows.length - 1)))
    save(s)
    this.refresh()
  },

  onSyncUpdate(msg) {
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    applySync(this.state, msg)
    this.profile = this.state.profile || this.profile
    this.allFinished = (this.state.workout.rows || []).every(rows => rows.every(r => r.done))
    this.refresh()
    return { status: 'applied', page: 'Workout', exercises: this.state.workout.exercises.length }
  },

  onRemoteEnded() {
    this.hrDirty = false
    this.state = loadState()
    this.stopHrCapture()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    router.replace({ uri: '/Summary' })
  },

  onSkipRest() {
    const s = this.state
    if (s.restUntil && this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
    s.restUntil = 0
    this.restStartAt = 0
    this.restSeq += 1
    sendControl({ t: 'rest', sid: s.sid, leftSec: 0, totalSec: 0, seq: this.restSeq })
    save(s)
    this.refresh()
  },

  nudgeRest(deltaSec) {
    const s = this.state
    if (!s.restUntil) return
    const left = Math.max(0, Math.round((s.restUntil - Date.now()) / 1000) + deltaSec)
    if (left <= 0) {
      if (this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
      s.restUntil = 0
      this.restStartAt = 0
    } else {
      s.restUntil = Date.now() + left * 1000
      this.restSeq += 1
      sendControl({ t: 'rest', sid: s.sid, leftSec: left, totalSec: left, seq: this.restSeq })
    }
    save(s)
    this.refresh()
  },

  onRestMinus() { this.nudgeRest(-15) },
  onRestPlus() { this.nudgeRest(15) },

  onPlanUpdate(msg) {
    const s = this.state
    if (msg && msg.sid && s.sid && msg.sid !== s.sid) {
      return { status: 'rejected', page: 'Workout', reason: 'session_mismatch', activeSid: s.sid }
    }
    if (!msg || !Array.isArray(msg.exercises) || !msg.exercises.length) {
      return { status: 'rejected', page: 'Workout', reason: 'empty_exercises' }
    }
    if (msg && msg.profile) s.profile = msg.profile
    replacePlan(s, { name: msg.workout, exercises: msg.exercises })
    this.allFinished = s.workout.rows.every(rows => rows.every(row => row.done))
    save(s)
    this.refresh()
    return { status: 'applied', page: 'Workout', exercises: s.workout.exercises.length }
  },

  onRemoteRest(msg) {
    const s = this.state
    if (!msg || msg.sid !== s.sid) return
    if (typeof msg.seq === 'number' && msg.seq <= this.remoteRestSeq) return
    if (typeof msg.seq === 'number') this.remoteRestSeq = msg.seq
    if (msg.leftSec > 0 && !s.restUntil) this.restStartAt = Date.now()
    s.restUntil = msg.leftSec > 0 ? Date.now() + msg.leftSec * 1000 : 0
    if (!s.restUntil) this.restStartAt = 0
    save(s)
    this.refresh()
  },

  isDoneRowCur() {
    const s = this.state
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    this.rowDone = !!(row && row.done)
    return !!(row && row.done)
  },

  refresh() {
    const s = this.state
    if (!s || !s.workout) return
    this.rowDone = this.isDoneRowCur()
    const ex = s.workout.exercises[s.exIdx]
    const row = s.workout.rows[s.exIdx] && s.workout.rows[s.exIdx][s.setIdx]
    this.exName = ex ? ex.name : ''
    this.groupLabel = ex ? '第 ' + (s.setIdx + 1) + ' / ' + (ex.sets || 1) + ' 组' : ''
    this.weightVal = row && row.w !== '' && row.w != null ? row.w + ' kg' : '—'
    this.repsVal = row && row.r !== '' && row.r != null ? row.r + (this.isTimed(ex) ? ' 秒' : ' 次') : '—'
    this.isRest = !!(row && !row.done && s.restUntil)

    const next = nextUndone(s)
    const totalSets = s.workout.rows.reduce((n, r) => n + r.length, 0)
    const doneSets = s.workout.rows.reduce((n, r) => n + r.filter(x => x.done).length, 0)
    this.restProgLabel = '✓ ' + doneSets + '/' + totalSets + ' 组'
    if (next) {
      const ne = s.workout.exercises[next.exIdx]
      const nr = s.workout.rows[next.exIdx][next.setIdx]
      const w = nr && nr.w !== '' && nr.w != null ? nr.w + 'kg' : ''
      const timed = ne && String(ne.reps || '').indexOf('秒') >= 0
      const r = nr && nr.r !== '' && nr.r != null ? nr.r + (timed ? '秒' : '次') : ''
      this.nextLabel = '下一组 ' + ne.name + ' ' + (w && r ? w + '×' + r : (w || r || ''))
    } else this.nextLabel = '本次训练已完成'

    this.syncClockTimer()
    this.tickClock()
  },

  isTimed(ex) { return ex && String(ex.reps || '').indexOf('秒') >= 0 },

  syncClockTimer() {
    const period = this.state && this.state.restUntil ? 1000 : 5000
    if (this.timer && this.clockPeriod === period) return
    if (this.timer) clearInterval(this.timer)
    this.clockPeriod = period
    this.timer = setInterval(() => this.tickClock(), period)
  },

  tickClock() {
    const s = this.state
    if (!s || !s.workout) return
    const mins = Math.floor((Date.now() - s.startedAt) / 60000)
    const secs = Math.floor(((Date.now() - s.startedAt) % 60000) / 1000)
    this.elapsedLabel = mins + ':' + String(secs).padStart(2, '0')

    const left = s.restUntil ? Math.ceil((s.restUntil - Date.now()) / 1000) : 0
    if (s.restUntil && left <= 0) {
      if (this.restStartAt) addRestTime(s, (Date.now() - this.restStartAt) / 1000)
      this.restStartAt = 0
      s.restUntil = 0
      save(s)
      restOver()
      this.refresh()
      return
    }
    this.restLabel = this.mmss(left)
    this.restTotalLabel = this.mmss(Math.round(s.restTotalSec || 0))
    this.hrLabel = this.hrLast ? '♥ ' + this.hrLast : '♥ --'
    this.kcalLabel = String(calories(s, s.profile, Math.max(0, (Date.now() - (s.segmentStartedAt || s.startedAt)) / 60000)))
    const n = pendingCount()
    this.syncLabel = isConnected() ? '已同步' : (n > 0 ? '未同步 ' + n + ' 条' : '')
  },

  mmss(sec) {
    sec = Math.max(0, Math.round(sec))
    return Math.floor(sec / 60) + ':' + String(sec % 60).padStart(2, '0')
  },

  onEnd(reason, notifyPhone = true) {
    if (typeof reason !== 'string') reason = 'manual'
    const s = this.state
    if (!s || !s.active) return
    this.stopHrCapture()
    const session = endSession(s, s.profile)
    if (notifyPhone) sendEvent({
      t: 'end', sid: session.sid, minutes: session.minutes, avgHr: session.avgHr,
      maxHr: session.maxHr, calories: session.calories, volume: session.volume || 0,
      sets: session.sets.length, reason: reason || 'manual',
      endedAt: session.endedAt, completedSets: session.sets,
    })
    this.state = loadState()
    if (this.timer) clearInterval(this.timer)
    if (this.hrFlush) clearInterval(this.hrFlush)
    router.replace({ uri: '/Summary' })
  },
}

</script>

<template>
  <div class="page" id="training" touch-focusable="true" onrotation="onRotation" ontouchstart="touchStart" ontouchmove="touchMove" ontouchend="touchEnd" ontouchcancel="touchCancel">
    <div class="topline"><text class="status">{{ syncLabel }}</text><text class="clock">{{ elapsedLabel }}</text></div>
    <text class="ex">{{ exName }}</text>

    <block if="{{ !isRest }}">
      <text class="group">{{ groupLabel }}{{ rowDone ? ' · 已完成' : '' }}</text>
      <div class="inputs">
        <div class="field" onclick="editWeight">
          <text class="fval">{{ weightVal }}</text>
          <text class="flbl">重量</text>
        </div>
        <div class="field" onclick="editReps">
          <text class="fval">{{ repsVal }}</text>
          <text class="flbl">次数</text>
        </div>
      </div>
      <div class="navrow">
        <input class="nav" type="button" value="‹ 上组" onclick="onPrevSet" />
        <input class="nav" type="button" value="下组 ›" onclick="onNextSet" />
      </div>
      <input class="complete" type="button" value="完成本组" onclick="onComplete" if="{{ !rowDone }}" />
      <input class="complete secondary" type="button" value="撤销本组" onclick="onUndo" if="{{ rowDone }}" />
    </block>

    <block if="{{ isRest }}">
      <text class="rest">{{ restLabel }}</text>
      <div class="rrow">
        <input class="rbtn" type="button" value="−15s" onclick="onRestMinus" />
        <text class="rtotal">{{ restTotalLabel }}</text>
        <input class="rbtn" type="button" value="+15s" onclick="onRestPlus" />
      </div>
      <text class="prog">{{ restProgLabel }}</text>
      <input class="skip" type="button" value="跳过" onclick="onSkipRest" />
    </block>

    <div class="metrics"><text class="hr">{{ hrLabel }}</text><text class="energy">{{ kcalLabel }} 千卡 · 估算</text></div>
    <div class="footer">
      <input class="tool" type="button" value="动作" onclick="openExercises" />
      <input class="tool" type="button" value="组数" onclick="openMenu" />
      <input class="tool" type="button" value="更多" onclick="openActions" />
    </div>

    <div class="menu" if="{{ menuOn }}">
      <text class="panel-title">调整组数</text>
      <div class="mrow">
        <input class="m" type="button" value="加组" onclick="onMenuAddSet" />
        <input class="m" type="button" value="减组" onclick="onMenuRemoveSet" />
      </div>
      <div class="mrow">
        <input class="m" type="button" value="上组" onclick="onMenuPrev" />
        <input class="m" type="button" value="下组" onclick="onMenuNext" />
      </div>
      <input class="mclose" type="button" value="收起" onclick="closeMenu" />
    </div>

    <div class="leave-panel" if="{{ leaveChoice }}">
      <text class="leave-title">训练操作</text>
      <input class="leave-btn continue" type="button" value="继续训练" onclick="continueTraining" />
      <input class="leave-btn end" type="button" value="结束当前训练" onclick="onEnd" />
    </div>
  </div>
</template>

<style>
.page { flex-direction: column; align-items: center; width: 390px; height: 450px; background-color: #000000; padding: 12px 20px; }
.topline { width: 350px; height: 24px; justify-content: space-between; }
.status { font-size: 16px; color: #63dfb1; }
.clock { font-size: 17px; color: #bfc6c9; }
.ex { width: 350px; height: 50px; font-size: 25px; color: #ffffff; lines: 2; text-align: center; }
.group { height: 26px; font-size: 18px; color: #bfc6c9; text-align: center; }
.inputs { flex-direction: row; justify-content: space-between; width: 350px; height: 92px; margin-top: 6px; }
.field { flex-direction: column; align-items: center; justify-content: center; width: 170px; height: 86px; border-radius: 8px; background-color: #191d1f; }
.fval { font-size: 27px; color: #ffffff; width: 164px; text-align: center; lines: 1; }
.flbl { font-size: 16px; color: #aeb9bd; }
.navrow { flex-direction: row; justify-content: space-between; width: 350px; height: 48px; }
.nav { width: 170px; height: 44px; font-size: 19px; border-radius: 8px; background-color: #191d1f; color: #ffffff; }
.complete { width: 350px; height: 56px; font-size: 23px; border-radius: 8px; background-color: #63dfb1; color: #001b12; margin-top: 6px; }
.secondary { background-color: #283236; color: #ffffff; }
.rest { width: 350px; height: 112px; font-size: 70px; color: #63dfb1; text-align: center; }
.rrow { flex-direction: row; align-items: center; justify-content: space-between; width: 350px; height: 48px; }
.rbtn { width: 100px; height: 44px; font-size: 20px; border-radius: 8px; background-color: #191d1f; color: #ffffff; }
.rtotal { font-size: 18px; color: #aeb9bd; }
.prog { width: 350px; height: 26px; font-size: 17px; color: #bfc6c9; text-align: center; }
.skip { width: 350px; height: 56px; font-size: 23px; border-radius: 8px; background-color: #63dfb1; color: #001b12; margin-top: 12px; }
.metrics { width: 350px; height: 38px; align-items: center; justify-content: space-between; }
.hr { font-size: 17px; color: #ff7d93; }
.energy { font-size: 17px; color: #e0c775; }
.footer { width: 350px; height: 48px; justify-content: space-between; }
.tool { width: 110px; height: 44px; border-radius: 8px; background-color: #191d1f; color: #ffffff; font-size: 18px; }
.menu { position: absolute; top: 0; left: 0; width: 390px; height: 450px; flex-direction: column; align-items: center; justify-content: center; background-color: #000000; }
.mrow { flex-direction: row; justify-content: center; }
.m { width: 145px; height: 58px; font-size: 21px; border-radius: 8px; background-color: #191d1f; color: #ffffff; margin: 7px 8px; }
.panel-title { font-size: 26px; color: #ffffff; margin-bottom: 16px; }
.mclose { width: 180px; height: 44px; font-size: 18px; border-radius: 12px; background-color: transparent; color: #636366; margin-top: 5px; }
.finish { width: 250px; height: 56px; font-size: 22px; border-radius: 14px; background-color: #30d158; color: #ffffff; margin-top: 18px; }
.leave-panel { position: absolute; top: 0; left: 0; width: 390px; height: 450px; flex-direction: column; align-items: center; justify-content: center; background-color: #000000; }
.leave-title { font-size: 28px; color: #ffffff; margin-bottom: 4px; }
.leave-hint { font-size: 16px; color: #8e8e93; margin-bottom: 14px; }
.leave-btn { width: 310px; height: 60px; font-size: 21px; border-radius: 8px; margin-top: 14px; }
.continue { background-color: #1c1c1e; color: #ffffff; }
.exit { background-color: #3a3a3c; color: #ffffff; }
.end { background-color: #ff453a; color: #ffffff; }
</style>
