+// legacy records). Exercise entries and their muscle snapshots are deliberately ignored here:
+// those describe analysis for Muscle Balance, not the user's training-day label.
+export function trainingThemesForDay(S, iso, dayWorkouts = []) {
+  const sessions = Array.isArray(dayWorkouts) ? dayWorkouts : []
+  const savedRoutines = Array.isArray(S?.routines) ? S.routines : []
+  const routines = new Map(savedRoutines.map(r => [r.id, r]))
+  const names = []
+  const add = value => {
+    const name = String(value || '').trim()
+    if (name && !names.includes(name)) names.push(name)
+  }
+  const routineIdsOf = workout => {
+    if (Array.isArray(workout?.routineIds)) return workout.routineIds
+    return workout?.routineId ? [workout.routineId] : []
+  }
+
+  if (sessions.length) {
+    sessions.forEach(workout => {
+      const routineNames = routineIdsOf(workout).map(id => routines.get(id)?.name).filter(Boolean)
+      if (routineNames.length) routineNames.forEach(add)
+      else add(workout?.name)
+    })
+  } else {
+    const planState = {
+      ...S,
+      routines: savedRoutines,
+      workouts: Array.isArray(S?.workouts) ? S.workouts : [],
+      week: S?.week && typeof S.week === 'object' ? S.week : {},
+      dayPlan: S?.dayPlan && typeof S.dayPlan === 'object' ? S.dayPlan : {},
+    }
+    effectiveRoutineIds(planState, iso).forEach(id => add(routines.get(id)?.name))
+  }
+  return names
+}
+
+export function compactTrainingTheme(names = []) {
+  const topics = Array.isArray(names) ? names : []
+  if (!topics.length) return ''
+  return topics.length === 1 ? topics[0] : `${topics[0]} +${topics.length - 1}`
+}
